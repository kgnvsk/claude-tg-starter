#!/usr/bin/env python3
"""GitHub CLI with the agent's current PAT; native gh OAuth is kept in place."""
import os
from pathlib import Path
import sys
from agent_connections import provider_environment


def main():
    try:
        native_auth = len(sys.argv) > 1 and sys.argv[1] == 'auth'
        # Backup login deliberately isolates its native OAuth account. Honor
        # that explicit context for every command, including `gh api user`.
        environment = dict(os.environ)
        if not environment.get('GH_CONFIG_DIR') and not native_auth:
            environment = provider_environment(Path.home().resolve(), 'github', environment)
        own = Path(__file__).resolve()
        candidates = (Path(entry) / 'gh' for entry in os.get_exec_path(environment))
        executable = next((str(path) for path in candidates if path.is_file() and os.access(path, os.X_OK) and path.resolve() != own), None)
        if not executable: raise ValueError()
        # Native login/logout must manage the native account, without a PAT
        # making gh reject login or accidentally exposing that PAT via status.
        if native_auth:
            environment.pop('GH_TOKEN', None); environment.pop('GITHUB_TOKEN', None)
        os.execve(executable, [executable, *sys.argv[1:]], environment)
    except (OSError, ValueError):
        print('GitHub configuration or CLI unavailable.', file=sys.stderr)
        return 1


if __name__ == '__main__': raise SystemExit(main())
