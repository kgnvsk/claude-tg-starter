#!/usr/bin/env python3
"""Selected-agent stdio transport. Byte forwarding is stock socat, never a session proxy."""
import fcntl
import json
import os
from pathlib import Path
import pwd
import re
import stat
import subprocess
import sys


class InvalidBrowser(ValueError):
    pass


def configuration(uid=None):
    uid = os.getuid() if uid is None else uid
    account = pwd.getpwuid(uid)
    if uid < 1000 or account.pw_dir != '/home/' + account.pw_name:
        raise InvalidBrowser('run as the selected installed agent')
    path = Path('/etc/claude-browser-private') / (str(uid) + '.json')
    for item in (path.parent, path):
        s = item.lstat()
        if item.is_symlink() or s.st_uid != 0 or s.st_mode & 0o022:
            raise InvalidBrowser('unsafe private browser configuration')
    if not stat.S_ISREG(path.stat().st_mode):
        raise InvalidBrowser('invalid private browser configuration')
    c = json.loads(path.read_text())
    expected = {'uid': uid, 'user': account.pw_name, 'home': account.pw_dir,
                'transport': 'private-stdio', 'socket': f'/run/claude-browser-private-{uid}.sock',
                'state': f'/var/lib/claude-browser-private/{uid}', 'unit': f'claude-browser-private-{uid}',
                'browser_user': f'claude-browser-{uid}', 'schema': 1}
    if any(c.get(k) != v for k, v in expected.items()):
        raise InvalidBrowser('private browser identity mismatch')
    if not re.fullmatch(r'/opt/claude-browser-runtimes/0\.0\.[0-9]{1,4}', c.get('runtime', '')):
        raise InvalidBrowser('unexpected browser runtime')
    return c


def socket_ready(c):
    s = Path(c['socket']).lstat()
    if not stat.S_ISSOCK(s.st_mode) or s.st_uid != c['uid'] or stat.S_IMODE(s.st_mode) != 0o600:
        raise InvalidBrowser('private browser socket is missing or not UID-private')


def registration_ready(c):
    # Local/project override would take precedence over the user registration.
    state_root = Path(os.environ.get('CLAUDE_CONFIG_DIR', c['home']))
    state_path = state_root / '.claude.json'
    if 'CLAUDE_CONFIG_DIR' in os.environ and (state_root / '.config.json').exists():
        state_path = state_root / '.config.json'
    state = json.loads(state_path.read_text())
    p = dict(state.get('mcpServers', {}).get('playwright') or {})
    if p.get('env') == {}:
        p.pop('env')
    if p != {'type': 'stdio', 'command': c['home'] + '/bin/browser-mcp', 'args': []}:
        raise InvalidBrowser('selected private stdio registration is missing')
    for workspace in (c['home'], c['home'] + '/obsidian-vault'):
        if 'playwright' in state.get('projects', {}).get(workspace, {}).get('mcpServers', {}):
            raise InvalidBrowser('local MCP override needs explicit reconciliation')
        project = Path(workspace, '.mcp.json')
        if project.exists() and 'playwright' in json.loads(project.read_text()).get('mcpServers', {}):
            raise InvalidBrowser('project MCP override needs explicit reconciliation')


def status(c):
    socket_ready(c)
    registration_ready(c)
    result = subprocess.run(['systemctl', 'is-active', '--quiet', c['unit'] + '.socket'], timeout=5)
    if result.returncode:
        raise InvalidBrowser('selected private browser socket is inactive')
    # Configuration/transport is a fact, never a claim of a successful new operation.
    receipt = Path(c['home'], '.cache/browser-private-smoke.json')
    operation = False
    try:
        r = json.loads(receipt.read_text())
        operation = r.get('uid') == c['uid'] and r.get('version') == c['version'] and r.get('ok') is True
    except (OSError, ValueError):
        pass
    return {'configured': True, 'socketActive': True, 'transport': 'private-stdio',
            'pastOperationVerified': operation, 'operationNow': 'not-run', 'maxConnections': 1,
            'legacyHttpMayRemain': Path('/etc/systemd/system/claude-browser.service').exists()}


def connect(c):
    socket_ready(c)
    # The server separately enforces MaxConnections=1. This lock gives ordinary
    # second MCP clients a quick, readable busy result before opening the socket.
    cache = Path(c['home'], '.cache')
    cache.mkdir(mode=0o700, exist_ok=True)
    if cache.is_symlink() or cache.stat().st_uid != c['uid'] or cache.stat().st_mode & 0o022:
        raise InvalidBrowser('unsafe private browser lock directory')
    fd = os.open(cache / 'browser-mcp.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    s = os.fstat(fd)
    if not stat.S_ISREG(s.st_mode) or s.st_uid != c['uid'] or s.st_nlink != 1 or s.st_mode & 0o077:
        raise InvalidBrowser('unsafe private browser client lock')
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        print('Browser busy: this agent already has one active browser MCP connection. Close it before opening another.', file=sys.stderr)
        return 75
    os.set_inheritable(fd, True)
    # No shell, no TCP, no user-provided address/options and no protocol parsing.
    os.execv('/usr/bin/socat', ['socat', '-t', '10', 'STDIO', 'UNIX-CONNECT:' + c['socket'] + ',connect-timeout=5'])


def main():
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and sys.argv[1] not in ('--check', '--runtime')):
        raise InvalidBrowser('usage: browser-mcp [--check|--runtime]')
    c = configuration()
    if sys.argv[1:] == ['--check']:
        print(json.dumps(status(c), sort_keys=True))
        return 0
    if sys.argv[1:] == ['--runtime']:
        print(c['runtime'])
        return 0
    return connect(c)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print('Private browser unavailable: ' + (str(error) if isinstance(error, InvalidBrowser) else type(error).__name__), file=sys.stderr)
        sys.exit(1)
