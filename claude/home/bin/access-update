#!/usr/bin/env python3
"""Atomically update Telegram access.json under a cross-process lock."""

from __future__ import annotations

import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import sqlite3
import sys
import tempfile
import time
import uuid
from contextlib import closing
from typing import Callable


CARRIER_MAX_AGE_S = 15 * 60
LOCK_WAIT_SECONDS = 5.0
TEAM_PREVIEW_TTL_MS = 10 * 60_000
PREVIEW_RETENTION_MS = 7 * 24 * 60 * 60_000


def acquire_access_lock(lock_fd: int) -> None:
    # A membership handler awaits this process in the sequential Telegram poller.
    # Never let a wedged writer hold up every later private message indefinitely.
    deadline = time.monotonic() + LOCK_WAIT_SECONDS
    while True:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return
        except BlockingIOError:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise SystemExit("access-update: lock wait timed out; retry the access change") from None
            time.sleep(min(0.05, remaining))


def unique(values: list[object]) -> list[str]:
    result: list[str] = []
    for value in values:
        normalized = str(value).strip()
        if normalized and normalized not in result:
            result.append(normalized)
    return result


def locked_update(path: Path, update: Callable[[dict], str]) -> str:
    path.parent.mkdir(parents=True, exist_ok=True)
    lock_path = path.with_name(path.name + ".lock")
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        acquire_access_lock(lock_fd)
        if path.is_symlink():
            raise SystemExit(f"Символічне посилання на файл доступу відхилено: {path}")
        data = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
        if not isinstance(data, dict):
            raise SystemExit(f"Файл доступу має містити JSON-об’єкт: {path}")
        message = update(data)
        fd, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as handle:
                json.dump(data, handle, ensure_ascii=False, indent=2)
                handle.write("\n")
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(temporary, 0o600)
            os.replace(temporary, path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
        return message
    finally:
        os.close(lock_fd)


def locked_inspect(path: Path, inspect: Callable[[dict], str]) -> str:
    path.parent.mkdir(parents=True, exist_ok=True)
    lock_path = path.with_name(path.name + ".lock")
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        acquire_access_lock(lock_fd)
        if path.is_symlink() or not path.is_file():
            raise SystemExit(f"Файл доступу відсутній або небезпечний: {path}")
        data = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            raise SystemExit(f"Файл доступу має містити JSON-об’єкт: {path}")
        return inspect(data)
    finally:
        os.close(lock_fd)


def reconcile_admins(data: dict, owner: str, additional_csv: str) -> str:
    desired = unique([owner, *additional_csv.split(",")])
    previous_admins = set(unique(data.get("admins", [])))
    guests = [
        chat_id
        for chat_id in unique(data.get("allowFrom", []))
        if chat_id not in previous_admins and chat_id not in desired
    ]
    data["admins"] = desired
    data["allowFrom"] = [*guests, *desired]
    if "superadmins" in data:
        # A super-administrator is an administrator first: losing that loses the role too.
        data["superadmins"] = [chat_id for chat_id in unique(data.get("superadmins", [])) if chat_id in desired and chat_id != owner]
    return f"Узгоджено адміністраторів: {len(desired)}; збережено гостей: {len(guests)}"


def set_superadmins(data: dict, owner: str, csv: str) -> str:
    """The owner's business assistants: administrators with his rights, never his private chat.
    Set only from the host (Novsky, installer); no chat helper can grant it."""
    wanted = unique(csv.split(","))
    admins, admitted = set(unique(data.get("admins", []))), set(unique(data.get("allowFrom", [])))
    for chat_id in wanted:
        if not chat_id.isdigit():
            raise SystemExit(f"Telegram ID суперадміністратора має бути числом: {chat_id}")
        if chat_id == owner:
            raise SystemExit("Основний власник не може бути суперадміністратором")
        if chat_id not in admins or chat_id not in admitted:
            raise SystemExit(f"Суперадміністратор має бути адміністратором цього бота: {chat_id}")
    data["superadmins"] = wanted
    return f"Суперадміністраторів: {len(wanted)}"


def team_fingerprint(data: dict) -> str:
    return hashlib.sha256(json.dumps(data, sort_keys=True, ensure_ascii=False).encode("utf-8")).hexdigest()


def cleanup_access_previews(db: sqlite3.Connection, table: str, now: int) -> None:
    if table not in {"access_team_previews", "access_settings_previews"}:
        raise ValueError("unknown access preview table")
    # A claimed approval may need reconciliation after a crash, so retain it.
    # Pending approvals are removed only after expiry; terminal receipts remain
    # for a week so a delayed callback can still report a one-use refusal.
    db.execute(f"DELETE FROM {table} WHERE (state='pending' AND expires_at<=?) "
               "OR (state IN ('applied','cancelled','stale') AND expires_at<=?)",
               (now, now - PREVIEW_RETENTION_MS))


def access_admin_audit(db: sqlite3.Connection) -> None:
    """Permanent decision trail; preview cleanup must never erase it."""
    db.execute("""CREATE TABLE IF NOT EXISTS access_admin_audit (
        id INTEGER PRIMARY KEY AUTOINCREMENT, ts INTEGER NOT NULL,
        kind TEXT NOT NULL, token TEXT NOT NULL, owner TEXT NOT NULL,
        actor TEXT NOT NULL, subject TEXT NOT NULL, message_id INTEGER,
        decision TEXT, event TEXT NOT NULL, change_json TEXT,
        UNIQUE(token, event))""")
    if "change_json" not in {row[1] for row in db.execute("PRAGMA table_info(access_admin_audit)")}:
        db.execute("ALTER TABLE access_admin_audit ADD COLUMN change_json TEXT")
    db.execute("""CREATE TRIGGER IF NOT EXISTS access_admin_audit_no_update
        BEFORE UPDATE ON access_admin_audit BEGIN SELECT RAISE(ABORT, 'access audit is append-only'); END""")
    db.execute("""CREATE TRIGGER IF NOT EXISTS access_admin_audit_no_delete
        BEFORE DELETE ON access_admin_audit BEGIN SELECT RAISE(ABORT, 'access audit is append-only'); END""")


def record_admin_decision(db: sqlite3.Connection, *, kind: str, token: str, owner: str,
                          actor: str, subject: str, event: str,
                          message_id: int | None = None, decision: str | None = None,
                          change_json: str | None = None) -> None:
    access_admin_audit(db)
    if message_id is None or change_json is None:
        row = db.execute("SELECT message_id,change_json FROM access_admin_audit WHERE token=? AND event='previewed'",
                         (token,)).fetchone()
        if row:
            message_id = row[0] if message_id is None else message_id
            change_json = row[1] if change_json is None else change_json
        # An approval may predate this audit schema; then both fields are null.
    db.execute("INSERT OR IGNORE INTO access_admin_audit "
               "(ts,kind,token,owner,actor,subject,message_id,decision,event,change_json) VALUES (?,?,?,?,?,?,?,?,?,?)",
               (int(time.time() * 1000), kind, token, owner, actor, subject, message_id, decision, event, change_json))


def close_stale_preview(path: Path, table: str, kind: str, token: str, owner: str,
                        actor: str, subject: str, change_json: str) -> None:
    """A stale base hash failed before access.json was written; close its claim."""
    if table not in {"access_team_previews", "access_settings_previews"}:
        raise ValueError("unknown access preview table")
    with closing(sqlite3.connect(path.with_name("messages.db"), timeout=5)) as db, db:
        updated = db.execute(f"UPDATE {table} SET state='stale' WHERE token=? AND state='claimed'",
                             (token,)).rowcount
        if updated:
            record_admin_decision(db, kind=kind, token=token, owner=owner, actor=actor,
                                  subject=subject, decision="approve", event="stale",
                                  change_json=change_json)


def settings_subject(change: dict) -> str:
    return (f"group:{change['groupId']}.{change['setting']}" if change["scope"] == "group"
            else f"agent.{change['setting']}")


def confirmation_status(path: Path, table: str, owner: str, actor: str, token: str) -> str:
    """Read back a terminal receipt if the confirm process response was lost."""
    if table not in {"access_team_previews", "access_settings_previews"}:
        raise ValueError("unknown confirmation table")
    db_path = path.with_name("messages.db")
    if db_path.is_symlink() or not db_path.is_file():
        raise SystemExit("Confirmation receipt unavailable")
    with closing(sqlite3.connect(f"file:{db_path}?mode=ro", uri=True, timeout=2)) as db:
        try:
            row = db.execute(f"SELECT state FROM {table} WHERE token=? AND owner=? AND actor=?",
                             (token, owner, actor)).fetchone()
        except sqlite3.OperationalError:
            row = None
    return json.dumps({"state": row[0] if row else "missing"})


def require_business_administrator(data: dict, owner: str, actor: str) -> None:
    admins = unique(data.get("admins", []))
    admitted = unique(data.get("allowFrom", []))
    superadmins = unique(data.get("superadmins", []))
    if owner not in admins or owner not in admitted or actor != owner and not (
        actor in superadmins and actor in admins and actor in admitted
    ):
        raise SystemExit("Дію відхилено: потрібні права власника або суперадміністратора")


def team_list(data: dict, owner: str, actor: str) -> str:
    require_business_administrator(data, owner, actor)
    admins = unique(data.get("admins", []))
    admitted = unique(data.get("allowFrom", []))
    superadmins = unique(data.get("superadmins", []))
    return json.dumps({
        "superadmins": [value for value in superadmins if value != owner],
        "admins": [value for value in admins if value != owner and value not in superadmins],
        "members": [value for value in admitted if value != owner and value not in admins],
    }, ensure_ascii=False)


def change_team_role(data: dict, owner: str, actor: str, target: str, role: str) -> str:
    """Owner and current superadmins may manage roles; nobody can replace the owner."""
    admins = unique(data.get("admins", []))
    admitted = unique(data.get("allowFrom", []))
    superadmins = unique(data.get("superadmins", []))
    if not owner.isdigit() or owner not in admins or owner not in admitted:
        raise SystemExit("Основний власник відсутній у файлі доступу")
    require_business_administrator(data, owner, actor)
    if not target.isdigit() or not target or target == owner or role not in {"superadmin", "admin", "member", "remove"}:
        raise SystemExit("Недопустима зміна ролі")
    if role == "remove":
        superadmins = [value for value in superadmins if value != target]
        admins = [value for value in admins if value != target]
        admitted = [value for value in admitted if value != target]
    else:
        if target not in admitted:
            admitted.append(target)
        if role in {"superadmin", "admin"}:
            if target not in admins:
                admins.append(target)
        else:
            admins = [value for value in admins if value != target]
        if role == "superadmin":
            if target not in superadmins:
                superadmins.append(target)
        else:
            superadmins = [value for value in superadmins if value != target]
    data["allowFrom"], data["admins"], data["superadmins"] = admitted, admins, superadmins
    return f"Роль {target}: {role}"


def team_preview(path: Path, owner: str, actor: str, message_id: str, target: str, role: str) -> str:
    if not message_id.isdigit():
        raise SystemExit("Неправильний номер повідомлення")
    corroborate_requester(path, actor, message_id, target, private_only=True)
    snapshot = json.loads(locked_inspect(path, lambda data: json.dumps(data)))
    proposed = json.loads(json.dumps(snapshot))
    summary = change_team_role(proposed, owner, actor, target, role)
    token = str(uuid.uuid4())
    expires_at = int(time.time() * 1000) + TEAM_PREVIEW_TTL_MS
    with closing(sqlite3.connect(path.with_name("messages.db"), timeout=5)) as db, db:
        db.execute("""CREATE TABLE IF NOT EXISTS access_team_previews (
            token TEXT PRIMARY KEY, owner TEXT NOT NULL, actor TEXT NOT NULL,
            target TEXT NOT NULL, role TEXT NOT NULL, base_hash TEXT NOT NULL, post_hash TEXT NOT NULL,
            expires_at INTEGER NOT NULL, state TEXT NOT NULL)""")
        cleanup_access_previews(db, "access_team_previews", expires_at - TEAM_PREVIEW_TTL_MS)
        db.execute("INSERT INTO access_team_previews VALUES (?,?,?,?,?,?,?,?,'pending')",
                   (token, owner, actor, target, role, team_fingerprint(snapshot), team_fingerprint(proposed), expires_at))
        record_admin_decision(db, kind="team", token=token, owner=owner, actor=actor,
                              subject=target, message_id=int(message_id), event="previewed",
                              change_json=json.dumps({"role": role}, separators=(",", ":")))
    return json.dumps({"token": token, "expiresAt": expires_at, "summary": summary}, ensure_ascii=False)


def team_confirm(path: Path, owner: str, actor: str, token: str, decision: str) -> str:
    if decision not in {"approve", "cancel"}:
        raise SystemExit("Неправильне підтвердження")
    now = int(time.time() * 1000)
    with closing(sqlite3.connect(path.with_name("messages.db"), timeout=5)) as db, db:
        db.execute("BEGIN IMMEDIATE")
        access_admin_audit(db)
        row = db.execute("SELECT owner,actor,target,role,base_hash,post_hash,expires_at,state "
                         "FROM access_team_previews WHERE token=?", (token,)).fetchone()
        if row is None or row[0] != owner or row[1] != actor:
            raise SystemExit("ACCESS_STALE: Підтвердження відсутнє, прострочене або вже використане")
        if row[7] == "claimed" and decision == "approve":
            pass  # Reconcile after releasing the SQLite write lock.
        elif row[7] != "pending" or row[6] <= now:
            raise SystemExit("ACCESS_STALE: Підтвердження відсутнє, прострочене або вже використане")
        else:
            db.execute("UPDATE access_team_previews SET state=? WHERE token=? AND state='pending'",
                       ("claimed" if decision == "approve" else "cancelled", token))
            record_admin_decision(db, kind="team", token=token, owner=owner, actor=actor,
                                  subject=row[2], decision=decision,
                                  event="claimed" if decision == "approve" else "cancelled",
                                  change_json=json.dumps({"role": row[3]}, separators=(",", ":")))
    if row[7] == "claimed":
        current = json.loads(locked_inspect(path, lambda data: json.dumps(data)))
        if team_fingerprint(current) != row[5]:
            raise SystemExit("Стан зміни ролі невизначений; перевірте поточний список доступу")
        with closing(sqlite3.connect(path.with_name("messages.db"), timeout=5)) as db, db:
            db.execute("UPDATE access_team_previews SET state='applied' WHERE token=? AND state='claimed'", (token,))
            record_admin_decision(db, kind="team", token=token, owner=owner, actor=actor,
                                  subject=row[2], decision="approve", event="applied",
                                  change_json=json.dumps({"role": row[3]}, separators=(",", ":")))
        return f"Роль {row[2]}: {row[3]}"
    if decision == "cancel":
        return "Скасовано"
    _, _, target, role, base_hash, _, _, _ = row
    def apply(data: dict) -> str:
        if team_fingerprint(data) != base_hash:
            raise SystemExit("ACCESS_STALE: Склад доступу змінився; створіть нове підтвердження")
        return change_team_role(data, owner, actor, target, role)
    try:
        result = locked_update(path, apply)
    except SystemExit as error:
        if str(error).startswith("ACCESS_STALE:"):
            close_stale_preview(path, "access_team_previews", "team", token, owner, actor,
                                target, json.dumps({"role": role}, separators=(",", ":")))
        raise
    with closing(sqlite3.connect(path.with_name("messages.db"), timeout=5)) as db, db:
        db.execute("UPDATE access_team_previews SET state='applied' WHERE token=? AND state='claimed'", (token,))
        record_admin_decision(db, kind="team", token=token, owner=owner, actor=actor,
                              subject=target, decision="approve", event="applied",
                              change_json=json.dumps({"role": role}, separators=(",", ":")))
    return result


def settings_list(data: dict, owner: str, actor: str) -> str:
    require_business_administrator(data, owner, actor)
    groups = data.get("groups", {})
    if not isinstance(groups, dict):
        raise SystemExit("Поле groups має бути JSON-об’єктом")
    shown = {}
    for group_id, policy in groups.items():
        if not isinstance(policy, dict):
            continue
        allowed = unique(policy.get("allowFrom", []))
        shown[group_id] = {
            "name": policy.get("name", group_id),
            "requireMention": policy.get("requireMention", True),
            "observeEnabled": policy.get("observeEnabled", True),
            "admissionMode": policy.get("admissionMode", "allowlist" if allowed else "all"),
            "allowFrom": allowed,
        }
    return json.dumps({"agent": {
        "replyToMode": data.get("replyToMode", "first"),
        "textChunkLimit": data.get("textChunkLimit", 4096),
        "chunkMode": data.get("chunkMode", "length"),
        "ackReaction": data.get("ackReaction", "👀"),
    }, "groups": shown}, ensure_ascii=False)


def apply_settings(data: dict, owner: str, actor: str, change: dict) -> str:
    require_business_administrator(data, owner, actor)
    if not isinstance(change, dict):
        raise SystemExit("Invalid setting request")
    scope, setting, value = change.get("scope"), change.get("setting"), change.get("value")
    if scope == "agent" and set(change) == {"scope", "setting", "value"}:
        valid = (
            setting == "replyToMode" and value in ("off", "first", "all")
            or setting == "chunkMode" and value in ("length", "newline")
            or setting == "textChunkLimit" and type(value) is int and 256 <= value <= 4096
            or setting == "ackReaction" and isinstance(value, str) and len(value) <= 8
        )
        if not valid:
            raise SystemExit("Invalid setting or value")
        data[setting] = value
        return f"Налаштування агента {setting}: {value}"
    if scope == "group" and set(change) == {"scope", "groupId", "setting", "value"}:
        group_id = change["groupId"]
        groups = data.get("groups", {})
        if not isinstance(group_id, str) or not re.fullmatch(r"-\d{1,20}", group_id) or not isinstance(groups, dict):
            raise SystemExit("Invalid group setting")
        policy = groups.get(group_id)
        if not isinstance(policy, dict):
            raise SystemExit("Group is not registered")
        if setting in {"requireMention", "observeEnabled"} and type(value) is bool:
            policy[setting] = value
        elif setting == "admissionMode" and value in {"all", "allowlist"}:
            policy["admissionMode"] = value
            if value == "all":
                policy["allowFrom"] = []
        elif setting == "allowFrom" and isinstance(value, list) and len(value) <= 200 and all(
            isinstance(item, str) and re.fullmatch(r"[1-9]\d{0,19}", item) for item in value
        ):
            policy["allowFrom"] = unique(value)
            policy["admissionMode"] = "allowlist"
        else:
            raise SystemExit("Invalid group setting or value")
        summary = f"Налаштування групи {group_id} {setting}: {json.dumps(value, ensure_ascii=False)}"
        if len(summary.encode("utf-8")) > 3500 and setting == "allowFrom":
            digest = hashlib.sha256(json.dumps(value, ensure_ascii=False).encode("utf-8")).hexdigest()
            return (f"Налаштування групи {group_id} {setting}: {len(value)} ID; "
                    f"перші {json.dumps(value[:10])}; останні {json.dumps(value[-5:])}; SHA-256 {digest}")
        return summary
    raise SystemExit("Invalid setting request")


def settings_preview(path: Path, owner: str, actor: str, message_id: str, change_json: str) -> str:
    if not message_id.isdigit() or len(change_json) > 8192:
        raise SystemExit("Invalid setting request")
    try:
        change = json.loads(change_json)
    except ValueError:
        raise SystemExit("Invalid setting request") from None
    corroborate_requester(path, actor, message_id, "settings", private_only=True)
    snapshot = json.loads(locked_inspect(path, lambda data: json.dumps(data)))
    proposed = json.loads(json.dumps(snapshot))
    summary = apply_settings(proposed, owner, actor, change)
    token = str(uuid.uuid4())
    expires_at = int(time.time() * 1000) + TEAM_PREVIEW_TTL_MS
    with closing(sqlite3.connect(path.with_name("messages.db"), timeout=5)) as db, db:
        db.execute("""CREATE TABLE IF NOT EXISTS access_settings_previews (
            token TEXT PRIMARY KEY, owner TEXT NOT NULL, actor TEXT NOT NULL,
            change_json TEXT NOT NULL, base_hash TEXT NOT NULL, post_hash TEXT NOT NULL,
            expires_at INTEGER NOT NULL, state TEXT NOT NULL)""")
        cleanup_access_previews(db, "access_settings_previews", expires_at - TEAM_PREVIEW_TTL_MS)
        db.execute("INSERT INTO access_settings_previews VALUES (?,?,?,?,?,?,?,'pending')",
                   (token, owner, actor, json.dumps(change, ensure_ascii=False),
                    team_fingerprint(snapshot), team_fingerprint(proposed), expires_at))
        record_admin_decision(db, kind="settings", token=token, owner=owner, actor=actor,
                              subject=settings_subject(change), message_id=int(message_id),
                              event="previewed", change_json=json.dumps(change, ensure_ascii=False))
    return json.dumps({"token": token, "expiresAt": expires_at, "summary": summary}, ensure_ascii=False)


def settings_confirm(path: Path, owner: str, actor: str, token: str, decision: str) -> str:
    if decision not in {"approve", "cancel"}:
        raise SystemExit("Invalid setting confirmation")
    now = int(time.time() * 1000)
    with closing(sqlite3.connect(path.with_name("messages.db"), timeout=5)) as db, db:
        db.execute("BEGIN IMMEDIATE")
        access_admin_audit(db)
        row = db.execute("SELECT owner,actor,change_json,base_hash,post_hash,expires_at,state "
                         "FROM access_settings_previews WHERE token=?", (token,)).fetchone()
        if row is None or row[0] != owner or row[1] != actor:
            raise SystemExit("ACCESS_STALE: Setting confirmation unavailable")
        if row[6] == "claimed" and decision == "approve":
            pass
        elif row[6] != "pending" or row[5] <= now:
            raise SystemExit("ACCESS_STALE: Setting confirmation unavailable")
        else:
            db.execute("UPDATE access_settings_previews SET state=? WHERE token=? AND state='pending'",
                       ("claimed" if decision == "approve" else "cancelled", token))
            change = json.loads(row[2])
            record_admin_decision(db, kind="settings", token=token, owner=owner, actor=actor,
                                  subject=settings_subject(change), decision=decision,
                                  event="claimed" if decision == "approve" else "cancelled",
                                  change_json=row[2])
    if row[6] == "claimed":
        current = json.loads(locked_inspect(path, lambda data: json.dumps(data)))
        if team_fingerprint(current) != row[4]:
            raise SystemExit("Setting state uncertain; inspect before retry")
        with closing(sqlite3.connect(path.with_name("messages.db"), timeout=5)) as db, db:
            db.execute("UPDATE access_settings_previews SET state='applied' WHERE token=? AND state='claimed'", (token,))
            change = json.loads(row[2])
            record_admin_decision(db, kind="settings", token=token, owner=owner, actor=actor,
                                  subject=settings_subject(change),
                                  decision="approve", event="applied", change_json=row[2])
        return "Налаштування оновлено"
    if decision == "cancel":
        return "Скасовано"
    def apply(data: dict) -> str:
        if team_fingerprint(data) != row[3]:
            raise SystemExit("ACCESS_STALE: Settings changed; create a new confirmation")
        return apply_settings(data, owner, actor, json.loads(row[2]))
    try:
        result = locked_update(path, apply)
    except SystemExit as error:
        if str(error).startswith("ACCESS_STALE:"):
            close_stale_preview(path, "access_settings_previews", "settings", token, owner, actor,
                                settings_subject(json.loads(row[2])), row[2])
        raise
    with closing(sqlite3.connect(path.with_name("messages.db"), timeout=5)) as db, db:
        db.execute("UPDATE access_settings_previews SET state='applied' WHERE token=? AND state='claimed'", (token,))
        change = json.loads(row[2])
        record_admin_decision(db, kind="settings", token=token, owner=owner, actor=actor,
                              subject=settings_subject(change),
                              decision="approve", event="applied", change_json=row[2])
    return result


def preserve_admins(data: dict, owner: str, additional_csv: str) -> str:
    del additional_csv  # Saved profile is not authority during an update.
    raw_admins = data.get("admins")
    raw_allowed = data.get("allowFrom")
    if not isinstance(raw_admins, list) or not isinstance(raw_allowed, list):
        raise SystemExit("Поля admins і allowFrom мають бути списками")
    if any(not isinstance(value, str) or not value.isdigit() for value in [*raw_admins, *raw_allowed]):
        raise SystemExit("Telegram ID у файлі доступу мають бути числовими рядками")
    if len(set(raw_admins)) != len(raw_admins) or len(set(raw_allowed)) != len(raw_allowed):
        raise SystemExit("Файл доступу містить дублікати Telegram ID")
    if owner not in raw_admins or owner not in raw_allowed:
        raise SystemExit("Основний власник відсутній у поточному файлі доступу")
    if not set(raw_admins).issubset(raw_allowed):
        raise SystemExit("Адміністратор поза allowFrom: оновлення не розширює доступ автоматично")
    return f"Збережено чинний склад доступу: адміністраторів {len(raw_admins)}"


def registered_groups(path: Path) -> set[str]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return set()
    groups = data.get("groups") if isinstance(data, dict) else None
    return set(map(str, groups)) if isinstance(groups, dict) else set()


def corroborate_requester(path: Path, requester: str, message_id: str, target: str,
                          private_only: bool = False) -> None:
    """The requester id arrives from the model, which read it out of message
    metadata, so a prompt injection could hand over any number. The transport's
    own message log is the second witness: the carrier message must exist, come
    from that user, and be fresh. In a private chat that is enough — nobody
    else sees those message ids. In a registered group every member sees them,
    so the carrier must additionally name the target id itself: an injected
    request can then only repeat what the admin literally asked for."""
    db_path = path.with_name("messages.db")
    if db_path.is_symlink() or not db_path.is_file():
        raise SystemExit("Дію відхилено: журнал транспорту недоступний, відправника не підтверджено")
    try:
        connection = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        try:
            rows = connection.execute(
                "SELECT chat_id, ts, COALESCE(text, '') FROM messages WHERE direction='in' "
                "AND user_id=? AND message_id=? ORDER BY ts DESC",
                (requester, int(message_id)),
            ).fetchall()
        finally:
            connection.close()
    except (sqlite3.Error, ValueError):
        raise SystemExit("Дію відхилено: журнал транспорту не читається, відправника не підтверджено") from None
    if not rows:
        raise SystemExit("Дію відхилено: повідомлення-носій не знайдено в журналі транспорту для цього відправника")
    groups = registered_groups(path)
    names_target = re.compile(rf"(?<!\d){re.escape(target)}(?!\d)")
    stale = False
    for chat_id, ts, text in rows:
        if time.time() - int(ts) / 1000 > CARRIER_MAX_AGE_S:
            stale = True
            continue
        if str(chat_id) == requester:
            return
        if private_only:
            continue
        if str(chat_id) in groups and names_target.search(text):
            return
    if stale:
        raise SystemExit("Дію відхилено: повідомлення-носій старіше за 15 хвилин — попроси адміністратора повторити запит")
    raise SystemExit(
        "Дію відхилено: носій має бути з приватного чату адміністратора або із зареєстрованої групи, "
        f"де в тому самому повідомленні названо id {target}"
    )


def record_access_event(event: dict) -> None:
    """Append-only trail: who changed the allowlist, for whom, when, and with
    which carrier message. Without it a grant is unexplainable after the fact."""
    log_dir = Path(os.environ.get("HOME") or Path.home()) / "logs"
    try:
        log_dir.mkdir(mode=0o700, exist_ok=True)
        fd = os.open(log_dir / "access-grants.log", os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a", encoding="utf-8") as handle:
            handle.write(json.dumps({"ts": int(time.time()), **event}, ensure_ascii=False) + "\n")
    except OSError as error:
        print(f"Увага: журнал видач не записано ({error})", file=sys.stderr)


def allow_chat(data: dict, requester: str, chat_id: str, name: str) -> str:
    if requester not in unique(data.get("admins", [])):
        raise SystemExit("Дію відхилено: користувач не є адміністратором")
    allowed = unique(data.get("allowFrom", []))
    if chat_id in allowed:
        return f"Чат {chat_id} уже в списку дозволених (усього: {len(allowed)})"
    allowed.append(chat_id)
    data["allowFrom"] = allowed
    suffix = f" {name}" if name else ""
    return f"Чат {chat_id}{suffix} додано до списку дозволених (усього: {len(allowed)})"


def revoke_chat(data: dict, requester: str, chat_id: str) -> str:
    admins = unique(data.get("admins", []))
    if requester not in admins:
        raise SystemExit("Дію відхилено: користувач не є адміністратором")
    # admins ⊆ allowFrom is an invariant preserve-admins checks on every update;
    # stripping an admin from the allowlist is a separate owner decision.
    if chat_id in admins:
        raise SystemExit("Дію відхилено: це адміністратор — зняти адміністратора може лише власник окремим рішенням")
    allowed = unique(data.get("allowFrom", []))
    if chat_id not in allowed:
        return f"Чату {chat_id} немає у списку дозволених — нічого змінювати (усього: {len(allowed)})"
    allowed.remove(chat_id)
    data["allowFrom"] = allowed
    return f"Чат {chat_id} прибрано зі списку дозволених (усього: {len(allowed)})"


def register_group(data: dict, actor: str, group_id: str, name: str) -> str:
    if actor not in unique(data.get("admins", [])):
        raise SystemExit("Дію відхилено: користувач не є адміністратором")

    groups = data.setdefault("groups", {})
    if not isinstance(groups, dict):
        raise SystemExit("Поле groups має бути JSON-об’єктом")
    current = groups.get(group_id, {})
    if not isinstance(current, dict):
        raise SystemExit(f"Некоректна політика групи: {group_id}")
    current["requireMention"] = current.get("requireMention", True)
    current["allowFrom"] = unique(current.get("allowFrom", []))
    current["observeEnabled"] = True
    if name:
        current["name"] = name
    groups[group_id] = current
    return f"Групу {name or group_id} зареєстровано ({group_id})"


def deactivate_group(data: dict, group_id: str, name: str) -> str:
    groups = data.get("groups", {})
    if not isinstance(groups, dict):
        raise SystemExit("Поле groups має бути JSON-об’єктом")
    current = groups.get(group_id)
    if not isinstance(current, dict):
        return f"Групу {group_id} не було зареєстровано"
    current["observeEnabled"] = False
    if name:
        current["name"] = name
    return f"Групу {current.get('name') or group_id} деактивовано ({group_id})"


def resolve_group(data: dict, target: str) -> tuple[str, dict]:
    groups = data.get("groups", {})
    if not isinstance(groups, dict):
        raise SystemExit("Поле groups має бути JSON-об’єктом")
    target = str(target).strip()
    if target in groups:
        return target, groups[target]

    folded = target.casefold()
    exact = [
        (group_id, policy)
        for group_id, policy in groups.items()
        if str(policy.get("name", "")).strip().casefold() == folded
    ]
    if len(exact) == 1:
        return exact[0]

    partial = [
        (group_id, policy)
        for group_id, policy in groups.items()
        if folded and folded in str(policy.get("name", "")).strip().casefold()
    ]
    if len(partial) == 1:
        return partial[0]
    if len(exact) > 1 or len(partial) > 1:
        raise SystemExit(f"Неоднозначна назва групи: {target}")
    raise SystemExit(f"Групу не знайдено: {target}")


def set_group_observation(
    data: dict, requester: str, desired: str, target: str
) -> str:
    admins = unique(data.get("admins", []))
    if requester not in admins:
        raise SystemExit("Дію відхилено: користувач не є адміністратором")

    group_id, policy = resolve_group(data, target)
    if not isinstance(policy, dict):
        raise SystemExit(f"Некоректна політика групи: {group_id}")
    name = str(policy.get("name") or group_id)

    if desired == "status":
        enabled = policy.get("observeEnabled", True) is not False
    elif desired in {"on", "off"}:
        enabled = desired == "on"
        policy["observeEnabled"] = enabled
    else:
        raise SystemExit("Стан має бути on, off або status")

    state_label = "увімкнено" if enabled else "вимкнено"
    return f"{name} ({group_id}): спостереження {state_label}"


def main(argv: list[str]) -> int:
    if len(argv) < 3:
        command_name = Path(argv[0]).name
        observation_command = "group-observation"
        print(
            f"Використання: {command_name} reconcile-admins <path> <chat_id_власника> [additional_csv]\n"
            f"       {command_name} preserve-admins <path> <chat_id_власника> [additional_csv]\n"
            f"       {command_name} set-superadmins <path> <chat_id_власника> <csv>\n"
            f"       {command_name} team-list <path> <owner> <actor>\n"
            f"       {command_name} team-preview <path> <owner> <actor> <message_id> <target> <role>\n"
            f"       {command_name} team-confirm <path> <owner> <actor> <token> <approve|cancel>\n"
            f"       {command_name} team-status <path> <owner> <actor> <token>\n"
            f"       {command_name} settings-list <path> <owner> <actor>\n"
            f"       {command_name} settings-preview <path> <owner> <actor> <message_id> <json>\n"
            f"       {command_name} settings-confirm <path> <owner> <actor> <token> <approve|cancel>\n"
            f"       {command_name} settings-status <path> <owner> <actor> <token>\n"
            f"       {command_name} allow <path> <requester> <message_id> <chat_id> [name]\n"
            f"       {command_name} revoke <path> <requester> <message_id> <chat_id>\n"
            f"       {command_name} {observation_command} <path> <requester> <on|off|status> <group>\n"
            f"       {command_name} group-register <path> <actor> <group_id> [name]\n"
            f"       {command_name} group-deactivate <path> <group_id> [name]",
            file=sys.stderr,
        )
        return 2
    command, path = argv[1], Path(argv[2])
    if command == "reconcile-admins" and len(argv) in (4, 5):
        message = locked_update(
            path, lambda data: reconcile_admins(data, argv[3], argv[4] if len(argv) == 5 else "")
        )
    elif command == "set-superadmins" and len(argv) == 5:
        message = locked_update(path, lambda data: set_superadmins(data, argv[3], argv[4]))
    elif command == "team-list" and len(argv) == 5:
        message = locked_inspect(path, lambda data: team_list(data, argv[3], argv[4]))
    elif command == "team-preview" and len(argv) == 8:
        message = team_preview(path, argv[3], argv[4], argv[5], argv[6], argv[7])
    elif command == "team-confirm" and len(argv) == 7:
        message = team_confirm(path, argv[3], argv[4], argv[5], argv[6])
    elif command == "team-status" and len(argv) == 6:
        message = confirmation_status(path, "access_team_previews", argv[3], argv[4], argv[5])
    elif command == "settings-list" and len(argv) == 5:
        message = locked_inspect(path, lambda data: settings_list(data, argv[3], argv[4]))
    elif command == "settings-preview" and len(argv) == 7:
        message = settings_preview(path, argv[3], argv[4], argv[5], argv[6])
    elif command == "settings-confirm" and len(argv) == 7:
        message = settings_confirm(path, argv[3], argv[4], argv[5], argv[6])
    elif command == "settings-status" and len(argv) == 6:
        message = confirmation_status(path, "access_settings_previews", argv[3], argv[4], argv[5])
    elif command == "preserve-admins" and len(argv) in (4, 5):
        message = locked_inspect(
            path, lambda data: preserve_admins(data, argv[3], argv[4] if len(argv) == 5 else "")
        )
    elif (
        command in {"allow", "revoke"}
        and (len(argv) >= 6 if command == "allow" else len(argv) == 6)
        and all(argv[index].lstrip("-").isdigit() for index in (3, 4, 5))
    ):
        requester, message_id, chat_id = argv[3], argv[4], argv[5]
        name = " ".join(argv[6:])
        event = {
            "action": command,
            "requester_id": requester,
            "message_id": message_id,
            "chat_id": chat_id,
            "name": name,
        }
        try:
            corroborate_requester(path, requester, message_id, chat_id)
            if command == "allow":
                message = locked_update(
                    path, lambda data: allow_chat(data, requester, chat_id, name)
                )
            else:
                message = locked_update(
                    path, lambda data: revoke_chat(data, requester, chat_id)
                )
        except SystemExit as error:
            record_access_event({**event, "result": "denied", "reason": str(error)})
            raise
        record_access_event({**event, "result": "ok", "detail": message})
    elif command == "group-observation" and len(argv) >= 6:
        message = locked_update(
            path,
            lambda data: set_group_observation(
                data, argv[3], argv[4].lower(), " ".join(argv[5:])
            ),
        )
    elif command == "group-register" and len(argv) >= 5:
        message = locked_update(
            path,
            lambda data: register_group(data, argv[3], argv[4], " ".join(argv[5:])),
        )
    elif command == "group-deactivate" and len(argv) >= 4:
        message = locked_update(
            path,
            lambda data: deactivate_group(data, argv[3], " ".join(argv[4:])),
        )
    else:
        print("Некоректні аргументи команди", file=sys.stderr)
        return 2
    print(message)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
