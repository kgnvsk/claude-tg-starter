def secret_key(name):
    folded = re.sub('[^a-z0-9]', '', str(name).lower())
    return folded in SECRET_WORDS or folded.endswith(('password','passwd','passphrase','secret','token','apikey','privatekey','secretkey'))

def _credential_key(name, *, authority=False, auth_context=False):
    """Ordinary code/data names are candidates, not credential-store authority."""
    if authority:return secret_key(name)
    folded=re.sub('[^a-z0-9]','',str(name).lower())
    if folded in {'token','cookie','cookies','oauth'}:return auth_context
    if folded.endswith('token'):
        return (folded.endswith(('accesstoken','refreshtoken','idtoken','sessiontoken','authtoken',
                                 'bearertoken','bottoken','apitoken','csrftoken','xsrftoken','oauthtoken'))
                or any(folded in names for names in PROVIDER_FIELDS.values()))
    return secret_key(name)

def _auth_context(names):
    fields={re.sub('[^a-z0-9]','',str(name).lower()) for name in names}
    return (any(_credential_key(name) for name in fields)
            or bool(fields & {'tokentype','expiresin','expiresat','refreshtoken'}))

def _json_field_context(names, inherited_auth=False):
    fields={re.sub('[^a-z0-9]','',str(field).lower()) for field in names}
    context=inherited_auth or _auth_context(fields)
    lexical=bool(fields & {'padtoken','eostoken','bostoken','unktoken','vocab','vocabulary','merges'})
    return context,lexical

def _json_credential_key(name, *, authority=False, context=False, lexical=False):
    folded=re.sub('[^a-z0-9]','',str(name).lower())
    if folded in {'token','cookie','cookies','oauth'}:
        # A sole token in a login result is still a credential. Only positive
        # tokenizer metadata can disambiguate ordinary data; auth context wins.
        return authority or context or not lexical
    return _credential_key(name,authority=authority,auth_context=context)

def _auth_container(name):
    return re.sub('[^a-z0-9]','',str(name).lower()) in {'auth','authentication','authorization','credentials','oauth','session'}

def source_code_path(path):
    return Path(str(path)).suffix.lower() in {'.py','.js','.mjs','.cjs','.ts','.tsx','.jsx','.sh','.bash','.zsh','.go','.rs','.rb','.swift','.java','.c','.h','.cpp'}

def credential_authority(path):
    value=str(path)
    return (bool(classify_path(value)) or value.startswith(('/etc/','system/etc/')) or value.endswith('.env')
            or bool(re.search(r'(?:^|/)(?:\.?claude|config|settings(?:\.local)?|integrations?|agent(?:-[^/]+)?)\.(?:json|env|toml|ya?ml)$',value)))

INVENTORY_DATA_DIRS = {'.git','node_modules','__pycache__','.venv','venv','site-packages',
                       'dist-packages','tests','test','fixtures','__fixtures__','examples'}

def credential_inventory_source(path):
    """Only access stores supply credentials to redact across unrelated files.

    An ordinary history, program or vocabulary is sanitized locally; its sample
    field values must not become global credentials for every other program.
    """
    parts=PurePosixPath(str(path).replace('\\','/')).parts
    base=parts[-1].lower() if parts else ''
    # Explicit stores remain authoritative even in a project called "tests".
    # Parent names distinguish generic config examples, never actual .env files.
    if (base=='.env' or base.startswith('.env.') or base.endswith('.env')
            or base in {'.npmrc','.netrc','.pypirc','.git-credentials','hosts.yml',
                        'auth.json','oauth.json','credentials','credentials.json',
                        '.credentials.json','secrets.json','github-token','secret.key'}):return True
    if any(part.lower() in INVENTORY_DATA_DIRS for part in parts):return False
    if source_code_path(path):return False
    if Path(str(path)).suffix.lower() in {'.md','.mdx','.rst','.html','.jsonl','.log'}:return False
    return credential_authority(path)

def classify_path(path, *, is_source=False):
    parts = [part.lower() for part in PurePosixPath(str(path).replace('\\','/')).parts]
    base = parts[-1] if parts else ''
    if '.git' in parts: return 'git-history-may-contain-credentials'
    if any(part in {'.ssh','.gnupg','.aws','.azure','.kube','.docker','keyrings','keyring','login data','cookies','network','session storage','local storage','indexeddb'} for part in parts):
        return 'credential-or-session-store'
    if any(part in {'google-chrome','chromium','chromium-browser','brave-browser','microsoft edge','.mozilla','firefox','browser-profile','browser-profile-data','browser-data','browser-profiles','user-data-dir'} for part in parts):
        return 'browser-profile-cannot-be-sanitized'
    if base in {'.env','.npmrc','.netrc','.pypirc','.git-credentials','hosts.yml','auth.json','oauth.json','cookies.txt','cookies.sqlite','credentials','credentials.json','.credentials.json','recovery-key.txt','github-token','secret.key','secrets.json'} or base.startswith(('.env.','id_rsa','id_ed25519','id_ecdsa')):
        return 'credential-file'
    source_code=is_source or source_code_path(base)
    documentation=Path(base).suffix in {'.md','.mdx','.rst','.html'}
    if Path(base).suffix in {'.key','.pem','.p12','.pfx','.jks','.keystore'} or not (source_code or documentation) and re.search(r'(?:^|[-_.])(?:credentials?|oauth|tokens?|secrets?|cookies?|passwords?)(?:[-_.]|$)',base):
        return 'credential-file'
    return None

def reconnect_for(path,data=b''):
    lower = str(path).lower()
    provider = next((name for terms,name in (
        (('telegram',),'telegram'), (('.codex','novsky/codex'),'openai-codex'),
        (('.claude','claude-tg'),'anthropic-claude'), (('github','/.config/gh/'),'github'),
        (('gogcli','gcal','google'),'google'), (('slack',),'slack'), (('.aws','aws'),'aws'),
        (('clickup',),'clickup'), (('vercel',),'vercel'), (('apify',),'apify'),
        (('hubspot',),'hubspot'), (('asana',),'asana'), (('.ssh',),'ssh'))
        if any(term in lower for term in terms)), 'other-integration')
    # Only fixed field names identify services; account/map keys and all values
    # are discarded. One .env may configure multiple independent providers.
    fields=set()
    if isinstance(data,bytes):
        try:text=data.decode('utf-8')
        except UnicodeDecodeError:text=''
        for match in re.finditer(r'(?m)(?:^|[\s{,])["\']?([A-Za-z][A-Za-z0-9_-]*)["\']?\s*[:=]',text):
            fields.add(re.sub('[^a-z0-9]','',match.group(1).lower()))
    providers={name for name,allowed in PROVIDER_FIELDS.items() if fields & allowed}
    if provider!='other-integration' or not providers:providers.add(provider)
    return [{'provider':name,'configLocation':RECONNECT_CATALOG[name][0],'scopes':[],
             'setupUrl':RECONNECT_CATALOG[name][1],'action':'reauthorize'} for name in sorted(providers)]

def _string_values(value):
    if isinstance(value,str): yield value
    elif isinstance(value,dict):
        for item in value.values(): yield from _string_values(item)
    elif isinstance(value,list):
        for item in value: yield from _string_values(item)

def _credential_value(value):
    return (isinstance(value,str) and bool(value) and value!=REDACTED
            and not re.fullmatch(r'(?i)(?:none|null|undefined|true|false|token|password|secret|changeme|placeholder|dummy|example|test|x+)',value)
            and not value.startswith(('$','${','{{','os.environ','process.env','getenv(')))

def _empty_assignment_comment(match):
    # In TOKEN= # explanation the whitespace starts a comment, not a value.
    # TOKEN=# and quoted "#" remain possible credentials, including old keys
    # in commented assignments which still need cross-file removal.
    return match.group('value').startswith('#') and match.group('prefix')[-1:].isspace()

def _code_template(value):
    return bool(re.search(r'\$\{|\$[A-Za-z_]|%[-+0-9.]*[sdrf]',value))

def _package_integrities(document,path):
    """Exact SRI digests are public dependency checksums, not opaque auth data."""
    if Path(str(path)).name not in {'package-lock.json','npm-shrinkwrap.json'}:return set()
    result=set()
    def visit(value):
        if isinstance(value,dict):
            for key,item in value.items():
                if key=='integrity' and isinstance(item,str):
                    match=re.fullmatch(r'sha(256|384|512)-([A-Za-z0-9+/]+={0,2})',item)
                    if match:
                        try: digest=base64.b64decode(match.group(2),validate=True)
                        except ValueError:continue
                        if len(digest)==int(match.group(1))//8 and base64.b64encode(digest).decode()==match.group(2):result.add(item)
                else:visit(item)
        elif isinstance(value,list):
            for item in value:visit(item)
    visit(document)
    return result

def _python_secret_nodes(text):
    """Credential value expressions, excluding executable regex definitions."""
    tree=ast.parse(text)
    parents={child:node for node in ast.walk(tree) for child in ast.iter_child_nodes(node)}
    found=[]
    def sensitive(target,value):
        name=target.id if isinstance(target,ast.Name) else target.attr if isinstance(target,ast.Attribute) else ''
        statement=parents.get(target);scope=parents.get(statement)
        if (isinstance(target,ast.Name) and isinstance(scope,ast.ClassDef)
                and any((isinstance(base,ast.Name) and base.id in {'Enum','StrEnum'})
                        or (isinstance(base,ast.Attribute) and base.attr in {'Enum','StrEnum'}) for base in scope.bases)
                and isinstance(value,ast.Constant) and isinstance(value.value,str)
                and re.sub('[^a-z0-9]','',name.lower())==re.sub('[^a-z0-9]','',value.value.lower())):
            return False  # An enum's own spelling is a schema label.
        return _credential_key(name)
    def add(value):
        if isinstance(value,ast.Constant) and isinstance(value.value,(str,bytes)):
            candidate=value.value.decode('utf-8',errors='replace') if isinstance(value.value,bytes) else value.value
            # Source defaults and display masks are not stored account secrets.
            # Credential files still harvest these exact values, and an
            # independently known credential always overrides this classification.
            if not candidate.strip() or re.fullmatch(r'\*{3,}',candidate):return
            if _credential_value(candidate):found.append(value)
    for node in ast.walk(tree):
        if isinstance(node,ast.Assign) and any(sensitive(target,node.value) for target in node.targets):add(node.value)
        elif isinstance(node,(ast.AnnAssign,ast.NamedExpr)) and sensitive(node.target,node.value):add(node.value)
        elif isinstance(node,ast.keyword) and node.arg:
            call=parents.get(node)
            names=[item.arg for item in call.keywords if item.arg] if isinstance(call,ast.Call) else []
            if _credential_key(node.arg,auth_context=_auth_context(names)):add(node.value)
        elif isinstance(node,ast.Dict):
            parent=parents.get(node)
            targets=parent.targets if isinstance(parent,ast.Assign) else [parent.target] if isinstance(parent,ast.AnnAssign) else []
            regex_definition=any(isinstance(target,ast.Name) and re.search(r'(?:^|_)(?:patterns?|regex(?:es)?)(?:_|$)',target.id.lower()) for target in targets)
            if regex_definition:continue
            names=[key.value for key in node.keys if isinstance(key,ast.Constant) and isinstance(key.value,str)]
            context=_auth_context(names)
            for key,value in zip(node.keys,node.values):
                if isinstance(key,ast.Constant) and isinstance(key.value,str) and _credential_key(key.value,auth_context=context):add(value)
    return found

def secret_literals(data, *, path):
    """Harvest literals from an already authorized read; never access files here."""
    if not isinstance(data,bytes): raise TypeError('sanitizer requires bytes')
    try: text=data.decode('utf-8')
    except UnicodeDecodeError: return set()
    found=set()
    authority=credential_authority(path) and not source_code_path(path) and not data.startswith(b'#!')
    def keep(value, *, authoritative=False):
        if _credential_value(value) and len(value)>=(1 if authoritative else 8):
            found.add(value.encode())
            escaped=json.dumps(value,ensure_ascii=True)[1:-1].encode()
            found.add(escaped)
            found.add(quote(value,safe='').encode())
    try: document=json.loads(text)
    except (ValueError,RecursionError): document=None
    integrities=_package_integrities(document,path)
    def visit(value, inherited_auth=False):
        if isinstance(value,dict):
            context,lexical=_json_field_context(value,inherited_auth)
            for key,item in value.items():
                if _json_credential_key(key,authority=authority,context=context,lexical=lexical):
                    for word in _string_values(item): keep(word,authoritative=True)
                else: visit(item,context or _auth_container(key))
        elif isinstance(value,list):
            for item in value: visit(item,inherited_auth)
    if document is not None: visit(document)
    elif '\n' in text:
        # Session JSONL is a sequence of independent objects, including small
        # files which are read in one block by the global inventory pass.
        for line in text.split('\n'):
            if not line.strip() or len(line)>MAX_LINE:continue
            try:record=json.loads(line)
            except (ValueError,RecursionError):continue
            visit(record)
    python_source=Path(str(path)).suffix=='.py' or text.startswith('#!') and 'python' in text.splitlines()[0]
    if python_source:
        try: nodes=_python_secret_nodes(text)
        except (SyntaxError,ValueError):nodes=[]
        public_fixtures=PUBLIC_FIXTURE_LITERAL_SHA256.get(hashlib.sha256(data).hexdigest(),()) if nodes else ()
        for node in nodes:
            value=node.value
            if isinstance(value,bytes):
                try:value=value.decode()
                except UnicodeDecodeError:continue
            if hashlib.sha256(value.encode()).hexdigest() in public_fixtures:continue
            keep(value,authoritative=True)
    for match in ASSIGNMENT.finditer(text) if authority and document is None else ():
        if _empty_assignment_comment(match):continue
        raw=match.group('value')
        if raw[:1] in {'"',"'"}:
            try: raw=json.loads(raw) if raw[0]=='"' else raw[1:-1]
            except ValueError: raw=raw[1:-1]
        keep(raw,authoritative=True)
    for pattern in (PRIVATE_KEY,*PATTERNS):
        for match in pattern.finditer(text):
            if pattern is PATTERNS[-1] and match.group() in integrities:continue
            if (source_code_path(path) or data.startswith(b'#!')) and _code_template(match.group()):continue
            keep(match.group())
    if classify_path(path) and len(data)<=MAX_BYTES:
        if document is not None:
            # Auth stores may use provider/account identifiers as map keys.
            for word in _string_values(document):
                if len(word)>=8: keep(word)
        elif not ASSIGNMENT.search(text) and 4<=len(text.strip())<=16384:
            keep(text.strip())
    return {word for word in found if word and word != REDACTED.encode()}

def _prefix_expression(prefixes):
    """Factor four-character literal prefixes into a shallow regex trie."""
    if len(prefixes)==1:return re.escape(prefixes[0])
    groups={}
    for prefix in prefixes:
        if not prefix:return ''
        groups.setdefault(prefix[0],[]).append(prefix[1:])
    return '(?:'+'|'.join(re.escape(char)+_prefix_expression(tails) for char,tails in groups.items())+')'

class _PreparedKnown:
    """Snapshot one stable operation's literals; never cache a mutable set by id."""
    __slots__=('values','minimum_length','prefixes','short','prefix_pattern','introduced')

    def __init__(self,known):
        values=[]
        # Preserve raw-length order: UTF-8 byte and decoded lengths can differ.
        for literal in sorted(known,key=len,reverse=True):
            try: value=literal.decode() if isinstance(literal,bytes) else str(literal)
            except UnicodeDecodeError: continue
            if value and value!=REDACTED:values.append(value)
        self.values=tuple(values)
        self.minimum_length=min(map(len,values),default=0)
        self.prefixes={};short=[]
        for index,value in enumerate(values):
            if len(value)<4:short.append(index)
            else:self.prefixes.setdefault(value[:4],[]).append(index)
        self.short=tuple(short)
        replacement_prefixes={REDACTED[start:start+4] for start in range(len(REDACTED)-3)}
        # New four-character prefixes are either inside [REDACTED] or cross
        # one of its bracket boundaries. All other prefixes already existed.
        self.introduced=tuple(index for index,value in enumerate(values)
                              if value[:4] in replacement_prefixes or '[' in value[:4] or ']' in value[:4])
        # Zero width retains overlapping prefixes (aaaa and aaab in aaaaab).
        self.prefix_pattern=(re.compile('(?=('+_prefix_expression(tuple(self.prefixes))+'))')
                             if len(values)>=64 and self.prefixes else None)

    def candidates(self,text,after=-1):
        if self.minimum_length>len(text):return []
        if len(self.values)<64:return None
        selected={index for index in self.short if index>after}
        matched=set()
        for match in self.prefix_pattern.finditer(text) if self.prefix_pattern is not None else ():
            prefix=match.group(1)
            values=self.prefixes[prefix]
            if prefix not in matched:
                # Dense buckets use the original remaining linear sequence.
                if len(values)>max(256,len(self.values)//4):return None
                matched.add(prefix)
                selected.update(index for index in values if index>after)
        return sorted(selected)

    def replace(self,text):
        count=0;after=-1;position=0;expanded=False
        candidates=self.candidates(text)
        while candidates is None or position<len(candidates):
            if candidates is None:
                for value in self.values[after+1:]:
                    if value not in text:continue
                    if len(value)<8:
                        text,changed=re.subn(r'(?<!\w)'+re.escape(value)+r'(?!\w)',lambda _match:REDACTED,text)
                    else:
                        changed=text.count(value);text=text.replace(value,REDACTED)
                    count+=changed
                return text,count
            index=candidates[position];value=self.values[index];changed=0
            if value in text:
                if len(value)<8:
                    text,changed=re.subn(r'(?<!\w)'+re.escape(value)+r'(?!\w)',lambda _match:REDACTED,text)
                else:
                    changed=text.count(value);text=text.replace(value,REDACTED)
            after=index;count+=changed
            if changed and not expanded:
                # A replacement can introduce later literals or new boundaries.
                # Never revisit an earlier index: the original pass did not.
                # Add every prefix the replacement could introduce once; later
                # replacements cannot create a prefix outside this same set.
                candidates=sorted(set(candidates[position+1:])|
                                  {index for index in self.introduced if index>after})
                position=0;expanded=True
            else:position+=1
        return text,count

def _prepare_known(known):
    return known if isinstance(known,_PreparedKnown) else _PreparedKnown(known)

def _plain(text,known,*,code=False,assignments=True,opaque=True):
    text,count=_prepare_known(known).replace(text)
    text,n=PRIVATE_KEY.subn(REDACTED,text);count+=n
    for pattern in PATTERNS if opaque else PATTERNS[:-1]:
        def replace(match):
            nonlocal count
            if code and _code_template(match.group()):return match.group()
            count+=1
            return REDACTED
        text=pattern.sub(replace,text)
    def assignment(match):
        nonlocal count
        if code and _empty_assignment_comment(match):return match.group()
        raw=match.group('value')
        quotechar=raw[0] if raw[:1] in {'"',"'"} else ''
        if code and quotechar:
            literal=raw[1:-1]
            following=text[match.end():].lstrip()
            if (not _credential_value(literal) or literal.endswith(('=',':'))
                    or _code_template(literal)
                    or following[:1] in {'+','.'}):return match.group()
            # A closing quote in startswith("BOT_TOKEN=") is not a credential
            # string opener. Track the current line's literal boundary first.
            start=text.rfind('\n',0,match.start('value'))+1
            active=None;escaped=False
            for char in text[start:match.start('value')]:
                if escaped:escaped=False;continue
                if char=='\\':escaped=True;continue
                if char in {'"',"'"}:
                    if active==char:active=None
                    elif active is None:active=char
            if active==quotechar or raw[1:].startswith(('$','{{')):return match.group()
        if not quotechar and (code or re.fullmatch(r'(?i)(?:none|null|undefined|true|false|[0-9.]+)',raw)
                              or raw.startswith(('$','{{','os.','process.','config.','env[','getenv('))):
            return match.group()
        count+=1
        return match.group('prefix')+quotechar+REDACTED+quotechar
    if assignments:text=ASSIGNMENT.sub(assignment,text)
    return text,count

def _text(text,known,*,code=False,assignments=True,integrities=(),authority=False):
    """Preserve valid JSON and recursively sanitize strings (including chat JSON)."""
    known=_prepare_known(known)
    try: document=json.loads(text)
    except (ValueError,RecursionError):
        if not code and '\n' in text:
            # JSONL syntax belongs to each record, including in small files.
            # Split only LF: Unicode separators can occur inside JSON strings.
            lines=text.split('\n')
            try:
                for line in lines:
                    if line.strip():json.loads(line)
            except (ValueError,RecursionError):pass
            else:
                count=0
                for index,line in enumerate(lines):
                    if line.strip():
                        lines[index],n=_text(line,known,assignments=assignments,integrities=integrities,authority=authority);count+=n
                return '\n'.join(lines),count
        return _plain(text,known,code=code,assignments=assignments)
    count=0
    def visit(value, inherited_auth=False):
        nonlocal count
        if isinstance(value,dict):
            result={}
            context,lexical=_json_field_context(value,inherited_auth)
            for key,item in value.items():
                safe_key,n=_plain(key,known);count+=n
                if re.sub('[^a-z]','',key.lower())=='fencingtoken' and type(item) is int:
                    result[safe_key]=item
                elif key=='integrity' and isinstance(item,str) and item in integrities:
                    result[safe_key],n=_plain(item,known,assignments=False,opaque=False);count+=n
                elif _json_credential_key(key,authority=authority,context=context,lexical=lexical): result[safe_key]=REDACTED;count+=1
                else: result[safe_key]=visit(item,context or _auth_container(key))
            return result
        if isinstance(value,list): return [visit(item,inherited_auth) for item in value]
        if isinstance(value,str):
            result,n=_text(value,known,assignments=assignments,authority=authority) if value.lstrip().startswith(('{','[')) else _plain(value,known,assignments=assignments)
            count+=n;return result
        return value
    clean=visit(document)
    whitespace=text[len(text.rstrip()):]
    return (json.dumps(clean,ensure_ascii=False,separators=(',',':'))+whitespace if count else text),count

def _comment(text,known,*,shebang=False):
    if shebang:
        # Do not hide a complete credential by splitting off its '#!' prefix.
        # Only the standalone structural characters may be preserved safely.
        if any(len(value)>1 and (text.startswith(value) or text.startswith(value,1))
               for value in _prepare_known(known).values):
            raise ValueError('Python source could not be safely sanitized')
        clean,count=_plain(text[2:],known,code=True,assignments=False)
        return '#!'+clean,count
    clean,count=_plain(text,known,code=True,assignments=False)
    # A removed credential may include the leading '#'. Keep the token a
    # comment; its remaining prose must never become executable source.
    return (clean if clean.startswith('#') else '# '+clean),count

def _fstring(text,known):
    # Python 3.10 exposes an entire f-string as one STRING token. Only literal
    # values are data; replacing its operators or quote delimiters breaks code.
    tree=ast.parse(text,mode='eval')
    count=0
    for node in ast.walk(tree):
        if not isinstance(node,ast.Constant) or not isinstance(node.value,(str,bytes)):continue
        binary=isinstance(node.value,bytes)
        try:plain=node.value.decode() if binary else node.value
        except UnicodeDecodeError:continue
        clean,n=_text(plain,known,code=True,assignments=False)
        if n and clean!=plain:
            node.value=clean.encode() if binary else clean;count+=n
    return (ast.unparse(tree) if count else text),count

def _python(text,known):
    """Inspect literal tokens, never treat a string's closing quote as a value."""
    sensitive=_python_secret_nodes(text)
    known=_prepare_known(known)
    lines=text.splitlines(keepends=True)
    tokens=list(tokenize.generate_tokens(io.StringIO(text).readline))
    changed=[];count=0
    for token in tokens:
        value=token.string
        if token.type==tokenize.STRING:
            try: literal=ast.literal_eval(value)
            except (ValueError,SyntaxError):literal=None
            if isinstance(literal,(str,bytes)):
                binary=isinstance(literal,bytes)
                try: plain=literal.decode() if binary else literal
                except UnicodeDecodeError:plain=None
                if plain is not None:
                    clean,n=_text(plain,known,code=True,assignments=False)
                    position=(token.start[0],len(lines[token.start[0]-1][:token.start[1]].encode()))
                    if any((node.lineno,node.col_offset)<=position<(node.end_lineno,node.end_col_offset) for node in sensitive) and plain:
                        clean=REDACTED;n+=1
                    if n and clean!=plain:
                        value=repr(clean.encode() if binary else clean);count+=n
            elif value.lower().startswith(('f"',"f'",'rf"',"rf'",'fr"',"fr'")):
                value,n=_fstring(value,known);count+=n
        elif token.type==tokenize.COMMENT:
            value,n=_comment(value,known,shebang=token.start==(1,0) and value.startswith('#!'));count+=n
        elif token.type==getattr(tokenize,'FSTRING_MIDDLE',-1):
            value,n=_plain(value,known,code=True,assignments=False);count+=n
        # TokenInfo coordinates are original; replacing only token spelling
        # preserves statements, indentation and all expressions around literals.
        changed.append(token._replace(string=value))
    if not count:return text,0
    clean=tokenize.untokenize(changed)
    ast.parse(clean)
    return clean,count

class _UnsafeAttachment(ValueError):
    pass


def _attachment_expression(values, depth=0):
    """Factor four prefix bytes so a native matcher skips unrelated literals."""
    if b'' in values:return b''
    if len(values)==1:return re.escape(values[0])
    if depth==4:return b'(?:'+b'|'.join(re.escape(value) for value in values)+b')'
    groups={}
    for value in values:groups.setdefault(value[:1],[]).append(value[1:])
    return b'(?:'+b'|'.join(re.escape(prefix)+_attachment_expression(rest,depth+1)
                          for prefix,rest in groups.items())+b')'


@lru_cache(maxsize=2)
def _attachment_matcher(literals):
    # The immutable cache key detects changes to a caller's mutable known set.
    values=sorted({value if isinstance(value,bytes) else str(value).encode()
                   for value in literals if value and value not in {REDACTED,REDACTED.encode()}})
    if not values:return None,0
    return re.compile(_attachment_expression(values)),max(map(len,values))-1


def _attachment_literals(known):
    return frozenset(known.values if isinstance(known,_PreparedKnown) else known)


def _scan_attachment(stream, matcher, deadline, *, output=None, limit=None):
    pattern,overlap=matcher
    carry=b'';total=0
    while True:
        if time.monotonic()>deadline:raise TimeoutError('attachment inspection deadline exceeded')
        block=stream.read(ATTACHMENT_CHUNK)
        if not block:break
        total+=len(block)
        if limit is not None and total>limit:raise _UnsafeAttachment('office-inspection-limit')
        window=carry+block
        if pattern is not None and pattern.search(window):raise _UnsafeAttachment('attachment-known-secret')
        if output is not None:output.write(block)
        carry=window[-overlap:] if overlap else b''
    return total


def _archive_header(header):
    return (header.startswith((b'PK\x03\x04',b'PK\x05\x06',b'\x1f\x8b',b'BZh',b'\xfd7zXZ\x00',
                               b'7z\xbc\xaf\x27\x1c',b'Rar!',b'\x28\xb5\x2f\xfd',b'age-encryption.org/',
                               b'-----BEGIN PGP',b'SQLite format 3\x00'))
            or header[257:262]==b'ustar')


def _attachment_format(header,suffix):
    if suffix in OFFICE_PARTS or suffix in ODF_TYPES:return header.startswith(b'PK\x03\x04')
    signatures={'.png':(b'\x89PNG\r\n\x1a\n',),'.jpg':(b'\xff\xd8\xff',),'.jpeg':(b'\xff\xd8\xff',),
                '.gif':(b'GIF87a',b'GIF89a'),'.bmp':(b'BM',),'.tif':(b'II*\x00',b'MM\x00*'),
                '.tiff':(b'II*\x00',b'MM\x00*'),'.ico':(b'\x00\x00\x01\x00',),
                '.ogg':(b'OggS',),'.oga':(b'OggS',),'.opus':(b'OggS',),'.flac':(b'fLaC',),
                '.webm':(b'\x1aE\xdf\xa3',),'.mkv':(b'\x1aE\xdf\xa3',),'.pdf':(b'%PDF-',)}
    if suffix in signatures:return header.startswith(signatures[suffix])
    if suffix in {'.webp','.wav','.avi'}:
        return header.startswith(b'RIFF') and header[8:12]=={'.webp':b'WEBP','.wav':b'WAVE','.avi':b'AVI '}[suffix]
    if suffix in {'.mp3','.aac'}:
        return header.startswith(b'ID3') or len(header)>1 and header[0]==255 and header[1]&224==224
    if suffix in {'.mp4','.m4v','.mov','.m4a','.heic','.heif','.avif'}:
        return header[4:8]==b'ftyp' or suffix=='.mov' and header[4:8] in {b'moov',b'mdat',b'wide'}
    return False


def _attachment_path_reason(path):
    reason=classify_path(path)
    if reason:return reason
    parts=PurePosixPath(str(path).replace('\\','/')).parts
    if any(part.lower()=='.env' or part.lower().startswith('.env.') or part.lower().endswith('.env') for part in parts):
        return 'credential-file'
    return None


def _office_xml(archive,name,root_tag,deadline,select=()):
    selected=[];root=None
    with archive.open(name) as stream:
        for event,node in ET.iterparse(stream,events=('start','end')):
            if time.monotonic()>deadline:raise TimeoutError('attachment inspection deadline exceeded')
            if root is None:root=node.tag
            if event=='end':
                if node.tag in select:selected.append(dict(node.attrib))
                node.clear()
    if root!=root_tag:raise _UnsafeAttachment('office-structure-invalid')
    return selected


def _inspect_office(stream,suffix,matcher,deadline):
    with zipfile.ZipFile(stream) as archive:
        members=archive.infolist();names=set();total=0
        if len(members)>10000:raise _UnsafeAttachment('office-inspection-limit')
        for member in members:
            name=member.filename;parts=PurePosixPath(name).parts
            if (not name or name!=member.orig_filename or '\\' in name or '\x00' in name
                    or name.startswith('/') or re.match(r'^[A-Za-z]:',name)
                    or any(part in {'','..','.'} for part in name.rstrip('/').split('/'))
                    or name.casefold() in names):raise _UnsafeAttachment('office-entry-unsafe')
            names.add(name.casefold())
            mode=stat.S_IFMT(member.external_attr>>16)
            if mode not in {0,stat.S_IFREG,stat.S_IFDIR}:raise _UnsafeAttachment('office-entry-unsafe')
            if member.flag_bits&1 or member.compress_type not in {zipfile.ZIP_STORED,zipfile.ZIP_DEFLATED}:
                raise _UnsafeAttachment('office-encrypted-or-unsupported-entry')
            if (_attachment_path_reason(name) or any(part.lower() in {'embeddings','objectreplacements'} for part in parts)
                    or Path(name).suffix.lower() in ARCHIVE_SUFFIXES | set(OFFICE_PARTS) | set(ODF_TYPES)):
                raise _UnsafeAttachment('office-secret-or-nested-container')
            if member.is_dir():continue
            total+=member.file_size
            if total>OFFICE_MAX_UNPACKED:raise _UnsafeAttachment('office-inspection-limit')
            with archive.open(member) as entry:
                header=entry.read(512)
                if _archive_header(header):raise _UnsafeAttachment('office-secret-or-nested-container')
                entry.seek(0)
                if _scan_attachment(entry,matcher,deadline,limit=member.file_size)!=member.file_size:
                    raise _UnsafeAttachment('office-entry-invalid')
        if suffix in OFFICE_PARTS:
            part,mime,namespace,element=OFFICE_PARTS[suffix]
            types_ns='{http://schemas.openxmlformats.org/package/2006/content-types}'
            types=_office_xml(archive,'[Content_Types].xml',types_ns+'Types',deadline,(types_ns+'Override',))
            if not any(row.get('PartName')=='/'+part and row.get('ContentType')=='application/vnd.openxmlformats-officedocument.'+mime+'.main+xml' for row in types):
                raise _UnsafeAttachment('office-structure-invalid')
            rel_ns='{http://schemas.openxmlformats.org/package/2006/relationships}'
            relations=_office_xml(archive,'_rels/.rels',rel_ns+'Relationships',deadline,(rel_ns+'Relationship',))
            if not any(row.get('Type')=='http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument'
                       and row.get('Target') in {part,'/'+part} and row.get('TargetMode')!='External' for row in relations):
                raise _UnsafeAttachment('office-structure-invalid')
            _office_xml(archive,part,'{http://schemas.openxmlformats.org/'+namespace+'}'+element,deadline)
        else:
            with archive.open('mimetype') as stream:
                mime=stream.read(256)
            if mime!=('application/vnd.oasis.opendocument.'+ODF_TYPES[suffix]).encode():
                raise _UnsafeAttachment('office-structure-invalid')
            ns='{urn:oasis:names:tc:opendocument:xmlns:manifest:1.0}'
            rows=_office_xml(archive,'META-INF/manifest.xml',ns+'manifest',deadline,(ns+'encryption-data',))
            if rows:raise _UnsafeAttachment('office-encrypted-or-unsupported-entry')
            _office_xml(archive,'content.xml','{urn:oasis:names:tc:opendocument:xmlns:office:1.0}document-content',deadline)


def _inspect_attachment(stream,path,known,deadline,output=None):
    reason=_attachment_path_reason(path)
    try:
        if reason:raise _UnsafeAttachment(reason)
        suffix=Path(str(path)).suffix.lower()
        stream.seek(0);header=stream.read(512)
        if not _attachment_format(header,suffix):raise _UnsafeAttachment('attachment-format-invalid')
        matcher=_attachment_matcher(_attachment_literals(known))
        if suffix in OFFICE_PARTS or suffix in ODF_TYPES:_inspect_office(stream,suffix,matcher,deadline)
        stream.seek(0);_scan_attachment(stream,matcher,deadline,output=output)
    except _UnsafeAttachment as error:reason=str(error)
    except (zipfile.BadZipFile,ET.ParseError,KeyError,NotImplementedError,RuntimeError,EOFError,ValueError):
        reason='office-structure-invalid'
    return {'disposition':'excluded' if reason else 'included','reason':reason,'redactions':0,
            'reconnect':reconnect_for(path) if reason else []}


def sanitize_bytes(data, *, path, known_secrets=()):
    return _sanitize_bytes(data,path=path,known_secrets=known_secrets)

def _sanitize_bytes(data, *, path, known_secrets, prepared_known=None):
    if not isinstance(data,bytes): raise TypeError('sanitizer requires bytes')
    if Path(str(path)).suffix.lower() in ATTACHMENT_SUFFIXES:
        report=_inspect_attachment(io.BytesIO(data),path,known_secrets,time.monotonic()+120)
        return {'data':data if report['disposition']=='included' else None,**report}
    is_source=data.startswith(b'#!') or source_code_path(path)
    reason=classify_path(path,is_source=is_source)
    if not reason and (Path(str(path)).suffix.lower() in OPAQUE_SUFFIXES or data.startswith((b'PK\x03\x04',b'\x1f\x8b',b'%PDF-',b'age-encryption.org/',b'SQLite format 3\0'))):
        reason='opaque-format-not-credential-inspectable'
    if not reason and len(data)>MAX_BYTES: reason='text-block-exceeds-inspection-limit'
    if not reason:
        try: text=data.decode('utf-8')
        except UnicodeDecodeError: reason='non-utf8-content-not-inspectable'
        else:
            if any(ord(char)<32 and char not in '\n\r\t' for char in text): reason='binary-content-not-inspectable'
    if reason:
        return {'data':None,'disposition':'excluded','reason':reason,'redactions':0,'reconnect':reconnect_for(path,data)}
    local=secret_literals(data,path=path)
    reuse=prepared_known is not None and local.issubset(known_secrets)
    known=known_secrets if reuse else set(known_secrets)|local
    prepared=prepared_known if reuse else known
    python_source=Path(str(path)).suffix=='.py' or text.startswith('#!') and 'python' in text.splitlines()[0]
    shell_source=not python_source and (text.startswith('#!') or Path(str(path)).suffix.lower() in {'.sh','.bash','.zsh'})
    # Shell comments and heredocs need syntax-aware handling. A genuine '#'
    # credential must fail capture rather than turn comment prose into commands.
    if shell_source and '#' in text and (b'#' in known or '#' in known):
        raise ValueError('Shell source could not be safely sanitized')
    if python_source:
        if not local and not _plain(text,prepared,code=True)[1]:
            return {'data':data,'disposition':'included','reason':None,'redactions':0,'reconnect':[]}
        try:clean,count=_python(text,prepared)
        except (SyntaxError,tokenize.TokenError,IndentationError) as error:
            raise ValueError('Python source could not be safely sanitized') from error
    else:
        if is_source:
            prepared=_prepare_known(prepared)
            javascript=Path(str(path)).suffix.lower() in {'.js','.mjs','.cjs','.ts','.tsx','.jsx'}
            hash_declaration=javascript and re.fullmatch(r'''\s*(?:export\s+)?(?:const|let|var)\s+[A-Za-z_$][\w$]*\s*=\s*(?:"#"|'#')\s*;?\s*''',text)
            for value in prepared.values:
                if len(value)>=8:continue
                # This complete simple declaration proves '#' is string data.
                # Other JS/TS contexts may contain escaped private identifiers.
                if value=='#' and hash_declaration:continue
                # Without a lexer, even a quoted short match cannot be proven
                # independent of executable syntax. Refuse instead of corrupting
                # a program; retain these credentials in the global inventory.
                if value in text and re.search(r'(?<!\w)'+re.escape(value)+r'(?!\w)',text):
                    raise ValueError('Source code could not be safely sanitized')
        try:integrities=_package_integrities(json.loads(text),path)
        except (ValueError,RecursionError):integrities=set()
        clean,count=_text(text,prepared,code=is_source,integrities=integrities,
                          authority=credential_authority(path) and not is_source)
    return {'data':clean.encode(),'disposition':'redacted' if count else 'included','reason':None,
            'redactions':count,'reconnect':reconnect_for(path,data) if count else []}

def known_secret_literals(home, *, include_paths=None, exclude_paths=None, sqlite_timeout_seconds=30):
    """Read declared credential stores, not all agent data; never follow symlinks."""
    home=Path(home)
    roots=include_paths or ['.']
    exclusions=exclude_paths or {}
    def excluded(path):
        relative=path.relative_to(home).as_posix()
        return any(relative==prefix or relative.startswith(prefix+'/') for prefix in exclusions)
    def candidates():
        for selected in roots:
            relative=PurePosixPath(selected)
            if relative.is_absolute() or '..' in relative.parts:raise ValueError('unsafe secret inventory scope')
            root=home/selected
            if any(parent.is_symlink() for parent in (root,*root.parents) if parent==home or home in parent.parents):continue
            if excluded(root):continue
            if root.is_file():yield root;continue
            for directory,dirs,files in os.walk(root,followlinks=False):
                dirs[:]=[name for name in dirs if not (Path(directory)/name).is_symlink()
                         and name.lower() not in {'.git','__pycache__'} and not excluded(Path(directory)/name)]
                for name in files:
                    path=Path(directory)/name
                    if not excluded(path):yield path
    found=set()
    for path in candidates():
            relative=path.relative_to(home).as_posix()
            if not credential_inventory_source(relative):continue
            try:
                info=path.lstat()
                if not stat.S_ISREG(info.st_mode) or path.suffix.lower() in OPAQUE_SUFFIXES:continue
                descriptor=os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK)
                with os.fdopen(descriptor,'rb') as stream:
                    pinned=os.fstat(stream.fileno())
                    if (pinned.st_dev,pinned.st_ino)!=(info.st_dev,info.st_ino):raise ValueError('secret inventory file changed')
                    header=stream.read(16);stream.seek(0)
                    if header==b'SQLite format 3\0':
                        try:found.update(_sqlite_secret_literals(path,timeout_seconds=sqlite_timeout_seconds))
                        except (sqlite3.Error,TimeoutError):
                            raise ValueError('secret inventory database could not be inspected') from None
                    elif info.st_size<=MAX_BYTES:
                        raw=stream.read(MAX_BYTES+1)
                        found.update(secret_literals(raw,path=str(path.relative_to(home))))
                    else:
                        raise ValueError('credential source exceeds inspection limit')
            except (FileNotFoundError,PermissionError):
                raise ValueError('credential source could not be inspected') from None
    return found

def _sqlite_secret_literals(path, timeout_seconds=30):
    found=set();deadline=time.monotonic()+timeout_seconds
    quoted=lambda name:'"'+name.replace('"','""')+'"'
    with closing(sqlite3.connect(path.as_uri()+'?mode=ro',uri=True,timeout=0.1)) as database:
        database.set_progress_handler(lambda:int(time.monotonic()>deadline),1000)
        database.execute('PRAGMA trusted_schema=OFF')
        for name,sql in database.execute("SELECT name,sql FROM sqlite_schema WHERE type='table'").fetchall():
            if not sql or name.startswith('sqlite_') or 'VIRTUAL TABLE' in sql.upper():continue
            columns=database.execute('PRAGMA table_xinfo('+quoted(name)+')').fetchall()
            columns=[column for column in columns if not column[6]]
            if not columns:continue
            for row in database.execute('SELECT '+','.join(quoted(column[1]) for column in columns)+' FROM '+quoted(name)):
                secret_row=any(column[1].lower() in {'key','name','setting'} and isinstance(value,str) and secret_key(value) for column,value in zip(columns,row))
                for column,value in zip(columns,row):
                    if isinstance(value,str):
                        found.update(secret_literals(value.encode(),path='database-value.txt'))
                        if secret_key(column[1]) or secret_row and column[1].lower() in {'value','data','content'}:
                            found.update(secret_literals(json.dumps({'secret':value}).encode(),path='database-value.txt'))
    return found

def sanitize_file(source,destination,*,path,known_secrets=(),timeout_seconds=120,prepared_known=None):
    if Path(str(path)).suffix.lower() in ATTACHMENT_SUFFIXES:
        try:
            with source.open('rb') as original,destination.open('wb') as output:
                result=_inspect_attachment(original,path,known_secrets,time.monotonic()+timeout_seconds,output)
            if result['disposition']=='excluded':destination.unlink(missing_ok=True)
            return result
        except BaseException:
            destination.unlink(missing_ok=True)
            raise
    with source.open('rb') as header: is_source=header.read(64).startswith(b'#!')
    reason=classify_path(path,is_source=is_source)
    if reason or Path(str(path)).suffix.lower() in OPAQUE_SUFFIXES:
        return sanitize_bytes(b'',path=path,known_secrets=known_secrets)
    if source.stat().st_size<=MAX_BYTES:
        result=_sanitize_bytes(source.read_bytes(),path=path,known_secrets=known_secrets,prepared_known=prepared_known)
        if result['data'] is not None:destination.write_bytes(result['data'])
        return {key:value for key,value in result.items() if key!='data'}
    deadline=time.monotonic()+timeout_seconds
    total=0
    # A historical credential may be copied in a different record of this same
    # conversation. Collect locally before writing, including references before
    # the credential field. Never add history examples to the global inventory.
    known=set(known_secrets)
    with source.open('rb') as original:
        while True:
            line=original.readline(MAX_LINE+1)
            if not line:break
            if time.monotonic()>deadline:raise TimeoutError('text sanitization deadline exceeded')
            if len(line)>MAX_LINE or b'-----BEGIN ' in line:
                return {'disposition':'excluded','reason':'text-stream-not-safely-inspectable','redactions':0,'reconnect':reconnect_for(path)}
            known.update(secret_literals(line,path=path))
    prepared=prepared_known if prepared_known is not None and known.issubset(known_secrets) else _prepare_known(known)
    with source.open('rb') as original,destination.open('wb') as output:
        while True:
            line=original.readline(MAX_LINE+1)
            if not line:break
            if len(line)<=MAX_LINE and time.monotonic()>deadline:
                raise TimeoutError('text sanitization deadline exceeded')
            if len(line)>MAX_LINE or b'-----BEGIN ' in line:
                return {'disposition':'excluded','reason':'text-stream-not-safely-inspectable','redactions':0,'reconnect':reconnect_for(path)}
            result=_sanitize_bytes(line,path=path,known_secrets=known,prepared_known=prepared)
            if result['data'] is None:return {key:value for key,value in result.items() if key!='data'}
            output.write(result['data']);total+=result['redactions']
    return {'disposition':'redacted' if total else 'included','reason':None,'redactions':total,'reconnect':reconnect_for(path) if total else []}

def sanitize_sqlite(source,destination,*,path,known_secrets=(),timeout_seconds=30):
    """Build a fresh logical database, never copy free pages, triggers or BLOBs."""
    deadline=time.monotonic()+timeout_seconds
    redactions=0
    invalidated=0
    replacements={}
    def placeholder(value):
        if value not in replacements:replacements[value]='[REDACTED-'+str(len(replacements)+1).zfill(8)+']'
        return replacements[value]
    omitted=0
    quote_name=lambda value:'"'+value.replace('"','""')+'"'
    known=set(known_secrets)
    with closing(sqlite3.connect(source.as_uri()+'?mode=ro',uri=True)) as original, closing(sqlite3.connect(destination)) as output:
        original.set_progress_handler(lambda:int(time.monotonic()>deadline),1000)
        output.set_progress_handler(lambda:int(time.monotonic()>deadline),1000)
        output.execute('PRAGMA secure_delete=ON')
        output.execute('PRAGMA journal_mode=OFF')
        for pragma in ('user_version','application_id'):
            output.execute('PRAGMA '+pragma+'='+str(int(original.execute('PRAGMA '+pragma).fetchone()[0])))
        tables=original.execute("SELECT name,sql FROM sqlite_schema WHERE type='table'").fetchall()
        try: shadow={row[1] for row in original.execute('PRAGMA table_list') if row[2] in {'shadow','virtual'}}
        except sqlite3.Error:shadow=set()
        omitted+=original.execute("SELECT count(*) FROM sqlite_schema WHERE type IN ('view','trigger','index') AND sql IS NOT NULL").fetchone()[0]
        table_defs=[]
        for name,sql in tables:
            if name.startswith('sqlite_') or name in shadow or not sql or 'VIRTUAL TABLE' in sql.upper() or secret_key(name) or _plain(name,known)[1]:
                omitted+=1;continue
            columns=original.execute('PRAGMA table_xinfo('+quote_name(name)+')').fetchall()
            columns=[column for column in columns if not column[6]]
            if not columns or any(_plain(column[1],known)[1] for column in columns):omitted+=1;continue
            table_defs.append((name,columns,sql))
            for column in columns:
                default=column[4]
                if secret_key(column[1]) and isinstance(default,str) and default[:1] in {'"',"'"}:
                    known.add(default[1:-1].replace("''", "'").encode())
            # First pass: credentials stored by key/value or secret column must
            # also disappear from ordinary chat strings in this same database.
            for row in original.execute('SELECT '+','.join(quote_name(column[1]) for column in columns)+' FROM '+quote_name(name)):
                secret_row=any(str(column[1]).lower() in {'key','name','setting'} and isinstance(value,str) and secret_key(value) for column,value in zip(columns,row))
                for column,value in zip(columns,row):
                    if isinstance(value,str):
                        known.update(secret_literals(value.encode(),path='database-value.txt'))
                        if secret_key(column[1]) or secret_row and str(column[1]).lower() in {'value','data','content'}:known.add(value.encode())
        output.execute('PRAGMA trusted_schema=OFF')
        known=_prepare_known(known)
        for name,columns,sql in table_defs:
            clean_schema,count=_plain(sql,known)
            redactions+=count
            output.execute(clean_schema)
            select='SELECT '+','.join(quote_name(column[1]) for column in columns)+' FROM '+quote_name(name)
            insert='INSERT INTO '+quote_name(name)+' ('+','.join(quote_name(column[1]) for column in columns)+') VALUES ('+','.join('?' for _ in columns)+')'
            for row in original.execute(select):
                if time.monotonic()>deadline:raise TimeoutError('SQLite sanitization deadline exceeded')
                secret_row=any(str(column[1]).lower() in {'key','name','setting'} and isinstance(value,str) and secret_key(value) for column,value in zip(columns,row))
                clean=[]
                inactive_states={'corporate_actions':{'previewed','approved'},
                                 'corporate_policy_previews':{'pending','approved'},
                                 'corporate_resource_previews':{'pending','claimed'}}
                invalidate=name in inactive_states and any(column[1]=='token' and isinstance(value,str) and value for column,value in zip(columns,row))
                for column,value in zip(columns,row):
                    if name=='conversation_jobs' and column[1]=='fencing_token' and column[2].upper()=='INTEGER' and type(value) is int:
                        pass
                    elif invalidate and column[1]=='state' and value in inactive_states[name]:
                        value='expired';invalidated+=1
                    elif isinstance(value,bytes):value=b'' if column[3] else None;redactions+=1
                    elif secret_key(column[1]) or secret_row and str(column[1]).lower() in {'value','data','content'}:
                        value=placeholder(value) if isinstance(value,str) else None;redactions+=1
                    elif isinstance(value,str):
                        value,count=_text(value,known);redactions+=count
                    clean.append(value)
                output.execute(insert,clean)
        kept_tables={name for name,_columns,_sql in table_defs}
        for name,table,sql in original.execute("SELECT name,tbl_name,sql FROM sqlite_schema WHERE type='index' AND sql IS NOT NULL"):
            if table not in kept_tables or _plain(name,known)[1]:continue
            clean_schema,count=_plain(sql,known)
            redactions+=count
            output.execute(clean_schema)
            omitted-=1
        if any(name=='sqlite_sequence' for name,_sql in tables):
            for name,sequence in original.execute('SELECT name,seq FROM sqlite_sequence'):
                if name in kept_tables and isinstance(sequence,int):
                    output.execute('DELETE FROM sqlite_sequence WHERE name=?',(name,))
                    output.execute('INSERT INTO sqlite_sequence(name,seq) VALUES (?,?)',(name,sequence))
        output.commit();output.execute('VACUUM')
        if output.execute('PRAGMA quick_check').fetchone()!=('ok',):raise ValueError('sanitized SQLite failed integrity check')
    destination.chmod(0o600)
    return {'disposition':'redacted' if redactions or omitted else 'included','reason':None,'redactions':redactions,
            'omittedSchemaObjects':omitted,'logicalRebuild':True,'invalidatedCapabilities':invalidated,
            'reconnect':reconnect_for(path) if redactions else []}
