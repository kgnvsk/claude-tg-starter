#!/usr/bin/env python3
"""no-nested-claude-guard — PreToolUse hook on Bash.

Hard DENY for any Bash command that would spawn a SECOND Claude Code instance
on this box. A nested `claude` re-spawns all MCP servers, and the telegram
plugin's stale-PID replace logic then SIGTERMs the live bun poller → the bot
goes mute until healthcheck revives it (1-2 min). This already killed Cash on
2026-06-25 (ran `claude mcp list` on a "add blender mcp" task and self-killed).

It inspects the FIRST executable of each pipeline/sequence segment (skipping
leading `VAR=val` and `env` prefixes), so it catches path-qualified forms like
`~/.local/bin/claude mcp …` and `/home/claude/.local/bin/claude -p`, but does
NOT false-positive on `claude` appearing as an argument (`pgrep -af claude`,
`grep claude`, `which claude`).

Denies interactive nesting and every `claude mcp …` invocation. The non-session commands `claude plugin …` and
`claude auth status` are allowed.

`ATARAX_SUPPRESS_TELEGRAM=1 claude -p …` is allowed on purpose: that env keeps
the telegram plugin inert, so the nested session cannot reach the poller. It is
how auto-publisher has run in production since June and how scheduled agent
tasks (RUN=1) execute. Interactive nesting and `claude mcp …` stay blocked —
the latter is what killed Cash on 2026-06-25.

The matching CLAUDE.md rule ("НИКОГДА не запускай claude mcp …") is the soft
guard; this hook is the hard backstop the model can't talk itself past.

Bypass (rarely needed): touch ~/.claude/state/no-nested-claude-guard.bypass
"""
import json
import os
import re
import shlex
import sys

BYPASS_FILE = os.path.expanduser("~/.claude/state/no-nested-claude-guard.bypass")


def segments(cmd: str):
    """Split a command line into pipeline/sequence segments on ; | & (incl && ||)."""
    return re.split(r"&&|\|\||[;|&]", cmd)


def first_executable(seg: str):
    """Return (exe_basename, rest_tokens, env_prefix) for a segment.
    Skips VAR=val / env prefixes but hands them back, because one of them
    decides whether a nested run is safe. Returns (None, [], {}) if empty."""
    try:
        toks = shlex.split(seg)
    except ValueError:
        toks = seg.split()
    i = 0
    assigned = {}
    while i < len(toks):
        t = toks[i]
        if t == "env":          # `env claude …`
            i += 1
            continue
        if re.match(r"^\w+=", t):  # `VAR=val claude …`
            key, _, value = t.partition("=")
            assigned[key] = value
            i += 1
            continue
        break
    if i >= len(toks):
        return None, [], {}
    exe = os.path.basename(toks[i])
    return exe, toks[i + 1:], assigned


def main() -> None:
    try:
        data = json.load(sys.stdin)
    except Exception:
        sys.exit(0)

    if os.path.exists(BYPASS_FILE):
        sys.exit(0)

    if (data.get("tool_name") or "") != "Bash":
        sys.exit(0)

    cmd = (data.get("tool_input") or {}).get("command") or ""

    for seg in segments(cmd):
        exe, rest, assigned = first_executable(seg)
        if exe != "claude":
            continue
        nxt = rest[0] if rest else ""
        # A suppressed headless run is the one nested form that is safe: the
        # telegram plugin stays inert, so the live poller is never touched.
        # This is what auto-publisher and scheduled agent tasks rely on.
        if assigned.get("ATARAX_SUPPRESS_TELEGRAM") == "1" and (
            "-p" in rest or "--print" in rest
        ):
            continue
        if nxt == "plugin":
            continue  # plugin management — safe
        if nxt == "auth" and rest[1:2] == ["status"]:
            continue  # read-only auth health check
        if nxt == "mcp":
            deny(
                "🚫 SELF-KILL GUARD: `claude mcp …` запрещён на живом боте.\n\n"
                "Он спавнит ВТОРОЙ инстанс Claude Code, который через stale-PID "
                "replace в telegram-плагине SIGTERM-ит твой bun-поллер — бот немеет.\n\n"
                "Проверить MCP/поллер → `pgrep -af \"bun.*telegram\"`.\n"
                "Поставить/настроить MCP → правь .mcp.json / settings файлом + рестарт "
                "сервиса, НЕ `claude mcp add` вживую."
            )
        deny(
            "🚫 SELF-KILL GUARD: вложенная интерактивная `claude`-сессия запрещена.\n\n"
            "Она конфликтует с живым Telegram-агентом. Что делать вместо этого:\n"
            "• подзадача сейчас → нативный Agent (Task);\n"
            "• разовый headless-прогон → `ATARAX_SUPPRESS_TELEGRAM=1 claude -p …` "
            "(разрешён: плагин остаётся спящим, поллер цел);\n"
            "• работа по расписанию → `reminder-task … --run`."
        )

    sys.exit(0)


def deny(reason: str) -> None:
    print(json.dumps({"decision": "block", "reason": reason}))
    sys.exit(0)


if __name__ == "__main__":
    main()
