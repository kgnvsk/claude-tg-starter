#!/usr/bin/env python3
"""no-nested-claude-guard — PreToolUse hook on Bash.

Hard DENY for any Bash command that would spawn a SECOND Claude Code instance
on this box. A nested `claude` re-spawns all MCP servers, and the telegram
plugin's stale-PID replace logic then SIGTERMs the live bun poller → the bot
goes mute until healthcheck revives it (1-2 min). This already killed Cash on
2026-06-25 (ran `claude mcp list` on a "add blender mcp" task and self-killed).

It inspects the FIRST executable of each pipeline/sequence segment (skipping
leading `VAR=val` and `env` prefixes), so it catches path-qualified forms like
`~/.local/bin/claude mcp …` and `/home/claude/.local/bin/claude -p`, but does
NOT false-positive on `claude` appearing as an argument (`pgrep -af claude`,
`grep claude`, `which claude`).

Denies interactive nesting and every `claude mcp …` invocation. The non-session commands `claude plugin …` and
`claude auth status` are allowed.

`ATARAX_SUPPRESS_TELEGRAM=1 claude -p …` is allowed on purpose: that env keeps
the telegram plugin inert, so the nested session cannot reach the poller. It is
how auto-publisher has run in production since June and how scheduled agent
tasks (RUN=1) execute. Interactive nesting and `claude mcp …` stay blocked —
the latter is what killed Cash on 2026-06-25.

The matching CLAUDE.md rule ("НИКОГДА не запускай claude mcp …") is the soft
guard; this hook is the hard backstop the model can't talk itself past.

Bypass (rarely needed): touch ~/.claude/state/no-nested-claude-guard.bypass
"""
import json
import os
import re
import shlex
import sys

BYPASS_FILE = os.path.expanduser("~/.claude/state/no-nested-claude-guard.bypass")
SHELL_WRAPPERS = {"bash", "sh", "zsh", "dash", "ksh", "ash"}
MAX_UNWRAP_DEPTH = 4  # `bash -c "bash -c …"` must still terminate


def segments(cmd: str):
    """Split actual shell separators, preserving quoted text for shell -c."""
    start = 0
    quote = None
    escaped = False
    for i, char in enumerate(cmd):
        if escaped:
            escaped = False
        elif char == "\\" and quote != "'":
            escaped = True
        elif quote:
            if char == quote:
                quote = None
        elif char in {"'", '"'}:
            quote = char
        elif char in ";|&\n":
            yield cmd[start:i]
            start = i + 1
    yield cmd[start:]


def first_executable(seg: str, inherited=None):
    """Unwrap common execution prefixes; apply their real env reset/unset rules.

    This is a guard for literal commands, not a shell interpreter or sandbox.
    Reads such as command -v, grep and pgrep do not execute their arguments.
    """
    try:
        toks = shlex.split(seg)
    except ValueError:
        toks = seg.split()
    assigned = dict(inherited or {})
    while toks:
        if re.match(r"^[A-Za-z_][A-Za-z_0-9]*=", toks[0]):
            key, _, value = toks.pop(0).partition("=")
            assigned[key] = value
            continue
        exe = os.path.basename(toks[0])
        if exe not in {"env", "timeout", "nice", "command", "exec", "nohup"}:
            return exe, toks[1:], assigned
        rest = toks[1:]
        if exe == "command" and any(t in {"-v", "-V"} for t in rest):
            return exe, rest, assigned
        i = 0
        while i < len(rest) and rest[i].startswith("-"):
            option = rest[i]
            i += 1
            if option == "--":
                break
            if exe == "env":
                if option in {"-i", "-", "--ignore-environment"}:
                    assigned.clear()
                elif option in {"-u", "--unset"} and i < len(rest):
                    assigned.pop(rest[i], None)
                    i += 1
                elif option.startswith("--unset="):
                    assigned.pop(option.split("=", 1)[1], None)
                elif option.startswith("-u"):
                    assigned.pop(option[2:], None)
                elif option in {"-C", "--chdir"}:
                    i += 1
                elif option in {"-S", "--split-string"} and i < len(rest):
                    rest[i:i + 1] = shlex.split(rest[i])
                elif option.startswith("--split-string="):
                    rest[i:i] = shlex.split(option.split("=", 1)[1])
            elif exe == "timeout" and option in {"-s", "--signal", "-k", "--kill-after"}:
                i += 1
            elif exe == "nice" and option in {"-n", "--adjustment"}:
                i += 1
            elif exe == "exec":
                if option == "-a":
                    i += 1
                elif "c" in option[1:]:
                    assigned.clear()
        if exe == "timeout":
            i += 1  # duration precedes the executable
        toks = rest[i:]
    return None, [], assigned


def effective_commands(seg: str, inherited=None, depth: int = 0):
    """Yield (exe, rest, env) for what a segment actually runs.

    `bash -c '<inner>'` (also `-lc`, `--norc -c`) executes <inner>, so it is
    scanned by the same rule as a bare command; VAR=val prefixes on the
    wrapper stay in force inside it, which keeps the suppressed headless form
    allowed through a shell as well."""
    exe, rest, env = first_executable(seg, inherited)
    if exe in SHELL_WRAPPERS and depth < MAX_UNWRAP_DEPTH:
        for i, tok in enumerate(rest[:-1]):
            if re.fullmatch(r"-[a-zA-Z]*c", tok):
                for sub in segments(rest[i + 1]):
                    yield from effective_commands(sub, env, depth + 1)
                return
    yield exe, rest, env


def main() -> None:
    try:
        data = json.load(sys.stdin)
    except Exception:
        sys.exit(0)

    if os.path.exists(BYPASS_FILE):
        sys.exit(0)

    if (data.get("tool_name") or "") != "Bash":
        sys.exit(0)

    cmd = (data.get("tool_input") or {}).get("command") or ""

    for exe, rest, assigned in (
        run for seg in segments(cmd) for run in effective_commands(seg)
    ):
        if exe != "claude":
            continue
        nxt = rest[0] if rest else ""
        # A suppressed headless run is the one nested form that is safe: the
        # telegram plugin stays inert, so the live poller is never touched.
        # This is what auto-publisher and scheduled agent tasks rely on.
        if nxt != "mcp" and assigned.get("ATARAX_SUPPRESS_TELEGRAM") == "1" and (
            "-p" in rest or "--print" in rest
        ):
            continue
        if nxt == "plugin":
            continue  # plugin management — safe
        if nxt == "auth" and rest[1:2] == ["status"]:
            continue  # read-only auth health check
        if nxt == "mcp":
            deny(
                "🚫 SELF-KILL GUARD: `claude mcp …` заборонено на живому боті.\n\n"
                "Ця команда запускає ДРУГИЙ екземпляр Claude Code, який через stale-PID "
                "replace у telegram-плагіні надсилає SIGTERM твоєму bun-полеру — бот замовкає.\n\n"
                "Перевірити MCP/полер → `pgrep -af \"bun.*telegram\"`.\n"
                "Встановити/налаштувати MCP → відредагуй .mcp.json або файл налаштувань і перезапусти "
                "службу, НЕ використовуй `claude mcp add` наживо."
            )
        deny(
            "🚫 SELF-KILL GUARD: вкладена інтерактивна `claude`-сесія заборонена.\n\n"
            "Вона конфліктує з живим Telegram-агентом. Що робити натомість:\n"
            "• підзавдання зараз → нативний Agent (Task);\n"
            "• одноразовий headless-запуск → `ATARAX_SUPPRESS_TELEGRAM=1 claude -p …` "
            "(дозволено: плагін лишається неактивним, полер працює);\n"
            "• робота за розкладом → `reminder-task … --run`."
        )

    sys.exit(0)


def deny(reason: str) -> None:
    print(json.dumps({"decision": "block", "reason": reason}))
    sys.exit(0)


if __name__ == "__main__":
    main()
