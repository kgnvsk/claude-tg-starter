#!/usr/bin/env python3
"""Block direct tool access to deployment credentials and process environments."""
from __future__ import annotations

import json
import os
import re
import shlex
import sys


HOME = os.environ.get("HOME") or "/home/claude"
PROTECTED_PATHS = (
    "/etc/claude-tg-starter",
)
# User-agnostic: on multi-instance boxes every agent home (/home/<user>) holds the
# same secret files; block them all regardless of which instance runs this hook.
# Any home and a relative path too (cd ~ && cat .claude/channels/telegram/.env), audit 20.10.2026.
HOME_SECRET_RE = re.compile(
    r"(?<![\w.-])(?:\.claude/channels/telegram/\.env"
    r"|\.claude/\.credentials\.json"
    r"|\.config/(?:vercel-token|apify-token|novsky/secrets\.json)"
    r"|\.ssh(?![\w.-]))"
)
PROCESS_SECRET_RE = re.compile(
    r"/proc/(?:[^/\s]+|\$\([^)]*\)|`[^`]*`)(?:/task/[^/\s]+)?/(?:environ|cmdline)", re.IGNORECASE
)
# Codex review of 4e57d636/cfca943e: a regex cannot tell a command from a word that merely mentions it, so
# the Bash check tokenises the line and acts on the command WORD of each simple command (recursing into a
# shell `-c`), never on `echo "set"`, `rg printenv` or `grep env`. It is still best-effort defence in depth:
# a backtick substitution or an unparseable line falls back to the narrow regex below, and the real boundary
# is the outbound-value filter (saved_credentials in any tool input) plus the deferred broker separation.
CODE_ENV_RE = re.compile(
    r"\bos\.environ\b(?!\s*(?:\.get\s*\(|\[|\.setdefault\s*\(|\.pop\s*\(|\.update\s*\())"
    r"|\b(?:process|Bun)\.env\b(?!\s*(?:\.[A-Za-z_$]|\[))|%ENV\b|\bENVIRON\b(?!\s*\[)"
)
FALLBACK_DUMP_RE = re.compile(
    r"(?<![\w.-])printenv\b"
    r"|(?:^|[;&|(`{\n'\"]|\$\()\s*(?:(?:/usr)?/bin/)?env(?:\s+-\S+|\s+[A-Za-z_][A-Za-z0-9_]*=\S*)*\s*(?=$|[;&|)`}\n'\"])"
    r"|(?:^|[;&|(`{\n'\"]|\$\()\s*(?:export(?:\s+-p)?|set)\s*(?=$|[;&|)`}\n'\"])",
    re.MULTILINE,
)
# The name of a credential, as the backup reads it: FAL_KEY, GITHUB_TOKEN, a password, an API hash.
CREDENTIAL_NAME = re.compile(
    r"(?:^|_)(?:API_?KEY|KEY|TOKEN|SECRET|PASSWORD|PASSWD|PASSPHRASE|PAT|HASH|COOKIES?|CREDENTIALS?)(?:_|$)"
    r"|(?:TOKEN|SECRET|PASSWORD|APIKEY)$"
)
# Expanding such a variable hands its value to whatever the command does with it: $X, ${X},
# os.environ["X"], os.getenv("X"), process.env.X, $ENV{X}, ENVIRON["X"].
VARIABLE_USE_RE = re.compile(
    r"\$\{?!?([A-Z][A-Z0-9_]*)"
    r"|(?:environ|getenv|process\.env|Bun\.env|ENV|ENVIRON)(?:\.get)?\W{0,3}([A-Z][A-Z0-9_]*)"
)
# ${#X} expands to a length (safe, dropped); ${X:+word} expands to word, not X, so keep word to scan it.
LENGTH_EXPANSION_RE = re.compile(r"\$\{#[A-Za-z_][A-Za-z0-9_]*\}")
CONDITIONAL_EXPANSION_RE = re.compile(r"\$\{[A-Za-z_][A-Za-z0-9_]*:\+([^}]*)\}")
# A test/[ operand that only asks whether a variable is set: -n "$X" / -z $X. A bare $X elsewhere still leaks.
TEST_PRESENCE_RE = re.compile(r"(?<![\w-])-[nz]\s+\"?\$\{?[A-Za-z_][A-Za-z0-9_]*\}?\"?")
# The connection store accepts a value from 8 characters (agent-connections).
SHORTEST_CREDENTIAL = 8
# Keywords that precede the real command word without being one.
SHELL_KEYWORDS = {"do", "then", "else", "elif", "if", "while", "until", "time", "!", "{", "}", "(", ")"}
# Wrappers that run a following command; their own leading options are skipped before recursing.
COMMAND_WRAPPERS = {"sudo", "doas", "command", "builtin", "exec", "nice", "nohup", "stdbuf", "ionice",
                    "setsid", "timeout", "watch", "xargs"}
WRAPPER_OPTS_WITH_VALUE = {"-u", "-g", "-U", "-C", "--chdir", "-I"}
# A wrapper's numeric operand (timeout 1m, nice -n 10, watch -n 5, xargs -n 1) is skipped before the command it runs.
WRAPPER_NUMBER_RE = re.compile(r"-?\d+(?:\.\d+)?[smhd]?")
# ps options whose following token is a value (user, format, sort key…), not a flag bundle.
PS_OPTS_WITH_VALUE = {"-o", "-p", "-u", "-U", "-g", "-G", "-s", "-t", "-C", "-q", "-L", "--format", "--sort",
                      "--pid", "--ppid", "--user", "--group", "--sid"}
SHELL_COMMANDS = {"sh", "bash", "zsh", "dash", "ksh", "mksh", "ash"}
CODE_RUNNERS = {"python", "python2", "python3", "node", "nodejs", "bun", "deno", "perl", "ruby", "awk", "gawk"}


def normalize(value: str) -> str:
    return (
        value.replace("${HOME}", HOME)
        .replace("$HOME", HOME)
        .replace("~", HOME)
    )


def protected_reference(value: str) -> bool:
    normalized = normalize(value)
    return (
        any(path in normalized for path in PROTECTED_PATHS)
        or bool(HOME_SECRET_RE.search(normalized))
        or ".config/novsky/secrets.json" in normalized
        or bool(PROCESS_SECRET_RE.search(normalized))
    )


def saved_credentials() -> set[str]:
    """Values of the credentials this agent holds; a store that cannot be read adds none."""
    values = {value for name, value in os.environ.items() if CREDENTIAL_NAME.search(name)}
    values.add(os.environ.get("TG_DELIVERY_STAMP", ""))
    state = os.environ.get("TELEGRAM_STATE_DIR") or os.path.join(HOME, ".claude/channels/telegram")
    try:
        with open(os.path.join(state, ".env"), encoding="utf-8") as handle:
            for line in handle:
                name, _, value = line.strip().removeprefix("export ").partition("=")
                if CREDENTIAL_NAME.search(name.strip()):
                    values.add(value.strip().strip("'\""))
    except (OSError, UnicodeDecodeError):
        pass
    # A store that does not parse still gives up its string values; one that cannot be read gives none.
    stores = (
        (".config/novsky/secrets.json", lambda data: data["values"].values(), r':\s*"((?:[^"\\]|\\.)+)"'),
        (".claude/.credentials.json",
         lambda data: (value for key, value in data["claudeAiOauth"].items() if key.lower().endswith("token")),
         r'"[A-Za-z]*[Tt]oken"\s*:\s*"((?:[^"\\]|\\.)+)"'),
    )
    for relative, pick, fallback in stores:
        try:
            with open(os.path.join(HOME, relative), encoding="utf-8") as handle:
                raw = handle.read()
        except (OSError, UnicodeDecodeError):
            continue
        try:
            values.update(value for value in pick(json.loads(raw)) if isinstance(value, str))
        except (ValueError, KeyError, TypeError, AttributeError):
            # A store that does not parse: recover each JSON string value as written, so an escaped quote
            # (abc\"defgh) is compared as the real secret abc"defgh, not the escaped form (Codex review).
            for captured in re.findall(fallback, raw):
                try:
                    values.add(json.loads('"' + captured + '"'))
                except ValueError:
                    values.add(captured)
    return {value for value in values if len(value) >= SHORTEST_CREDENTIAL}


def strings(value):
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for item in value.values():
            yield from strings(item)
    elif isinstance(value, list):
        for item in value:
            yield from strings(item)


def expands_credential(text: str) -> bool:
    cleaned = CONDITIONAL_EXPANSION_RE.sub(r" \1 ", LENGTH_EXPANSION_RE.sub(" ", text))
    return any(
        name and CREDENTIAL_NAME.search(name)
        for match in VARIABLE_USE_RE.finditer(cleaned)
        for name in match.groups()
    )


def simple_commands(command: str) -> list[list[str]]:
    """Each simple command of a shell line as its argv, split on operators. Raises ValueError if unparseable."""
    lexer = shlex.shlex(command, posix=True, punctuation_chars=True)
    lexer.whitespace_split = True
    lexer.commenters = ""  # `foo#bar` is not a shell comment; do not drop the rest of the line (Codex re-review)
    segments, current = [], []
    for token in lexer:  # punctuation_chars makes runs of ();<>|& their own tokens
        if token and set(token) <= set("();<>|&"):
            if current:
                segments.append(current)
                current = []
        else:
            current.append(token)
    if current:
        segments.append(current)
    return segments


def dash_value(args: list[str], flags: tuple[str, ...]) -> str | None:
    for index, arg in enumerate(args):
        if arg in flags and index + 1 < len(args):
            return args[index + 1]
        for flag in flags:
            if arg.startswith(flag + "="):
                return arg[len(flag) + 1:]
    return None


def env_dumps(args: list[str], depth: int = 0) -> bool:
    """`env` with only options/assignments prints the whole environment; with a command it runs it."""
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--":
            index += 1
            break
        if arg in ("-u", "--unset", "-C", "--chdir", "--block-signal", "--default-signal", "--ignore-signal"):
            index += 2
            continue
        if arg.startswith("-") and len(arg) > 1:
            index += 1
            continue
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", arg, re.S):
            index += 1
            continue
        break
    rest = args[index:]
    return command_leaks(rest, depth + 1) if rest else True


def ps_prints_environment(arg: str, previous: str) -> bool:
    if previous in PS_OPTS_WITH_VALUE or arg.startswith("--"):
        return False  # an option value, or a long option whose name ("--user") just happens to spell flag letters
    flags = arg.lstrip("-")
    if arg in ("e", "ee"):
        return True
    if "e" not in flags:
        return False
    # `e` prints the environment only in BSD personality. Dashless `aux`/`eww` is BSD; a dash form is sysv
    # unless it carries the BSD a/u/x letters, so `-efww` (sysv wide) is not a dump but `-auxe` is.
    return any(letter in flags for letter in ("auxw" if not arg.startswith("-") else "aux"))


def shell_code_leaks(code: str, depth: int) -> bool:
    """A string a shell parses again (`bash -c CODE`, `eval WORDS`)."""
    try:
        return any(command_leaks(segment, depth + 1) for segment in simple_commands(code))
    except (ValueError, RecursionError):
        return bool(FALLBACK_DUMP_RE.search(code) or CODE_ENV_RE.search(code) or expands_credential(code))


def command_leaks(argv: list[str], depth: int = 0) -> bool:
    if depth > 40:
        return True  # deeply nested wrappers are not ordinary work; fail safe rather than recurse forever
    index = 0
    while index < len(argv):
        token = argv[index]
        if token in SHELL_KEYWORDS or re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", token, re.S):
            index += 1
            continue
        break
    if index >= len(argv):
        return False
    command, args = argv[index], argv[index + 1:]
    base = command.rsplit("/", 1)[-1]

    if base == "eval":
        return shell_code_leaks(" ".join(args), depth)
    if base in COMMAND_WRAPPERS:
        # `command -v X` / `-V` only looks X up; a -v after X (`command env -v`) is X's own option.
        leading = []
        for arg in args:
            if not arg.startswith("-"):
                break
            leading.append(arg)
        if base in ("command", "builtin") and any(re.fullmatch(r"-[A-Za-z]*[vV][A-Za-z]*", arg) for arg in leading):
            return expands_credential(" ".join(args))
        inner = 0
        while inner < len(args) and (args[inner].startswith("-") or WRAPPER_NUMBER_RE.fullmatch(args[inner])):
            inner += 2 if args[inner] in WRAPPER_OPTS_WITH_VALUE else 1
        return command_leaks(args[inner:], depth + 1)
    if base in SHELL_COMMANDS:
        code = dash_value(args, ("-c", "-lc"))
        return expands_credential(" ".join(args)) if code is None else shell_code_leaks(code, depth)
    if base in CODE_RUNNERS:
        code = dash_value(args, ("-c", "-e", "-E", "--eval", "-p")) or " ".join(args)
        return bool(CODE_ENV_RE.search(code) or expands_credential(code))
    if base in ("env", "/usr/bin/env", "/bin/env"):
        return env_dumps(args, depth)
    if base == "printenv":
        return True
    if base == "set":
        return not args
    if base == "export":
        return not args or args == ["-p"]
    if base in ("declare", "typeset"):
        names = [arg for arg in args if not arg.startswith("-")]
        has_print = any("p" in arg.lstrip("-") for arg in args if arg.startswith("-"))
        return not args or (has_print and not names) or any(CREDENTIAL_NAME.search(name) for name in names)
    if base == "ps":
        return any(ps_prints_environment(arg, args[position - 1] if position else command)
                   for position, arg in enumerate(args))
    if base in ("test", "[", "[["):
        # A presence operand (-n "$X") only asks whether it is set; a bare $X leaks via the value or an error.
        return expands_credential(TEST_PRESENCE_RE.sub(" ", " ".join(args)))
    return expands_credential(" ".join(argv[index:]))


def command_leaks_environment(command: str) -> bool:
    try:
        return any(command_leaks(segment) for segment in simple_commands(command))
    except (ValueError, RecursionError, TypeError, AttributeError, IndexError):
        # Odd or unparseable input must fail safe to the narrow anchored regex, never crash the hook.
        return bool(FALLBACK_DUMP_RE.search(command) or CODE_ENV_RE.search(command) or expands_credential(command))


def deny(reason: str = (
    "Protected credential access blocked. Use the dedicated "
    "status/setup helper, which returns redacted output, instead "
    "of reading secret files or process environments directly."
)) -> None:
    print(json.dumps({"decision": "block", "reason": reason}))


def main() -> None:
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError):
        return
    if not isinstance(payload, dict):
        return

    tool_name = str(payload.get("tool_name") or "")
    tool_input = payload.get("tool_input") or {}
    if not isinstance(tool_input, dict):
        return
    credentials = saved_credentials()
    if any(credential in text for text in strings(tool_input) for credential in credentials):
        deny(
            "A saved credential is in this tool call. Keys and tokens never go into a message, "
            "a command, a link, a file or a subagent prompt: the helper that needs one reads it itself."
        )
        return

    path_values = []
    for key in ("file_path", "path", "notebook_path"):
        value = tool_input.get(key)
        if isinstance(value, str):
            path_values.append(value)
    edits = tool_input.get("edits")
    if isinstance(edits, list):
        for edit in edits:
            if isinstance(edit, dict):
                value = edit.get("file_path")
                if isinstance(value, str):
                    path_values.append(value)
    if any(protected_reference(value) for value in path_values):
        deny()
        return

    if tool_name == "Bash":
        command = str(tool_input.get("command") or "")
        if protected_reference(command):
            deny()
        elif command_leaks_environment(command):
            deny(
                "Blocked: this command would print the process environment or expand a saved credential "
                "variable on the command line. The helpers in ~/bin read their own keys: call them instead. "
                "To write a script that references a credential variable, create the file with the Write tool; "
                "to search for a variable, search for its name without the $."
            )


if __name__ == "__main__":
    main()
