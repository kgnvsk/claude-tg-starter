#!/usr/bin/env bash
# claude-login — подписочный (Max) OAuth-логин Claude Code для ТЕКУЩЕГО юзера, headless-friendly.
#
# Использует `claude auth login --claudeai` (полный scope подписки, вкл. user:mcp_servers —
# в отличие от урезанного `setup-token`). Гонит его в detached screen с редиректом вывода,
# поэтому URL ловится чисто (интерактивный промпт не рендерится в сырой SSH-канал → SSH виснет).
#
# Два шага, чтобы владелец сделал минимум — открыл один URL и вставил один код:
#   claude-login            → стартует логин, печатает OAuth-URL (отдать владельцу)
#   claude-login <код>      → скармливает вставленный владельцем код, завершает + верифицирует
#   claude-login --switch   → те саме при ЖИВОМУ вході: перевести бота на інший обліковий запис
#                             (вичерпаний тижневий ліміт, спільний вхід); успіх = інший email
#
# Запускать ОТ ИМЕНИ юзера бота:  runuser -l claude -c 'claude-login'
set -uo pipefail
# A login shell may not read ~/.profile (an empty ~/.bash_profile hides it): the CLI is found here, not by luck
# of the caller's PATH — «claude: command not found» left Ґарет and Мерлін without a link (Володимир, 07.10.2026).
export PATH="$HOME/.local/bin:$PATH"
SES="clogin-$(id -u)"
LOG="${TMPDIR:-/tmp}/claude-login.$(id -u).log"
# Обліковий запис до перемикання; порожній файл = зараховується будь-який вхід.
BEFORE="${TMPDIR:-/tmp}/claude-login.$(id -u).before"
SWITCH=""
if [ "${1:-}" = "--switch" ]; then SWITCH=1; shift; fi

# CLI 2.1.288 renews in `auth status` near the token's end and drops the answer, which wipes the login (kit
# #186): a live login in its last ten minutes is read from the files, never asked of the CLI.
near_end() {
  python3 - "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json" <<'PY' 2>/dev/null
import json, sys, time
try:
    login = json.load(open(sys.argv[1], encoding="utf-8")).get("claudeAiOauth") or {}
except (OSError, ValueError, AttributeError):
    sys.exit(1)
live = login.get("accessToken") and login.get("refreshToken")
sys.exit(0 if live and int(login.get("expiresAt") or 0) <= (time.time() + 600) * 1000 else 1)
PY
}
authed() { near_end && return 0; claude auth status 2>/dev/null | grep -q '"loggedIn": *true'; }
account_record() {  # the record the bot reads, as the launcher selects it
  if [ -z "${CLAUDE_CONFIG_DIR:-}" ]; then printf '%s' "$HOME/.claude.json"
  elif [ -f "$CLAUDE_CONFIG_DIR/.config.json" ]; then printf '%s' "$CLAUDE_CONFIG_DIR/.config.json"
  else printf '%s' "$CLAUDE_CONFIG_DIR/.claude.json"; fi
}
account() {
  if near_end; then
    local record; record="$(account_record)"
    python3 -c 'import json, sys; print((json.load(open(sys.argv[1])).get("oauthAccount") or {}).get("emailAddress") or "")' \
      "$record" 2>/dev/null
    return
  fi
  claude auth status 2>/dev/null | grep -oE '"email": *"[^"]*"' | head -1 | sed -E 's/.*: *"([^"]*)"/\1/'
}
landed() {
  authed || return 1
  local before
  before=$(cat "$BEFORE" 2>/dev/null || true)
  [ -z "$before" ] || [ "$(account)" != "$before" ]
}
AUTH_ESTABLISHED="${AGENT_ROOT:-$HOME}/.claude/auth-established"
mark_auth_established() {
  mkdir -p "$(dirname "$AUTH_ESTABLISHED")"
  (umask 077; : > "$AUTH_ESTABLISHED")
  chmod 0600 "$AUTH_ESTABLISHED"
}


if [ -z "$SWITCH" ] && [ -z "$(cat "$BEFORE" 2>/dev/null)" ] && authed; then
  mark_auth_established
  echo "✅ Вже авторизовано:"
  if near_end; then echo "  обліковий запис: $(account) (вхід саме оновлюється)"
  else claude auth status 2>/dev/null | grep -E '"(email|subscriptionType|authMethod)"'; fi
  exit 0
fi

if [ $# -eq 0 ]; then
  # ШАГ 1 — старт логина, поймать URL
  # A switch remembers the current account to prove the new one. Near the live login's end the CLI is not asked
  # for it (kit #186): the login is renewed first through a closed call that waits for the answer, so every try
  # moves it on (an expired login nobody renews would otherwise stay «near» for good, Codex review of 52aa9b74).
  # Only a renewal that did not land asks for another try; a renewed or a dead login goes on.
  if [ -n "$SWITCH" ] && near_end; then
    ATARAX_SUPPRESS_TELEGRAM=1 timeout 120 claude -p --safe-mode --tools "" --no-session-persistence \
      --model haiku "Reply with OK" </dev/null >/dev/null 2>&1 || true
    if near_end; then
      echo "⚠ Вхід у Claude саме оновлюється — повтори перемикання за кілька хвилин."; exit 75
    fi
  fi
  screen -S "$SES" -X quit >/dev/null 2>&1 || true
  : > "$LOG"
  if [ -n "$SWITCH" ]; then account > "$BEFORE"; else : > "$BEFORE"; fi
  screen -dmS "$SES" bash -c "claude auth login --claudeai > '$LOG' 2>&1"
  URL=""
  for _ in $(seq 1 40); do
    URL=$(grep -oE 'https://[^[:space:]]+' "$LOG" | head -1)
    [ -n "$URL" ] && break
    sleep 1
  done
  if [ -z "$URL" ]; then
    echo "⚠ OAuth-URL не з’явився за 40 с. Повний журнал входу:"; cat "$LOG"
    screen -S "$SES" -X quit >/dev/null 2>&1 || true
    exit 1
  fi
  if [ -n "$SWITCH" ]; then
    echo "1) Передай власнику цей URL — нехай відкриє його у браузері та увійде до ІНШОГО облікового запису (поточний: $(cat "$BEFORE")). Поточний вхід працює, доки не завершиться новий:"
  else
    echo "1) Передай власнику цей URL — нехай відкриє його у браузері та увійде зі СВОЄЮ підпискою Max:"
  fi
  echo
  echo "   $URL"
  echo
  echo "2) Власник копіює код зі сторінки → виконай:  claude-login <код>"
  exit 0
fi

# ШАГ 2 — скормить вставленный код
if ! screen -S "$SES" -X stuff "$1"$'\n' 2>/dev/null; then
  echo "⚠ Сесію входу не знайдено — спочатку запусти: claude-login"; exit 1
fi
for _ in $(seq 1 20); do landed && break; sleep 1; done
if landed; then
  mark_auth_established
  if [ -n "$(cat "$BEFORE" 2>/dev/null)" ]; then
    echo "✅ Обліковий запис змінено:"; claude auth status 2>/dev/null | grep -E '"(email|subscriptionType|authMethod)"'
    echo "Перезапусти службу бота, щоб вона підхопила новий вхід — запущений процес тримає старий токен у пам’яті."
  else
    echo "✅ Авторизовано через підписку:"; claude auth status 2>/dev/null | grep -E '"(email|subscriptionType|authMethod)"'
  fi
  : > "$BEFORE"
  screen -S "$SES" -X quit >/dev/null 2>&1 || true
else
  echo "⚠ Підтвердження ще не отримано. Кінець журналу:"; tail -10 "$LOG"
  echo "Перевір код або запусти claude-login знову."; exit 1
fi
