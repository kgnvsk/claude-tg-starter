                 r"|ничего\s+страшн|ничего\s+плох|нічого\s+страшн|нічого\s+поган)")
CANT_CLAIM = re.compile(
    rf"(?<![\w-])(?:не\s+с?могу(?![\w-])(?!\s+(?:[\w-]+\s+)?{KNOWING}(?![\w-]))"
    rf"|не\s+з?можу(?![\w-])(?!\s+(?:[\w-]+\s+)?{KNOWING}(?![\w-]))"
    rf"|(?:у\s+меня|мне)\s+{GAP}нет\s+(?:доступа|входа|прав|возможности|логина|пароля)|нет\s+у\s+меня\s+(?:доступа|входа|прав)"
    rf"|(?:[ув]\s+мене|мені)\s+{GAP}(?:немає|нема)\s+(?:доступу|входу|прав|можливості|логіна|пароля)"
    r"|(?:немає|нема)\s+[ув]\s+мене\s+(?:доступу|входу|прав)"
    r"|(?:доступа|входа|прав)\s+(?:[\w-]+\s+){0,3}?у\s+меня\s+нет(?![\w-])"
    r"|(?:доступу|входу|прав)\s+(?:[\w-]+\s+){0,3}?[ув]\s+мене\s+(?:немає|нема)(?![\w-])"
    r"|(?:^|(?<=[.!?:;]))\s*(?:нет|немає|нема)\s+(?:доступа|входа|доступу|входу)(?![\w-])"
    rf"|(?:у\s+меня|мне)\s+не\s+получ(?:ится|ается)|не\s+получ(?:ится|ается)\s+{ACTS}|{ACTS}\s+{GAP}не\s+получ(?:ится|ается)"
    rf"|(?:[ув]\s+мене|мені)\s+не\s+(?:вийде|виходить)|не\s+(?:вийде|виходить)\s+{ACTS}|{ACTS}\s+{GAP}не\s+(?:вийде|виходить)"
    r"|в\s+этой\s+сессии\s+(?:нет|не)(?![\w-])|в\s+цій\s+сесії\s+(?:немає|нема|не)(?![\w-])"
    rf"|отсюда\s+{GAP}не\s+(?:могу|вижу|достать)|звідси\s+{GAP}не\s+(?:можу|бачу|дістати)"
    r"|напиши(?:те)?\s+(?:мне\s+|мені\s+)?(?:в|у)\s+(?:личк|особист|приват)\w*|временно\s+недоступ\w*|тимчасово\s+недоступ\w*"
    r"|не\s+получилось|не\s+удал[ао]сь|не\s+смог(?:ла|ли)?(?![\w-])|не\s+сработал[аои]?(?![\w-])"
    r"|не\s+вийшло|не\s+вдал[ао]ся|не\s+зміг(?![\w-])|не\s+змогл[аи](?![\w-])|не\s+спрацюва(?:в|ла|ло|ли)(?![\w-])"
    rf"|не\s+(?:видно|вижу|бачу)(?![\w-])(?!\s+(?:[\w-]+\s+)?{NOT_A_FAILURE}))"
    r"|\bI\s+(?:can(?:no|'|’)t|can\s+not|am\s+unable\s+to|'m\s+unable\s+to|couldn(?:'|’)t|could\s+not"
    r"|wasn(?:'|’)t\s+able\s+to|was\s+unable\s+to|failed\s+to)\b"
    r"(?!\s+(?:say|tell|guarantee|promise|confirm|know|judge|be\s+sure)\b)"
    r"|\bI\s+(?:don(?:'|’)t|do\s+not)\s+(?:have\s+(?:access|a\s+login|permission|the\s+rights|rights|credentials)|see)\b"
