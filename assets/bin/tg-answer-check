_LOCALE = []


def localized(key: str, ukrainian: str) -> str:
    """The text in the owner's notice language (OWNER_NOTICE_LOCALE), as every kit notice; Ukrainian on any failure."""
    try:
        if not _LOCALE:
            spec = importlib.util.spec_from_file_location("agent_notice_locale",
                                                          Path(__file__).with_name("agent_notice_locale.py"))
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            _LOCALE.append(module)
        return _LOCALE[0].notice_text(key, ukrainian, home=HOME)
    except Exception:
        return ukrainian


def off(check: str) -> bool:
    return (STATE / SWITCH[check]).exists()


def log(record: dict) -> None:
    try:
        if LOG.exists() and LOG.stat().st_size > 2_000_000:
            LOG.write_text("".join(LOG.read_text(encoding="utf-8").splitlines(True)[-4000:]), encoding="utf-8")
        with LOG.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(record, ensure_ascii=False) + "\n")
    except Exception:
        pass


def own_lock(tool: str) -> bool:
    """The agent's own reply-send-lock is present and hooked on this tool (two live agents, 13.11.2026): it already
    checks these replies, and one answer held twice for one reason would be one hold too many. A tool its matcher
    leaves out (an edit, when it watches replies only) is checked here."""
    try:
        settings = json.loads((CONFIG / "settings.json").read_text(encoding="utf-8"))
        for group in (settings.get("hooks") or {}).get("PreToolUse") or []:
            matcher = str(group.get("matcher") or "") if isinstance(group, dict) else ""
            try:
                if matcher not in ("", "*") and not re.fullmatch(matcher, tool):
                    continue
            except re.error:
                continue
            for hook in (group.get("hooks") or []) if isinstance(group, dict) else []:
                for word in str(hook.get("command") or "").split() if isinstance(hook, dict) else []:
                    path = Path(os.path.expanduser(word.strip("'\"")))
                    if path.name == "reply-send-lock" and path.is_file():
                        return True
    except Exception:
        return False
    return False


def owner_id() -> str:
    """The owner's Telegram id: the agent profile first (as tg-format-enforcer), then the channel's .env."""
    for path in (HOME / ".agent-profile.env", TELEGRAM_STATE / ".env"):
        try:
            for line in path.read_text(encoding="utf-8").splitlines():
                if line.startswith("OWNER_CHAT_ID="):
                    value = line.split("=", 1)[1].strip().strip("'\"")
                    if value:
                        return value
        except (OSError, UnicodeError):
            continue
    return ""


def owner_name_stem() -> str:
    """OWNER_NAME's stem for a refusal that names the owner («це особисте Олени»); empty when there is none."""
    try:
        for line in (HOME / ".agent-profile.env").read_text(encoding="utf-8").splitlines():
            if line.startswith("OWNER_NAME="):
                words = line.split("=", 1)[1].strip().strip("'\"").split()
                name = words[0] if words else ""
                return re.escape(name[:-1] if len(name) > 4 and name[-1].lower() in "аяоaeiouй" else name) if len(name) >= 3 else ""
    except (OSError, UnicodeError):
        pass
    return ""


def same(a, b) -> bool:
    return str(a if a is not None else "") == str(b if b is not None else "")


def stamp(event: dict):
    try:
        return calendar.timegm(time.strptime(str(event.get("timestamp"))[:19], "%Y-%m-%dT%H:%M:%S"))
    except (TypeError, ValueError):
        return None


def sentence(text: str, match) -> str:
    """The whole sentence with the claim, on one line."""
    starts = [x.end() for x in re.finditer(r"[.!?…](?=\s)|\n", text[:match.start()])]
    end = re.search(r"[.!?…](?=\s|$)|\n", text[match.end():])
    return " ".join(text[starts[-1] if starts else 0: match.end() + (end.end() if end else len(text))].split()).removesuffix(".")


def claim_matches(rx, text: str, earlier_ok=False, negated_ok=False) -> list:
    """Matches of rx that state something: not quoted, not in a question, not after «якщо / если / if»; «не …» before
    the word (unless negated_ok) and «ти / ты / you …» drop it; earlier_ok: a time named in the sentence drops it too."""
    plain = QUOTED.sub(lambda q: " " * len(q.group(0)), text)
    found = []
    for m in rx.finditer(plain):
        start = max([x.end() for x in re.finditer(r"[.!?…](?=\s)|\n", plain[:m.start()])] or [0])
        end = re.search(r"[.!?…](?=\s|$)|\n|$", plain[m.end():])
        before, whole = plain[start:m.start()], plain[start:m.end() + end.end()]
        if whole.rstrip().endswith("?") or CONDITION.search(before):
            continue
        if (not negated_ok and NEGATED.search(before)) or ADDRESSED.search(before):
            continue
        if earlier_ok and EARLIER.search(whole):
            continue
        found.append(m)
    return found


def by_rule(text: str, m) -> bool:
    """A refusal a rule requires, in its own sentence or the next one: the owner's private things, owner-only changes,
    a site's «are you human» check, never sending a password."""
    end = re.search(r"[.!?…](?=\s|$)|\n", text[m.end():])
    tail = text[m.end() + end.end():] if end else ""
    nxt = re.search(r"[.!?…](?=\s|$)|\n|$", tail)
    stem = owner_name_stem()
    rule = RULE_REFUSAL.replace("OWNER", f"(?:{OWNER_WORDS[3:-1]}|{stem})" if stem else OWNER_WORDS)
    return bool(re.search(rule, sentence(text, m) + " " + tail[: nxt.end() if nxt else len(tail)], re.I))


def refusal(text: str):
    """The first «не можу / I can't / не вийшло / не бачу» that no rule requires and that is not «can't say for sure»."""
    for m in claim_matches(CANT_CLAIM, text, earlier_ok=True, negated_ok=True):
        if (not by_rule(text, m) and not KNOWING_BEFORE.search(text[max(0, m.start() - 40):m.start()])
                and not HEADING_BEFORE.search(text[max(0, m.start() - 12):m.start()])):
            return m  # «*Що не вийшло:*» heads a list, it refuses nothing
    return None


def pushback(text: str):
    """«У мене немає X / X не підключений» and «підключи / налаштуй / надішли» with no exact step (a link, a command):
    the work goes back to the person. «Надішли скріншот / файл» asks to see their own thing and is not that."""
    if not MISSING.search(text) or EXACT_STEP.search(text):
        return None
    plain = QUOTED.sub(lambda q: " " * len(q.group(0)), text)
    for m in PUSHBACK.finditer(plain):
        end = re.search(r"[.!?…](?=\s|$)|\n|$", plain[m.end():])
        rest = plain[m.end():m.end() + end.end()]
        if rest.rstrip().endswith("?") or by_rule(text, m) or SHOW_ME.match(rest):
            continue
        return m
    return None


def turn(path: str):
    """(events since the request, events of the PREV_SECONDS before it), oldest first; None without a request in the
    record. An event is ("tool", name, input, (error?, result text, the CLI's toolUseResult) | None) or
    ("note", "", {}, None) for a helper's report (a task-notification, also when queued as an attachment).
    The request is the latest user prompt that is no tool result, CLI meta line, compaction summary or helper's report
    (Маркетинг, 10.11.2026: 12 of 66 channel messages that opened a turn were marked meta);
    Telegram sends and sidechains are no events (reading an attachment is)."""
    size = os.path.getsize(path)
    with open(path, "rb") as handle:
        handle.seek(max(0, size - TAIL))
        lines = handle.read().split(b"\n")
    if size > TAIL:
        lines = lines[1:]
    events, earlier, results, asked = [], [], {}, None
    for raw in reversed(lines):
        if not raw.strip():
            continue
        try:
            event = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(event, dict) or event.get("isSidechain"):
            continue
        at = stamp(event)
        if asked is not None and (at is None or at < asked - PREV_SECONDS):
            if at is None:
                continue
            break
        content = (event.get("message") or {}).get("content")
        blocks = [b for b in content if isinstance(b, dict)] if isinstance(content, list) else []
        attachment = event.get("attachment") if isinstance(event.get("attachment"), dict) else {}
        if event.get("type") == "attachment":
            # A helper's report that arrives while the turn runs is queued into it as an attachment (as the stop guard
            # reads it); any other attachment, a queued channel message included, opens nothing.
            if attachment.get("type") == "queued_command" and attachment.get("commandMode") == "task-notification":
                (events if asked is None else earlier).append(("note", "", {}, None))
        elif event.get("type") == "assistant":
            for block in reversed(blocks):
                name = str(block.get("name") or "")
                if block.get("type") == "tool_use" and (not name.startswith(TOOLS) or name.endswith("__download_attachment")):
                    item = ("tool", name, block.get("input") if isinstance(block.get("input"), dict) else {},
                            results.get(block.get("id")))
                    (events if asked is None else earlier).append(item)
        elif event.get("type") == "user" and any(b.get("type") == "tool_result" for b in blocks):
            for block in blocks:  # a result follows its call in the record: read backwards, it is seen first
                if block.get("type") == "tool_result":
                    body = block.get("content")
                    body = body if isinstance(body, str) else " ".join(
                        str(x.get("text") or "") for x in (body or []) if isinstance(x, dict))
                    response = event.get("toolUseResult") if isinstance(event.get("toolUseResult"), dict) else {}
                    results[block.get("tool_use_id")] = (bool(block.get("is_error")), body[:3000], response)
        elif event.get("type") == "user" and not event.get("isCompactSummary"):
            text = content if isinstance(content, str) else " ".join(str(b.get("text") or "") for b in blocks)
            if event.get("isMeta") and not text.lstrip().startswith("<channel"):
                continue  # a CLI line ([Image …], a reminder); a channel message is a request even when the CLI marks it meta
            if "<task-notification>" in text:
                (events if asked is None else earlier).append(("note", "", {}, None))
            elif asked is None:
                if at is None:
                    return events[::-1], []  # a request without a time: nothing before it counts
                asked = at
    return None if asked is None else (events[::-1], earlier[::-1])


def shell_text(command: str) -> str:
    """The command without heredoc bodies and quoted strings: «&» in a URL is no start, «cat > file» no reading."""
    command = re.sub(r"<<-?\s*['\"]?(\w+)['\"]?[^\n]*\n.*?\n\s*\1[ \t]*(?=\n|$)", "\n", command, flags=re.S)
    return re.sub(r"'[^'\n]*'|\"[^\"\n]*\"", "''", command)


def start_of(name: str, inp: dict, result) -> tuple:
    """(what was started, the command's rest after the start) or (None, ''). A background Agent or command and a
    resumed helper are read from the CLI's own result, as tg-native-task reads them; a word to a running helper
    starts nothing, whatever it says."""
    response = result[2] if result and len(result) > 2 else {}
    background = inp.get("run_in_background") is True or str(inp.get("run_in_background")).lower() == "true"
    if name in ("Agent", "Task"):
        launched = background or response.get("isAsync") is True or bool(result and result[1].startswith("Async agent launched"))
        return ("Agent (run_in_background)", "") if launched else (None, "")
    if name == "SendMessage":
        resumed = response.get("success") is True and bool(response.get("resumedAgentId"))
        return ("SendMessage (resume)", "") if resumed else (None, "")
    if name != "Bash":
        return None, ""
    command = shell_text(str(inp.get("command") or ""))
    if background or response.get("backgroundTaskId"):
        return "Bash (run_in_background)", ""
    for rx, what in ((START_BG, "nohup / &"), (START_TASK, "reminder-task / crontab")):
        m = rx.search(command)
        if m:
            return what, command[m.end():]
    return None, ""


def is_read(name: str, inp: dict) -> bool:
    if name in READ_TOOLS:
        return True
    return name == "Bash" and bool(READ_CMD.search(re.sub(r"\bcat\s*>>?", " ", shell_text(str(inp.get("command") or "")))))


def unchecked_start(events: list):
    """The last start of the turn when nothing after it was read and no helper reported; else None."""
    last = None
    for index, (kind, name, inp, result) in enumerate(events):
        if kind == "tool":
            what, rest = start_of(name, inp, result)
            if what:
                last = (index, what, rest)
    if not last or READ_CMD.search(re.sub(r"\bcat\s*>>?", " ", last[2])):
        return None
    if any(kind == "note" or is_read(name, inp) for kind, name, inp, _ in events[last[0] + 1:]):
        return None
    return last[1]


def segments(command: str) -> list:
    return [part for part in re.split(r"[;\n|]+|&&", shell_text(command)) if part.strip()]


def side_call(name: str, inp: dict) -> bool:
    """No attempt: bookkeeping, reading the chat, writing notes."""
    if name in BOOK_TOOLS:
        return True
    if name == "Read":
        return bool(CHAT_READ.search(str(inp.get("file_path") or "")))
    if name == "Bash":
        parts = segments(str(inp.get("command") or ""))
        return bool(parts) and all(CHAT_READ.search(p) or re.search(r">>\s*\S*(?:obsidian-vault|\.md)\b", p)
                                   or re.match(r"\s*(?:echo|printf|date|true|sleep|cd)\b", p) for p in parts)
    return False


def route(name: str, inp: dict) -> str:
    """The way an attempt went: a program (its first word), a site (its host), a tool."""
    if name == "Bash":
        for part in segments(str(inp.get("command") or "")):
            words = [w for w in part.split() if not re.match(r"^\w+=", w)]
            while words and (os.path.basename(words[0]) in INTERPRETERS or words[0].isdigit()
                             or words[0].startswith("-") or words[0] == "''"):
                words = words[1:]
            if words:
                program = os.path.basename(words[0])
                if program in ("curl", "wget"):
                    host = re.search(r"https?://([^/\s'\"]+)", str(inp.get("command") or ""))
                    return f"{program}:{host.group(1) if host else ''}"
                return program
        return "bash"
    host = re.search(r"https?://([^/\s]+)", str(inp.get("url") or ""))
    return f"{name}:{host.group(1)}" if host else name


def diagnosis(name: str, inp: dict) -> bool:
    """A look at why it failed: a read (a file, a log, settings), a status check, --help."""
    if name in READ_TOOLS or (name.startswith("mcp__") and re.search(r"snapshot|status|list|get|read|whoami|doctor",
                                                                      f"{name} {inp.get('action') or ''}")):
        return True
    command = str(inp.get("command") or "")
    return name == "Bash" and bool(READ_CMD.search(re.sub(r"\bcat\s*>>?", " ", shell_text(command))) or STATUS_CMD.search(command))


def status_check(name: str, inp: dict) -> bool:
    """A check of a connection or a sign-in: status, doctor, whoami, auth list, --help, systemctl status, curl -I."""
    if name.startswith("mcp__"):
        return bool(re.search(r"status|list|whoami|doctor", f"{name} {inp.get('action') or ''}", re.I))
    return name == "Bash" and bool(STATUS_CMD.search(shell_text(str(inp.get("command") or ""))))


def repair(name: str, inp: dict) -> bool:
    """A try to fix it or to hand it on: a file or settings written, a sign-in, a connection, an install, a helper."""
    if name in ("Write", "Edit", "MultiEdit", "NotebookEdit", "Agent", "Task", "SendMessage"):
        return True
    if name.startswith("mcp__") and re.search(r"connect|auth|login|set|create|update", f"{name} {inp.get('action') or ''}", re.I):
        return True
    return name == "Bash" and bool(FIX_CMD.search(shell_text(str(inp.get("command") or ""))))


def gave_up(events: list, earlier: list, text: str):
    """«cant»: no attempt since the request, nor in the minutes before it; «giveup»: one or two tries by one route and
    after the first no look at why, no repair, no second route; None: a second route or a repair, a helper's report, a
    guard's refusal, or one person-only step named after the agent checked the connection itself."""
    def attempts(items):
        return [e for e in items if e[0] == "tool" and not side_call(e[1], e[2])]
    if any(e[0] == "note" for e in events):
        return None
    tries = attempts(events) or attempts(earlier)
    if not tries:
        return None if any(e[0] == "note" for e in earlier) else "cant"
    if any(e[3] and GUARD_OUT.search(e[3][1]) for e in tries):
        return None
    if PERSON_STEP.search(text) and any(status_check(e[1], e[2]) for e in tries):
        return None
    first = route(tries[0][1], tries[0][2])
    if sum(1 for e in tries if route(e[1], e[2]) == first) > 2:
        return None  # kept at it by one route: that is no giving up after the first try
    if any(route(e[1], e[2]) != first or diagnosis(e[1], e[2]) or repair(e[1], e[2]) for e in tries[1:]):
        return None
    return "giveup"


def request_of(db, chat: str, thread, delivery: str, edited) -> tuple:
    """(key, requester) of the request a reply answers. The key: the message the reply's delivery_id names, else the
    latest message in this chat and topic (an edit's topic is the edited message's); (None, '') when the receiver's
    archive holds no such message. The requester only when certain: the sender of the named message, or the owner
    in his own chat; else '' — a reply to a third person's chat or a group without a delivery_id names nobody."""
    if edited:
        row = db.execute("SELECT thread_id FROM messages WHERE chat_id=? AND direction='out' AND message_id=?",
                         (chat, str(edited))).fetchone()
        thread = row[0] if row else thread
    rows = [r for r in db.execute("SELECT direction, user_id, message_id, thread_id FROM messages WHERE chat_id=? "
                                  "ORDER BY ts DESC, id DESC LIMIT 500", (chat,)) if same(r[3], thread)]
    topic = "" if thread is None else thread
    message = delivery.rsplit(":", 1)[-1] if delivery.startswith(chat + ":") else ""
    named = next((r for r in rows if r[0] == "in" and message and str(r[2]) == message), None)
    if named:  # a newer message already in the archive is its own request, with its own check
        return f"{chat}|{topic}|{named[2]}", str(named[1] or "")
    sender = "" if chat.startswith("-") else chat
    latest = next((r for r in rows if r[0] == "in" and (not sender or str(r[1]) == sender)), None)
    if not latest:
        return None, ""
    return f"{chat}|{topic}|{latest[2]}", chat if chat == owner_id() else ""


def requester(sender: str) -> str:
    owner = owner_id()
    which = "unknown" if not owner or not sender else "owner" if sender == owner else "other"
    return localized(*WHO[which])


def payload_of(payload: str) -> tuple:
    try:
        params = json.loads(payload).get("params") or {}
        return params.get("meta") or {}, str(params.get("content") or "")
    except (ValueError, AttributeError):
        return {}, ""


def render(meta: dict, content: str) -> str:
    sent = str(meta.get("ts") or "")[11:19]
    kind = str(meta.get("transcribed_from") or meta.get("attachment_kind") or "")
    head = ", ".join(x for x in (sent and sent + " UTC", kind,
                                 meta.get("attachment_name") and f"«{meta['attachment_name']}»") if x)
    extra = [f"image_path: {meta.get('image_paths') or meta.get('image_path')}"] if meta.get("image_paths") or meta.get("image_path") else []
    if meta.get("attachment_file_id") and not meta.get("transcribed_from"):
        extra.append(f"attachment_file_id={meta['attachment_file_id']} (download_attachment)")
    return "\n".join(["— " + head + ":", content.strip() or "—", *extra])


def send_lock(db, inp: dict, chat: str, now: float, shown: dict, held: dict, base: dict):
    """The hold text when the receiver's queue keeps a message of the same person in this chat and topic that the agent
    has not been shown; else None. Another person's message in a group holds nothing."""
    rows = db.execute("SELECT delivery_id, payload, state FROM pending_inbound_deliveries ORDER BY created_at, rowid").fetchall()
    delivery = str(inp.get("delivery_id") or "")
    current = next((payload_of(p)[0] for d, p, _ in rows if d == delivery), {})
    user = str(current.get("user_id") or "")
    thread = inp.get("thread_id", current.get("thread_id"))
    fresh = []
    for delivery_id, payload, state in rows:
        if state != "queued" or delivery_id in shown or delivery_id == delivery:
            continue
        meta, content = payload_of(payload)
        if not same(meta.get("chat_id"), chat) or not same(meta.get("thread_id"), thread):
            continue
        sender = str(meta.get("user_id") or "")
        if (user and sender and sender != user) or (not user and chat.startswith("-")):
            continue
        fresh.append((delivery_id, meta, content))
    if not fresh:
        return None
    key = delivery or chat
    if len(held.get(key, [])) >= MAX_HOLDS:
        base["lock"] = "cap"
        return None
    for delivery_id, _, _ in fresh:
        shown[delivery_id] = now
    held[key] = held.get(key, []) + [now]
    return localized(*HOLD["lock"]) + "\n\n" + "\n\n".join(render(meta, content) for _, meta, content in fresh)


def text_checks(data: dict, inp: dict, edit: bool, chat: str, text: str, once: dict, now: float, base: dict):
    """(hold text or None, log fields) of the three text checks, one hold per request between them."""
    body = text.strip()
    if len(body) < MIN_CHARS or body.startswith(ACK):
        return None, {}
    done = None if off("done") else next(iter(claim_matches(DONE_CLAIM, text, earlier_ok=True)), None)
    launch = None if off("launch") else next(iter(claim_matches(LAUNCH_CLAIM, text)), None)
    refuse = None if off("giveup") else refusal(text)
    pushed = None if off("giveup") else pushback(text)
    if not (done or launch or refuse or pushed):
        return None, {}
    with contextlib.closing(sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=1.0)) as db:
        key, sender = request_of(db, chat, inp.get("thread_id"), str(inp.get("delivery_id") or ""),
                                 inp.get("message_id") if edit else None)
    if not key:
        return None, {"request": "unknown"}
    digest = hashlib.sha256(text.encode("utf-8")).hexdigest()[:16]
    if key in once:  # this request has had its hold: everything passes, and the first send after it is on record
        record = once[key]
        if record.get("done"):
            return None, {}
        record["done"] = True
        return None, {"after_" + record["why"].replace("-", "_"): True, "changed": record["h"] != digest}
    found = turn(str(data.get("transcript_path") or ""))
    if found is None:
        return None, {"turn": "not found"}
    events, earlier = found
    why, fields, extra = None, {}, {}
    what = unchecked_start(events) if launch else None
    if what:
        why, fields, extra = "launch", {"sentence": sentence(text, launch), "what": what}, {"started": what}
    if not why and (refuse or pushed):
        verdict = gave_up(events, earlier, text) if refuse else None
        if verdict:
            why, fields = verdict, {"sentence": sentence(text, refuse)}
            extra = {"attempts": sum(1 for e in events + earlier if e[0] == "tool" and not side_call(e[1], e[2]))}
        elif pushed and not any(e[0] == "note" or not side_call(e[1], e[2]) for e in events + earlier):
            why, fields, extra = "pushback", {"sentence": sentence(text, pushed)}, {"kind": "pushback"}
    if not why and done and not refuse and not MISSING.search(text) and not any(
            e[0] == "note" or e[1] not in BOOK_TOOLS for e in events + earlier):
        why, fields = "done", {"found": f"«{' '.join(done.group(0).split())}»"}
    if not why:
        return None, {}
    once[key] = {"t": now, "why": why + "-check", "h": digest}
    reason = localized(*HOLD[why]).format(who=requester(sender), **fields)
    return reason, {"why": ("giveup" if why == "pushback" else why) + "-check", **extra}


@contextlib.contextmanager
def state_lock():
    """One reply hook at a time reads and writes the state: two replies at once never both find «no hold yet»."""
    with open(STATE / "lock", "a+") as handle:
        deadline = time.time() + 3
        while True:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.time() > deadline:
                    raise
                time.sleep(0.05)
        yield


def main() -> None:
    data = json.loads(sys.stdin.read() or "{}")
    name = str(data.get("tool_name") or "")
    edit = name == TOOLS + "edit_message"
    if (name != TOOLS + "reply" and not edit) or data.get("agent_id"):
        return
    inp = data.get("tool_input") if isinstance(data.get("tool_input"), dict) else {}
    chat = str(inp.get("chat_id") or "")
    if not chat or not DB.exists() or OFF.exists() or own_lock(name):
        return
    STATE.mkdir(parents=True, exist_ok=True)
    os.chmod(STATE, 0o700)
    now = time.time()
    text = str(inp.get("text") or "")
    base = {"t": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now)), "delivery": str(inp.get("delivery_id") or ""),
            "phase": inp.get("phase"), **({"edit": True} if edit else {})}
    with state_lock():
        try:  # a record that cannot be read starts afresh: at worst a request gets its one hold again
            saved = json.loads(SAVED.read_text(encoding="utf-8"))
            once = {k: v for k, v in saved["once"].items() if now - v["t"] < KEEP_SECONDS}
            shown = {k: v for k, v in saved["shown"].items() if now - v < KEEP_SECONDS}
            held = {k: [t for t in v if now - t < HOLD_WINDOW] for k, v in saved["held"].items()}
        except Exception:
            once, shown, held = {}, {}, {}
        reason, why, more = None, None, {}
        if not edit and not off("lock"):
            try:  # first: a newer message of the same person matters more than any wording; its error holds nothing
                with contextlib.closing(sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=1.0)) as db:
                    reason = send_lock(db, inp, chat, now, shown, held, base)
                why = "send-lock" if reason else None
            except Exception as error:
                more = {"lock_error": type(error).__name__}
        if not reason:
            try:
                reason, extra = text_checks(data, inp, edit, chat, text, once, now, base)
                why = extra.pop("why", None)
                more.update(extra)
            except Exception as error:
                reason, more = None, {**more, "error": type(error).__name__}
        tmp = SAVED.with_suffix(".tmp")
        tmp.write_text(json.dumps({"once": once, "shown": shown, "held": {k: v for k, v in held.items() if v}}),
                       encoding="utf-8")
        os.replace(tmp, SAVED)  # a hold is given only once it is on record
    if reason:
        log({**base, "decision": "deny", "why": why, "chars": len(text), **more})
        print(json.dumps({"decision": "block", "reason": reason}))  # as tg-format-enforcer; ASCII on any locale
        return
    log({**base, "decision": "allow", **more})


if __name__ == "__main__":
    try:
        main()
    except Exception as error:  # the hook never stops a reply by failing
        log({"t": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "decision": "allow", "error": type(error).__name__})
