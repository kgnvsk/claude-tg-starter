#!/usr/bin/env python3
"""tg-answer-check: PreToolUse hook on the Telegram reply and edit_message tools. A reply whose words claim what this
turn did not do goes back to the agent once, with what to do; every other reply is sent untouched.

Product owner, 13.11.2026: «не перепроверяет… ой, могу, ой, не могу, ой, да, ты прав, я не сделал. Или ой, не
запустилось, ой, да, я не проверил. Вот этого всего не должно быть»; «агент не должен сдаваться… должен проверить, если
не получается — починить, подключить, настроить и вернуться». The kit's version of four checks proven since that night
on two live agents (their own reply-send-lock):

  done    «зробив / сделал / I've fixed…», and neither this turn nor the 10 minutes before the request took any action;
  launch  «запустив / запустил / is running…» after a start (a background Agent or command, nohup or &, reminder-task,
          crontab) that nothing read afterwards: no process, log or task list looked at, no helper's report;
  giveup  «не можу / не могу / I can't / не вийшло…» with no attempt since the request (nor in the 10 minutes before
          it), or after one or two tries by one route with no look at the error, no repair and no second route; and
          «у мене немає X — підключи / надішли» with no attempt and no exact step (a link or a command);
  lock    a newer message from the same person waits in the receiver's queue: the reply goes back with it, once.

Claims are matched in Ukrainian, Russian and English whatever the agent's language; the reply that goes back is in the
owner's notice language (agent_notice_locale.py, Ukrainian by default) and says whose request it is: the owner's, or
another person's in the chat (from the receiver's record). Never held: replies under MIN_CHARS, «🔄» acknowledgements,
quotes, questions, conditions, negations, «you did», a time named («вчора», «at 14:20»), a refusal that a rule or a
guard requires, a person-only step named after checking the connection, a turn with a helper's report. The three text
checks hold one request once between them (the request: its sender's latest message in this chat or topic); the lock
shows each queued message once and holds one reply at most MAX_HOLDS times in HOLD_WINDOW. A hold is given only after
it is on record, so the same reply never comes back twice for one reason. Any error lets the reply through.

~/.local/state/tg-answer-check: OFF switches the hook off; NO-DONE-CHECK, NO-LAUNCH-CHECK, NO-GIVEUP-CHECK and
NO-SEND-LOCK one check each, without a restart. log.jsonl keeps decisions and their reasons, never text.

Not here: an agent whose own reply-send-lock is hooked keeps it, and this hook stays silent (one mechanism, not two
holds); a subagent's reply passes (its turn is not in the main session record); company sessions have no reply tool,
the host delivers their answer, so this hook never sees them.
"""
import calendar
import contextlib
import fcntl
import hashlib
import importlib.util
import json
import os
import re
import sqlite3
import sys
import time
from pathlib import Path

HOME = Path(os.environ.get("AGENT_ROOT") or Path.home())
CONFIG = Path(os.environ.get("CLAUDE_CONFIG_DIR") or HOME / ".claude")
TELEGRAM_STATE = Path(os.environ.get("TELEGRAM_STATE_DIR") or CONFIG / "channels" / "telegram")
DB = TELEGRAM_STATE / "messages.db"
STATE = HOME / ".local" / "state" / "tg-answer-check"
OFF, LOG, SAVED = STATE / "OFF", STATE / "log.jsonl", STATE / "state.json"
SWITCH = {"done": "NO-DONE-CHECK", "launch": "NO-LAUNCH-CHECK", "giveup": "NO-GIVEUP-CHECK", "lock": "NO-SEND-LOCK"}
TOOLS = "mcp__plugin_telegram_telegram__"
MIN_CHARS = 80  # a shorter reply is conversation and is never held
ACK = "\U0001F504"  # «🔄 Прийняв: …», the kit's acknowledgement
PREV_SECONDS = 600  # what the agent did this long before the request counts for it (the texts say «10 minutes»)
TAIL = 8_000_000  # how much of the session record's end is read
KEEP_SECONDS = 2 * 86400
MAX_HOLDS, HOLD_WINDOW = 3, 600
BOOK_TOOLS = {"ToolSearch", "TodoWrite", "TaskCreate", "TaskUpdate", "TaskList", "TaskGet"}
READ_TOOLS = {"Read", "Grep", "Glob", "BashOutput", "TaskOutput", "Monitor"}
INTERPRETERS = {"python3", "python", "bash", "sh", "node", "timeout", "nice", "env", "exec", "sudo", "cd", "export"}

W = r"[\w'’-]+"
GAP = rf"(?:{W}\s+){{0,2}}?"
DONE_CLAIM = re.compile(
    # Russian: «сделал(а)», «сделано»
    r"(?<![\w-])(?:(?:сделал|настроил|поставил|добавил|обновил|исправил|починил|записал|сохранил|создал|подключил|включил"
    r"|выключил|убрал|удалил|перепроверил|проверил|отправил|опубликовал|выложил|разослал|оплатил|запустил|установил)"
    r"(?:а|о|и)?"
    r"|(?:сделан|настроен|поставлен|добавлен|обновл[её]н|исправлен|починен|записан|сохран[её]н|создан|подключ[её]н"
    r"|включ[её]н|выключ[её]н|убран|удал[её]н|перепроверен|проверен|отправлен|опубликован|выложен|разослан|оплачен"
    r"|запущен|установлен)[аоы]?"
    # Ukrainian: «зробив / зробила / зробили», «зроблено»
    r"|(?:зроби|налаштува|постави|дода|онови|виправи|полагоди|записа|створи|підключи|увімкну|ввімкну|вимкну|прибра"
    r"|видали|перевіри|надісла|відправи|опублікува|розісла|оплати|запусти|встанови)(?:в|ла|ло|ли)|зберіг|зберегл[аои]"
    r"|(?:зроблен|налаштован|поставлен|додан|оновлен|виправлен|полагоджен|записан|збережен|створен|підключен|увімкнен"
    r"|ввімкнен|вимкнен|прибран|видален|перевірен|надіслан|відправлен|опублікован|розіслан|оплачен|запущен|встановлен)"
    r"(?:о|ий|а|е|і))(?![\w-])"
    # English: «I've fixed», «it is fixed», «Done.»
    r"|\bI(?:'ve|’ve|\s+have)?\s+(?:just\s+|now\s+|already\s+)?(?:done\s+it|did\s+it|fixed|set\s+up|configured|added"
    r"|updated|created|saved|connected|enabled|disabled|removed|deleted|checked|verified|double-checked|sent|published"
    r"|posted|paid|installed|started|launched)\b"
    r"|\b(?:is|are|was|were|has\s+been|have\s+been)\s+(?:now\s+|already\s+)?(?:done|fixed|set\s+up|configured|added"
    r"|updated|created|saved|connected|enabled|disabled|removed|deleted|checked|verified|sent|published|posted|paid"
    r"|installed)\b"
    r"|^\s*(?:done|fixed|sent)\b(?=\s*[.!:—-])", re.I | re.M)
RUNNABLE = (r"(?:сторож|задач|завданн|рендер|поиск|пошук|прог[оі]н|процесс?|проверк|перевірк|монтаж|сборк|збірк|выгрузк"
            r"|вивантаж|скрипт|программ|програм|напоминани|нагадуван|рассылк|розсилк|помощник|помічник|воркер|таймер)\w*")
RUNS = r"(?:работа[ею]т|ид[её]т|идут|крутится|працю[єю]|працюють|йде|іде|йдуть|ідуть|крутиться)"
LAUNCH_CLAIM = re.compile(
    r"(?<![\w-])(?:запустил\w*|запусти(?:в|ла|ли)|запущен\w*"
    rf"|поставил\w*\s+{GAP}{RUNNABLE}|постави(?:в|ла|ли)\s+{GAP}{RUNNABLE}"
    rf"|поставлен\w*\s+{GAP}(?:в|на|у)\s+(?:расписани|розклад|cron|крон|очеред|черг)\w*"
    rf"|{RUNNABLE}\s+{GAP}(?:{RUNS}|запущен\w*|сто[ия]т|сто[їя]ть)(?![\w-])"
    rf"|{RUNS}\s+(?:{W}\s+)?{RUNNABLE})"
    r"|\bI(?:'ve|’ve|\s+have)?\s+(?:just\s+|now\s+)?(?:started|launched|kicked\s+off|scheduled|queued|restarted|resumed)\b"
    r"|\b(?:is|are)\s+(?:now\s+|still\s+)?(?:running|in\s+progress|under\s*way|scheduled|queued)\b"
    r"|\b(?:running|working)\s+in\s+the\s+background\b", re.I)
ACTS = (r"(?:открыть|зайти|войти|скачать|выгрузить|отправить|опубликовать|сделать|проверить|достать|получить|загрузить"
        r"|прочитать|посмотреть|остановить|запустить|поставить|найти|подключить|відкрити|увійти|завантажити|скачати"
        r"|вивантажити|надіслати|відправити|опублікувати|зробити|перевірити|дістати|отримати|прочитати|подивитися"
        r"|зупинити|запустити|поставити|знайти|підключити)")
KNOWING = (r"(?:сказать|судить|гарантир\w*|утвержд\w*|обеща\w*|знать|понять|оценить|подтверд\w*|точно|не|сказати|судити"
           r"|гарантува\w*|стверджува\w*|обіця\w*|знати|зрозуміти|оцінити|підтверди\w*)")
