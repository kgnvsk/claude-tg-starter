EARLIER = re.compile(
    r"(?<![\w-])(?:вчера|позавчера|раньше|ранее|прежде|недавно|на\s+днях|утром|дн[её]м|вечером|ночью|с\s+утра|тогда"
    r"|в\s+прошл\w+\s+раз|на\s+прошл\w+\s+недел\w*|до\s+этого|ещ[её]\s+в|вчора|учора|позавчора|раніше|нещодавно|днями"
    r"|вранці|зранку|вдень|ввечері|уночі|вночі|тоді|минулого\s+(?:разу|тижня)|до\s+цього|ще\s+в|yesterday|earlier"
    r"|previously|recently|this\s+morning|last\s+(?:night|time|week)"
    r"|\d+\s+(?:минут\w*|час\w*|дн\w+|недел\w+|хвилин\w*|годин\w*|тижн\w+|minutes?|hours?|days?|weeks?)"
    r"\s+(?:назад|тому|ago))(?![\w-])|(?<!\d)\d{1,2}[:.]\d{2}(?!\d)", re.I)
START_BG = re.compile(r"\bnohup\b|\bsetsid\b|\bdisown\b|\bsystemd-run\b|\bscreen\s+-\w*d|\btmux\s+new\S*\s[^\n]*-d\b"
                      r"|(?<![&>|<\d])&(?![&>])")
START_TASK = re.compile(r"\breminder-task\s+(?:one|repeat|sequence)\b|\|\s*crontab\s+-(?![\w-])|\bcrontab\s+(?!-)[^\s|;&]+")
READ_CMD = re.compile(
    r"(?<![\w-])(?:ps|pgrep|pidof|jobs|tail|head|cat|less|grep|egrep|rg|ls|stat|wc|du|find|file|ffprobe|test|journalctl)"
    r"(?![\w-])|\[\s+-[efsd]\s|\bsystemctl\s+(?:status|is-active)\b|\breminder-task\s+(?:status|delivery-status)\b"
    r"|\bcrontab\s+-l\b")
STATUS_CMD = re.compile(r"(?<![\w-])(?:status|doctor|whoami|accounts?|check|ping|health|auth\s+(?:list|status)|--help|help|-h)"
                        r"(?![\w-])|\bsystemctl\s+(?:status|is-active)\b|\bcurl\s+-\w*I\b", re.I)
FIX_CMD = re.compile(r"(?<![\w-])(?:install|pip3?|npm|npx|apt(?:-get)?|brew|chmod|chown|mkdir|ln|cp|mv|tee|login|logout|auth"
                     r"|connect|reconnect|relogin|refresh|enable|disable|restart|reset|repair|fix|setup|configure|config"
                     r"|init|token)(?![\w-])|\bsed\s+-\w*i|\bset-\w+|(?<![<>&=-])\d?>\s*(?!/dev/null)[~/$\w]", re.I)
CHAT_READ = re.compile(r"\b(?:transcribe-telegram|memory-search|memory-open)\b|messages\.db|channels/telegram/inbox")

