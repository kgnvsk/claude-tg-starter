#!/usr/bin/env python3
"""Select only a ledger-bound Telegram session with a verified local transcript."""
from __future__ import annotations

import json
import os
from pathlib import Path
import re
import sqlite3
import sys


class LegacySession(Exception):
    """The last session is not proven to belong to callback tracking; the receiver would refuse its background work."""


def proven_current(connection: sqlite3.Connection, session: str) -> bool:
    """True only when neither of the receiver's two startup rules (telegram-server-fixed.ts,
    delivery_legacy_native_sessions: by results and by origins) would mark this session, and it is not marked. No such
    evidence, as before the first receiver with callback tracking ever started, is no proof (Codex 01.11: the first update
    resumed such a session, and a result adopted under a newer stamp kept its older turn; both were then refused)."""
    try:
        return connection.execute(
            "SELECT 1 FROM delivery_native_session_origins o "
            "LEFT JOIN delivery_runtime e ON e.key='callback_ledger_epoch:' || o.stamp "
            "WHERE o.session_id=? AND NOT (o.source IN ('resume','compact') AND o.inherited=0) "
            "AND ((o.source IS 'startup' AND o.inherited=0 AND e.value IS NOT NULL AND CAST(e.value AS INTEGER)>0) "
            "OR (o.stamp IS NOT NULL AND e.value IS NOT NULL AND CAST(e.value AS INTEGER)>0 "
            "AND o.started_at IS NOT NULL AND o.started_at>CAST(e.value AS INTEGER))) "
            "AND NOT EXISTS (SELECT 1 FROM delivery_legacy_native_sessions l WHERE l.session_id=o.session_id) "
            "AND NOT EXISTS (SELECT 1 FROM delivery_results r "
            "LEFT JOIN delivery_runtime re ON re.key='callback_ledger_epoch:' || r.stamp "
            "LEFT JOIN delivery_turns t ON t.turn_id=r.turn_id AND t.session_id=r.session_id "
            "WHERE r.session_id=o.session_id AND (r.stamp IS NULL OR re.value IS NULL "
            "OR CAST(re.value AS INTEGER)<=0 "
            "OR (t.turn_id IS NULL AND r.state NOT IN ('complete','no_reply','cancelled','failed')) "
            "OR (t.turn_id IS NOT NULL AND (t.opened_at IS NULL OR t.opened_at<=CAST(re.value AS INTEGER))))) "
            "LIMIT 1", (session,)
        ).fetchone() is not None
    except sqlite3.OperationalError as error:
        if 'no such table' not in str(error):
            raise
        return False


def select_session(config: Path, state: Path, workspace: Path, *, receiver: bool = False) -> str | None:
    connection = sqlite3.connect(f'file:{state / "messages.db"}?mode=ro', uri=True, timeout=3)
    try:
        row = connection.execute(
            "SELECT t.session_id, coalesce(t.transcript_path,s.transcript_path) "
            "FROM delivery_turns t JOIN delivery_sessions s ON s.session_id=t.session_id "
            "WHERE s.stamp IS NOT NULL AND EXISTS "
            "(SELECT 1 FROM delivery_turn_messages m WHERE m.turn_id=t.turn_id) "
            "ORDER BY t.opened_at DESC,t.turn_id DESC LIMIT 1"
        ).fetchone()
        # Under the receiver only a session proven current resumes; any other starts fresh (an update moves earlier
        # agents to the receiver, owner 01.11.2026).
        if receiver and row and isinstance(row[0], str) and not proven_current(connection, row[0]):
            raise LegacySession
    finally:
        connection.close()
    if not row or not isinstance(row[0], str) or not re.fullmatch(
        r'[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}', row[0]
    ) or not row[1]:
        return None
    session, raw_path = row
    projects = (config / 'projects').resolve(strict=True)
    transcript = Path(raw_path).resolve(strict=True)
    transcript.relative_to(projects)
    if not transcript.is_file() or transcript.name != session + '.jsonl':
        return None
    expected_cwd = workspace.resolve(strict=True)
    # No transcript text leaves this process. Metadata may follow an initial
    # snapshot, but an unbounded read must never delay the service launch.
    with transcript.open('r', encoding='utf-8') as handle:
        budget = 1024 * 1024
        for _ in range(256):
            line = handle.readline(min(budget + 1, 128 * 1024))
            if not line:
                break
            budget -= len(line.encode('utf-8'))
            if budget < 0 or not line.endswith('\n'):
                return None
            try:
                record = json.loads(line)
            except (ValueError, TypeError):
                continue
            if not isinstance(record, dict) or record.get('sessionId') != session:
                continue
            cwd = record.get('cwd')
            if isinstance(cwd, str) and Path(cwd).is_absolute() and Path(cwd).resolve() == expected_cwd:
                return session
    return None


def main() -> None:
    config = Path(os.environ.get('CLAUDE_CONFIG_DIR') or Path.home() / '.claude')
    state = Path(os.environ.get('TELEGRAM_STATE_DIR') or config / 'channels/telegram')
    try:
        session = select_session(config, state, Path.cwd(),
                                 receiver=os.environ.get('TG_DELIVERY_AUTHORITY') == 'receiver')
    except LegacySession:
        print('telegram launcher: the last session predates delivery receipts; starting fresh', file=sys.stderr)
        return
    except (OSError, ValueError, sqlite3.Error):
        session = None
    if session:
        print(session)
    else:
        # Exactly one bounded diagnostic; never include paths, content or SQL.
        print('telegram launcher: no verified bot session; starting fresh with durable recovery', file=sys.stderr)


if __name__ == '__main__':
    main()
