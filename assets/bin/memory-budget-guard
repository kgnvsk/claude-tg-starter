#!/usr/bin/env python3
"""Keep the always-injected memory cores whole and within their limits: the agent edits them itself, with Edit or
Write; a shell may not touch them."""

from pathlib import Path
import hashlib
import json
import os
import re
import sys


HOME = Path(os.environ.get("HOME") or "/home/claude").expanduser().resolve()
CORE_PATHS = {
    (HOME / ".claude/memory/USER.md").resolve(),
    (HOME / ".claude/memory/MEMORY.md").resolve(),
}
MEMORY_DIR = (HOME / ".claude/memory").resolve()
USER_PATH = (HOME / ".claude/memory/USER.md").resolve()
FIRST_CONTACT_MARKER = HOME / ".claude/memory/first-contact.done"
STOCK_USER_SENTINEL = "Keep this file under 1,375 characters."
USER_CHAR_LIMIT = 1375
# Only shell forms that change files count as mutation. Reading the memory
# directory with sed -n, python3, bash -c cat or ls 2>/dev/null is fine — the
# guard protects the always-injected cores from silent edits, not from being
# looked at.
SHELL_MUTATION_RE = re.compile(
    r"(?<![0-9&])>>?(?!&)|"
    r"\b(?:tee|truncate|rm|mv|cp|ln|link|unlink|install|touch|dd|sponge|shred)\b|"
    r"\bsed\s+(?:-[A-Za-z]*i|--in-place)\b|"
    r"\bperl\s+-[A-Za-z]*i\b",
    re.IGNORECASE,
)


def normalize_path(value: object) -> Path | None:
    if not isinstance(value, str) or not value:
        return None
    expanded = (
        value.replace("${HOME}", str(HOME))
        .replace("$HOME", str(HOME))
        .replace("~", str(HOME), 1)
    )
    try:
        return Path(expanded).expanduser().resolve()
    except OSError:
        return None


def first_fill_allowed(tool_input: dict) -> bool:
    """The owner's profile may be written once, during the first conversation:
    the core is still the stock template, so there is nothing to review yet."""
    if FIRST_CONTACT_MARKER.exists():
        return False
    try:
        current = USER_PATH.read_text(encoding="utf-8")
    except OSError:
        return False
    if STOCK_USER_SENTINEL not in current:
        return False
    content = tool_input.get("content")
    return isinstance(content, str) and len(content) <= USER_CHAR_LIMIT


CORE_LIMITS = {USER_PATH: USER_CHAR_LIMIT, (HOME / ".claude/memory/MEMORY.md").resolve(): 2200}
# The installer's own templates, whitespace aside (the fingerprints wiki-hot-inject has; tests keep both sets equal to
# the kit's templates). A core that still is one holds nothing of the agent's, so its first map may be far shorter
# than the template (478 characters).
STOCK_TEMPLATES = {"e136f640cfd1070f", "8986e8c0fda8270c", "2c862e867b35b68c"}


def direct_write_refusal(tool_name: str, tool_input: dict, path: Path) -> str:
    """Why this direct write may not pass; empty when it may. Memory v2 (owner, 14.11.2026): the agent keeps its own
    cores, as Hermes and OpenClaw agents do - a core nobody was allowed to write stayed an empty template for weeks
    (Arti). A write passes while the result stays within the core's limit and most of the core's lines stay."""
    try:
        current = path.read_text(encoding="utf-8")
    except OSError:
        current = ""
    if tool_name == "Write":
        result = tool_input.get("content")
    else:
        edits = tool_input.get("edits") if tool_name == "MultiEdit" else [tool_input]
        result = current
        for edit in edits if isinstance(edits, list) else []:
            old, new = (edit or {}).get("old_string"), (edit or {}).get("new_string")
            if not isinstance(old, str) or not isinstance(new, str) or old not in result:
                return ""  # the tool itself refuses an edit that does not apply
            result = result.replace(old, new) if (edit or {}).get("replace_all") else result.replace(old, new, 1)
    if not isinstance(result, str):
        return ""
    limit = CORE_LIMITS[path]
    if len(result) > limit:
        return (f"The result would be {len(result)} characters and this core holds {limit}. In the same edit shorten, "
                "merge or remove stale lines so that the whole file fits.")
    stock = hashlib.sha256(" ".join(current.split()).encode("utf-8")).hexdigest()[:16] in STOCK_TEMPLATES
    # By the lines that stay, not by the length: a rewrite of the same size loses every fact just as well.
    lines = [row.strip() for row in current.splitlines() if row.strip()]
    if not stock and len(current.strip()) > 400 and sum(1 for row in lines if row in result) < 0.4 * len(lines):
        return ("This edit would throw away most of the core. Remove stale lines a few at a time; a full rewrite needs "
                "the owner's explicit word.")
    return ""


def refuse(reason: str) -> None:
    print(json.dumps({"decision": "block", "reason": "Core memory edit not applied. " + reason}))


def main() -> None:
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError):
        return

    tool_name = str(payload.get("tool_name") or "")
    tool_input = payload.get("tool_input") or {}
    if not isinstance(tool_input, dict):
        return

    if tool_name == "Bash":
        command = str(tool_input.get("command") or "")
        normalized = (
            command.replace("${HOME}", str(HOME))
            .replace("$HOME", str(HOME))
            .replace("~", str(HOME))
        )
        references_memory_dir = re.search(
            rf"(?<![\w./-]){re.escape(str(MEMORY_DIR))}(?![\w./-])",
            normalized,
        )
        references_core = any(
            re.search(
                rf"(?<![\w./-]){re.escape(str(path))}(?![\w./-])",
                normalized,
            )
            for path in CORE_PATHS
        )
        if (references_memory_dir or references_core) and SHELL_MUTATION_RE.search(
            normalized
        ):
            refuse("A shell may not change the memory directory: edit USER.md or MEMORY.md with Edit or Write, "
                   "within the file's limit.")
        return

    if tool_name not in {"Edit", "Write", "MultiEdit"}:
        return
    path = normalize_path(tool_input.get("file_path") or tool_input.get("path"))
    if path == USER_PATH and tool_name == "Write" and first_fill_allowed(tool_input):
        return
    if path in CORE_PATHS:
        refusal = direct_write_refusal(tool_name, tool_input, path)
        if refusal:
            refuse(refusal)


if __name__ == "__main__":
    main()
