#!/usr/bin/env python3
# Claude hook that re-grounds the model on every Telegram turn and immediately
# after compaction with:
#   1. CURRENT MOMENT: fresh date/weekday/time in the owner's timezone. Long
#      --continue sessions otherwise reuse a stale "today" from days ago.
#   2. Last N messages of the CURRENT chat from the plugin's messages.db
#      (per-chat, both directions) — survives compaction/restart and keeps
#      Telegram chats separated. Durable global facts come from bounded
#      MEMORY/USER/hot files; no mixed-chat snapshot is injected.
#
# Reads hook JSON from stdin, prints hookSpecificOutput JSON. Fails open:
# any error → plain {"continue": true} so a broken hook never blocks a turn.
import json
import hashlib
import os
import re
import sqlite3
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

# ATARAX_SUPPRESS_TELEGRAM=1 marks a session that must not touch Telegram
# (nested claude -p workers, cron sessions). Injecting the owner's private chat
# there leaks his conversation into non-owner contexts and hands them his
# chat_id — skip entirely.
if os.environ.get("ATARAX_SUPPRESS_TELEGRAM") == "1":
    print(json.dumps({"continue": True}))
    sys.exit(0)

CONFIG_ROOT = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
TELEGRAM_STATE = Path(
    os.environ.get("TELEGRAM_STATE_DIR") or CONFIG_ROOT / "channels" / "telegram"
)
DB = TELEGRAM_STATE / "messages.db"
N_MSGS = 30
MSG_CAP = 2000
CONTEXT_CAP = 12000
# The CLI passes a hook's context on whole only up to 10 000 characters; a longer one goes to a file and the model
# gets its first 2 KB, which is the oldest end of the chat (Manzik, 02.10.2026: 61 of 139 turns).
HOOK_CONTEXT_CAP = 9500
CLI_HOOK_CONTEXT_LIMIT = 10000
TRANSCRIPT_TAIL_CAP = 8_000_000
PROJECTS_ROOT = CONFIG_ROOT / "projects"

_CHAT_RE = re.compile(r'<channel\s[^>]*?chat_id=["\']?(-?\d+)', re.IGNORECASE)
_MSGID_RE = re.compile(r'message_id=["\']?(\d+)', re.IGNORECASE)
_CHANNEL_OPEN_RE = re.compile(
    r"\A<channel(?P<attrs>(?:\s+[A-Za-z_:][A-Za-z0-9_.:-]*\s*=\s*"
    r"(?:\"[^\"]*\"|'[^']*'))+)\s*>",
    re.DOTALL,
)
_CHANNEL_ATTR_RE = re.compile(
    r"\s+([A-Za-z_:][A-Za-z0-9_.:-]*)\s*=\s*(?:\"([^\"]*)\"|'([^']*)')"
)
_TELEGRAM_SOURCE = "plugin:telegram:telegram"
_TELEGRAM_BLOCK_REASON = (
    "Не вдалося підтвердити передачу збереженого Telegram-повідомлення. "
    "Не виконуй його без чинного claim: приймач повторить передачу."
)


def channel_envelope_attributes(prompt: str) -> dict[str, str] | None:
    if not prompt.startswith("<channel"):
        return None
    match = _CHANNEL_OPEN_RE.match(prompt)
    if not match:
        raise ValueError("invalid channel envelope")
    raw = match.group("attrs")
    attrs = {}
    position = 0
    while position < len(raw):
        attribute = _CHANNEL_ATTR_RE.match(raw, position)
        if not attribute:
            raise ValueError("invalid channel attribute")
        name = attribute.group(1)
        if name in attrs:
            raise ValueError("duplicate channel attribute")
        attrs[name] = attribute.group(2) if attribute.group(2) is not None else attribute.group(3)
        position = attribute.end()
    return attrs


def is_non_telegram_channel_envelope(prompt: str) -> bool:
    try:
        attrs = channel_envelope_attributes(prompt)
    except ValueError:
        return False
    source = attrs.get("source") if attrs is not None else None
    return bool(source and not source.startswith("plugin:telegram"))


# ── turn ledger (added 2026-09-19) ───────────────────────────────────────────
# The receiver owns the schema; this hook only records which turn of which
# session took which delivery. TG_DELIVERY_AUTHORITY sets how strict the record
# is: `receiver` — the claim and the turn record are one transaction and a
# failure blocks the turn exactly like a failed claim; `guard` (default) and
# `shadow` — the claim runs as before and the turn record is a separate
# best-effort write that is logged and never blocks. A prompt that is not a
# channel envelope (task notification, subagent return, the owner typing)
# continues the session's open turn or opens one without messages.
DB_TIMEOUT = 3.0
AUTHORITY = os.environ.get("TG_DELIVERY_AUTHORITY") or "guard"
AGENT_ROOT = Path(os.environ.get("AGENT_ROOT", str(Path.home())))
LEDGER_LOG = AGENT_ROOT / "logs" / "tg-context-inject.log"
LEDGER_TABLES = ("delivery_sessions", "delivery_turns", "delivery_turn_messages")


def ledger_log(message: str) -> None:
    try:
        LEDGER_LOG.parent.mkdir(parents=True, exist_ok=True)
        with LEDGER_LOG.open("a", encoding="utf-8") as handle:
            handle.write(f"{datetime.now().astimezone().isoformat(timespec='seconds')} {message}\n")
    except OSError:
        pass


def ledger_connect() -> sqlite3.Connection:
    # Autocommit connection: every write below is one explicit BEGIN IMMEDIATE.
    return sqlite3.connect(f"file:{DB}?mode=rw", uri=True, timeout=DB_TIMEOUT, isolation_level=None)


def ledger_present(conn: sqlite3.Connection) -> bool:
    marks = ",".join("?" * len(LEDGER_TABLES))
    (found,) = conn.execute(
        f"SELECT count(*) FROM sqlite_master WHERE type='table' AND name IN ({marks})",
        LEDGER_TABLES,
    ).fetchone()
    return found == len(LEDGER_TABLES)


def results_present(conn: sqlite3.Connection) -> bool:
    return conn.execute(
        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='delivery_results'"
    ).fetchone() is not None


def rollback(conn: sqlite3.Connection | None) -> None:
    if conn is not None and conn.in_transaction:
        try:
            conn.execute("ROLLBACK")
        except sqlite3.Error:
            pass


def session_of(data: dict) -> dict | None:
    session_id = data.get("session_id")
    if not isinstance(session_id, str) or not session_id:
        return None
    transcript_path = data.get("transcript_path")
    return {
        "session_id": session_id,
        "transcript_path": transcript_path if isinstance(transcript_path, str) else None,
    }


def open_turn(conn: sqlite3.Connection, session: dict, now: int) -> int:
    """The session's open turn, or a new one: at most one open turn per session."""
    row = conn.execute(
        "SELECT turn_id FROM delivery_turns WHERE session_id=? AND closed_at IS NULL "
        "ORDER BY turn_id DESC LIMIT 1",
        (session["session_id"],),
    ).fetchone()
    if row:
        return row[0]
    # The SessionStart hook can fire before the receiver has created the ledger
    # (service start: CLI first, plugin a moment later), so the session row may
    # be missing; a turn without its session has no stamp and can never be
    # replaced by the next service life. Record the session here, once.
    conn.execute(
        "INSERT OR IGNORE INTO delivery_sessions (session_id, started_at, transcript_path, source, stamp) "
        "VALUES (?,?,?,?,?)",
        (session["session_id"], now, session["transcript_path"], "claim",
         os.environ.get("TG_DELIVERY_STAMP") or None),
    )
    return conn.execute(
        "INSERT INTO delivery_turns (session_id, transcript_path, opened_at) VALUES (?,?,?)",
        (session["session_id"], session["transcript_path"], now),
    ).lastrowid


def take_delivery(
    conn: sqlite3.Connection, session: dict, delivery_id: str, chat_id: str, thread_id: str | None, now: int,
) -> None:
    turn_id = open_turn(conn, session, now)
    conn.execute(
        "INSERT OR IGNORE INTO delivery_turn_messages (turn_id, delivery_id, chat_id, thread_id, taken_at) "
        "VALUES (?,?,?,?,?)",
        (turn_id, delivery_id, chat_id, thread_id, now),
    )
    # A transport receipt may release the inbound queue before the promised
    # result exists. Keep that obligation under its original delivery identity.
    # Old receivers have no result table and keep the previous hook contract.
    if results_present(conn):
        columns = {row[1] for row in conn.execute("PRAGMA table_info(delivery_results)")}
        if "request_payload" in columns:
            # Claim and rebind are one transaction in every authority mode.
            # The old turn remains in the ledger; late results cannot complete
            # this new attempt because every sender also matches turn + stamp.
            payload = conn.execute(
                "SELECT payload FROM pending_inbound_deliveries WHERE delivery_id=?", (delivery_id,),
            ).fetchone()
            conn.execute(
                "INSERT INTO delivery_results "
                "(delivery_id,turn_id,session_id,stamp,chat_id,thread_id,state,request_payload,created_at,updated_at) "
                "VALUES (?,?,?,?,?,?,'pending',?,?,?) ON CONFLICT(delivery_id) DO UPDATE SET "
                "turn_id=excluded.turn_id, session_id=excluded.session_id, stamp=excluded.stamp, "
                "state='pending', response_turn_id=NULL, task_id=NULL, resume_after=0, "
                "updated_at=excluded.updated_at, finished_at=NULL, "
                "result_generation=delivery_results.result_generation+1, "
                "request_payload=COALESCE(delivery_results.request_payload,excluded.request_payload) "
                "WHERE delivery_results.state IN ('queued','resume_pending','paused')",
                (delivery_id, turn_id, session["session_id"], os.environ.get("TG_DELIVERY_STAMP") or None,
                 chat_id, thread_id, payload[0] if payload else None, now, now),
            )
            return
        conn.execute(
            "INSERT OR IGNORE INTO delivery_results "
            "(delivery_id, turn_id, session_id, stamp, chat_id, thread_id, state, created_at, updated_at) "
            "VALUES (?,?,?,?,?,?,'pending',?,?)",
            (delivery_id, turn_id, session["session_id"], os.environ.get("TG_DELIVERY_STAMP") or None,
             chat_id, thread_id, now, now),
        )


def claim_telegram_delivery(prompt: str, data: dict) -> bool:
    try:
        attrs = channel_envelope_attributes(prompt)
    except ValueError:
        return False
    if attrs is None or attrs.get("source") != _TELEGRAM_SOURCE:
        return False
    chat_id = attrs.get("chat_id")
    message_id = attrs.get("message_id")
    delivery_id = attrs.get("delivery_id")
    if (
        not chat_id
        or not message_id
        or not re.fullmatch(r"-?\d+", chat_id)
        or not re.fullmatch(r"\d+", message_id)
    ):
        return False
    expected_delivery_id = f"{chat_id}:{message_id}"
    if delivery_id is None:
        delivery_id = expected_delivery_id
    elif delivery_id != expected_delivery_id:
        return False
    thread_id = attrs.get("thread_id") or None
    session = session_of(data)
    now = int(time.time() * 1000)

    conn = None
    try:
        conn = ledger_connect()
        conn.execute("BEGIN IMMEDIATE")
        if results_present(conn) and conn.execute(
            "SELECT 1 FROM delivery_results WHERE delivery_id=? AND state IN ('complete','no_reply','cancelled','failed')",
            (delivery_id,),
        ).fetchone():
            rollback(conn)
            return False
        claimed = conn.execute(
            "UPDATE pending_inbound_deliveries "
            "SET state='started', next_attempt_at=0, started_at=? "
            "WHERE delivery_id=? AND state='offered'",
            (now, delivery_id),
        ).rowcount == 1
        if not claimed:
            rollback(conn)
            return False
        record = ledger_present(conn)
        if not record:
            ledger_log(f"ledger tables missing; {delivery_id} claimed without a turn record")
        elif session is None:
            record = False
            ledger_log(f"no session_id in hook input; {delivery_id} claimed without a turn record")
        elif AUTHORITY == "receiver" or (
            results_present(conn) and "request_payload" in
            {row[1] for row in conn.execute("PRAGMA table_info(delivery_results)")}
        ):
            take_delivery(conn, session, delivery_id, chat_id, thread_id, now)
            record = False  # Already recorded atomically; no second shadow claim.
        conn.execute("COMMIT")
        if record and AUTHORITY != "receiver":
            try:
                conn.execute("BEGIN IMMEDIATE")
                take_delivery(conn, session, delivery_id, chat_id, thread_id, now)
                conn.execute("COMMIT")
            except sqlite3.Error as error:
                rollback(conn)
                ledger_log(f"turn record failed after claim of {delivery_id}: {error}")
        return True
    except sqlite3.Error as error:
        rollback(conn)
        ledger_log(f"claim of {delivery_id} failed: {error}")
        return False
    finally:
        if conn is not None:
            conn.close()


# The ID the CLI gives a tool call it moved to the background (its kind «mcp_task»): «k» and eight
# characters, as the CLI's own table of task kinds has it (b command, a agent, m monitor, k this one).
# No request launches such a task, and it cannot be registered before its notice names it.
CLI_TOOL_CALL_TASK = re.compile(r"k[0-9a-z]{8}")


def task_notification_id(prompt: str) -> str | None:
    # Only a native notification envelope is eligible. In particular, never
    # search within a channel body, quoted text, or another plugin's envelope.
    match = re.fullmatch(
        r"<task-notification>\s*<task-id>([A-Za-z0-9_-]{1,128})</task-id>.*</task-notification>",
        prompt, re.DOTALL,
    )
    if not match or prompt.count("<task-id>") != 1 or prompt.count("</task-notification>") != 1:
        return None
    return match.group(1)


def return_callback(conn: sqlite3.Connection, session_id: str, stamp: str, turn_id: int,
                    task_id: str, prompt: str, now: int) -> list[dict]:
    """Resolve a native notification by the obligation of its exact launch.

    The owner row of (session, stamp, task_id) is open and the notice's
    <tool-use-id> is its launch_ref; a task registered with no recorded launch
    returns by its bound task ID. Only then the obligation is returned, the
    return is written with its request and occurrence, and that request is
    reopened; a paused one keeps its pause and is only named. A request-less
    obligation returns without reopening anything. Anything else (a legacy
    obligation, an earlier occurrence, another stamp, a replay) is unbound and
    visible. `killed` confirms a stop: the obligation is stopped, and it is
    neither a return nor a reopening.
    """
    launch = re.search(r"<tool-use-id>([^<]{1,256})</tool-use-id>", prompt)
    launch = launch.group(1) if launch else None
    prompt_hash = hashlib.sha256(prompt.encode("utf-8")).hexdigest()
    owner = conn.execute(
        "SELECT delivery_id, state, launch_ref, occurrence, launched_turn FROM delivery_task_owners "
        "WHERE session_id=? AND stamp=? AND task_id=?", (session_id, stamp, task_id),
    ).fetchone()
    if launch is None and owner is None and CLI_TOOL_CALL_TASK.fullmatch(task_id) and not conn.execute(
            "SELECT 1 FROM delivery_task_owners WHERE session_id=? AND task_id=? LIMIT 1", (session_id, task_id)).fetchone():
        # Арти, 02.10.2026: a reply with two 49 MB videos outlasted the 120 s an MCP call may stay
        # silent. The CLI had moved the call to the background as a task of its own and reported
        # its failure in this same envelope. Written down as a worker's return nobody could place,
        # it made the receiver demand a delivery_id of the next reply, the guard refuse Stop, and
        # the sweep keep an answered request at the head of the queue. A worker's callback that
        # names no tool call and has no owner (a registration that failed, a callback restored
        # after a restart) is still recorded: only the CLI's own kind is let go.
        return []
    exact = owner is not None and owner[1] in ("owned", "unowned") and (
        owner[2] == launch if owner[2] is not None else owner[1] == "owned")
    if re.search(r"<status>killed</status>", prompt):
        if not exact:
            return []
        conn.execute("UPDATE delivery_task_owners SET state='stopped' WHERE session_id=? AND stamp=? "
                     "AND task_id=? AND state=?", (session_id, stamp, task_id, owner[1]))
        # Codex U4 review P1-5: a stop is no return, but a request no other worker holds is
        # owed its final now, in this turn, as every mode bound this notice before U4.
        # Otherwise the worker still running answers it.
        delivery = owner[0] if owner[1] == "owned" else launch_turn_request(conn, session_id, stamp, owner[4])
        request = conn.execute(
            "SELECT chat_id, thread_id, state, turn_id, response_turn_id FROM delivery_results "
            "WHERE delivery_id=? AND session_id=? AND stamp=?", (delivery, session_id, stamp),
        ).fetchone() if delivery else None
        if request is None or request[2] not in ("pending", "deferred") or conn.execute(
                "SELECT 1 FROM delivery_task_launches WHERE session_id=? AND stamp=? AND state='launching' "
                "AND launched_turn IN (?, ?) AND silent_notified_at IS NULL "
                "UNION ALL SELECT 1 FROM delivery_task_owners WHERE session_id=? AND stamp=? "
                "AND ((state IN ('owned','legacy') AND delivery_id=?) OR (state='unowned' AND launched_turn IN (?, ?))) "
                "AND silent_notified_at IS NULL LIMIT 1",
                (session_id, stamp, request[3], request[4], session_id, stamp, delivery, request[3], request[4]),
        ).fetchone():
            return []
        return reopen_request(conn, delivery, request, turn_id, now)
    # A replayed notification never returns an obligation a second time.
    exact = exact and not conn.execute(
        "SELECT 1 FROM delivery_task_returns WHERE session_id=? AND stamp=? AND task_id=? AND prompt_hash=? LIMIT 1",
        (session_id, stamp, task_id, prompt_hash),
    ).fetchone()
    delivery = owner[0] if exact else None
    if exact and owner[1] == "unowned" and owner[4] is not None:
        delivery = launch_turn_request(conn, session_id, stamp, owner[4])
        exact = delivery is not None
    if exact:
        conn.execute("UPDATE delivery_task_owners SET state='returned', delivery_id=? WHERE session_id=? "
                     "AND stamp=? AND task_id=? AND state=?", (delivery, session_id, stamp, task_id, owner[1]))
    conn.execute(
        "INSERT INTO delivery_task_returns "
        "(session_id,stamp,turn_id,task_id,prompt_hash,delivery_id,observed_at,occurrence) VALUES (?,?,?,?,?,?,?,?)",
        (session_id, stamp, turn_id, task_id, prompt_hash, delivery, now, owner[3] if exact else None),
    )
    # Retain only unmatched returns: a returned task may be resumed and
    # registered again, and an unmatched callback must not be lost before a retry.
    conn.execute("DELETE FROM delivery_unbound_task_returns WHERE observed_at < ?", (now - 14 * 24 * 60 * 60 * 1000,))
    if exact:
        conn.execute("DELETE FROM delivery_unbound_task_returns WHERE task_id=? AND session_id=? AND stamp=?",
                     (task_id, session_id, stamp))
    else:
        conn.execute(
            "INSERT INTO delivery_unbound_task_returns (task_id,session_id,stamp,observed_at) VALUES (?,?,?,?) "
            "ON CONFLICT(task_id,session_id,stamp) DO UPDATE SET observed_at=excluded.observed_at",
            (task_id, session_id, stamp, now),
        )
    request = conn.execute(
        "SELECT chat_id, thread_id, state FROM delivery_results WHERE delivery_id=? AND session_id=? AND stamp=?",
        (delivery, session_id, stamp),
    ).fetchone() if delivery else None
    if request is None or request[2] not in ("pending", "deferred", "complete", "paused", "resume_pending"):
        return []
    if request[2] == "complete" and AUTHORITY != "receiver":
        # Codex U4 review P0-2: guard and shadow sent this final themselves while the
        # worker still ran. Its late callback keeps the evidence above but owes no second
        # answer there; what the receiver would do is recorded.
        if conn.execute("SELECT 1 FROM sqlite_master WHERE name='delivery_shadow' AND type='table'").fetchone():
            conn.execute(
                "INSERT OR IGNORE INTO delivery_shadow (created_at,class,chat_id,thread_id,delivery_id,turn_id,detail) "
                "VALUES (?,'would_reopen_completed',?,?,?,?,?)", (now, request[0], request[1], delivery, turn_id, task_id))
        return []
    if request[2] in ("pending", "deferred", "complete"):
        # The callback's result is owed now, in this turn. Under the receiver a final
        # that went out while this worker still ran does not answer it.
        return reopen_request(conn, delivery, request, turn_id, now)
    return [{"delivery_id": delivery, "chat_id": request[0], "thread_id": request[1]}]


def launch_turn_request(conn: sqlite3.Connection, session_id: str, stamp: str, launched_turn: int | None) -> str | None:
    """No progress registered the worker: under the receiver it belongs to the one open
    request of the turn it was launched in, like a deferral (B0-a)."""
    if AUTHORITY != "receiver" or launched_turn is None:
        return None
    open_requests = conn.execute(
        "SELECT delivery_id FROM delivery_results WHERE session_id=? AND stamp=? "
        "AND state IN ('pending','deferred') AND (turn_id=? OR response_turn_id=?)",
        (session_id, stamp, launched_turn, launched_turn),
    ).fetchall()
    return open_requests[0][0] if len(open_requests) == 1 else None


def reopen_request(conn: sqlite3.Connection, delivery: str, request: tuple, turn_id: int, now: int) -> list[dict]:
    """The request is owed its final in this turn. An ACK of an older final kept for the
    calls of its turn is evidence from here on (P2-2)."""
    acked = "superseded_ack" in {row[1] for row in conn.execute("PRAGMA table_info(delivery_results)")}
    conn.execute(
        "UPDATE delivery_results SET state='pending', response_turn_id=?, finished_at=NULL, "
        "result_generation=result_generation+1, updated_at=?"
        + (", superseded_by=NULL, superseded_ack=NULL" if acked else "") + " WHERE delivery_id=?",
        (turn_id, now, delivery),
    )
    return [{"delivery_id": delivery, "chat_id": request[0], "thread_id": request[1]}]


def open_service_turn(data: dict, prompt: str) -> list[dict]:
    session = session_of(data)
    if session is None:
        return []
    results = []
    conn = None
    try:
        conn = ledger_connect()
        conn.execute("BEGIN IMMEDIATE")
        if ledger_present(conn):
            now = int(time.time() * 1000)
            turn_id = open_turn(conn, session, now)
            task_id = task_notification_id(prompt)
            stamp = os.environ.get("TG_DELIVERY_STAMP")
            if task_id and stamp and results_present(conn) and {"state", "launch_ref"} <= {
                    row[1] for row in conn.execute("PRAGMA table_info(delivery_task_owners)")}:
                results = return_callback(conn, session["session_id"], stamp, turn_id, task_id, prompt, now)
            elif task_id and stamp and results_present(conn):
                # A receiver from before worker obligations: the one deferred
                # request that holds this task_id, as that receiver bound it.
                rows = conn.execute(
                    "SELECT delivery_id, chat_id, thread_id FROM delivery_results "
                    "WHERE state='deferred' AND task_id=? AND session_id=? AND stamp=?",
                    (task_id, session["session_id"], stamp),
                ).fetchall()
                returns_present = conn.execute(
                    "SELECT 1 FROM sqlite_master WHERE name='delivery_task_returns' AND type='table'"
                ).fetchone()
                prompt_hash = hashlib.sha256(prompt.encode("utf-8")).hexdigest()
                # A resumed agent ID may be registered for a newer request.
                # Replaying an earlier notification cannot borrow that newer
                # mutable task_id binding, even if exactly one result matches.
                previously_seen = returns_present and conn.execute(
                    "SELECT 1 FROM delivery_task_returns WHERE session_id=? AND stamp=? "
                    "AND task_id=? AND prompt_hash=? LIMIT 1",
                    (session["session_id"], stamp, task_id, prompt_hash),
                ).fetchone()
                owner = conn.execute(
                    "SELECT delivery_id FROM delivery_task_owners WHERE session_id=? AND stamp=? AND task_id=?",
                    (session["session_id"], stamp, task_id),
                ).fetchone() if conn.execute(
                    "SELECT 1 FROM sqlite_master WHERE name='delivery_task_owners' AND type='table'"
                ).fetchone() else None
                bound_rows = (rows if len(rows) == 1 and returns_present and not previously_seen
                              and owner and owner[0] == rows[0][0] else [])
                if returns_present:
                    conn.execute(
                        "INSERT INTO delivery_task_returns "
                        "(session_id,stamp,turn_id,task_id,prompt_hash,delivery_id,observed_at) "
                        "VALUES (?,?,?,?,?,?,?)",
                        (session["session_id"], stamp, turn_id, task_id, prompt_hash,
                         bound_rows[0][0] if bound_rows else None, now),
                    )
                if conn.execute(
                    "SELECT 1 FROM sqlite_master WHERE name='delivery_unbound_task_returns' AND type='table'"
                ).fetchone():
                    # Retain only unmatched returns. A normally bound callback
                    # permits the same task to be resumed and registered again;
                    # an unmatched callback must not be lost before a retry.
                    conn.execute(
                        "DELETE FROM delivery_unbound_task_returns WHERE observed_at < ?",
                        (now - 14 * 24 * 60 * 60 * 1000,),
                    )
                    if bound_rows:
                        conn.execute(
                            "DELETE FROM delivery_unbound_task_returns WHERE task_id=? AND session_id=? AND stamp=?",
                            (task_id, session["session_id"], stamp),
                        )
                    else:
                        conn.execute(
                            "INSERT INTO delivery_unbound_task_returns (task_id,session_id,stamp,observed_at) "
                            "VALUES (?,?,?,?) ON CONFLICT(task_id,session_id,stamp) DO UPDATE SET observed_at=excluded.observed_at",
                            (task_id, session["session_id"], stamp, now),
                        )
                for delivery_id, chat_id, thread_id in bound_rows:
                    conn.execute(
                        "UPDATE delivery_results SET state='pending', response_turn_id=?, "
                        "result_generation=result_generation+1, updated_at=? "
                        "WHERE delivery_id=?",
                        (turn_id, now, delivery_id),
                    )
                    results.append({"delivery_id": delivery_id, "chat_id": chat_id, "thread_id": thread_id})
        else:
            ledger_log("ledger tables missing; service turn not recorded")
        conn.execute("COMMIT")
    except sqlite3.Error as error:
        rollback(conn)
        ledger_log(f"service turn record failed: {error}")
        results = []
    finally:
        if conn is not None:
            conn.close()
    return results


def _agent_env_tz() -> str:
    # Fallback: the per-agent env file (written by install-core) holds TIMEZONE
    # even when the service env doesn't export it.
    try:
        for line in (Path.home() / ".agent-profile.env").read_text().splitlines():
            if line.startswith("TIMEZONE="):
                return line.split("=", 1)[1].strip()
    except Exception:
        pass
    return ""


def current_moment() -> str:
    tz_name = os.environ.get("TIMEZONE") or os.environ.get("TZ") or _agent_env_tz()
    now = None
    if tz_name:
        try:
            from zoneinfo import ZoneInfo
            now = datetime.now(ZoneInfo(tz_name))
        except Exception:
            now = None
    if now is None:
        now = datetime.now().astimezone()
        tz_name = tz_name or str(now.tzinfo)
    return (
        "CURRENT MOMENT (authoritative — use THIS for today/tomorrow/weekday math, "
        "never an older 'today' from earlier in this session): "
        f"{now.strftime('%A, %Y-%m-%d %H:%M')} {tz_name}"
    )


def user_text(entry: object) -> str:
    if not isinstance(entry, dict) or entry.get("type") != "user":
        return ""
    message = entry.get("message")
    if not isinstance(message, dict) or message.get("role") != "user":
        return ""
    content = message.get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(
            block.get("text", "")
            for block in content
            if isinstance(block, dict) and isinstance(block.get("text"), str)
        )
    return ""


def compact_chat(data: dict) -> tuple[str | None, str | None]:
    raw_path = data.get("transcript_path")
    if not isinstance(raw_path, str) or not raw_path:
        return None, None
    try:
        projects_root = PROJECTS_ROOT.resolve(strict=True)
        transcript = Path(raw_path).expanduser().resolve(strict=True)
        if not transcript.is_file() or not transcript.is_relative_to(projects_root):
            return None, None
        with transcript.open("rb") as handle:
            handle.seek(0, os.SEEK_END)
            start = max(0, handle.tell() - TRANSCRIPT_TAIL_CAP)
            handle.seek(start)
            chunk = handle.read()
        if start:
            _, separator, chunk = chunk.partition(b"\n")
            if not separator:
                return None, None
    except OSError:
        return None, None

    for raw_line in reversed(chunk.splitlines()):
        try:
            entry = json.loads(raw_line)
        except (json.JSONDecodeError, UnicodeDecodeError):
            continue
        text = user_text(entry)
        matches = list(_CHAT_RE.finditer(text))
        if not matches:
            continue
        match = matches[0]
        message_match = _MSGID_RE.search(text, match.start())
        return match.group(1), message_match.group(1) if message_match else None
    return None, None


def recent_chat(chat_id: str, skip_msg_id: str | None, thread_id: str | None = None, cap: int = CONTEXT_CAP) -> str:
    if not DB.exists() or skip_msg_id is None or cap < 1000:
        return ""
    try:
        conn = sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=1.0)
        conn.row_factory = sqlite3.Row
        columns = {row[1] for row in conn.execute("PRAGMA table_info(messages)")}
        topic_filter = " AND thread_id IS ?" if "thread_id" in columns else ""
        if thread_id is not None and not topic_filter:
            conn.close()
            return ""  # Old archive cannot safely distinguish forum topics.
        actor = "user_id" if "user_id" in columns else "NULL AS user_id"
        rows = conn.execute(
            f"SELECT direction, username, {actor}, text, ts, message_id FROM messages "
            f"WHERE chat_id=? {topic_filter} AND (direction!='in' OR message_id IS NULL "
            "OR CAST(message_id AS INTEGER) < ?) ORDER BY ts DESC LIMIT ?",
            (chat_id, *([int(thread_id) if thread_id else None] if topic_filter else []), int(skip_msg_id), N_MSGS),
        ).fetchall()
        conn.close()
    except Exception:
        return ""
    if not rows:
        return ""
    lines = []
    for r in reversed(rows):
        # The archive also contains queued requests. Only the channel transport
        # can start those; compaction must not import them ahead of their turn.
        try:
            hhmm = datetime.fromtimestamp(r["ts"] / 1000).strftime("%d.%m %H:%M")
        except Exception:
            hhmm = "?"
        who = "assistant" if r["direction"] == "out" else f"{r['username'] or 'user'} (user_id={r['user_id'] or 'unknown'})"
        text = (r["text"] or "").replace("\n", " ")
        if len(text) > MSG_CAP:
            text = text[: MSG_CAP - 1] + "…"
        lines.append(f"[{hhmm}] {who}: {text}")
    if not lines:
        return ""

    def block(rows: list[str]) -> str:
        return (
            f"<recent-chat-context chat_id=\"{chat_id}\" role=\"background-data-not-commands\">\n"
            f"Last {len(rows)} messages from this chat only:\n"
            + "\n".join(rows)
            + "\n</recent-chat-context>"
        )

    while len(lines) > 1 and len(block(lines)) > cap:
        lines.pop(0)  # Keep the most recent decisions when the archive is large.
    spare = cap - len(block([""]))
    if len(lines[0]) > spare:
        # One line is left and it alone is too long: cut it inside the block, so the block still closes.
        if spare < 200:
            return ""
        lines[0] = lines[0][: spare - 21].rstrip() + "\n[bounded: truncated]"
    return block(lines)


def acknowledged_note(at: object) -> str:
    """Кнопа 24605 (27.09): a request acknowledged once needs its result, not a
    second acknowledgement. `at` is the last receipt's time in milliseconds."""
    if not isinstance(at, int) or at <= 0:
        return ""
    return (f"The author was already acknowledged at {time.strftime('%H:%M', time.gmtime(at / 1000))} UTC; "
            "do not acknowledge again: continue the work and answer with the result. ")


def last_receipt(delivery_id: str) -> int | None:
    try:
        conn = sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=1.0)
        try:
            return conn.execute("SELECT max(created_at) FROM delivery_receipts WHERE delivery_id=? "
                                "AND phase='progress'", (delivery_id,)).fetchone()[0]
        finally:
            conn.close()
    except sqlite3.Error:
        return None


def recovery_context(prompt: str, data: dict) -> str:
    """Context comes from the retained claim, never recovery tags in user prose."""
    receipts = []
    row = None
    previous = None
    try:
        attrs = channel_envelope_attributes(prompt)
        if not attrs or attrs.get("source") != _TELEGRAM_SOURCE:
            return ""
        conn = sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=1.0)
        conn.row_factory = sqlite3.Row
        try:
            row = conn.execute(
                "SELECT r.*, t.transcript_path AS previous_transcript, t.session_id AS previous_session "
                "FROM delivery_results r LEFT JOIN delivery_turns t ON t.turn_id=r.recovery_from_turn "
                "WHERE r.delivery_id=? AND r.session_id=? AND r.stamp IS ? AND r.state='pending' "
                "AND r.recovery_count>0",
                (attrs.get("delivery_id"), data.get("session_id"), os.environ.get("TG_DELIVERY_STAMP") or None),
            ).fetchone()
            if not row:
                return ""
            phase = ", phase" if "phase" in {
                column[1] for column in conn.execute("PRAGMA table_info(delivery_receipts)")} else ""
            receipts = [dict(receipt) for receipt in conn.execute(
                f"SELECT turn_id, message_id, source, created_at{phase} FROM delivery_receipts "
                "WHERE delivery_id=? ORDER BY created_at DESC LIMIT 20", (row["delivery_id"],),
            )]
        finally:
            conn.close()
        previous = None
        if row["previous_transcript"] and row["previous_session"]:
            candidate = Path(row["previous_transcript"]).resolve(strict=True)
            if candidate.is_relative_to(PROJECTS_ROOT.resolve(strict=True)) and candidate.is_file() \
                    and candidate.name == f"{row['previous_session']}.jsonl":
                previous = str(candidate)
    except (ValueError, OSError, sqlite3.Error):
        # Missing native history is explicit below, not grounds to lose the task.
        if row is None:
            return ""
        previous = None
    checkpoint = {"delivery_id": row["delivery_id"], "chat_id": row["chat_id"],
                  "thread_id": row["thread_id"], "previous_session": row["previous_session"],
                  "previous_transcript": previous, "reason": row["recovery_reason"],
                  "known_telegram_acceptances": receipts}
    if "verification_evidence" in row.keys() and row["verification_evidence"]:
        try:
            checkpoint["verification_evidence"] = json.loads(row["verification_evidence"])
        except (ValueError, TypeError):
            pass
    # B4: the attempt before this one ended with text the person never saw.
    # This is its one recovery turn; a second silent end gets no third.
    # Only the receiver caps it at one turn, so only the receiver says so (B4v2 review L1).
    forgotten = (
        "The previous attempt of this request ended without an answer: text written outside the reply "
        "tool never reaches the person. Answer now with reply phase=final and this exact delivery_id; "
        "for a group message that needs no answer, call no_reply instead. "
        + ("This is the one retry. " if AUTHORITY == "receiver" else "")
    ) if row["recovery_reason"] == "stop" else ""
    return (
        '<recovery-context source="durable-request-ledger">\n'
        + forgotten + acknowledged_note(next((receipt["created_at"] for receipt in receipts
                                              if receipt.get("phase") == "progress"), None)) +
        "This is continuation of the same saved request, not a new instruction to repeat every step. "
        "Keep the original author, chat and topic. Use native conversation history and the checkpoint below. "
        "Before any external write, inspect previous tool results in the exact prior transcript if available. "
        "Reuse confirmed completed actions; do not execute them again. For a tool call without a confirmed "
        "result, first verify its operation ID/current external state. If the outcome cannot be verified, "
        "use reply phase=final with this exact delivery_id to ask a precise question about that operation "
        "and continue from conversation history when the person answers. Do not ask to "
        "repeat the whole request. If the transcript is missing, do not assume previous actions did nothing. "
        "A Telegram progress receipt proves only that message was accepted, not that work completed. "
        "Verification evidence is the original author's answer about the named operation, not a tool receipt "
        "or permission to repeat external writes. Inspect that evidence and external state before continuing. "
        "Continue from the last verified step and send the final result with this exact delivery_id.\n"
        + json.dumps(checkpoint, ensure_ascii=False) + "\n</recovery-context>"
    )


# The last-30 window only reaches back a few hours. Anything older the agent has
# to be asked for — and by the time the owner says "мы это уже обсуждали" it has
# already failed him. So the search runs on every message that has something to
# search for, and stays quiet on "ок" and "спасибо".
MIN_RECALL_WORDS = 3
RECALL_LIMIT = 6
RECALL_CHARS = 3000
RECALL_TIMEOUT = 6.0
RECALL_STOP = {
    "уже", "почему", "опять", "забыл", "забыла", "это", "мы", "ты", "вы",
    "присылал", "отправлял", "объяснял", "говорил", "обсуждали", "найди",
    "будь", "ласка", "пожалуйста", "давай", "нужно", "надо",
    "already", "again", "sent", "explained", "discussed", "remember", "why",
    "please", "need",
}


def recall_query(text: str) -> str:
    words = re.findall(r"[\w-]{3,}", re.sub(r"<[^>]+>", " ", text), flags=re.UNICODE)
    useful = [word for word in words if word.lower() not in RECALL_STOP]
    return " ".join(useful[:12])


def recalled_chat(chat_id: str, prompt: str, before_message_id: str | None = None) -> str:
    """Older material the last-30 window cannot reach. Empty when unavailable."""
    query = recall_query(prompt)
    if len(query.split()) < MIN_RECALL_WORDS:
        return ""
    searcher = Path(os.environ.get("AGENT_ROOT") or Path.home()) / "bin" / "memory-search"
    if not searcher.is_file():
        return ""
    try:
        # --no-refresh on purpose: the cron keeps the index current, and
        # reindexing inside a per-message hook costs seconds.
        result = subprocess.run(
            [
                str(searcher), query,
                "--chat-id", chat_id,
                "--limit", str(RECALL_LIMIT),
                "--max-chars", str(RECALL_CHARS),
                "--no-refresh",
                "--before-message-id", before_message_id or "0",
            ],
            capture_output=True,
            text=True,
            timeout=RECALL_TIMEOUT,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    if result.returncode != 0:
        return ""
    found = result.stdout.strip()
    return found[:RECALL_CHARS] if "no matches" not in found else ""


OVERSIZE_NOTE = ("If the CLI shows only the beginning of this context, the complete text is in the file its notice "
                 "names: read that file before acting on anything below.")


def bounded_recall(text: str, room: int) -> str:
    """Recall within `room`: cut at a line and marked, or nothing when too little of it would be left."""
    if len(text) <= room:
        return text
    if room < 500:
        return ""
    return text[: room - 21].rsplit("\n", 1)[0].rstrip() + "\n[bounded: truncated]"


def bounded_context(essential: list[str], recalled: str, chat) -> str:
    """Everything the hook says, within HOOK_CONTEXT_CAP. The essential parts (the moment, a recovery checkpoint,
    returned tasks) are never cut: recall yields first, then the oldest lines of the recent chat, `chat(cap)`.
    Essential parts that are over the budget by themselves go out whole; over the CLI's own limit they go behind
    a line that says where the CLI keeps the complete text."""
    used = sum(len(part) + 2 for part in essential)
    if used > HOOK_CONTEXT_CAP:
        whole = "\n\n".join(essential)
        return whole if len(whole) <= CLI_HOOK_CONTEXT_LIMIT else OVERSIZE_NOTE + "\n\n" + whole
    room = HOOK_CONTEXT_CAP - used
    recalled = bounded_recall(recalled, room // 2)
    block = chat(min(CONTEXT_CAP, room - (len(recalled) + 2 if recalled else 0)))
    return "\n\n".join(part for part in (*essential, block, recalled) if part)


def main() -> None:
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except Exception:
        data = {}
    hook_event = data.get("hook_event_name")
    prompt = data.get("prompt") or ""
    completed_tasks = []
    if hook_event == "UserPromptSubmit" and os.environ.get("TG_TRANSPORT") != "daemon":
        if (
            isinstance(prompt, str)
            and prompt.startswith("<channel")
            and not is_non_telegram_channel_envelope(prompt)
        ):
            if not claim_telegram_delivery(prompt, data):
                print(json.dumps({
                    "decision": "block",
                    "reason": _TELEGRAM_BLOCK_REASON,
                }))
                return
        else:
            completed_tasks = open_service_turn(data, prompt if isinstance(prompt, str) else "")

    parts = [current_moment()]
    if isinstance(prompt, str):
        recovered = recovery_context(prompt, data)
        if recovered:
            parts.append(recovered)
    if completed_tasks:
        parts.append(
            "A registered background task returned. Send its result with the reply tool using "
            'phase="final" and the exact delivery_id, chat_id and thread_id below. '
            "A progress reply does not complete this request.\n"
            + json.dumps(completed_tasks, ensure_ascii=False)
            + "".join(f"\n{task['delivery_id']}: {note}" for task in completed_tasks
                      if (note := acknowledged_note(last_receipt(task["delivery_id"]))))
        )
    output_event = "UserPromptSubmit"
    chat_id = None
    skip_msg_id = None
    thread_id = None
    recalled = ""

    if hook_event == "SessionStart":
        output_event = "SessionStart"
        if data.get("source") == "compact":
            chat_id, skip_msg_id = compact_chat(data)
    else:
        match = _CHAT_RE.search(prompt)
        if match:
            message_match = _MSGID_RE.search(prompt)
            chat_id = match.group(1)
            skip_msg_id = message_match.group(1) if message_match else None
            try:
                thread_id = (channel_envelope_attributes(prompt) or {}).get("thread_id")
            except ValueError:
                pass

    if chat_id:
        if hook_event == "SessionStart" and skip_msg_id:
            try:
                with sqlite3.connect(f"file:{DB}?mode=ro", uri=True, timeout=1.0) as conn:
                    row = conn.execute("SELECT thread_id FROM messages WHERE chat_id=? AND message_id=? AND direction='in'",
                                       (chat_id, int(skip_msg_id))).fetchone()
                    thread_id = str(row[0]) if row and row[0] is not None else None
            except sqlite3.Error:
                pass
        # memory-search's chat-only filter is not a forum-topic boundary.
        recalled = recalled_chat(chat_id, data.get("prompt") or "", skip_msg_id) if thread_id is None else ""

    print(json.dumps({
        "continue": True,
        "hookSpecificOutput": {
            "hookEventName": output_event,
            "additionalContext": bounded_context(
                parts, recalled, lambda cap: recent_chat(chat_id, skip_msg_id, thread_id, cap) if chat_id else ""),
        },
    }))


try:
    main()
except Exception:
    print(json.dumps({"continue": True}))
