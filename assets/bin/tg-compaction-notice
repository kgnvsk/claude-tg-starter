#!/usr/bin/env python3
"""Native PreCompact status, scoped by the receipt ledger; never a result.

One attempt per open turn and chat/topic. Claim before sending because a timeout
does not prove Telegram rejected the message. Missing/legacy identity is silent.
Nothing in this hook reads the transcript or changes the delivery ledger.
"""
import concurrent.futures
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import sqlite3
import subprocess
import sys
import time

TEXT = 'Секундочку, зараз стискаю контекст розмови. Після цього продовжу завдання.'


def main():
    if os.environ.get('ATARAX_SUPPRESS_TELEGRAM') == '1':
        return
    event = json.load(sys.stdin)
    session = event.get('session_id')
    stamp = os.environ.get('TG_DELIVERY_STAMP')
    if (event.get('hook_event_name') != 'PreCompact'
            or event.get('trigger') not in ('auto', 'manual')
            or not isinstance(session, str) or not session or not stamp):
        return
    root = Path(os.environ.get('AGENT_ROOT') or Path.home())
    config = Path(os.environ.get('CLAUDE_CONFIG_DIR') or Path.home() / '.claude')
    state = Path(os.environ.get('TELEGRAM_STATE_DIR') or config / 'channels/telegram')
    with sqlite3.connect(f'file:{state / "messages.db"}?mode=ro', uri=True, timeout=1) as db:
        targets = db.execute(
            'SELECT DISTINCT t.turn_id,r.chat_id,r.thread_id FROM delivery_results r '
            'JOIN delivery_turns t ON t.turn_id=coalesce(r.response_turn_id,r.turn_id) '
            'JOIN delivery_sessions s ON s.session_id=t.session_id '
            'WHERE t.session_id=? AND s.stamp=? AND r.session_id=? AND r.stamp=? '
            "AND t.closed_at IS NULL AND r.state IN ('pending','deferred')",
            (session, stamp, session, stamp),
        ).fetchall()
    if not targets:
        return
    claims = state / 'compaction-notices.json'
    lock = state / 'compaction-notices.lock'
    attempts = []
    with lock.open('a') as handle:
        lock.chmod(0o600)
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        now = time.time()
        saved = json.loads(claims.read_text()) if claims.exists() else {}
        saved = {key: ts for key, ts in saved.items() if isinstance(ts, (int, float)) and now - ts < 604800}
        for turn, chat, thread in targets:
            if not re.fullmatch(r'-?[1-9][0-9]{0,19}', chat):
                continue
            if thread is not None and (not chat.startswith('-') or not re.fullmatch(r'[1-9][0-9]{0,9}', thread)):
                continue
            key = hashlib.sha256(json.dumps([stamp, session, turn, chat, thread]).encode()).hexdigest()
            if key not in saved:
                saved[key] = now
                attempts.append((chat, thread))
        # Bounded status cache, separate from durable work and receipts.
        saved = dict(sorted(saved.items(), key=lambda item: item[1])[-1024:])
        temp = claims.with_suffix('.tmp')
        temp.write_text(json.dumps(saved))
        temp.chmod(0o600)
        temp.replace(claims)

    def send(target):
        chat, thread = target
        args = [str(root / 'bin/tg-send'), '--no-watchdog-credit', chat, TEXT]
        if thread is not None:
            args += ['--thread-id', thread]
        try:
            subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           timeout=4, check=False)
        except (OSError, subprocess.TimeoutExpired):
            pass

    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as executor:
        list(executor.map(send, attempts))


if __name__ == '__main__':
    try:
        main()
    except Exception:
        # A status failure must never stop native compaction or expose hook input.
        pass
