#!/usr/bin/env python3
"""Owner-triggered recovery for a bot that cannot recover itself.

The Telegram session is the one thing that stops working when the agent is
wedged, so a command handled by the agent is useless exactly when it is needed —
that is why /relogin lives in cron, and why this does too. Reads the owner's
message straight from the transport's message log and acts outside Claude.

The exact /restart command restarts once without disabling automatic recovery.
Two things happen on /unstick, in this order:
  1. automatic restarts are parked for a while — when the watchdog is itself the
     thing killing the bot, restarting without parking it just feeds the loop;
  2. the service is restarted once.

Never logs message text. Only the owner can trigger it.
"""
import datetime
import fcntl
import importlib.util
import json
import math
import os
import re
import signal
import sqlite3
import stat
import subprocess
import sys
import tempfile
import time
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path(os.environ.get("HOME", "/home/claude"))
AGENT_ROOT = Path(os.environ.get("AGENT_ROOT", str(HOME)))
STATE_DIR = Path(os.environ.get("TELEGRAM_STATE_DIR")
                 or (AGENT_ROOT / ".claude/channels/telegram"))
ENV_FILE = STATE_DIR / ".env"
ACCESS_FILE = STATE_DIR / "access.json"
MESSAGES_DB = STATE_DIR / "messages.db"
STATE_FILE = AGENT_ROOT / "logs/unstick-watch.state"
RESTART_HOLD = AGENT_ROOT / "logs/restart-hold.until"
# The hold this command wrote itself, by value: a second /unstick inside its fifteen minutes is the
# owner asking again, not an update (Арти, 03.10.2026: «Зараз триває оновлення» while nothing was updating).
RESTART_HOLD_BY_UNSTICK = AGENT_ROOT / "logs/restart-hold.unstick"
LIFECYCLE_LOCK = AGENT_ROOT / "logs/transport-lifecycle.lock"
LOG = AGENT_ROOT / "logs/healthcheck.log"
SERVICE = os.environ.get("CLAUDE_TELEGRAM_SERVICE", "claude-telegram.service")
HOLD_SECONDS = 15 * 60
# The agent's own restart (persona: «Перезапустити себе»). Run from here, outside its unit, it keeps what a restart
# from inside cannot: the update's restart hold, the lifecycle lock across stop and start, and a loop guard
# (partner, 19.10: the agent restarted itself twice with a bare `sudo systemctl restart`, past both barriers).
AGENT_RESTART_REQUEST = AGENT_ROOT / "logs/restart-request"
AGENT_RESTART_LOOP_LIMIT = 3  # restarts in the last ten minutes after which a request is refused
# The agent account cannot read the system journal, so the watcher counts the restarts it made itself, in monotonic
# seconds of this boot: a wall-clock correction can neither hide nor invent one.
AGENT_RESTART_LEDGER = AGENT_ROOT / "logs/agent-restarts.json"
BOOT_ID = Path("/proc/sys/kernel/random/boot_id")
# The whole message has to be the command. "fix" and "оживи" are words the owner
# uses in ordinary requests — matching them at the start of a sentence would
# restart the agent in the middle of the very task he just asked for.
TRIGGER = re.compile(
    r"^\s*(?:/restart|/?(unstick|fix|фикс|отвисни|оживи|перезапустись|розблокуйся|відвисни|перезапустися)\s*[.!]*)\s*$",
    re.IGNORECASE,
)



def telegram_api_base():
    import os, runpy
    from pathlib import Path
    candidates = [Path(__file__).resolve().with_name('telegram-api'), Path.home() / 'bin/telegram-api']
    candidates += [Path(__file__).resolve().parents[3] / 'assets/bin/telegram-api'] if 'telegram-corporate' in str(__file__) else []
    for helper in candidates:
        if helper.is_file():
            return runpy.run_path(str(helper))['api_base']()
    configured = os.environ.get('TELEGRAM_API_BASE', '')
    state = Path(os.environ.get('TELEGRAM_STATE_DIR') or Path.home() / '.claude/channels/telegram')
    if not configured and (state / '.env').is_file():
        for line in (state / '.env').read_text().splitlines():
            import re
            match = re.match(r'^(?:export\s+)?TELEGRAM_API_BASE\s*=(.*)', line.strip())
            if match:
                configured = match[1].strip().strip("\"'")
    if configured and configured.rstrip('/') != 'https://api.telegram.org':
        raise ValueError('Telegram local API helper is unavailable; no cloud fallback')
    return 'https://api.telegram.org'


def env_val(key: str) -> str:
    try:
        for line in ENV_FILE.read_text(encoding="utf-8").splitlines():
            if line.startswith(key + "="):
                return line.split("=", 1)[1].strip()
    except Exception:
        pass
    return ""


def owner() -> str:
    configured = os.environ.get("OWNER_CHAT_ID", env_val("OWNER_CHAT_ID"))
    if configured:
        return configured
    data = json.loads(ACCESS_FILE.read_text(encoding="utf-8"))
    ids = data.get("admins") or data.get("allowFrom") or []
    return str(ids[0]) if ids else ""


def control_chats(primary: str) -> set[str]:
    """Current owner and verified superadmins; never infer authority from a group."""
    allowed = {primary}
    try:
        access = json.loads(ACCESS_FILE.read_text(encoding="utf-8"))
        admins, admitted, superadmins = (access[key] for key in ("admins", "allowFrom", "superadmins"))
        if not all(isinstance(items, list) and all(isinstance(item, str) and re.fullmatch(r"[1-9]\d{0,19}", item)
                                                   for item in items) for items in (admins, admitted, superadmins)):
            return allowed
        allowed.update((set(superadmins) & set(admins) & set(admitted)) - {primary})
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return allowed


def send(chat: str, text: str, thread_id: str | None = None) -> bool:
    token = env_val("TELEGRAM_BOT_TOKEN")
    if not token or not chat:
        return False
    body = urllib.parse.urlencode({
        "chat_id": chat, "text": text,
        **({"message_thread_id": thread_id} if thread_id else {}),
    }).encode()
    try:
        with urllib.request.urlopen(urllib.request.Request(
                f"{telegram_api_base()}/bot{token}/sendMessage", data=body),
                timeout=15) as response:
            delivered = json.loads(response.read().decode("utf-8")).get("ok") is True
        if delivered:
            try:
                subprocess.run(
                    [str(HOME / "bin/tg-fallback-outbound"), chat],
                    check=False,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=5,
                )
            except (OSError, subprocess.TimeoutExpired):
                pass
        return delivered
    except Exception:
        return False


def fallback_outbound(chat: str) -> int:
    """Return a recent verified direct-send timestamp for this exact chat."""
    if re.fullmatch(r"-?\d+", chat) is None:
        return 0
    try:
        raw = (STATE_DIR / "fallback-outbound" / f"{chat}.ts").read_text(
            encoding="ascii"
        ).strip()
    except (OSError, UnicodeError):
        return 0
    if not raw.isascii() or not raw.isdigit() or len(raw) > 16:
        return 0
    timestamp = int(raw)
    now_ms = time.time_ns() // 1_000_000
    return timestamp if 0 < timestamp <= now_ms + 60_000 else 0


def note(line: str) -> None:
    try:
        with LOG.open("a", encoding="utf-8") as handle:
            handle.write(f"[{time.strftime('%FT%TZ', time.gmtime())}] {line}\n")
    except Exception:
        pass


def recent_restarts() -> int:
    """Restarts in the last ten minutes — the tell that the watchdog is the problem."""
    try:
        out = subprocess.run(
            ["journalctl", "-u", SERVICE, "--since", "10 min ago", "--no-pager"],
            capture_output=True, text=True, timeout=20).stdout
        # systemd 249 (22.04): "Started Claude Code Telegram Bot…";
        # 255+ (24.04, 26.04): "Started claude-telegram.service - Claude Code Telegram Bot…".
        return len(re.findall(r"Started (?:\S+\.service - )?Claude Code", out))
    except Exception:
        return -1


def open_lifecycle_lock(path: Path) -> int | None:
    """Take the transport-wide nonblocking restart lock without following links."""
    descriptor = -1
    try:
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        flags = os.O_RDWR | os.O_CREAT
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        descriptor = os.open(path, flags, 0o600)
        opened = os.fstat(descriptor)
        if not stat.S_ISREG(opened.st_mode):
            return None
        os.fchmod(descriptor, 0o600)
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return None
        acquired = descriptor
        descriptor = -1
        return acquired
    except OSError:
        return None
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def atomic_write_private(path: Path, payload: bytes) -> None:
    """Replace a file with one private, complete value in the same directory."""
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{path.name}.",
        suffix=".tmp",
        dir=path.parent,
    )
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as handle:
            descriptor = -1
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        directory_flags = os.O_RDONLY
        if hasattr(os, "O_DIRECTORY"):
            directory_flags |= os.O_DIRECTORY
        directory_descriptor = os.open(path.parent, directory_flags)
        try:
            os.fsync(directory_descriptor)
        finally:
            os.close(directory_descriptor)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def atomic_write_restart_hold(until: int) -> None:
    atomic_write_private(RESTART_HOLD, str(until).encode("ascii"))


def restart_hold_active() -> bool:
    """Is somebody else holding restarts right now?

    This file is how an update stops the watchdog from restarting the agent
    mid-upgrade. cash-healthcheck has always honoured it; /unstick wrote one and
    then restarted regardless, so the one command the owner reaches for when the
    bot feels stuck could interrupt the very update in progress.

    Narrower than service_mutation_allowed() on purpose: only a well-formed hold
    in the future blocks. That check also refuses on a corrupted or symlinked
    file, which is right for an automatic restart — but this path runs because a
    person asked for help, and junk on disk is not evidence of an update.
    """
    if not RESTART_HOLD.exists() and not RESTART_HOLD.is_symlink():
        return False
    try:
        raw = RESTART_HOLD.read_text(encoding="ascii").strip()
    except OSError:
        raw = ""
    # Only a well-formed hold in the future counts. cash-healthcheck also blocks
    # on a malformed one, and for an automatic restart that is right — but this
    # is the owner typing /unstick because the bot feels dead. A corrupted file
    # or a planted symlink is not evidence of an update, and refusing on it
    # would strand him with no way back. Junk is replaced by the write below.
    if raw.isdigit() and len(raw) <= 10 and int(time.time()) < int(raw):
        try:
            ours = RESTART_HOLD_BY_UNSTICK.read_text(encoding="ascii").strip() == raw
        except OSError:
            ours = False
        if ours:
            note(f"/unstick: the hold until {raw} is an earlier /unstick's; the owner asked again")
            return False
        note(f"/unstick: restart hold active until {raw} — refusing to restart")
        return True
    return False


def take_agent_restart_request() -> bool:
    """Consume the request once. A link, another owner's file or anything but a regular file is removed, never acted on."""
    try:
        info = AGENT_RESTART_REQUEST.lstat()
    except OSError:
        return False
    try:
        AGENT_RESTART_REQUEST.unlink()
    except OSError:
        return False
    return stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid()


def agent_restart_held() -> bool:
    """Any hold file that is not a past time refuses the agent's own restart: it can always ask again later."""
    if not RESTART_HOLD.exists() and not RESTART_HOLD.is_symlink():
        return False
    try:
        raw = RESTART_HOLD.read_text(encoding="ascii").strip()
    except OSError:
        return True
    return not (raw.isdigit() and len(raw) <= 10 and int(raw) <= int(time.time()))


def restart_service(command_name: str) -> tuple[bool, bool]:
    stop_ok = False
    start_ok = False
    try:
        try:
            stopped = subprocess.run(
                ["sudo", "systemctl", "stop", SERVICE],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=30,
            )
        except (OSError, subprocess.TimeoutExpired):
            note(f"{command_name}: stop failed or timed out; queue retained")
        else:
            stop_ok = stopped.returncode == 0
            if not stop_ok:
                note(f"{command_name}: stop failed; queue retained")
        if stop_ok:
            # Restart changes the process, not the person's intent. Keep
            # request, turn and send proofs intact for receiver recovery.
            note(f"{command_name}: requests and delivery evidence retained for receiver recovery")
    finally:
        # A failed/timed-out stop can already have stopped the service. Never
        # leave it down even when the stop client reports a failure.
        try:
            started = subprocess.run(
                ["sudo", "systemctl", "start", SERVICE],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=30,
            )
            start_ok = started.returncode == 0
            note(f"{command_name}: service start " + ('succeeded' if started.returncode == 0 else 'failed'))
        except (OSError, subprocess.TimeoutExpired):
            note(f"{command_name}: service start failed or timed out")
    return stop_ok, start_ok


UUID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")

# Anthropic's safety filter stops a response, and the CLI then stops every later turn of that session: each message
# hangs until the inactivity ladder gives up, for hours (Арти, 21.10.2026, twice). The stopped session is retired
# durably first, so the launcher never resumes it (tg-resume-session), and only then is the service restarted once on
# a fresh session. The receiver offers the interrupted message again; the owner hears once.
CLASSIFIER_SYSTEM = "safeguards stopped the response"
CLASSIFIER_NOTE = "Your response above was stopped by a safety classifier"
CLASSIFIER_GRACE = 60  # seconds the CLI's own «continuing once» gets before the session counts as stopped
RETIRED_SESSIONS = STATE_DIR / "retired-sessions"
# The stopped session's restart and the owner's notice stay pending here until both are done (Codex batch 2 P1-14).
SAFETY_PENDING = STATE_DIR / "safety-restart-pending"
SAFETY_RESTART_TEXT = ("🔄 Anthropic зупинив мою відповідь фільтром безпеки, і ця сесія більше не могла відповідати. "
                       "Я перезапустився на чистій сесії; повідомлення, що чекали, обробляю далі.")


def latest_turn_session() -> tuple[str, Path] | None:
    """The session of the newest turn the receiver opened, with its transcript."""
    try:
        conn = sqlite3.connect(f"file:{MESSAGES_DB}?mode=ro", uri=True, timeout=2)
        try:
            row = conn.execute(
                "SELECT t.session_id, coalesce(t.transcript_path,s.transcript_path) FROM delivery_turns t "
                "JOIN delivery_sessions s ON s.session_id=t.session_id "
                "ORDER BY t.opened_at DESC,t.turn_id DESC LIMIT 1").fetchone()
        finally:
            conn.close()
    except Exception:
        return None
    if not row or not isinstance(row[0], str) or not UUID.fullmatch(row[0]) or not isinstance(row[1], str) or not row[1]:
        return None
    return row[0], Path(row[1])


def retired_sessions() -> set[str] | None:
    """The retired list as tg-resume-session reads it; None when it exists but cannot be trusted."""
    try:
        info = RETIRED_SESSIONS.lstat()
    except FileNotFoundError:
        return set()
    except OSError:
        return None
    if not stat.S_ISREG(info.st_mode) or info.st_size > 1024 * 1024:
        return None
    try:
        names = RETIRED_SESSIONS.read_text(encoding="ascii").split()
    except (OSError, UnicodeError):
        return None
    return set(names) if names and all(UUID.fullmatch(name) for name in names) else None


def stopped_by_filter(transcript: Path, now: float) -> bool:
    """The newest turn record is the CLI's note right after the filter's stop, older than the grace."""
    try:
        info = transcript.lstat()
        if not stat.S_ISREG(info.st_mode):
            return False
        with transcript.open("rb") as handle:
            handle.seek(max(0, info.st_size - 256 * 1024))
            lines = handle.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return False
    note_at = None
    for line in reversed(lines):
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if not isinstance(event, dict) or event.get("type") not in ("user", "assistant", "system"):
            continue
        message = event.get("message")
        content = message.get("content") if isinstance(message, dict) else event.get("content")
        text = content if isinstance(content, str) else "\n".join(
            item.get("text", "") for item in content if isinstance(item, dict) and isinstance(item.get("text"), str)
        ) if isinstance(content, list) else ""
        if note_at is not None:
            return (event.get("type") == "system" and event.get("subtype") == "informational"
                    and CLASSIFIER_SYSTEM in text and now - note_at >= CLASSIFIER_GRACE)
        if event.get("type") == "user" and text.startswith(CLASSIFIER_NOTE):
            try:
                note_at = datetime.datetime.fromisoformat(str(event.get("timestamp")).replace("Z", "+00:00")).timestamp()
            except ValueError:
                note_at = info.st_mtime
            continue
        return False
    return False


def stopped_session() -> str | None:
    """The live session the filter stopped and nobody retired yet."""
    found = latest_turn_session()
    retired = retired_sessions()
    if found is None or retired is None or found[0] in retired:
        return None
    return found[0] if stopped_by_filter(found[1], time.time()) else None


def retire_session(session: str) -> bool:
    """Durable before any restart: written, synced and read back, or nothing restarts into a fresh session."""
    retired = retired_sessions()
    if retired is None:
        note("safety-filter stop: the retired-session list is unreadable; not restarting")
        return False
    try:
        atomic_write_private(RETIRED_SESSIONS, ("\n".join(sorted(retired | {session})) + "\n").encode("ascii"))
    except OSError:
        note("safety-filter stop: the retired-session list cannot be written; not restarting")
        return False
    if session not in (retired_sessions() or set()):
        note("safety-filter stop: the retired session did not read back; not restarting")
        return False
    note(f"safety-filter stop: session {session[:8]} retired")
    return True


def safety_restart_text() -> str:
    """The owner's notice in the agent's notice language; Ukrainian without a profile."""
    try:
        spec = importlib.util.spec_from_file_location(
            "agent_notice_locale", Path(__file__).with_name("agent_notice_locale.py"))
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module.notice_text("session.safety_restart", SAFETY_RESTART_TEXT, home=AGENT_ROOT)
    except Exception:  # noqa: BLE001 — a missing helper keeps the kit text, never the restart
        return SAFETY_RESTART_TEXT


def main_pid() -> str | None:
    """The service's main process now; "0" when it is not running; None when systemd cannot say."""
    try:
        shown = subprocess.run(["systemctl", "show", "-p", "MainPID", "--value", SERVICE],
                               capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    value = shown.stdout.strip()
    return value if shown.returncode == 0 and value.isdigit() else None


def safety_pending() -> dict | None:
    try:
        data = json.loads(SAFETY_PENDING.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return None
    except (OSError, ValueError):
        note("safety-filter stop: the pending restart record is unreadable; nothing restarted")
        return None
    if not isinstance(data, dict) or not isinstance(data.get("session"), str) or not UUID.fullmatch(data["session"]):
        note("safety-filter stop: the pending restart record is malformed; nothing restarted")
        return None
    return data


def begin_safety_restart(session: str) -> None:
    """The pending restart is recorded before the session is retired, and retired before any restart: a crash in
    between leaves either a record the next minute finishes or a session the next scan finds again."""
    try:
        atomic_write_private(SAFETY_PENDING, json.dumps({"session": session, "pid": main_pid()}).encode("utf-8"))
    except OSError:
        note("safety-filter stop: the pending restart cannot be recorded; not restarting")
        return
    if not retire_session(session):
        SAFETY_PENDING.unlink(missing_ok=True)


def restart_after_filter() -> bool:
    """One restart onto a fresh session, inside the update hold and the loop guard the agent's own restart keeps."""
    if agent_restart_held():
        note("safety-filter stop: a restart hold is active (an update or /unstick); retried after it")
        return False
    now = time.monotonic()
    boot = boot_id()
    stamps = None if boot is None else agent_restart_ledger(boot)
    if stamps is None:
        note("safety-filter stop: the restart ledger is unreadable; not restarting")
        return False
    recent = [s for s in stamps if s > now - 600]
    if len(recent) >= AGENT_RESTART_LOOP_LIMIT:
        note(f"safety-filter stop: {len(recent)} restarts in the last 10 minutes; retried later")
        return False
    try:
        atomic_write_private(AGENT_RESTART_LEDGER, json.dumps({"boot": boot, "stamps": recent + [now]}).encode("utf-8"))
    except OSError:
        note("safety-filter stop: the restart ledger cannot be written; not restarting")
        return False
    stop_ok, start_ok = restart_service("safety-filter stop")
    return stop_ok and start_ok


def finish_safety_restart(chat: str, pending: dict) -> int:
    """Until the process that ran the stopped session is gone, restart; then tell the owner once."""
    if pending["session"] not in (retired_sessions() or set()):
        note("safety-filter stop: the pending session is not retired; no restart")
        SAFETY_PENDING.unlink(missing_ok=True)
        return 0
    if pending.get("restarted") is not True:
        pid = main_pid()
        if pid is None:
            return 0  # systemd cannot say which process runs: the next minute asks again
        # Another restart (an update, /unstick, the night start) already left the stopped session behind.
        if pending.get("pid") in (None, pid) or pid == "0":
            if not restart_after_filter():
                return 0
            # A start is proven by a new running process, not by systemctl's answer (Codex batch 2 round 2).
            started = main_pid()
            if started in (None, "0") or started == pending.get("pid"):
                note("safety-filter stop: no new running process after the restart; retried next minute")
                return 0
    if send(chat, safety_restart_text()):
        SAFETY_PENDING.unlink(missing_ok=True)
    else:
        try:
            atomic_write_private(SAFETY_PENDING, json.dumps({**pending, "restarted": True}).encode("utf-8"))
        except OSError:
            pass
        note("safety-filter stop: restarted; the owner's notice did not go and is retried")
    return 0


def boot_id() -> str | None:
    """This boot's id; "" on a host without one (not Linux); None when it cannot be read, which refuses."""
    try:
        raw = BOOT_ID.read_text(encoding="ascii").strip()
    except FileNotFoundError:
        return ""
    except (OSError, UnicodeError):
        return None
    return raw if UUID.fullmatch(raw) else None


def agent_restart_ledger(boot: str) -> list | None:
    """This boot's restarts; another boot's ledger counts none. Only a missing ledger is a new one: a link, another
    kind of file or a broken value (a boot that is not an id, a stamp that is not a finite number) returns None and
    the request is refused, never counted as zero."""
    try:
        descriptor = os.open(AGENT_RESTART_LEDGER, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return []
    except OSError:
        return None
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_size > 65536:
            return None
        ledger = json.loads(os.read(descriptor, 65536))
    except (OSError, ValueError):
        return None
    finally:
        os.close(descriptor)
    if not isinstance(ledger, dict):
        return None
    stamps, recorded = ledger.get("stamps"), ledger.get("boot")
    # An int is exact at any size (math.isfinite would overflow on a huge one); a float must be finite.
    if (not isinstance(stamps, list) or not all(type(s) is int or type(s) is float and math.isfinite(s) for s in stamps)
            or not isinstance(recorded, str) or recorded and not UUID.fullmatch(recorded)):
        return None
    return stamps if recorded == boot else []


def restart_for_agent() -> int:
    if agent_restart_held():
        note("agent restart request: a restart hold is active (an update or /unstick) — refused")
        return 0
    now = time.monotonic()
    boot = boot_id()
    stamps = None if boot is None else agent_restart_ledger(boot)
    if stamps is None:
        note("agent restart request: the restart ledger is unreadable — refused")
        return 0
    recent = [s for s in stamps if s > now - 600]
    if len(recent) >= AGENT_RESTART_LOOP_LIMIT:
        note(f"agent restart request: {len(recent)} restarts in the last 10 minutes — refused")
        return 0
    try:
        # Recorded before the restart, so one that dies halfway still counts.
        atomic_write_private(AGENT_RESTART_LEDGER, json.dumps({"boot": boot, "stamps": recent + [now]}).encode("utf-8"))
    except OSError:
        note("agent restart request: the restart ledger cannot be written — refused")
        return 0
    note("agent restart request: one service restart")
    restart_service("agent restart")
    return 0


def atomic_write_checkpoint(timestamp: int) -> None:
    payload = json.dumps({"ts": timestamp}, separators=(",", ":")).encode("utf-8")
    atomic_write_private(STATE_FILE, payload)


def main() -> int:
    if not MESSAGES_DB.exists():
        return 0
    chat = owner()
    if not chat:
        return 0
    descriptor = open_lifecycle_lock(LIFECYCLE_LOCK)
    if descriptor is None:
        # Do not scan or checkpoint while another recovery owns the lifecycle:
        # the next cron tick retries from the same durable boundary.
        return 0
    try:
        try:
            checkpoint = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        except FileNotFoundError:
            if os.path.lexists(STATE_FILE):
                return 0
            last = int((time.time() - 120) * 1000)  # first run: only look 2 min back
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            return 0
        else:
            if not isinstance(checkpoint, dict):
                return 0
            last = checkpoint.get("ts")
            if isinstance(last, bool) or not isinstance(last, int) or last < 0:
                return 0

        try:
            conn = sqlite3.connect(f"file:{MESSAGES_DB}?mode=ro", uri=True, timeout=2)
            columns = {row[1] for row in conn.execute("PRAGMA table_info(messages)")}
            chats = control_chats(chat) if "user_id" in columns else {chat}
            placeholders = ",".join("?" for _ in chats)
            rows = conn.execute(
                f"SELECT ts,text,chat_id FROM messages WHERE chat_id IN ({placeholders}) "
                "AND direction='in' AND ts>? "
                + ("AND chat_id=user_id " if "user_id" in columns else "")
                + "ORDER BY ts", (*sorted(chats), last)).fetchall()
            latest_out_by_chat = dict(conn.execute(
                f"SELECT chat_id,MAX(ts) FROM messages WHERE chat_id IN ({placeholders}) "
                "AND direction='out' GROUP BY chat_id", tuple(sorted(chats))).fetchall())
            conn.close()
        except Exception:
            return 0

        triggers: dict[str, list[tuple[int, bool]]] = {}
        newest = last
        for ts, text, sender_chat in rows:
            newest = max(newest, ts)
            if text and TRIGGER.match(text.strip()):
                explicit_restart = text.strip().lower() == '/restart'
                # The owner's bare /unstick is the out-of-band whole-service
                # escape hatch. A superadmin's /unstick is handled by the
                # corporate runtime for that person's own conversation.
                if sender_chat == chat or explicit_restart:
                    triggers.setdefault(sender_chat, []).append((ts, explicit_restart))

        # Preserve the existing at-most-once command semantics by checkpointing
        # before the first side effect. Non-trigger advancement uses the same lock
        # so an older scan can never roll a completed /unstick checkpoint back.
        atomic_write_checkpoint(newest)
        agent_request = take_agent_restart_request()
        # Any restart from here on, the owner's included, must not resume a session the filter stopped.
        stopped = stopped_session()
        if stopped is not None:
            begin_safety_restart(stopped)
        safety = safety_pending()
        if not triggers:
            if safety is not None:
                return finish_safety_restart(chat, safety)
            return restart_for_agent() if agent_request else 0
        authorized = control_chats(owner())
        active: dict[str, bool] = {}
        for sender, commands in triggers.items():
            if sender not in authorized:
                continue
            latest_out = max(latest_out_by_chat.get(sender, 0), fallback_outbound(sender))
            pending = [explicit for ts, explicit in commands if explicit or latest_out <= ts]
            if pending:
                active[sender] = all(pending)  # Any unanswered /unstick requests the hold.
        if not active:
            note("/unstick commands already answered or no longer authorized — restart skipped")
            if safety is not None:
                return finish_safety_restart(chat, safety)
            return restart_for_agent() if agent_request else 0
        needs_hold = any(not explicit for explicit in active.values())

        if restart_hold_active():
            for sender in active:
                send(sender, "🛠 Зараз триває оновлення — перезапускати мене саме "
                             "зараз небезпечно, це перерве його на півдорозі. "
                             "Напиши ще раз за кілька хвилин.")
            return 0

        loops = recent_restarts()
        if needs_hold:
            until = int(time.time()) + HOLD_SECONDS
            atomic_write_private(RESTART_HOLD_BY_UNSTICK, str(until).encode("ascii"))
            atomic_write_restart_hold(until)
            note(f"/unstick from authorized chat: holding automatic restarts {HOLD_SECONDS // 60}m, "
                 f"restarts in last 10m={loops}")
        else:
            note('/restart from authorized chat: one service restart, automatic recovery remains enabled')

        verdict = (f"Автоперезапуски вимкнено на {HOLD_SECONDS // 60} хв — "
                   f"сторож перезапускав мене {loops} разів за 10 хвилин, саме це й заважало."
                   if loops >= 2 else
                   f"Автоперезапуски вимкнено на {HOLD_SECONDS // 60} хв, щоб нічого не заважало.")
        command_name = '/unstick' if needs_hold else '/restart'
        if agent_request:
            note(f"agent restart request: covered by the owner's {command_name}")
        stop_ok, start_ok = restart_service(command_name)
        # Telegram sends can take 20 seconds each including fallback evidence.
        # They must not consume the 180-second cron budget before service
        # recovery, after the commands have already been checkpointed.
        for sender, explicit_restart in active.items():
            if not stop_ok or not start_ok:
                send(sender, "🛠 Прийнято, але я не зміг перезапуститися. Твої запити збережено; "
                             "якщо за кілька хвилин я не відповім — напиши нам.")
            elif explicit_restart:
                send(sender, "🔄 Прийнято. Службу перезапущено один раз.")
            else:
                send(sender, f"🛠 Прийнято. {verdict} Службу перезапущено один раз — "
                             "збережені запити залишаються в черзі.")
        return 0
    finally:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
        finally:
            os.close(descriptor)


if __name__ == "__main__":
    # Cron cancellation must unwind through the service-start finally block.
    signal.signal(signal.SIGTERM, lambda signum, _frame: sys.exit(128 + signum))
    raise SystemExit(main())
