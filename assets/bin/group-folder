#!/usr/bin/env python3
"""The shared work folder of a group or topic: the same folder its company conversation sees (owner, 21.10.2026).

Work the owner's own session does for a group goes here, so the group's conversation can go on with it whoever writes
next. usage: group-folder <group chat_id> [topic thread_id]
"""
import hashlib
import os
import re
import sys
from pathlib import Path


def main() -> int:
    args = sys.argv[1:]
    if len(args) not in (1, 2) or not re.fullmatch(r"-\d{1,20}", args[0]) or (len(args) == 2 and not re.fullmatch(r"\d{1,10}", args[1])):
        print("usage: group-folder <group chat_id> [topic thread_id]", file=sys.stderr)
        return 2
    key = f"group:{args[0]}" if len(args) == 1 else f"topic:{args[0]}:{args[1]}"
    root = Path(os.environ.get("AGENT_ROOT") or os.environ.get("HOME") or "/home/claude")
    folder = root / "corporate-workspaces" / "shared" / hashlib.sha256(key.encode()).hexdigest()[:24]
    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(folder, 0o700)
    print(folder)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
