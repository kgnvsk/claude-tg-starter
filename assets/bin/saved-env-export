#!/usr/bin/env python3
"""Parse persisted shell-style settings as data and emit NUL pairs."""

import os
import shlex
import sys
from pathlib import Path


EXPORTABLE = {
    "ACTIVE_ROLES", "AGENT_ROLE",
    "ADDITIONAL_ADMIN_CHAT_IDS", "AGENT_NAME", "ALERT_COPY_CHAT_IDS",
    "BOT_USERNAME", "BUN_EXECUTABLE", "CALENDAR_EMAIL", "CHANNEL_ID",
    "CLAUDE_EXECUTABLE",
    "GOG_KEYRING_BACKEND", "GOG_KEYRING_PASSWORD",
    "MAX_ATTEMPTS", "MODULE_CHANNEL_PUBLISH",
    "MODULE_DESIGN_PACK", "MODULE_INSTAGRAM_DM",
    "MODULE_SOCIAL_BROWSER", "MODULE_TELEGRAM_CORPORATE", "MODULE_TRANSPORT_DAEMON",
    "MEMORY_EMBEDDINGS_OPENAI", "MODULE_VAULT_WEB", "MODULE_YOUTUBE_COMMENTS",
    "OPENAI_API_KEY", "NOVSKY_LICENSE_KEY",
    "OWNER_CHAT_ID", "OWNER_EMAIL", "OWNER_NAME", "OWNER_NOTICE_LOCALE",
    "OWNER_TG_USERNAME", "RECALL_API_KEY", "RECALL_REGION",
    "RETRY_INITIAL_MS", "RETRY_MAX_MS",
    "SITE_PASSWORD", "TELEGRAM_BOT_TOKEN", "TG_CORPORATE_SESSIONS",
    "TG_DELIVERY_AUTHORITY", "TG_DROP_PENDING_ON_BOOT",
    "TIMEZONE", "VAULT_LOCALE", "VOICE_SETUP_STATUS",
    "WORKER_TIMEOUT_MS",
}

# Accepted only so an environment written by the former experimental runtime
# can upgrade to stable main. These values must not re-enter the process env.
RETIRED = {
    "MODULE_GRAPHIFY",
    "MODULE_MULTI_USER", "ADMIN_CHAT_IDS", "CREATIVE_OPERATOR_IDS",
    "INSTAGRAM_OPERATOR_IDS", "GUEST_ACCESS_MODE", "MAX_WORKERS",
    "WORKER_TIMEOUT_FULL_MS", "WORKER_TIMEOUT_CREATIVE_MS",
    "WORKER_TIMEOUT_INSTAGRAM_MS", "WORKER_TIMEOUT_GUEST_MS",
    "GUEST_RETENTION_DAYS", "RETENTION_CLEANUP_INTERVAL_MS",
    "CODEX_EXECUTABLE", "OPENAI_API_KEY_FILE",
    "INSTAGRAM_DM_REPORT_EXECUTABLE", "INSTAGRAM_COMMENT_REPORT_EXECUTABLE",
    "INSTAGRAM_TOP_REPORT_EXECUTABLE", "INSTAGRAM_WEB_REPORT_EXECUTABLE",
}
ALLOWED = EXPORTABLE | RETIRED
ANSI_C_ESCAPES = {"a": 7, "b": 8, "e": 27, "E": 27, "f": 12, "n": 10, "r": 13, "t": 9, "v": 11,
                  "\\": 92, "'": 39, '"': 34, "?": 63}
OCTAL, HEX = "01234567", "0123456789abcdefABCDEF"


def ansi_c_value(raw: str, name: str, number: int) -> str:
    """Bash's %q wrote $'…' for non-ASCII under `env -i` in older updates (Cash, 29.10.2026): read the escapes it
    uses, as data; anything else in that form is still refused."""
    invalid = ValueError(f"invalid saved value for {name} on line {number}")
    if len(raw) < 3 or not raw.endswith("'"):
        raise invalid
    body, out, index = raw[2:-1], bytearray(), 0
    while index < len(body):
        char = body[index]
        if char == "'":
            raise invalid
        if char != "\\":
            out += char.encode("utf-8")
            index += 1
            continue
        index += 1
        char = body[index] if index < len(body) else ""
        if char in ANSI_C_ESCAPES:
            out.append(ANSI_C_ESCAPES[char])
            index += 1
        elif char and char in OCTAL:
            end = index
            while end < len(body) and end - index < 3 and body[end] in OCTAL:
                end += 1
            out.append(int(body[index:end], 8) & 0xFF)
            index = end
        elif char == "x" and index + 1 < len(body) and body[index + 1] in HEX:
            end = index + 1
            while end < len(body) and end - index - 1 < 2 and body[end] in HEX:
                end += 1
            out.append(int(body[index + 1:end], 16))
            index = end
        else:
            raise invalid
    try:
        return out.decode("utf-8")
    except UnicodeDecodeError:
        raise invalid from None


def parse(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        name, separator, raw = line.partition("=")
        if not separator or name not in ALLOWED or name in values:
            raise ValueError(f"invalid saved setting on line {number}")
        if raw.startswith("$'"):
            value = ansi_c_value(raw, name, number)
        elif raw == "":
            value = ""
        else:
            lexer = shlex.shlex(raw, posix=True)
            lexer.whitespace_split = True
            lexer.commenters = ""
            tokens = list(lexer)
            if len(tokens) != 1:
                raise ValueError(f"invalid saved value for {name} on line {number}")
            value = tokens[0]
        # Readers split on NUL (saved-env-export prints NUL pairs): none in any form.
        if "\0" in value:
            raise ValueError(f"invalid saved value for {name} on line {number}")
        values[name] = value
    return values


def main() -> None:
    value_mode = len(sys.argv) == 4 and sys.argv[1] == "--value"
    if value_mode:
        path = sys.argv[2]
        requested = [sys.argv[3]]
    else:
        if len(sys.argv) < 2:
            raise SystemExit("usage: saved-env-export PATH [NAME ...]")
        path = sys.argv[1]
        requested = sys.argv[2:]
    if any(name not in EXPORTABLE for name in requested):
        raise SystemExit("requested setting is not allowlisted")
    try:
        values = parse(Path(path))
    except (OSError, UnicodeError, ValueError) as error:
        raise SystemExit(str(error)) from error
    if value_mode:
        sys.stdout.write(values.get(requested[0], ""))
        return
    names = requested or [name for name in values if name in EXPORTABLE]
    for name in names:
        if name in values:
            os.write(1, name.encode() + b"\0" + values[name].encode() + b"\0")


if __name__ == "__main__":
    main()
