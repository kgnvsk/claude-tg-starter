#!/usr/bin/env python3
"""Commit and push a secret-free agent backup to its private Git repository."""

from __future__ import annotations

import argparse
from collections import deque
from datetime import datetime, timezone
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path, PurePosixPath
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
from types import ModuleType
from urllib import error as urlerror, request
from zoneinfo import ZoneInfo, ZoneInfoNotFoundError


_NOTICE_SPEC = importlib.util.spec_from_file_location(
    "agent_notice_locale", Path(__file__).with_name("agent_notice_locale.py")
)
_NOTICE_MODULE = importlib.util.module_from_spec(_NOTICE_SPEC)
_NOTICE_SPEC.loader.exec_module(_NOTICE_MODULE)


HOME = Path.home()
VAULT = HOME / "obsidian-vault"
STATE_DIR = HOME / ".local/state/agent-github-backup"
STATE_PATH = STATE_DIR / "state.json"
NIGHTLY_SLOT_PATH = STATE_DIR / "nightly-slot"
LOCK_PATH = STATE_DIR / "run.lock"
KEY_PATH = STATE_DIR / "github-backup-ed25519"
PROFILE_PATH = HOME / ".agent-profile.env"
GITHUB_REMOTE = re.compile(
    r"^(?:git@github\.com:|ssh://git@github\.com/)"
    r"([A-Za-z0-9](?:[A-Za-z0-9-]{0,38}))/"
    r"([A-Za-z0-9][A-Za-z0-9_.-]{0,99})\.git$"
)
SHA = re.compile(r"^[0-9a-f]{40}$")
PROFILE_NAME = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
TIMEZONE_NAME = re.compile(r"^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$")
SLOT = re.compile(r"^\d{4}-\d{2}-\d{2}T(?:09|21)$")
# A local-date backup can be 25 hours apart across Lisbon's autumn DST shift.
MAX_SUCCESS_AGE_SECONDS = 27 * 60 * 60


class BackupError(RuntimeError):
    def __init__(self, code: str):
        super().__init__(code)
        self.code = code


def run_process(
    command: list[str],
    *,
    cwd: Path | None = None,
    environment: dict[str, str] | None = None,
    input_bytes: bytes | None = None,
    timeout: int = 60,
) -> subprocess.CompletedProcess[bytes]:
    try:
        return subprocess.run(
            command,
            cwd=cwd,
            env=environment,
            input=input_bytes,
            capture_output=True,
            check=False,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise BackupError("command-unavailable") from error


def clean_git_environment() -> dict[str, str]:
    environment = {
        name: value for name, value in os.environ.items()
        if not name.startswith("GIT_")
    }
    environment.update(
        GIT_CONFIG_GLOBAL=os.devnull,
        GIT_CONFIG_NOSYSTEM="1",
        GIT_TERMINAL_PROMPT="0",
        GIT_NO_REPLACE_OBJECTS="1",
        GIT_GRAFT_FILE=os.devnull,
    )
    return environment


def git(
    *arguments: str,
    environment: dict[str, str] | None = None,
    input_bytes: bytes | None = None,
    timeout: int = 60,
) -> subprocess.CompletedProcess[bytes]:
    return run_process(
        ["git", *arguments],
        cwd=VAULT,
        environment=environment if environment is not None else clean_git_environment(),
        input_bytes=input_bytes,
        timeout=timeout,
    )


def decoded(result: subprocess.CompletedProcess[bytes]) -> str:
    return result.stdout.decode("utf-8", errors="strict").strip()


def require_success(
    result: subprocess.CompletedProcess[bytes],
    code: str,
) -> subprocess.CompletedProcess[bytes]:
    if result.returncode != 0:
        raise BackupError(code)
    return result


def ensure_state_dir() -> None:
    current = HOME
    for part in (".local", "state"):
        current = current / part
        if current.is_symlink() or (current.exists() and not current.is_dir()):
            raise BackupError("state-unsafe")
    STATE_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    if STATE_DIR.is_symlink() or not STATE_DIR.is_dir():
        raise BackupError("state-unsafe")
    os.chmod(STATE_DIR, 0o700)


def lock_run():
    ensure_state_dir()
    descriptor = os.open(
        LOCK_PATH,
        os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0),
        0o600,
    )
    metadata = os.fstat(descriptor)
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
        os.close(descriptor)
        raise BackupError("state-unsafe")
    os.chmod(LOCK_PATH, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(descriptor)
        raise BackupError("busy")
    return descriptor


def load_state() -> dict:
    if STATE_PATH.is_symlink():
        raise BackupError("state-unsafe")
    if not STATE_PATH.exists():
        return {
            "schemaVersion": 1,
            "remoteIdentity": None,
            "publicKeyFingerprint": None,
            "privateConfirmed": False,
            "lastSuccessfulRevision": None,
            "lastSuccessfulAt": None,
            "completedSlots": {},
        }
    metadata = STATE_PATH.lstat()
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_nlink != 1
        or stat.S_IMODE(metadata.st_mode) != 0o600
        or metadata.st_size > 64 * 1024
    ):
        raise BackupError("state-unsafe")
    try:
        state = json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise BackupError("state-invalid") from error
    expected = {
        "schemaVersion",
        "remoteIdentity",
        "publicKeyFingerprint",
        "privateConfirmed",
        "lastSuccessfulRevision",
        "lastSuccessfulAt",
        "completedSlots",
    }
    if (
        not isinstance(state, dict)
        or set(state) != expected
        or state["schemaVersion"] != 1
        or not isinstance(state["privateConfirmed"], bool)
        or not isinstance(state["completedSlots"], dict)
    ):
        raise BackupError("state-invalid")
    for key in ("remoteIdentity", "publicKeyFingerprint", "lastSuccessfulRevision", "lastSuccessfulAt"):
        if state[key] is not None and not isinstance(state[key], str):
            raise BackupError("state-invalid")
    revision = state["lastSuccessfulRevision"]
    if revision is not None and not SHA.fullmatch(revision):
        raise BackupError("state-invalid")
    slots = state["completedSlots"]
    if len(slots) > 64 or any(
        not isinstance(slot, str)
        or SLOT.fullmatch(slot) is None
        or not isinstance(completed_at, str)
        or len(completed_at) > 64
        for slot, completed_at in slots.items()
    ):
        raise BackupError("state-invalid")
    return state


def write_state(state: dict) -> None:
    ensure_state_dir()
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=".state.json.",
        dir=STATE_DIR,
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(state, handle, ensure_ascii=False, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, STATE_PATH)
    finally:
        temporary.unlink(missing_ok=True)


def load_nightly_slot() -> str | None:
    if NIGHTLY_SLOT_PATH.is_symlink():
        raise BackupError("state-unsafe")
    if not NIGHTLY_SLOT_PATH.exists():
        return None
    metadata = NIGHTLY_SLOT_PATH.lstat()
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_nlink != 1
        or stat.S_IMODE(metadata.st_mode) != 0o600
        or metadata.st_size > 32
    ):
        raise BackupError("state-unsafe")
    try:
        slot = NIGHTLY_SLOT_PATH.read_text(encoding="ascii").strip()
        if datetime.fromisoformat(slot).date().isoformat() != slot:
            raise ValueError("date is not canonical")
    except (OSError, UnicodeError, ValueError) as error:
        raise BackupError("state-invalid") from error
    return slot


def write_nightly_slot(slot: str) -> None:
    ensure_state_dir()
    descriptor, temporary_name = tempfile.mkstemp(prefix=".nightly-slot.", dir=STATE_DIR)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="ascii") as handle:
            handle.write(slot + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, NIGHTLY_SLOT_PATH)
    finally:
        temporary.unlink(missing_ok=True)


def profile_timezone() -> str:
    try:
        descriptor = os.open(
            PROFILE_PATH,
            os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0),
        )
    except OSError as error:
        raise BackupError("timezone-invalid") from error
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != os.geteuid()
            or stat.S_IMODE(metadata.st_mode) & 0o077
            or metadata.st_size > 64 * 1024
        ):
            raise BackupError("timezone-invalid")
        with os.fdopen(descriptor, "r", encoding="utf-8") as handle:
            descriptor = -1
            content = handle.read(64 * 1024 + 1)
    except (OSError, UnicodeError) as error:
        raise BackupError("timezone-invalid") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    if len(content.encode("utf-8")) > 64 * 1024:
        raise BackupError("timezone-invalid")
    values: dict[str, str] = {}
    for line in content.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if stripped.startswith("export "):
            stripped = stripped[7:].lstrip()
        name, separator, raw = stripped.partition("=")
        if not separator or PROFILE_NAME.fullmatch(name) is None or name in values:
            raise BackupError("timezone-invalid")
        if raw.startswith("$'"):
            raise BackupError("timezone-invalid")
        try:
            parsed = shlex.split(raw, posix=True) if raw else [""]
        except ValueError as error:
            raise BackupError("timezone-invalid") from error
        if len(parsed) != 1:
            raise BackupError("timezone-invalid")
        values[name] = parsed[0]
    name = values.get("TIMEZONE", "")
    if len(name) > 128 or TIMEZONE_NAME.fullmatch(name) is None:
        raise BackupError("timezone-invalid")
    try:
        ZoneInfo(name)
    except (ZoneInfoNotFoundError, ValueError) as error:
        raise BackupError("timezone-invalid") from error
    return name


def current_utc_time() -> datetime:
    configured = os.environ.get("AGENT_BACKUP_TEST_NOW")
    if configured is None or os.environ.get("AGENT_BACKUP_TESTING") != "1":
        return datetime.now(timezone.utc)
    try:
        parsed = datetime.fromisoformat(configured.replace("Z", "+00:00"))
    except ValueError as error:
        raise BackupError("clock-invalid") from error
    if parsed.tzinfo is None:
        raise BackupError("clock-invalid")
    return parsed.astimezone(timezone.utc)


def require_repository() -> None:
    if VAULT.is_symlink() or not VAULT.is_dir():
        raise BackupError("vault-unsafe")
    git_path = VAULT / ".git"
    if git_path.is_symlink() or not git_path.is_dir():
        raise BackupError("repository-missing")
    # Any local branch: the checked revision is always pushed to refs/heads/main,
    # and install-core's `git init` leaves vaults on master (Пара, 23.09.2026).
    require_success(git("symbolic-ref", "--quiet", "HEAD"), "branch-invalid")


def git_config_values(name: str) -> list[str]:
    result = git("config", "--get-all", name)
    if result.returncode == 1:
        return []
    require_success(result, "remote-invalid")
    try:
        values = result.stdout.decode("utf-8", errors="strict").splitlines()
    except UnicodeDecodeError as error:
        raise BackupError("remote-invalid") from error
    if any(not value for value in values):
        raise BackupError("remote-invalid")
    return values


def commit_author(default_name: str, default_email: str) -> tuple[str, str]:
    # The vault-web module connects this same private repo to Vercel, which
    # requires an author on the project. Its setup stores that identity locally.
    marker = VAULT / "vercel.json"
    if not marker.exists() and not marker.is_symlink():
        return default_name, default_email
    if marker.is_symlink() or not marker.is_file():
        raise BackupError("website-author-missing")

    def configured(name: str) -> str:
        result = git("config", "--local", "--get-all", name)
        if result.returncode != 0:
            raise BackupError("website-author-missing")
        try:
            values = result.stdout.decode("utf-8", errors="strict").splitlines()
        except UnicodeDecodeError as error:
            raise BackupError("website-author-missing") from error
        if len(values) != 1 or not values[0].strip() or any(ord(c) < 32 or ord(c) == 127 for c in values[0]):
            raise BackupError("website-author-missing")
        return values[0]

    name, email = configured("user.name"), configured("user.email")
    if len(name) > 256 or len(email) > 254 or not re.fullmatch(r"[^@\s<>]+@[^@\s<>]+", email):
        raise BackupError("website-author-missing")
    return name, email


def configured_push_remote() -> str:
    push_urls = git_config_values("remote.origin.pushurl")
    urls = push_urls or git_config_values("remote.origin.url")
    if len(urls) != 1:
        raise BackupError("remote-invalid")
    return urls[0]


def remote_identity() -> tuple[str, str]:
    remotes = require_success(git("remote"), "remote-invalid")
    names = [line for line in decoded(remotes).splitlines() if line]
    if names != ["origin"]:
        raise BackupError("remote-invalid")
    remote = configured_push_remote()
    require_original_destination(remote)
    return remote, validate_remote(remote)


def require_original_destination(remote: str) -> None:
    if git_config_values("remote.origin.url") != [remote]:
        raise BackupError("remote-invalid")
    for options in (("--all",), ("--push", "--all")):
        resolved = require_success(
            git("remote", "get-url", *options, "origin"), "remote-invalid"
        )
        if decoded(resolved).splitlines() != [remote]:
            raise BackupError("remote-invalid")


def validate_remote(remote: str) -> str:
    testing = os.environ.get("AGENT_BACKUP_TESTING") == "1"
    if testing:
        expected = os.environ.get("AGENT_BACKUP_TEST_REMOTE")
        if not expected:
            raise BackupError("remote-invalid")
        try:
            if Path(remote).resolve(strict=False) != Path(expected).resolve(strict=False):
                raise BackupError("remote-invalid")
        except OSError as error:
            raise BackupError("remote-invalid") from error
        return "test-local"
    match = GITHUB_REMOTE.fullmatch(remote)
    if match is None:
        raise BackupError("remote-invalid")
    return f"github:{match.group(1)}/{match.group(2)}"


def git_environment(remote: str) -> dict[str, str]:
    environment = clean_git_environment()
    if remote.startswith(("git@github.com:", "ssh://git@github.com/")):
        if KEY_PATH.is_symlink() or not KEY_PATH.is_file():
            raise BackupError("deploy-key-missing")
        metadata = KEY_PATH.stat()
        if stat.S_IMODE(metadata.st_mode) != 0o600 or metadata.st_nlink != 1:
            raise BackupError("deploy-key-unsafe")
        environment["GIT_SSH_COMMAND"] = (
            "/usr/bin/ssh -F /dev/null -i "
            + shlex.quote(str(KEY_PATH))
            + " -o IdentitiesOnly=yes -o BatchMode=yes "
            + "-o HostName=github.com -o Port=22 -o StrictHostKeyChecking=accept-new"
        )
        environment["GIT_CONFIG_GLOBAL"] = os.devnull
        environment["GIT_CONFIG_NOSYSTEM"] = "1"
        environment["GIT_TERMINAL_PROMPT"] = "0"
    return environment


def isolated_git(
    *arguments: str,
    environment: dict[str, str],
    timeout: int = 60,
) -> subprocess.CompletedProcess[bytes]:
    # Read local objects, but never use the live repository's transport config,
    # refs, URL rewrites, hooks or extra push destinations.
    with tempfile.TemporaryDirectory(prefix=".transport.", dir=STATE_DIR) as name:
        repository = Path(name)
        initialized = run_process(
            ["git", "init", "--bare", "--template=", str(repository)],
            environment=environment,
        )
        require_success(initialized, "transport-unavailable")
        objects = str(VAULT / ".git/objects")
        if "\n" in objects or "\r" in objects:
            raise BackupError("repository-unsafe")
        (repository / "objects/info/alternates").write_text(objects + "\n")
        return run_process(
            ["git", "--git-dir=" + str(repository), "-c", "core.hooksPath=/dev/null", *arguments],
            cwd=repository,
            environment=environment,
            timeout=timeout,
        )


def require_private_repository(identity: str) -> None:
    if os.environ.get("AGENT_BACKUP_TESTING") == "1":
        visibility = os.environ.get("AGENT_BACKUP_TEST_VISIBILITY", "private")
        if visibility == "private":
            return
        if visibility == "public":
            raise BackupError("repository-public")
        raise BackupError("privacy-unverified")
    prefix = "github:"
    if not identity.startswith(prefix):
        raise BackupError("privacy-unverified")
    repository = identity.removeprefix(prefix)
    probe = request.Request(
        f"https://api.github.com/repos/{repository}",
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": "agent-github-backup",
            "X-GitHub-Api-Version": "2026-03-10",
        },
    )
    try:
        with request.urlopen(probe, timeout=15) as response:
            if response.status != 200:
                raise BackupError("privacy-unverified")
            payload = response.read(64 * 1024 + 1)
    except urlerror.HTTPError as error:
        if error.code == 404:
            return
        raise BackupError("privacy-unverified") from error
    except (OSError, TimeoutError, urlerror.URLError) as error:
        raise BackupError("privacy-unverified") from error
    if len(payload) > 64 * 1024:
        raise BackupError("privacy-unverified")
    try:
        metadata = json.loads(payload)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise BackupError("privacy-unverified") from error
    if not isinstance(metadata, dict) or not isinstance(metadata.get("private"), bool):
        raise BackupError("privacy-unverified")
    if metadata["private"] is False:
        raise BackupError("repository-public")


def require_remote_access(remote: str, environment: dict[str, str]) -> None:
    result = isolated_git("ls-remote", remote, environment=environment, timeout=30)
    if result.returncode != 0:
        raise BackupError("remote-unavailable")


# The agent's own work outside the kit, for the GitHub projection only (the ZIP archive and its restore keep their
# fixed list). Cash's server was wiped on 06.11.2026 and every script the agent had written in ~/bin, its scheduled
# tasks, its rules and its tool folders were gone: the projection carried none of them. Each file is read once beneath
# HOME without following a link, and one that looks like a credential is left out alone, never the whole backup.
# agent-backup is pinned by Novsky's readiness manifest, so this lives here and joins its projection payload through
# load_backup_module.
OWN_BIN_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
OWN_COPY = re.compile(r"\.(?:bak|orig|old|tmp|swp|part)(?:[-._]|$)", re.IGNORECASE)
OWN_CREDENTIAL_NAME = re.compile(
    r"(?i)(?:^|[._-])(?:tokens?|secrets?|passwords?|passwd|credentials?|cookies?|sessions?|auth|apikey|api[_-]?key|"
    r"private[_-]?key|keyring)(?:$|[._-])|^\.env|\.session$")
# NAME=value, NAME: value or "name": "value" with any value of 6+ characters, quoted or not.
OWN_ASSIGNED = re.compile(rb"[\"']?([A-Za-z_][A-Za-z0-9_.-]*)[\"']?[\t ]*[:=][\t ]*(?:\"([^\"\n]{6,})\"|'([^'\n]{6,})'|([^\s\"',;]{6,}))")
OWN_SECRET_SHAPES = (
    re.compile(rb"\s*[A-Za-z0-9_+/=.:-]{20,}\s*"),                                       # a file that is one token
    re.compile(rb"(?i)authorization[\"']?[\t ]*[:=][\t ]*[\"']?(?:basic|bearer|token)[\t ]+[A-Za-z0-9._~+/=-]{4,}"),
    re.compile(rb"eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{4,}"),          # JWT
    re.compile(rb"(?im)^[\t ]*(?:(?:machine[\t ]+\S+|default)[\t ]+)?(?:login[\t ]+\S+[\t ]+)?password[\t ]+\S+"),  # .netrc
)
CAMEL = re.compile(r"(?<=[a-z0-9])(?=[A-Z])")
# A value that is wholly a pointer to a secret: $VAR, ${VAR}, ${VAR:?message}, $(command), %VAR%, <placeholder>.
# ${VAR:-literal} or ${VAR}literal still carry a literal and stay secret-like.
REFERENCE = re.compile(rb"\$\{[A-Za-z_][A-Za-z0-9_]*(?::?\?[^}]*)?\}|\$[A-Za-z_][A-Za-z0-9_]*|\$\([^)]*\)"
                       rb"|%[A-Za-z_][A-Za-z0-9_]*%|<[A-Za-z_ -]+>")
OWN_MAX_SCANNED = 20000
OWN_MAX_BYTES = 1024 * 1024
OWN_MAX_FILES = 2000
OWN_MAX_TOTAL = 50 * 1024 * 1024
BACKUP_INCLUDE = Path(".claude/product/backup-include.txt")
OWN_ROOTS = (Path(".local/share/agent-rules"),)
OWN_SENSITIVE = (Path(".ssh"), Path(".gnupg"), Path(".claude/channels"), Path(".claude/personal-inbox"),
                 Path(".local/state/agent-full-backup"), Path(".local/state/agent-github-backup"), Path(".config/novsky"),
                 Path(".config/gh"), Path(".config/gogcli"), Path(".local/share/gogcli"))
CRONTAB_NAME = "home/.local/state/agent-backup/crontab.txt"


def kit_owned_bin(home: Path) -> set[str]:
    """~/bin names the kit and its modules install: they come back with a reinstall, not from this backup (an old copy
    restored over a newer kit would roll it back)."""
    names = set()
    for kit in (Path("/opt/claude-tg-starter"), Path(f"/opt/claude-tg-starter@{home.name}")):
        for folder in [kit / "assets/bin", *sorted(kit.glob("modules/*/bin"))]:
            if folder.is_dir():
                names.update("bin/" + entry.name for entry in folder.iterdir())
    for record in [home / ".claude/product/managed-runtime-baseline.json",
                   *sorted((home / ".claude/product/modules").glob("*.files.json"))]:
        try:
            data = json.loads(record.read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            continue
        files = data.get("files") if isinstance(data, dict) and isinstance(data.get("files"), dict) else data
        if isinstance(files, dict):
            names.update(name for name in files if isinstance(name, str))
    return names


def own_secret(backup: ModuleType, data: bytes) -> bool:
    """contains_secret, plus what a credential looks like without a known vendor shape: a file that is one long token,
    or a NAME=value / "name": "value" whose name says key, token, secret or password."""
    if backup.contains_secret(data) or backup.URL_LOGIN.search(data) or OWN_SECRET_SHAPES[0].fullmatch(data):
        return True
    if any(shape.search(data) for shape in OWN_SECRET_SHAPES[1:]):
        return True
    for match in OWN_ASSIGNED.finditer(data):
        value = match.group(2) or match.group(3) or match.group(4) or b""
        if REFERENCE.fullmatch(value.rstrip(b"}") if value.count(b"}") > value.count(b"{") else value):
            continue  # ${API_TOKEN:?missing}, $(cat file), %TOKEN%: a pointer to a secret, not the secret
        name = CAMEL.sub("_", match.group(1).decode("utf-8", "replace")).upper().replace("-", "_").replace(".", "_")
        if backup.CREDENTIAL_ENV_NAME.search(name):
            return True
    return False


def read_beneath(home: Path, relative: Path) -> tuple[bytes, int] | None:
    """A small regular UTF-8 text file read through directory descriptors opened without following links."""
    directory = os.open(home, os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in relative.parts[:-1]:
            inner = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
            os.close(directory)
            directory = inner
        descriptor = os.open(relative.parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
    except OSError:
        os.close(directory)
        return None
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size > OWN_MAX_BYTES:
            return None
        chunks, size = [], 0
        while size <= OWN_MAX_BYTES:
            chunk = os.read(descriptor, 65536)
            if not chunk:
                break
            chunks.append(chunk)
            size += len(chunk)
        data = b"".join(chunks)
        if len(data) > OWN_MAX_BYTES or b"\0" in data:
            return None
        data.decode("utf-8")
        return data, stat.S_IMODE(info.st_mode)
    except (OSError, UnicodeDecodeError):
        return None
    finally:
        os.close(descriptor)
        os.close(directory)


def agent_crontab(home: Path) -> bytes | None:
    """The agent's own crontab, read only as the agent itself; it goes to the projection, nothing is written."""
    if os.geteuid() != home.stat().st_uid:
        return None
    if os.environ.get("AGENT_BACKUP_TESTING") == "1":
        fixture = home / ".test-crontab"
        return fixture.read_bytes() if fixture.is_file() else None
    try:
        result = subprocess.run(["crontab", "-l"], capture_output=True, timeout=30, check=False)
    except (OSError, subprocess.SubprocessError):
        return None
    return result.stdout if result.returncode == 0 and result.stdout.strip() else None


class ScanBudget(Exception):
    """The own-work scan saw more than OWN_MAX_SCANNED directory entries."""


def own_candidates(backup: ModuleType, listed_bytes: bytes | None):
    """Own-work paths, lazily: ~/bin outside the kit, reminder tasks, then the rules store and the listed folders.
    Every directory entry seen counts toward OWN_MAX_SCANNED, so one huge folder cannot make the walk unbounded; when
    the budget is spent it yields None once and stops."""
    home, seen = backup.HOME, 0

    def entries(base: Path):
        nonlocal seen
        try:
            with os.scandir(base) as found:
                for entry in found:
                    seen += 1
                    if seen > OWN_MAX_SCANNED:
                        raise ScanBudget
                    yield entry
        except OSError:
            return

    kit = kit_owned_bin(home)
    try:
        for folder in (Path("bin"), Path(".atarax/reminders")):
            base = home / folder
            if base.is_symlink() or not base.is_dir():
                continue
            for entry in entries(base):
                if not entry.is_file(follow_symlinks=False):
                    continue
                if folder == Path("bin") and (not OWN_BIN_NAME.fullmatch(entry.name) or "bin/" + entry.name in kit):
                    continue
                if folder != Path("bin") and not entry.name.endswith(".rem"):
                    continue
                yield folder / entry.name
        roots = list(OWN_ROOTS)
        for line in (listed_bytes or b"").decode("utf-8").splitlines():
            entry = line.split("#", 1)[0].strip()
            relative = Path(entry)
            if entry and not relative.is_absolute() and ".." not in relative.parts and not entry.startswith("~"):
                roots.append(relative)
        for root in roots:
            if any(root == place or place in root.parents or root in place.parents for place in OWN_SENSITIVE):
                continue
            base = home / root
            if base.is_symlink() or not base.exists():
                continue
            if base.is_file():
                yield root
                continue
            pending = [base]
            while pending:
                folder = pending.pop()
                for entry in entries(folder):
                    if entry.is_dir(follow_symlinks=False):
                        if entry.name not in backup.EXCLUDED_DIRS:
                            pending.append(Path(entry.path))
                    elif entry.is_file(follow_symlinks=False):
                        yield Path(entry.path).relative_to(home)
    except ScanBudget:
        yield None


def own_work_payload(backup: ModuleType, taken: set[str]) -> list[tuple[str, bytes, int]]:
    listed = read_beneath(backup.HOME, BACKUP_INCLUDE)
    payload, total, cut = [], 0, None
    if listed is not None and not own_secret(backup, listed[0]):
        payload.append(("home/" + BACKUP_INCLUDE.as_posix(), listed[0], listed[1]))
        taken.add(payload[-1][0])
        total += len(listed[0])
    crontab = agent_crontab(backup.HOME)
    if crontab is not None and CRONTAB_NAME not in taken and not own_secret(backup, crontab) and len(crontab) <= OWN_MAX_BYTES:
        payload.append((CRONTAB_NAME, crontab, 0o600))
        taken.add(CRONTAB_NAME)
        total += len(crontab)
    name = "(the start)"
    for relative in own_candidates(backup, listed[0] if listed else None):
        if relative is None:
            cut = f"scanned more than {OWN_MAX_SCANNED} paths"
            break
        name = "home/" + relative.as_posix()
        if (name in taken or OWN_COPY.search(relative.name) or OWN_CREDENTIAL_NAME.search(relative.name)
                or backup.is_excluded(relative)):
            continue
        read = read_beneath(backup.HOME, relative)
        if read is None or own_secret(backup, read[0]):
            continue
        if len(payload) >= OWN_MAX_FILES or total + len(read[0]) > OWN_MAX_TOTAL:
            cut = f"over {OWN_MAX_FILES} files or {OWN_MAX_TOTAL // (1024 * 1024)} MB"
            break
        payload.append((name, read[0], read[1]))
        taken.add(name)
        total += len(read[0])
    if cut:
        # A cut backup says so inside itself, so nobody takes it for the whole of the agent's own work.
        note = (f"The agent's own work was cut at {name}: {cut}. Files after it in ~/bin, reminders, rules or the "
                f"listed folders are not in this backup.\n").encode()
        payload.append(("home/.local/state/agent-backup/own-work-incomplete.txt", note, 0o600))
        print("agent-github-backup: own work cut: " + cut, file=sys.stderr)
    return payload


def load_backup_module() -> ModuleType:
    path = Path(__file__).with_name("agent-backup")
    loader = importlib.machinery.SourceFileLoader("agent_backup_projection", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise BackupError("projection-unavailable")
    module = importlib.util.module_from_spec(spec)
    try:
        loader.exec_module(module)
    except (OSError, ValueError) as error:
        raise BackupError("projection-unavailable") from error
    # A Python environment (any folder with pyvenv.cfg) is rebuilt by whatever made it and never backed up: a skill's
    # 623 MB .venv held a library over GitHub's file limit and stopped every nightly backup (Cash, 29.10.2026).
    # agent-backup's own exclusions are pinned by Novsky's readiness manifest, so the rule lives here.
    # Only outside the vault (its tracked files keep their old rule), and only a real marker file: a linked
    # pyvenv.cfg must not hide a folder's own files (Codex review).
    listed = module.is_excluded
    home = module.HOME

    def environment_marker(folder: Path) -> bool:
        try:
            return stat.S_ISREG((home / folder / "pyvenv.cfg").lstat().st_mode)
        except OSError:
            return False

    def is_excluded(relative: Path) -> bool:
        if listed(relative):
            return True
        if relative.parts[:1] == ("obsidian-vault",):
            return False
        return any(environment_marker(Path(*relative.parts[:depth])) for depth in range(1, len(relative.parts)))

    module.is_excluded = is_excluded
    read_safe_file = module.read_safe_file

    def read_masked(source: Path, archive_name: str) -> tuple[bytes, int]:
        if archive_name != SETTINGS_NAME:
            return read_safe_file(source, archive_name)
        check = module.contains_secret
        module.contains_secret = lambda _data: False  # the masked bytes are checked right below
        try:
            data, mode = read_safe_file(source, archive_name)
        finally:
            module.contains_secret = check
        data = masked_settings(data, module.SECRET_PATTERNS)
        if check(data):
            raise ValueError(f"secret-like content detected: {archive_name}")
        return data, mode

    module.read_safe_file = read_masked
    selected_payload = module.selected_payload

    def with_own_work(*, include_vault: bool) -> list[tuple[str, bytes, int]]:
        payload = selected_payload(include_vault=include_vault)
        if not include_vault:  # create_projection; the ZIP archive keeps its fixed list
            payload += own_work_payload(module, {name for name, _, _ in payload})
        return payload

    module.selected_payload = with_own_work
    return module


# settings.json env holds a process's credentials under any vendor's name (FAL_KEY, a custom token, a password inside a
# database URL), which agent-backup's patterns do not know, so the value went to the GitHub copy (audit 20.10.2026; the
# fix 31fc079c was lost in the V2 switch of 29.10, partner report 31.10). agent-backup masks them again since 01.11.2026
# (its released bytes of 20.10, which Novsky's readiness manifest already accepts); this copy keeps its own masking for
# an agent whose agent-backup stayed older. restore-agent-backup puts the live value back.
SETTINGS_NAME = "home/.claude/settings.json"
REDACTED = "[REDACTED]"
CREDENTIAL_ENV_NAME = re.compile(
    r"(?:^|_)(?:API_?KEY|KEY|TOKEN|SECRET|PASSWORD|PASSWD|PASSPHRASE|PAT|COOKIES?|CREDENTIALS?)(?:_|$)"
    r"|(?:TOKEN|SECRET|PASSWORD|APIKEY)$"
)
URL_LOGIN = re.compile(rb"[A-Za-z][A-Za-z0-9+.-]*://[^\s/:@]+:[^\s/@]+@")


def masked_settings(data: bytes, patterns) -> bytes:
    """settings.json with each credential-like env value as [REDACTED]; the same bytes when none is."""
    try:
        settings = json.loads(data)
    except ValueError as error:
        raise ValueError(f"unreadable JSON: {SETTINGS_NAME}") from error
    env = settings.get("env") if isinstance(settings, dict) else None
    if not isinstance(env, dict):
        return data
    masked = False
    for name, value in env.items():
        if value in ("", None, REDACTED):
            continue
        text = str(value).encode()
        if (CREDENTIAL_ENV_NAME.search(name.upper().replace("-", "_"))
                or URL_LOGIN.search(text) or any(pattern.search(text) for pattern in patterns)):
            env[name] = REDACTED
            masked = True
    return (json.dumps(settings, ensure_ascii=False, indent=2) + "\n").encode() if masked else data


def safe_vault_paths(backup: ModuleType) -> set[str]:
    paths: set[str] = set()
    try:
        selected = backup.selected_files(include_vault=True)
        for source, archive_name in selected:
            prefix = "home/obsidian-vault/"
            if not archive_name.startswith(prefix):
                continue
            backup.read_safe_file(source, archive_name)
            relative = archive_name.removeprefix(prefix)
            pure = PurePosixPath(relative)
            if pure.is_absolute() or ".." in pure.parts or not pure.parts:
                raise ValueError("unsafe vault path")
            paths.add(pure.as_posix())
    except (OSError, ValueError) as error:
        raise BackupError("unsafe-content") from error
    return paths


def project_external_state(backup: ModuleType) -> set[str]:
    output = VAULT / ".agent-backup"
    try:
        backup.create_projection(output)
    except (OSError, ValueError) as error:
        raise BackupError("unsafe-content") from error
    paths: set[str] = set()
    for source in output.rglob("*"):
        if source.is_symlink():
            raise BackupError("projection-unsafe")
        if source.is_file():
            paths.add(source.relative_to(VAULT).as_posix())
    if ".agent-backup/manifest.json" not in paths:
        raise BackupError("projection-unsafe")
    return paths


def clean_index() -> None:
    result = git("diff", "--cached", "--quiet", "--no-ext-diff")
    if result.returncode not in (0, 1):
        raise BackupError("index-invalid")
    if result.returncode == 1:
        raise BackupError("index-dirty")


def tracked_paths() -> set[str]:
    result = require_success(git("ls-files", "-z"), "index-invalid")
    try:
        return {
            value.decode("utf-8", errors="strict")
            for value in result.stdout.split(b"\0")
            if value
        }
    except UnicodeDecodeError as error:
        raise BackupError("index-invalid") from error


def tracked_path_allowed(backup: ModuleType, relative: str) -> bool:
    path = PurePosixPath(relative)
    if path.is_absolute() or ".." in path.parts or not path.parts:
        return False
    if path.parts[0] == ".agent-backup":
        return True
    return not backup.is_excluded(Path("obsidian-vault") / Path(*path.parts))


def index_backup() -> tuple[Path, bytes | None, int | None]:
    path = VAULT / ".git/index"
    if not path.exists():
        return path, None, None
    metadata = path.stat()
    return path, path.read_bytes(), stat.S_IMODE(metadata.st_mode)


def restore_index(snapshot: tuple[Path, bytes | None, int | None]) -> None:
    path, data, mode = snapshot
    if data is None:
        path.unlink(missing_ok=True)
        return
    descriptor, temporary_name = tempfile.mkstemp(prefix=".index.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode or 0o644)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def stage_paths(paths: set[str], backup: ModuleType) -> None:
    tracked = tracked_paths()
    if any(not tracked_path_allowed(backup, relative) for relative in tracked):
        raise BackupError("tracked-unsafe")
    pathspecs = sorted(paths | tracked)
    if not pathspecs:
        raise BackupError("backup-empty")
    payload = b"\0".join(value.encode("utf-8") for value in pathspecs) + b"\0"
    result = git(
        "add",
        "--force",
        "-A",
        "--pathspec-from-file=-",
        "--pathspec-file-nul",
        input_bytes=payload,
    )
    require_success(result, "index-write-failed")


def has_staged_changes() -> bool:
    result = git("diff", "--cached", "--quiet", "--no-ext-diff")
    if result.returncode == 0:
        return False
    if result.returncode == 1:
        return True
    raise BackupError("index-invalid")


def commit_backup(author: tuple[str, str]) -> str:
    message = "Agent backup " + datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    result = git(
        "-c",
        "user.name=" + author[0],
        "-c",
        "user.email=" + author[1],
        "-c",
        "core.hooksPath=/dev/null",
        "commit",
        "--no-gpg-sign",
        "--no-verify",
        "-m",
        message,
    )
    require_success(result, "commit-failed")
    return head_revision()


def head_revision() -> str:
    result = require_success(git("rev-parse", "HEAD"), "revision-missing")
    revision = decoded(result)
    if not SHA.fullmatch(revision):
        raise BackupError("revision-invalid")
    return revision


# agent-backup's key pattern (pinned for connection readiness, so it stays as released) takes «sk-»
# anywhere, followed by any 20 of letters, digits, - and _: a transliterated note name such as
# «…zapusk-reklamy-dla-kliniky-u-varsavi…» or «war-risk-…» read as an OpenAI key, and every vault-sync
# failed history-unsafe from then on, seen only in its log: Volodymyr's vault for 11 days (03.10.2026),
# Максимус and Руфус about 2000 times each. The history check judges each such match by the rule real
# keys follow — a word start and a run of 20+ letters and digits, which old sk- keys are and sk-proj-,
# sk-ant-, sk-svcacct-, sk-or- keys hold between their separators — and defuses the rest before asking.
KEY_WORD = re.compile(rb"[A-Za-z0-9_-]+")
KEY_RUN = re.compile(rb"[A-Za-z0-9]{20,}")
SECRET_WORD = re.compile(rb"(?:sk-|\b\d{8,12}:AA|ghp_|github_pat_|xox[baprs]-)[A-Za-z0-9_-]*")


def without_word_keys(payload: bytes) -> bytes:
    """payload with «sk-» defused (sk- → sk_) in every word not shaped like a key.

    A word is a run of letters, digits, - and _. It holds a key when one of its «sk-» starts it or follows
    - or _, and a run of 20+ letters and digits begins after that «sk-». Each word is judged once, so the
    cost is linear in the payload whatever it holds (Codex AGENTS 03.10, re-review of d0585b36 P1-2)."""
    if b"sk-" not in payload:
        return payload
    defused = None
    for word in KEY_WORD.finditer(payload):
        text = word.group(0)
        first = text.find(b"sk-")
        if first < 0:
            continue
        runs = [run.start() for run in KEY_RUN.finditer(text)]
        last_run, at, is_key = (runs[-1] if runs else -1), first, False
        while at >= 0 and not is_key:
            is_key = (at == 0 or text[at - 1:at] in (b"-", b"_")) and last_run >= at + 3
            at = text.find(b"sk-", at + 1)
        if is_key:
            continue
        defused = defused if defused is not None else bytearray(payload)
        at = first
        while at >= 0:
            defused[word.start() + at + 2] = ord("_")
            at = text.find(b"sk-", at + 1)
    return payload if defused is None else bytes(defused)


def saved_literal_in(backup: ModuleType, data: bytes) -> bool:
    """agent-backup's saved-connection half of contains_secret, on the bytes as they are: a value the
    owner saved is caught whatever it looks like, before any defusing (re-review of d0585b36 P1-3)."""
    private = backup.HOME / ".config/novsky/secrets.json"
    for candidate in (private, private.parent, private.parent.parent):
        if candidate.is_symlink():
            raise ValueError("unsafe connection store")
    try:
        info = private.stat()
    except FileNotFoundError:
        return False
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        raise ValueError("unsafe connection store")
    fingerprint = (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns)
    return any(value in data for value in backup.connection_literals(str(backup.HOME), fingerprint))


def history_secret(backup: ModuleType, payload: bytes) -> bool:
    return saved_literal_in(backup, payload) or backup.contains_secret(without_word_keys(payload))


def mask_secrets(raw: bytes) -> str:
    """raw as text with every key-like word cut to its first three characters, to its end (P1-1)."""
    return SECRET_WORD.sub(lambda match: match.group(0)[:3] + "…".encode(), raw).decode("utf-8", "replace")


def unsafe_object_place(backup: ModuleType, revision: str, identifier: str, kind: str, payload: bytes) -> str:
    """Where history-unsafe was found, in words, with secret-like text masked: the owner can find the
    note without the value reaching a log (Volodymyr, 03.10.2026: the bare code took hours to trace)."""
    def shown(raw: bytes) -> str:
        """A name with key-like words masked and control characters as «?». A name holding a saved value,
        or still matching any family the guard knows after masking (a private-key block), is not shown
        at all (re-review of 731469ce)."""
        if saved_literal_in(backup, raw):
            return "a name that holds a saved secret"
        masked = re.sub(r"[\x00-\x1f\x7f]", "?", mask_secrets(raw))
        if backup.contains_secret(without_word_keys(masked.encode("utf-8", "replace"))):
            return "a name that holds a secret"
        return masked

    if kind == "commit":
        return f"secret-like text in the message of commit {identifier[:12]}"
    name = ""
    listed = git("rev-list", "--objects", revision)
    if listed.returncode == 0:
        for line in decoded(listed).splitlines():
            if line.startswith(identifier + " "):
                name = line[len(identifier) + 1:]
                break
    name = shown(name.encode("utf-8", "surrogateescape"))
    if kind == "tree":
        offset = 0
        while offset < len(payload):  # tree entries: <mode> <name>\0<20-byte id>
            space = payload.find(b" ", offset)
            end = payload.find(b"\0", space)
            if space < 0 or end < 0:
                break
            entry = payload[space + 1:end]
            if history_secret(backup, entry):
                return f"secret-like text in the name «{shown(entry)}» inside «{name or '/'}»"
            offset = end + 21
        return f"secret-like text in a file or folder name inside «{name or '/'}»"
    return f"secret-like text in «{name}»" if name else f"secret-like text in {kind} {identifier[:12]}"


def note_unsafe_place(detail: str) -> None:
    """The place goes to ~/logs/history-unsafe.last: the callers' own logs keep their one-line codes."""
    try:
        target = Path.home() / "logs/history-unsafe.last"
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ ") + detail + "\n", encoding="utf-8")
    except OSError:
        pass


def require_safe_history(
    backup: ModuleType, revision: str, checked: set[str] | None = None,
) -> set[str]:
    checked = set() if checked is None else checked
    shallow = require_success(
        git("rev-parse", "--is-shallow-repository"), "history-unverifiable"
    )
    if decoded(shallow) != "false":
        raise BackupError("history-unverifiable")
    reachable = require_success(
        git("rev-list", "--objects", "--no-object-names", revision),
        "history-unverifiable",
    )
    identifiers = decoded(reachable).splitlines()
    if not identifiers or any(not SHA.fullmatch(value) for value in identifiers):
        raise BackupError("history-unverifiable")
    identifiers = sorted(set(identifiers) - checked)
    if not identifiers:
        return checked
    metadata = require_success(
        git("cat-file", "--batch-check", input_bytes=("\n".join(identifiers) + "\n").encode()),
        "history-unverifiable",
    )
    lines = decoded(metadata).splitlines()
    if len(lines) != len(identifiers):
        raise BackupError("history-unverifiable")
    objects = deque()
    for expected, line in zip(identifiers, lines):
        fields = line.split()
        if len(fields) != 3 or fields[0] != expected or fields[1] not in {"blob", "tree", "commit", "tag"}:
            raise BackupError("history-unverifiable")
        try:
            size = int(fields[2])
        except ValueError as error:
            raise BackupError("history-unverifiable") from error
        if not 0 <= size <= backup.MAX_FILE_BYTES:
            raise BackupError("history-unverifiable")
        objects.append((expected, fields[1], size))
    # Bound each read instead of loading an entire repository history into RAM.
    while objects:
        batch, size = [], 0
        while objects and (not batch or (size + objects[0][2] <= 8 * 1024 * 1024 and len(batch) < 256)):
            item = objects.popleft()
            batch.append(item)
            size += item[2]
        result = require_success(
            git("cat-file", "--batch", input_bytes=("\n".join(item[0] for item in batch) + "\n").encode()),
            "history-unverifiable",
        )
        offset = 0
        for identifier, kind, size in batch:
            header = f"{identifier} {kind} {size}\n".encode()
            if result.stdout[offset:offset + len(header)] != header:
                raise BackupError("history-unverifiable")
            offset += len(header)
            payload = result.stdout[offset:offset + size]
            if len(payload) != size or result.stdout[offset + size:offset + size + 1] != b"\n":
                raise BackupError("history-unverifiable")
            if history_secret(backup, payload):
                error = BackupError("history-unsafe")
                error.detail = unsafe_object_place(backup, revision, identifier, kind, payload)
                note_unsafe_place(error.detail)
                raise error
            checked.add(identifier)
            offset += size + 1
        if offset != len(result.stdout):
            raise BackupError("history-unverifiable")
    return checked


def remote_head(remote: str, environment: dict[str, str]) -> str | None:
    result = isolated_git(
        "ls-remote",
        "--exit-code",
        remote,
        "refs/heads/main",
        environment=environment,
        timeout=30,
    )
    if result.returncode == 2:
        return None
    if result.returncode != 0:
        raise BackupError("remote-unavailable")
    fields = decoded(result).split()
    if len(fields) != 2 or fields[1] != "refs/heads/main" or not SHA.fullmatch(fields[0]):
        raise BackupError("remote-invalid")
    return fields[0]


def push_head(remote: str, environment: dict[str, str], revision: str) -> None:
    result = isolated_git(
        "push",
        "--no-follow-tags",
        remote,
        revision + ":refs/heads/main",
        environment=environment,
        timeout=60,
    )
    if result.returncode == 0:
        readback = remote_head(remote, environment)
        if readback != revision:
            raise BackupError("remote-mismatch")
        return
    try:
        readback = remote_head(remote, environment)
    except BackupError:
        raise BackupError("push-unavailable")
    if readback is not None and readback != revision:
        raise BackupError("remote-diverged")
    raise BackupError("push-unavailable")


def run_backup() -> dict:
    # A box where nobody set a backup up says exactly that, before any repository check.
    if os.environ.get("AGENT_BACKUP_TESTING") != "1" and load_state()["remoteIdentity"] is None:
        raise BackupError("not-configured")
    require_repository()
    clean_index()
    remote, identity = remote_identity()
    state = load_state()
    if state["remoteIdentity"] not in (None, identity):
        raise BackupError("remote-mismatch")
    if os.environ.get("AGENT_BACKUP_TESTING") != "1" and (
        state["remoteIdentity"] != identity or state["privateConfirmed"] is not True
    ):
        raise BackupError("not-configured")
    environment = git_environment(remote)
    require_private_repository(identity)
    author = commit_author("Agent Backup", "agent-backup@localhost")
    backup = load_backup_module()
    existing = git("rev-parse", "--verify", "--quiet", "HEAD")
    if existing.returncode not in (0, 1):
        raise BackupError("history-unverifiable")
    checked = require_safe_history(backup, decoded(existing)) if existing.returncode == 0 else set()
    vault_paths = safe_vault_paths(backup)
    projection_paths = project_external_state(backup)
    snapshot = index_backup()
    changed = False
    try:
        stage_paths(vault_paths | projection_paths, backup)
        changed = has_staged_changes()
        revision = commit_backup(author) if changed else head_revision()
    except Exception:
        restore_index(snapshot)
        raise
    require_safe_history(backup, revision, checked)
    require_private_repository(identity)
    push_head(remote, environment, revision)
    state.update(
        {
            "remoteIdentity": identity,
            "lastSuccessfulRevision": revision,
            "lastSuccessfulAt": current_utc_time().isoformat(),
        }
    )
    write_state(state)
    return {
        "status": "ok",
        "changed": changed,
        "revision": revision,
        "containsSecrets": False,
    }


def backup_status() -> dict:
    # A box where nobody set a backup up says exactly that, before any repository check.
    if os.environ.get("AGENT_BACKUP_TESTING") != "1" and load_state()["remoteIdentity"] is None:
        raise BackupError("not-configured")
    require_repository()
    remote, identity = remote_identity()
    state = load_state()
    if state["remoteIdentity"] not in (None, identity):
        raise BackupError("remote-mismatch")
    if os.environ.get("AGENT_BACKUP_TESTING") != "1" and (
        state["remoteIdentity"] != identity or state["privateConfirmed"] is not True
    ):
        raise BackupError("not-configured")
    manifest = VAULT / ".agent-backup/manifest.json"
    if not manifest.is_file() or manifest.is_symlink():
        raise BackupError("not-backed-up")
    try:
        revision = head_revision()
    except BackupError as error:
        raise BackupError("not-backed-up") from error
    backed_up_revision = state["lastSuccessfulRevision"]
    if backed_up_revision is None:
        raise BackupError("not-backed-up")
    projection_status = git("status", "--porcelain", "--", ".agent-backup")
    require_success(projection_status, "index-invalid")
    if decoded(projection_status):
        raise BackupError("projection-dirty")
    environment = git_environment(remote)
    require_private_repository(identity)
    try:
        readback = remote_head(remote, environment)
    except BackupError as error:
        raise BackupError("remote-mismatch") from error
    if readback != revision:
        raise BackupError("remote-mismatch")
    if backed_up_revision != revision:
        raise BackupError("not-backed-up")
    try:
        successful_at = datetime.fromisoformat(state["lastSuccessfulAt"].replace("Z", "+00:00"))
        if successful_at.tzinfo is None:
            raise ValueError("timezone missing")
        age = (current_utc_time() - successful_at).total_seconds()
    except (AttributeError, TypeError, ValueError) as error:
        raise BackupError("not-backed-up") from error
    if not -300 <= age <= MAX_SUCCESS_AGE_SECONDS:
        raise BackupError("not-backed-up")
    require_safe_history(load_backup_module(), revision)
    return {
        "status": "configured",
        "revision": revision,
        "containsSecrets": False,
    }


def scheduled_backup() -> dict:
    now = current_utc_time()
    local = now.astimezone(ZoneInfo("Europe/Lisbon"))
    if local.hour != 22:
        return {
            "status": "not-due",
            "ran": False,
            "containsSecrets": False,
        }
    slot = local.strftime("%Y-%m-%dT%H")
    load_state()
    if load_nightly_slot() == local.date().isoformat():
        return {
            "status": "already-ran",
            "ran": False,
            "slot": slot,
            "containsSecrets": False,
        }
    result = run_backup()
    # Older versions accept only T09/T21 in completedSlots. Keep their state
    # readable after rollback by recording the new date in a separate file.
    write_nightly_slot(local.date().isoformat())
    return {
        "status": "scheduled",
        "ran": True,
        "slot": slot,
        "changed": result["changed"],
        "revision": result["revision"],
        "containsSecrets": False,
    }


def public_key_material() -> str:
    if KEY_PATH.is_symlink() or not KEY_PATH.is_file():
        raise BackupError("deploy-key-missing")
    metadata = KEY_PATH.stat()
    if stat.S_IMODE(metadata.st_mode) != 0o600 or metadata.st_nlink != 1:
        raise BackupError("deploy-key-unsafe")
    result = run_process(
        ["ssh-keygen", "-y", "-f", str(KEY_PATH)],
        timeout=15,
    )
    require_success(result, "deploy-key-invalid")
    try:
        fields = decoded(result).split()
    except UnicodeDecodeError as error:
        raise BackupError("deploy-key-invalid") from error
    if len(fields) < 2 or fields[0] != "ssh-ed25519":
        raise BackupError("deploy-key-invalid")
    return " ".join(fields[:2])


def setup_key() -> dict:
    ensure_state_dir()
    public_path = KEY_PATH.with_suffix(KEY_PATH.suffix + ".pub")
    if KEY_PATH.exists() or KEY_PATH.is_symlink():
        public_key = public_key_material()
    else:
        if public_path.exists() or public_path.is_symlink():
            raise BackupError("deploy-key-unsafe")
        temporary_directory = Path(
            tempfile.mkdtemp(prefix=".deploy-key.", dir=STATE_DIR)
        )
        temporary_key = temporary_directory / "key"
        try:
            result = run_process(
                [
                    "ssh-keygen",
                    "-q",
                    "-t",
                    "ed25519",
                    "-N",
                    "",
                    "-C",
                    "agent-github-backup",
                    "-f",
                    str(temporary_key),
                ],
                timeout=30,
            )
            require_success(result, "deploy-key-create-failed")
            os.chmod(temporary_key, 0o600)
            os.chmod(temporary_key.with_suffix(".pub"), 0o644)
            os.replace(temporary_key, KEY_PATH)
            os.replace(temporary_key.with_suffix(".pub"), public_path)
        finally:
            shutil.rmtree(temporary_directory, ignore_errors=True)
        public_key = public_key_material()
    fingerprint = hashlib.sha256(public_key.encode("ascii")).hexdigest()
    state = load_state()
    state["publicKeyFingerprint"] = fingerprint
    write_state(state)
    return {"status": "key-ready", "publicKey": public_key}


def connect_backup(remote: str, confirm_private: bool) -> dict:
    if not confirm_private:
        raise BackupError("private-confirmation-required")
    identity = validate_remote(remote)
    require_repository()
    public_key = public_key_material()
    remotes = require_success(git("remote"), "remote-invalid")
    names = [line for line in decoded(remotes).splitlines() if line]
    if not names:
        require_success(
            git("remote", "add", "origin", remote),
            "remote-invalid",
        )
    elif names == ["origin"]:
        if configured_push_remote() != remote:
            raise BackupError("remote-invalid")
    else:
        raise BackupError("remote-invalid")
    require_original_destination(remote)
    state = load_state()
    if state["remoteIdentity"] not in (None, identity):
        raise BackupError("remote-mismatch")
    environment = git_environment(remote)
    require_remote_access(remote, environment)
    require_private_repository(identity)
    state.update(
        {
            "remoteIdentity": identity,
            "privateConfirmed": True,
            "publicKeyFingerprint": hashlib.sha256(
                public_key.encode("ascii")
            ).hexdigest(),
        }
    )
    write_state(state)
    receipt = run_backup()
    receipt["status"] = "connected"
    return receipt


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("status", "run", "setup-key", "scheduled"):
        command = commands.add_parser(name)
        command.add_argument("--json", action="store_true")
    connect = commands.add_parser("connect")
    connect.add_argument("--remote", required=True)
    connect.add_argument("--confirm-private", action="store_true")
    connect.add_argument("--json", action="store_true")
    return parser


def emit(receipt: dict, *, as_json: bool) -> None:
    if as_json:
        print(json.dumps(receipt, ensure_ascii=False, sort_keys=True))
        return
    messages = {
        "ok": "✅ Приватну резервну копію оновлено й перевірено.",
        "scheduled": "✅ Приватну резервну копію оновлено за розкладом.",
        "connected": "✅ Приватний GitHub-репозиторій підключено й першу копію перевірено.",
        "configured": "✅ Приватне резервне копіювання налаштовано й перевірено.",
        "history-unsafe": "Копіювання зупинено: історія Git містить секрети. Автоматичне переписування історії не виконується.",
        "history-unverifiable": "Копіювання зупинено: повну історію Git не вдалося перевірити.",
    }
    if receipt["status"] == "key-ready":
        print(receipt["publicKey"])
        return
    if receipt["status"] in {"not-due", "already-ran"}:
        return
    status = receipt["status"]
    print(_NOTICE_MODULE.notice_text(
        "backup." + status if status in messages else "backup.error",
        messages.get(status, "Резервне копіювання не виконано."),
        home=HOME,
    ))


def main() -> int:
    args = build_parser().parse_args()
    try:
        descriptor = lock_run()
        try:
            if args.command == "run":
                receipt = run_backup()
            elif args.command == "status":
                receipt = backup_status()
            elif args.command == "setup-key":
                receipt = setup_key()
            elif args.command == "scheduled":
                receipt = scheduled_backup()
            else:
                receipt = connect_backup(args.remote, args.confirm_private)
        finally:
            os.close(descriptor)
        emit(receipt, as_json=args.json)
        return 0
    except BackupError as error:
        emit(
            {"status": error.code, "containsSecrets": False},
            as_json=args.json,
        )
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
