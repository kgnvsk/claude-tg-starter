#!/usr/bin/env python3
"""Transcribe a Telegram attachment and persist it into message history."""

import argparse
import os
from pathlib import Path
import sqlite3
import subprocess
import sys


DEFAULT_TRANSCRIBE_TIMEOUT_SECONDS = 150


def transcribe_timeout_seconds() -> int:
    raw = os.environ.get(
        "TRANSCRIBE_SUBPROCESS_TIMEOUT_SECONDS",
        str(DEFAULT_TRANSCRIBE_TIMEOUT_SECONDS),
    )
    try:
        return max(1, min(int(raw), 600))
    except ValueError:
        return DEFAULT_TRANSCRIBE_TIMEOUT_SECONDS


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--chat-id", required=True)
    parser.add_argument("--message-id", required=True, type=int)
    parser.add_argument("audio", type=Path)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    home = Path.home()
    # The same history the receiver writes: its state dir, not always ~/.claude.
    state = os.environ.get("TELEGRAM_STATE_DIR") or Path(
        os.environ.get("CLAUDE_CONFIG_DIR") or home / ".claude"
    ) / "channels/telegram"
    db = Path(state) / "messages.db"
    transcribe = home / "bin/transcribe"

    try:
        completed = subprocess.run(
            [str(transcribe), str(args.audio)],
            capture_output=True,
            text=True,
            timeout=transcribe_timeout_seconds(),
        )
    except subprocess.TimeoutExpired:
        print("transcription timed out; retry the voice message", file=sys.stderr)
        return 124
    if completed.returncode != 0:
        sys.stderr.write(completed.stderr)
        return completed.returncode

    transcript = completed.stdout.strip()
    if not transcript:
        print("transcribe returned empty text", file=sys.stderr)
        return 1
    if not db.is_file():
        print(f"Telegram history database not found: {db}", file=sys.stderr)
        return 1

    with sqlite3.connect(db, timeout=5) as conn:
        conn.execute("PRAGMA busy_timeout=5000")
        # A forwarded recording keeps the line that says whose voice it is.
        row = conn.execute(
            "SELECT text FROM messages WHERE chat_id=? AND direction='in' AND message_id=?",
            (args.chat_id, args.message_id),
        ).fetchone()
        stored = (row[0] or "") if row else ""
        lead = stored.split("\n", 1)[0] + "\n" if stored.startswith("Переслано від ") else ""
        changed = conn.execute(
            "UPDATE messages SET text=? "
            "WHERE chat_id=? AND direction='in' AND message_id=?",
            (lead + transcript, args.chat_id, args.message_id),
        ).rowcount
        if changed == 0:
            print("matching Telegram history row not found", file=sys.stderr)
            return 1

    print(transcript)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
