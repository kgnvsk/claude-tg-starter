#!/usr/bin/env bash
# Read-only CLI compatibility gate for an existing Claude agent. CLI upgrades
# require their own reviewed, version-pinned maintenance transaction.
set -euo pipefail

[ "$(id -u)" -eq 0 ] || {
  echo "FATAL: update-agent-clis must run as root" >&2
  exit 1
}
[ "$#" -eq 1 ] && [ "$1" = --check ] || {
  echo "FATAL: usage: update-agent-clis --check" >&2
  exit 2
}

AGENT_USER="${AGENT_USER:-claude}"
H=/home/$AGENT_USER
CLAUDE_BIN="$H/.local/bin/claude"
CODEX_BIN="$H/.npm-global/bin/codex"

# Claude Code can update itself on startup. Both CLI probes suppress its updater
# and first-run marketplace installation so this gate remains observational.
check_cli() {
  local label="$1"
  shift
  if ! runuser -u "$AGENT_USER" -- env HOME="$H" \
      DISABLE_UPDATES=1 CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL=1 \
      /usr/bin/timeout --foreground 30s "$@" >/dev/null 2>&1; then
    echo "FATAL: $label не пройшов перевірку; версію CLI не змінено" >&2
    return 1
  fi
}

check_version() {
  local label="$1" binary="$2" version
  version="$(runuser -u "$AGENT_USER" -- env HOME="$H" \
    DISABLE_UPDATES=1 CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL=1 \
    /usr/bin/timeout --foreground 30s "$binary" --version 2>/dev/null)" || {
      echo "FATAL: не вдалося прочитати версію $label; CLI не змінено" >&2
      return 1
    }
  if ! [[ "$version" =~ [0-9]+\.[0-9]+\.[0-9]+ ]]; then
    echo "FATAL: $label повернув некоректну версію; CLI не змінено" >&2
    return 1
  fi
}

[ -x "$CLAUDE_BIN" ] || {
  echo "FATAL: встановлений Claude Code не знайдено в $CLAUDE_BIN; CLI не змінено" >&2
  exit 1
}
check_version "Claude Code" "$CLAUDE_BIN"
check_cli "вхід у Claude Code" "$CLAUDE_BIN" auth status
# update.sh uses these commands later in the same stopped maintenance window.
# Their help paths exercise the installed CLI's command surface without
# downloading a marketplace or changing the owner's plugin cache.
check_cli "Claude plugin marketplace update" "$CLAUDE_BIN" plugin marketplace update --help
check_cli "Claude plugin update" "$CLAUDE_BIN" plugin update --help

# Codex is optional on a Claude agent. Preserve it wherever installed, and
# reject a broken installed binary before the update changes any other state.
if [ -e "$CODEX_BIN" ] || [ -L "$CODEX_BIN" ]; then
  [ -x "$CODEX_BIN" ] || {
    echo "FATAL: встановлений Codex не запускається; CLI не змінено" >&2
    exit 1
  }
  check_version Codex "$CODEX_BIN"
fi

echo "      наявні Claude Code і Codex збережено; перевірка CLI пройшла"
