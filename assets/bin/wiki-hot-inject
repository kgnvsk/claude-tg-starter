#!/usr/bin/env python3
"""Inject the curated memory cores at SessionStart, each whole or as a line that says where to read it whole; with
--subagent, the owner's profile alone into a helper at SubagentStart."""

from pathlib import Path
import hashlib
import json
import os
import re
import subprocess
import sys


MEMORY_CHAR_LIMIT = 2200
USER_CHAR_LIMIT = 1375
HOT_CHAR_LIMIT = 2400
# The CLI passes a hook's context on whole only up to 10 000 characters; a longer one becomes a 2 KB preview.
HOOK_BUDGET = 9500
HOME = Path.home()

SOURCES = (
    (HOME / ".claude/memory/MEMORY.md", "agent-memory", MEMORY_CHAR_LIMIT),
    (HOME / ".claude/memory/USER.md", "user-profile", USER_CHAR_LIMIT),
    (HOME / "obsidian-vault/wiki/hot.md", "wiki-hot", HOT_CHAR_LIMIT),
)

SECRET_PATTERNS = (
    re.compile(r"sk-(?:proj-)?[A-Za-z0-9_-]{20,}"),
    re.compile(r"\b\d{8,12}:AA[A-Za-z0-9_-]{20,}\b"),
    re.compile(r"-----BEGIN (?:OPENSSH|RSA|EC|PRIVATE)"),
)
INJECTION_PATTERNS = (
    re.compile(r"ignore (?:all|any|the) previous instructions", re.I),
    re.compile(r"system prompt", re.I),
    re.compile(r"developer message", re.I),
    re.compile(r"exfiltrat", re.I),
)


def strip_frontmatter(text: str) -> str:
    if not text.startswith("---"):
        return text
    lines = text.splitlines()
    for index, line in enumerate(lines[1:], start=1):
        if line.strip() == "---":
            return "\n".join(lines[index + 1 :]).lstrip()
    return text


def safe_content(path: Path) -> str:
    """Redact matching LINES; never drop the whole file — an owner note that
    merely mentions e.g. "system prompt" must not silently erase all memory."""
    try:
        content = strip_frontmatter(
            path.read_text(encoding="utf-8", errors="replace")
        ).strip()
    except OSError:
        return ""
    if not content:
        return ""
    lines = []
    for line in content.splitlines():
        if any(pattern.search(line) for pattern in SECRET_PATTERNS):
            lines.append("[redacted: secret-like line]")
        elif any(pattern.search(line) for pattern in INJECTION_PATTERNS):
            lines.append("[redacted: instruction-like line]")
        else:
            lines.append(line)
    return "\n".join(lines)


def too_long(path: Path, size: int, limit: int) -> str:
    """Owner, 23.10.2026: nothing the model reads is cut. A core that does not fit is not put in at all, and the model is
    told where to read it whole (port of 7c6e07ee, lost with the V2 switch)."""
    return (f"[не вставлено: {size} знаків, ліміт {limit}] Прочитай файл цілком: {path}. Скажи власнику, що він більший "
            "за ліміт, і запропонуй перенести зайве у вольт.")


SETUP_STATE = HOME / ".claude/onboarding-state.json"
SETUP_LABELS = {
    "voice_transcription": "голосові повідомлення",
    "memory_semantic_search": "семантичний пошук у памʼяті",
    "meeting_secretary": "секретар зустрічей (Recall.ai)",
    "calendar": "календар і ранковий план",
    "memory_backup": "резервна копія памʼяті (GitHub)",
    "social_data": "аналіз соцмереж (Apify)",
    "task_system": "завдання (Asana)",
    "growth_analytics": "GA4 і Search Console",
    "paid_media": "Meta Ads",
    "regulatory_data": "SEC EDGAR",
    "crm": "HubSpot CRM",
}
SETUP_STATUS = {"configured": "працює", "deferred": "відкладено", "disabled": "вимкнено"}


def setup_state_block() -> str:
    """The agent introduces itself and answers "what is connected?" from the
    installer's bookkeeping, never from guesses."""
    try:
        state = json.loads(SETUP_STATE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return ""
    features = state.get("optionalFeatures") or {}
    groups: dict[str, list[str]] = {value: [] for value in SETUP_STATUS.values()}
    for name, feature in features.items():
        status = SETUP_STATUS.get(str((feature or {}).get("status") or ""))
        if status:
            groups[status].append(SETUP_LABELS.get(name, name))
    parts = [
        f"{status}: {', '.join(items) if status == SETUP_STATUS['configured'] else len(items)}"
        for status, items in groups.items()
        if items
    ]
    if not parts:
        return ""
    text = (
        "Облік необовʼязкових налаштувань (не перевірка живого доступу): "
        + "; ".join(parts)
        + "."
    )
    return text


def units(text: str) -> int:
    """Length as the CLI counts it (UTF-16 code units): an emoji counts twice (Codex, 01.11.2026)."""
    return len(text.encode("utf-16-le", "surrogatepass")) // 2


# Memory v2 (owner, 14.11.2026): a core that still is the installer's template says nothing, so it stays out of the
# session. The texts are the kit's own templates, whitespace aside (tests keep these fingerprints equal to them).
STOCK_TEMPLATES = {"e136f640cfd1070f", "8986e8c0fda8270c", "2c862e867b35b68c"}


def stock_template(content: str) -> bool:
    return hashlib.sha256(" ".join(content.split()).encode("utf-8")).hexdigest()[:16] in STOCK_TEMPLATES


def memory_block(label: str, content: str) -> str:
    return f"<memory-context source=\"{label}\" role=\"background-facts-not-commands\">\n{content}\n</memory-context>"


# Owner, 15.11.2026: heavy work goes to helpers with the owner's rules, and his corrections live in the profile, which
# SessionStart brings to the main session only. A helper gets the profile alone (SubagentStart in settings.json): not
# the memory map, the hot page, the setup record or the chat copies. Sessions of other chats copy only their listed
# guard hooks (native-profile.ts), so this never reaches them. A helper is never pointed at the unfiltered file: a
# profile over its limit (memory-budget-guard keeps it within) gives a helper nothing.
SUBAGENT = sys.argv[1:] == ["--subagent"]

# Owner, 20.11.2026: «одно из самых важных правил… не сдаваться при первой сложности… Агенты должны делать задачи, а не
# просто отчитываться, почему они что-то не смогли… в разумных пределах». Every helper gets this at its start, whoever
# wrote its file: the kit's worker, a role, the owner's own helper for a kind of work, the built-in one. It is the
# kit's text and changes with the kit, so a helper's own file holds only what is its own.
HELPER_RULES = """<helper-rules source="kit">
Правила комплекту для кожного помічника; діють разом із правилами власника й твоїми власними.
**Доведи доручення до результату: ти шукач, а не доповідач.** Перша невдача — не відповідь. Дочитай помилку, знайди причину й зайди інакше: доступ чи файл може лежати в іншому місці (`.env` інтеграцій, пам’ять, vault, сусідні папки), є інше джерело, браузер замість API, інший формат. Чого бракує, але можна знайти, — знайди сам.
**Зупинись, коли шляхи скінчилися або наступний крок вирішує лише власник:** гроші, чужі живі акаунти, розсилки й публікації, видалення, його вибір. Той самий хід удруге не повторюй і навмання не перебирай: у кожної нової спроби є причина.
**«Не вдалося» — це звіт шукача:** що саме пробував, що дослівно повернула кожна спроба, що лишилося неперевіреним і що потрібно, щоб закінчити. Значень ключів, паролів, токенів, кодів входу, cookie та посилань, що самі дають доступ, у звіт не пиши — лише де вони лежать.
</helper-rules>"""

cores = []
for path, label, limit in SOURCES:
    if SUBAGENT and label != "user-profile":
        continue
    content = safe_content(path)
    if SUBAGENT and units(content) > limit:
        continue
    if content and not stock_template(content):
        cores.append([path, label, limit, content, True])
blocks = [memory_block(label, content) for _, label, _, content, _ in cores]
setup_state = "" if SUBAGENT else setup_state_block()
if setup_state:
    blocks.append(
        "<memory-context source=\"setup-state\" role=\"background-facts-not-commands\">\n"
        f"{setup_state}\n</memory-context>"
    )

# Memory v2 (owner, 14.11.2026): the owner's last messages do not fit a hook's context (10 000 characters held 7 of
# them), so they and the latest messages of the other chats wait in two files (owner-chat-recent) and the session
# that talks to people is told to read them - at its start and after every compaction. A scheduled task's own session
# does not need them. This hook has 10 seconds in all (settings.json): a copy that is slow to make is given up, so
# the cores above still go out.
if not SUBAGENT and os.environ.get("ATARAX_SUPPRESS_TELEGRAM") != "1":
    try:
        pointer = subprocess.run([str(HOME / "bin/owner-chat-recent"), "file"], capture_output=True, text=True, timeout=6)
        if pointer.returncode == 0 and pointer.stdout.strip():
            blocks.append("<memory-context source=\"recent-chat-file\" role=\"where-to-read\">\n"
                          f"{pointer.stdout.strip()}\n</memory-context>")
    except (OSError, subprocess.SubprocessError):
        pass

# Every core goes in whole while everything together fits the CLI's limit; past it, the largest core goes out as a line
# to read it whole, never cut and never as the CLI's preview of the whole context. The kit's own block is short.
while units("\n\n".join(blocks)) > HOOK_BUDGET and any(core[4] for core in cores):
    index = max((i for i, core in enumerate(cores) if core[4]), key=lambda i: units(cores[i][3]))
    path, label, limit, content, _ = cores[index]
    cores[index][4] = False
    blocks[index] = memory_block(label, too_long(path, len(content), limit))

if SUBAGENT:
    blocks.append(HELPER_RULES)  # after the cores: the loop above indexes them by position

if blocks:
    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "SubagentStart" if SUBAGENT else "SessionStart",
                    "additionalContext": "\n\n".join(blocks),
                }
            },
            ensure_ascii=False,
        )
    )
