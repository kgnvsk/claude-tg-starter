#!/usr/bin/env python3
"""Validate model changes and preserve the installed runtime mechanics.

This tool-call guard prevents accidental self-modification; it is not an OS
sandbox against arbitrary programs. Operator maintenance runs outside it.
"""

from pathlib import Path
import json
import os
import re
import shlex
import shutil
import subprocess
import sys


HOME = Path(os.environ.get("HOME") or "/home/claude").expanduser().resolve()
SETTINGS_PATH = (HOME / ".claude/settings.json").resolve()
PROBE_TIMEOUT_SECONDS = 75
COMPACTION_KEYS = {"CLAUDE_AUTOCOMPACT_PCT_OVERRIDE", "CLAUDE_CODE_AUTO_COMPACT_WINDOW",
                   "DISABLE_AUTO_COMPACT", "DISABLE_COMPACT"}
# A one-shot headless run with the Telegram plugin inert: the same shape the
# healthcheck uses, so the poller is never disturbed. The API answers with the
# provider's own words when this CLI build does not know the identifier.
PROBE_ENV_INERT = "ATARAX_SUPPRESS_TELEGRAM"
MODEL_ID_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:\-\[\]]{0,79}")
SHELL_MUTATION_RE = re.compile(
    r"(?<![0-9&])>>?(?!&)|"
    r"\b(?:tee|truncate|rm|mv|cp|ln|link|unlink|install|touch|dd|sponge|shred|chmod|chown|chgrp|setfacl)\b|"
    r"\bsed\s+(?:-[A-Za-z]*i|--in-place)\b|"
    r"\bperl\s+-[A-Za-z]*i\b|"
    r"\bjq\b|\bpython3?\b",
    re.IGNORECASE,
)


def normalize_path(value: object) -> Path | None:
    if not isinstance(value, str) or not value:
        return None
    expanded = (
        value.replace("${HOME}", str(HOME))
        .replace("$HOME", str(HOME))
        .replace("~", str(HOME), 1)
    )
    try:
        return Path(expanded).expanduser().resolve()
    except OSError:
        return None


def block(reason: str) -> None:
    print(json.dumps({"decision": "block", "reason": reason}))


def claude_binary() -> str | None:
    local = HOME / ".local/bin/claude"
    if os.access(local, os.X_OK):
        return str(local)
    return shutil.which("claude")


def probe(model: str) -> tuple[bool, str]:
    binary = claude_binary()
    if binary is None:
        return False, "the Claude CLI binary was not found"
    env = {**os.environ, "HOME": str(HOME), PROBE_ENV_INERT: "1"}
    try:
        run = subprocess.run(
            [binary, "-p", "ok", "--model", model],
            env=env,
            capture_output=True,
            text=True,
            timeout=PROBE_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired:
        return False, f"the probe did not answer within {PROBE_TIMEOUT_SECONDS}s"
    except OSError as error:
        return False, f"the probe could not start: {error}"
    if run.returncode == 0:
        return True, ""
    detail = " ".join((run.stderr or run.stdout or "").split())  # whole (owner, 23.10.2026)
    return False, detail or f"exit {run.returncode}"


def proposed_text(tool_name: str, tool_input: dict, current: str) -> str | None:
    if tool_name == "Write":
        content = tool_input.get("content")
        return content if isinstance(content, str) else None
    edits: list[dict] = []
    if tool_name == "Edit":
        edits = [tool_input]
    elif tool_name == "MultiEdit":
        raw = tool_input.get("edits")
        if not isinstance(raw, list):
            return None
        edits = [e for e in raw if isinstance(e, dict)]
    text = current
    for edit in edits:
        old = edit.get("old_string")
        new = edit.get("new_string")
        if not isinstance(old, str) or not isinstance(new, str) or old not in text:
            return None
        text = text.replace(old, new) if edit.get("replace_all") else text.replace(old, new, 1)
    return text


def model_of(text: str) -> tuple[bool, object]:
    try:
        data = json.loads(text)
    except json.JSONDecodeError as error:
        return False, str(error)
    return True, data.get("model") if isinstance(data, dict) else None


def protected_files(settings: dict) -> set[Path]:
    files = {HOME / "bin" / name for name in (
        "claude-telegram-bot", "settings-model-guard", "no-nested-claude-guard",
    )}
    files.add(HOME / ".claude/state/no-nested-claude-guard.bypass")
    hooks = settings.get("hooks") or {}
    if isinstance(hooks, dict):
        for groups in hooks.values():
            for group in groups if isinstance(groups, list) else []:
                for hook in group.get("hooks", []) if isinstance(group, dict) else []:
                    if not isinstance(hook, dict) or hook.get("type") != "command":
                        continue
                    try:
                        tokens = shlex.split(hook.get("command", ""))
                    except (ValueError, TypeError):
                        continue
                    for token in tokens:
                        path = normalize_path(token)
                        if path and path.is_relative_to(HOME / "bin"):
                            files.add(path)
    return {path.resolve() for path in files}


def mechanics_error(old: dict, new: dict) -> str | None:
    if new.get("disableAllHooks") and not old.get("disableAllHooks"):
        return "Installed hooks must remain enabled."
    before, after = old.get("hooks") or {}, new.get("hooks") or {}
    if not isinstance(after, dict) or not isinstance(before, dict):
        return "Hooks must remain an object."
    for event, groups in before.items():
        proposed = after.get(event, [])
        if not isinstance(proposed, list) or any(group not in proposed for group in groups):
            return "Installed hooks cannot be removed or rewritten from an agent turn."
    before_env, after_env = old.get("env") or {}, new.get("env") or {}
    if not isinstance(after_env, dict) or not isinstance(before_env, dict):
        return "Settings env must remain an object."
    if any(before_env.get(key) != after_env.get(key) for key in COMPACTION_KEYS):
        return "Compaction settings are maintained by the installer, not agent turns."
    return None


def main() -> None:
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, OSError):
        return

    tool_name = str(payload.get("tool_name") or "")
    tool_input = payload.get("tool_input") or {}
    if not isinstance(tool_input, dict):
        return

    try:
        current = SETTINGS_PATH.read_text(encoding="utf-8")
        settings = json.loads(current)
        if not isinstance(settings, dict):
            settings = {}
    except (OSError, ValueError):
        current, settings = "", {}
    protected = protected_files(settings)

    if tool_name == "Bash":
        command = str(tool_input.get("command") or "")
        normalized = (
            command.replace("${HOME}", str(HOME))
            .replace("$HOME", str(HOME))
            .replace("~", str(HOME))
        )
        references_settings = any(
            normalize_path(token) == SETTINGS_PATH
            for token in re.findall(r"[\w./~$-]*\.claude/settings\.json\b", normalized)
        )
        references_runtime = any(
            normalize_path(token) in protected
            for token in re.findall(r"[\w./~$-]+", normalized)
        )
        if references_runtime and SHELL_MUTATION_RE.search(normalized):
            block("Runtime launchers and installed hooks require operator maintenance; an agent turn cannot rewrite or disable them.")
            return
        if references_settings and SHELL_MUTATION_RE.search(normalized):
            block(
                "Shell mutation of settings.json is disabled. Change it with the Edit "
                "tool: settings-model-guard verifies a new model id with the installed "
                "Claude CLI before it is written."
            )
        return

    if tool_name not in {"Edit", "Write", "MultiEdit"}:
        return
    target = normalize_path(tool_input.get("file_path") or tool_input.get("path"))
    if target in protected:
        block("Runtime launchers and installed hooks require operator maintenance; an agent turn cannot rewrite or disable them.")
        return
    if target != SETTINGS_PATH:
        return
    text = proposed_text(tool_name, tool_input, current)
    if text is None:
        return
    valid, new_model = model_of(text)
    if not valid:
        block(f"settings.json must remain valid JSON after the change: {new_model}")
        return
    proposed = json.loads(text)
    if not isinstance(proposed, dict):
        block("settings.json must remain a JSON object.")
        return
    error = mechanics_error(settings, proposed)
    if error:
        block(error)
        return
    _, old_model = model_of(current) if current else (True, None)
    if new_model is None or new_model == old_model:
        return
    if not isinstance(new_model, str) or not MODEL_ID_RE.fullmatch(new_model):
        block(f"model must be a plain identifier, got {new_model!r}")
        return
    ok, detail = probe(new_model)
    if ok:
        return
    block(
        f"The installed Claude CLI does not accept model '{new_model}': {detail}. "
        f"Keep the current model ({old_model!r}) or choose an identifier this CLI "
        "build knows; a newer id needs a CLI update first."
    )


if __name__ == "__main__":
    main()
