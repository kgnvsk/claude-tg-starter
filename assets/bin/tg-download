#!/usr/bin/env python3
"""tg-download — save a file posted in Telegram, by its file_id, through this agent's own bot.

The bot's key is read here and never shown: an agent may not read its key itself (no-secrets-guard),
so a scheduled task or a subagent without the download_attachment tool fetches a file this way
(Максимус, 06.10.2026: a PDF from a work group's history for his digest).

  tg-download <file_id>   → {"ok": true, "path": "...", "bytes": N}

The cloud API gives bots files up to 20 MB. A configured local Bot API copies larger files from its private directory into this bot's inbox.
"""
import json
import io
import runpy
from pathlib import Path
import os
import re
import secrets
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

LIMIT = 20 * 1024 * 1024
# A bot key wherever it appears, an error text from Telegram included: it is never printed.
KEY_SHAPE = re.compile(r"\d{5,}:[A-Za-z0-9_-]{30,}")



def telegram_api_base():
    import os, runpy
    from pathlib import Path
    candidates = [Path(__file__).resolve().with_name('telegram-api'), Path.home() / 'bin/telegram-api']
    candidates += [Path(__file__).resolve().parents[3] / 'assets/bin/telegram-api'] if 'telegram-corporate' in str(__file__) else []
    for helper in candidates:
        if helper.is_file():
            return runpy.run_path(str(helper))['api_base']()
    configured = os.environ.get('TELEGRAM_API_BASE', '')
    state = Path(os.environ.get('TELEGRAM_STATE_DIR') or Path.home() / '.claude/channels/telegram')
    if not configured and (state / '.env').is_file():
        for line in (state / '.env').read_text().splitlines():
            import re
            match = re.match(r'^(?:export\s+)?TELEGRAM_API_BASE\s*=(.*)', line.strip())
            if match:
                configured = match[1].strip().strip("\"'")
    if configured and configured.rstrip('/') != 'https://api.telegram.org':
        raise ValueError('Telegram local API helper is unavailable; no cloud fallback')
    return 'https://api.telegram.org'


def state_dir():
    return os.environ.get("TELEGRAM_STATE_DIR") or os.path.expanduser("~/.claude/channels/telegram")


def token():
    value = os.environ.get("TELEGRAM_BOT_TOKEN")
    if value:
        return value.strip()
    try:
        with open(os.path.join(state_dir(), ".env"), encoding="utf-8") as handle:
            for line in handle:
                if line.startswith("TELEGRAM_BOT_TOKEN="):
                    return line.split("=", 1)[1].strip().strip("\"'")
    except OSError:
        pass
    sys.exit("tg-download: the bot's key is not configured")


def fetch(url, limit, timeout=60):
    """The body, or an error text that never carries the URL (it holds the key)."""
    try:
        with urllib.request.urlopen(url, timeout=timeout) as response:
            body = response.read(limit + 1)
    except urllib.error.HTTPError as error:
        try:
            return None, str(json.load(error).get("description") or f"HTTP {error.code}")
        except ValueError:
            return None, f"HTTP {error.code}"
    except (urllib.error.URLError, TimeoutError, OSError) as error:
        return None, f"network: {type(error).__name__}"
    if len(body) > limit:
        return None, "the file is over 20 MB"
    return body, None


def main(argv):
    if len(argv) != 2 or not re.fullmatch(r"[A-Za-z0-9_-]{10,256}", argv[1]):
        sys.exit("usage: tg-download <file_id>")
    key = token()
    try:
        base = telegram_api_base()
    except (OSError, ValueError):
        print(json.dumps({"ok": False, "error": "Telegram API configuration is invalid"})); return 1
    body, error = fetch(f"{base}/bot{key}/getFile?" + urllib.parse.urlencode({"file_id": argv[1]}), 64 * 1024,
                        timeout=1800 if base != "https://api.telegram.org" else 60)
    info = {}
    if body is not None:
        try:
            info = json.loads(body)
        except ValueError:
            error = "Telegram gave an unreadable answer"
    file = info.get("result") or {}
    if error is None and not (info.get("ok") and file.get("file_path")):
        error = str(info.get("description") or "Telegram gave no file: it is over 20 MB or no longer kept")
    path, size = None, 0
    if error is None:
        ext = re.sub(r"[^A-Za-z0-9]", "", file["file_path"].rsplit(".", 1)[-1])[:10] if "." in file["file_path"] else ""
        unique = re.sub(r"[^A-Za-z0-9_-]", "", str(file.get("file_unique_id") or ""))[:100] or "dl"
        stem = f"{int(time.time() * 1000)}-{unique}"
        if base != "https://api.telegram.org":
            try:
                helper = runpy.run_path(str(Path(__file__).resolve().with_name('telegram-api')))
                with helper['open_local_file'](file['file_path']) as source:
                    before = os.fstat(source.fileno())
                    path, size, error = save_stream(source, stem, ext or 'bin')
                    after = os.fstat(source.fileno())
                    identity = lambda item: (item.st_dev, item.st_ino, item.st_size, item.st_mtime_ns)
                    if error is None and (identity(before) != identity(after) or size != before.st_size):
                        os.unlink(path)
                        path, size, error = None, 0, 'Telegram local file changed during the copy'
            except (OSError, ValueError):
                error = 'Telegram local file is unavailable or outside its private directory'
        else:
            body, error = fetch(f"{base}/file/bot{key}/{file['file_path']}", LIMIT)
            if error is None:
                path, error = save(body, stem, ext or 'bin')
                size = len(body)
    if error is not None:
        print(json.dumps({"ok": False, "error": KEY_SHAPE.sub("***", error)}, ensure_ascii=False))
        return 1
    print(json.dumps({"ok": True, "path": path, "bytes": size}, ensure_ascii=False))
    return 0


def save(body, stem, ext):
    path, _, error = save_stream(io.BytesIO(body), stem, ext)
    return path, error


def save_stream(source, stem, ext):
    """A new file of this run in the inbox, or an error; nothing already there is followed or overwritten.

    Codex, review of a333bb5c: the name of a Telegram file is not the name of one download, and a plain open
    truncated a file of the same name or wrote through a link planted in the inbox.
    """
    inbox = os.path.join(state_dir(), "inbox")
    try:
        os.makedirs(inbox, exist_ok=True)
    except OSError:
        pass
    if os.path.islink(inbox) or not os.path.isdir(inbox):
        return None, 0, "the inbox is not a plain folder"
    for _ in range(5):
        path = os.path.join(inbox, f"{stem}-{secrets.token_hex(4)}.{ext}")
        try:
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        except FileExistsError:
            continue
        except OSError as error:
            return None, 0, f"cannot save: {type(error).__name__}"
        try:
            size = 0
            with os.fdopen(descriptor, "wb") as out:
                while chunk := source.read(1024 * 1024):
                    out.write(chunk)
                    size += len(chunk)
        except OSError as error:
            os.unlink(path)
            return None, 0, f"cannot save: {type(error).__name__}"
        return path, size, None
    return None, 0, "cannot save: no free name"


if __name__ == "__main__":
    sys.exit(main(sys.argv))
