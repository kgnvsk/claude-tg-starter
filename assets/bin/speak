#!/bin/bash
# Voice reply: OpenAI TTS (gpt-4o-mini-tts) → Telegram voice message (ogg/opus).
# Same OPENAI_API_KEY as transcribe — no extra service needed.
# Usage: speak <chat_id> "text"   [env: OPENAI_TTS_VOICE=onyx OPENAI_TTS_SPEED=1.1 OPENAI_TTS_STYLE="..."]
set -e

# Cron has no bot environment: read the same channel configuration before any send.
telegram_api_base() {
  local helper="$(dirname "${BASH_SOURCE[0]}")/telegram-api"
  [ -f "$helper" ] || helper="$HOME/bin/telegram-api"
  if [ -f "$helper" ]; then
    python3 "$helper" base
    return $?
  fi
  # Standalone historical installations are cloud-only. A missing local helper
  # must never silently log a local bot back into the cloud.
  if [ -n "${TELEGRAM_API_BASE:-}" ] || grep -Eq '^(export[[:space:]]+)?TELEGRAM_API_BASE=' "${TELEGRAM_STATE_DIR:-$HOME/.claude/channels/telegram}/.env" 2>/dev/null; then
    echo 'Telegram local API helper is unavailable; no cloud fallback' >&2
    return 1
  fi
  printf '%s\n' 'https://api.telegram.org'
}

# Re-enter once with the current store value; the parent bot need not restart.
if [ "${1:-}" = "--novsky-provider-ready" ]; then
  shift
else
  if [ -f "$HOME/.claude/channels/telegram/.env" ]; then
    set -a
    . "$HOME/.claude/channels/telegram/.env"
    set +a
  fi
  exec python3 "$(dirname "$0")/agent-provider-run" openai /bin/bash "$0" --novsky-provider-ready "$@"
fi

CHAT_ID="$1"
TEXT="$2"
[ -z "$CHAT_ID" ] || [ -z "$TEXT" ] && { echo "Usage: speak <chat_id> \"text\"" >&2; exit 1; }

[ -z "$OPENAI_API_KEY" ] && { echo "No OPENAI_API_KEY" >&2; exit 1; }
[ -z "$TELEGRAM_BOT_TOKEN" ] && { echo "No TELEGRAM_BOT_TOKEN" >&2; exit 1; }
[[ "$TELEGRAM_BOT_TOKEN" =~ ^[A-Za-z0-9:_-]+$ ]] || { echo "Invalid TELEGRAM_BOT_TOKEN" >&2; exit 1; }

# OpenAI TTS caps input at 4096 chars — refuse louder texts so the caller
# shortens instead of sending a voice that cuts off mid-sentence.
if [ ${#TEXT} -gt 4096 ]; then
  echo "Text too long for TTS (${#TEXT} > 4096 chars) — shorten it" >&2
  exit 1
fi

VOICE="${OPENAI_TTS_VOICE:-onyx}"
SPEED="${OPENAI_TTS_SPEED:-1.1}"
STYLE="${OPENAI_TTS_STYLE:-Lively, upbeat, natural conversational delivery.}"
OGG="/tmp/speak-$$.ogg"
trap 'rm -f "$OGG"' EXIT

# 1. TTS → ogg/opus (Telegram's native voice format)
HTTP=$(printf 'Authorization: Bearer %s\n' "$OPENAI_API_KEY" | curl -H @- -sS -o "$OGG" -w "%{http_code}" -X POST "https://api.openai.com/v1/audio/speech" \
  -H "Content-Type: application/json" \
  -d "$(jq -n --arg t "$TEXT" --arg v "$VOICE" --argjson s "$SPEED" --arg i "$STYLE" '{model:"gpt-4o-mini-tts", input:$t, voice:$v, speed:$s, instructions:$i, response_format:"opus"}')")
if [ "$HTTP" != "200" ]; then
  echo "TTS failed (HTTP $HTTP)" >&2
  exit 1
fi

telegram_base=$(telegram_api_base) || exit 1

# 2. Send as Telegram voice message
RESP=$(curl -sS -X POST -K - \
  -F "chat_id=${CHAT_ID}" \
  -F "voice=@${OGG}" <<<"url = \"${telegram_base}/bot${TELEGRAM_BOT_TOKEN}/sendVoice\"")
if echo "$RESP" | jq -e '.ok' >/dev/null 2>&1; then
  echo "voice sent (message_id: $(echo "$RESP" | jq -r '.result.message_id'))"
else
  echo "sendVoice failed: $RESP" >&2  # whole (owner, 23.10.2026: its first 300 bytes)
  exit 1
fi
