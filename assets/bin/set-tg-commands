#!/usr/bin/env python3
"""Publish the bot's command menu to Telegram so it matches what actually works.

Without this the menu is empty and the owner has to remember which words the bot
answers to — and the difference that matters is invisible: /fix and /relogin are
handled by cron watchers and work while the agent is wedged, while /health and
/restart need the agent to be able to think. The descriptions say which is which.
"""
from __future__ import annotations

import json
import os
from pathlib import Path
import sys
import urllib.parse
import urllib.request

HOME = Path(os.environ.get("HOME", "/home/claude"))
ENV_FILE = Path(os.environ.get("TELEGRAM_STATE_DIR")
                or (HOME / ".claude/channels/telegram")) / ".env"

COMMANDS = [
    {"command": "fix",
     "description": "Оживить бота, если молчит — работает даже когда он мёртв"},
    {"command": "relogin",
     "description": "Прислать свежую ссылку для входа — работает даже когда он мёртв"},
    {"command": "health",
     "description": "Отчёт о здоровье: служба, канал, память, диск"},
    {"command": "restart",
     "description": "Перезапустить бота (нужен живой бот)"},
]


def token() -> str:
    for line in ENV_FILE.read_text(encoding="utf-8").splitlines():
        if line.startswith("TELEGRAM_BOT_TOKEN="):
            return line.split("=", 1)[1].strip()
    return ""


def call(method: str, payload: dict | None = None) -> dict:
    body = urllib.parse.urlencode(payload).encode() if payload else None
    request = urllib.request.Request(
        f"https://api.telegram.org/bot{token()}/{method}", data=body)
    with urllib.request.urlopen(request, timeout=20) as response:
        return json.load(response)


if not token():
    print("TELEGRAM_BOT_TOKEN not found; nothing to publish", file=sys.stderr)
    raise SystemExit(1)

current = call("getMyCommands").get("result") or []
if current == COMMANDS:
    print(f"command menu already matches ({len(COMMANDS)} commands)")
    raise SystemExit(0)

result = call("setMyCommands", {"commands": json.dumps(COMMANDS, ensure_ascii=False)})
if not result.get("ok"):
    print(f"could not publish command menu: {result}", file=sys.stderr)
    raise SystemExit(1)

published = call("getMyCommands").get("result") or []
print(f"command menu published: {', '.join('/' + c['command'] for c in published)}")
