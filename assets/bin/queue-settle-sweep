#!/usr/bin/env python3
"""Give the Stop guard a second chance at a queue head it never got to judge.

The Stop hook fires the moment a turn ends, but the transcript's final record
lands a little later. The guard reads an unfinished turn, exits silently
(rc=0, no stdout, no stderr) — and nobody calls it again. The head stays
'started' for good, every later message piles up behind it, and a restart
picks a different old message instead (Kirill's box, 2026-09-15). Running the
installed guard by hand over the same wedged session settles the head at
once, so the guard is right and only its timing was wrong.

This decides nothing about delivery: when a head has been sitting longer than
QUEUE_SETTLE_AFTER_SECONDS it calls the same guard again over the finished
transcript and lets it apply all of its own proofs. A refusal leaves the input
untouched. With a durable request ledger, unfinished work remains the receiver's
responsibility. The only exception is an old guard-owned carrier whose exact
final reply receipt and closed turn already prove completion.
"""
import fcntl
import json
import os
import pathlib
import re
import sqlite3
import subprocess
import sys
import time
import uuid
from contextlib import closing

AGENT_ROOT = pathlib.Path(os.environ.get("AGENT_ROOT") or os.environ.get("HOME") or "/home/claude")
STATE_DIR = pathlib.Path(os.environ.get("TELEGRAM_STATE_DIR") or AGENT_ROOT / ".claude/channels/telegram")
CONFIG_DIR = pathlib.Path(os.environ.get("CLAUDE_CONFIG_DIR") or AGENT_ROOT / ".claude")
GUARD = AGENT_ROOT / "bin/tg-reply-stop-guard"
LOG = AGENT_ROOT / "logs/queue-settle-sweep.log"
# Shared with cash-healthcheck, unstick-watch, claude-limit-recovery and
# claude-auth-rescue: whoever holds it is mid-way through the transport, and a
# lifecycle transition must not race another guard check.
LIFECYCLE_LOCK = AGENT_ROOT / "logs/transport-lifecycle.lock"
STUCK_SECONDS = int(os.environ.get("QUEUE_SETTLE_AFTER_SECONDS", "180"))
# The carrier envelope naming the head sits at the start of its turn, so the
# tail of a recent transcript is where a wedged head is found. Bounded: these
# files grow to megabytes and this runs every minute.
TRANSCRIPT_TAIL_BYTES = 4 * 1024 * 1024
TRANSCRIPT_CANDIDATES = 12


def log(message: str) -> None:
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with LOG.open("a", encoding="utf-8") as handle:
        handle.write(f"[{time.strftime('%FT%TZ', time.gmtime())}] {message}\n")


AUTHORITY_VALUES = ("guard", "shadow", "receiver")


def delivery_authority() -> str:
    """Who removes a delivered message from the queue (KTD8).

    The value the poller started with, read from the database on every run —
    never from the channel file, which may already say something the running
    service has not started with. Absent or unknown means guard.
    """
    try:
        connection = sqlite3.connect(f"file:{STATE_DIR / 'messages.db'}?mode=ro", uri=True, timeout=5)
        try:
            row = connection.execute("SELECT value FROM delivery_runtime WHERE key='authority'").fetchone()
        finally:
            connection.close()
    except sqlite3.Error:
        return "guard"
    return row[0] if row and row[0] in AUTHORITY_VALUES else "guard"


def queue_head() -> tuple[str, int] | None:
    """The oldest started head and its age in seconds."""
    database = STATE_DIR / "messages.db"
    try:
        connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True, timeout=5)
        columns = {item[1] for item in connection.execute("PRAGMA table_info(pending_inbound_deliveries)")}
        if not columns:
            connection.close()
            return None
        # The schema differs between kit generations: started_at is not everywhere.
        stamp = "started_at" if "started_at" in columns else "created_at"
        # The same order every other actor walks the queue in; judging by rowid
        # could pick a newer row and requeue the wrong message.
        row = connection.execute(
            f"SELECT delivery_id, {stamp} FROM pending_inbound_deliveries "
            "WHERE state='started' ORDER BY created_at ASC, rowid ASC LIMIT 1"
        ).fetchone()
        connection.close()
    except sqlite3.Error as error:
        log(f"queue not read: {error}")
        return None
    if row is None:
        return None
    delivery_id, marked = row
    marked = marked or 0
    age = int(time.time() - (marked / 1000 if marked > 10 ** 11 else marked))
    return str(delivery_id), age


def transcript_for(delivery_id: str) -> pathlib.Path | None:
    """The transcript that carries this head, and only that one.

    An agent runs several sessions at once, so the newest transcript is often
    somebody else's turn. The guard would read it, find no proof for this head
    and refuse — a refusal about a different conversation, on which this script
    would then put a message back in the queue. A head no transcript carries is
    left alone instead.
    """
    files = sorted((CONFIG_DIR / "projects").glob("*/*.jsonl"), key=lambda path: path.stat().st_mtime, reverse=True)
    needle = delivery_id.encode()
    for path in files[:TRANSCRIPT_CANDIDATES]:
        try:
            with path.open("rb") as handle:
                handle.seek(max(0, path.stat().st_size - TRANSCRIPT_TAIL_BYTES))
                if needle in handle.read():
                    return path
        except OSError:
            continue
    return None


def session_of(transcript: pathlib.Path) -> str | None:
    """Claude Code names a transcript after its session; fall back to its records."""
    stem = transcript.stem
    try:
        return str(uuid.UUID(stem))
    except ValueError:
        pass
    try:
        with transcript.open("r", encoding="utf-8", errors="replace") as handle:
            for line in handle:
                try:
                    recorded = json.loads(line).get("sessionId")
                except (json.JSONDecodeError, AttributeError):
                    continue
                if isinstance(recorded, str):
                    try:
                        return str(uuid.UUID(recorded))
                    except ValueError:
                        return None
    except OSError:
        return None
    return None


def still_started(delivery_id: str) -> bool:
    try:
        connection = sqlite3.connect(f"file:{STATE_DIR / 'messages.db'}?mode=ro", uri=True, timeout=5)
        row = connection.execute(
            "SELECT 1 FROM pending_inbound_deliveries WHERE delivery_id=? AND state='started'",
            (delivery_id,),
        ).fetchone()
        connection.close()
    except sqlite3.Error:
        return False
    return row is not None


# The model never ran: the account is out of its session, weekly or usage
# allowance, the seat is out of credits, the subscription or organisation is
# gone, or the request itself is refused (a 4xx: a model this CLI does not
# know, a revoked key). Same wording the limit watcher classifies, kept here
# because a sweep that cannot see this replays a dead agent (Kirill's box,
# 2026-09-15: a weekly limit, every turn dying at once). A 5xx is not listed:
# an overloaded provider is exactly what a later replay fixes.
TURN_NEVER_RAN = re.compile(
    r"You've hit your (?:session|weekly|usage) limit"
    r"|You're out of usage credits"
    r"|Invalid API key|OAuth token has expired|Please run /login"
    r"|Failed to authenticate"
    r"|subscription (?:has |is )?(?:expired|ended|inactive)|no active subscription"
    r"|credit balance is too low|payment (?:required|failed)|overdue invoice"
    r"|organization has been disabled"
    r"|API Error: 4[0-9]{2}\b"
)


def turn_records(transcript: pathlib.Path, delivery_id: str) -> list[dict] | None:
    """This delivery's turn: every record from its envelope to the end of the tail.

    None when the tail no longer carries the envelope: the turn began more than
    TRANSCRIPT_TAIL_BYTES ago, so the model has long since run.
    """
    try:
        with transcript.open("rb") as handle:
            handle.seek(max(0, transcript.stat().st_size - TRANSCRIPT_TAIL_BYTES))
            lines = handle.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return None
    needle = f'delivery_id="{delivery_id}"'
    start = next((index for index, line in enumerate(lines) if needle in line.replace('\\"', '"')), None)
    if start is None:
        return None
    records = []
    for line in lines[start:]:
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(record, dict):
            records.append(record)
    return records


def turn_closed(records: list[dict] | None) -> bool:
    """Claude Code ends every turn, a refused one included, with a turn_duration record.

    Until it lands the model is still working, and the transcript is written
    with a lag and out of order: judged in the middle of a long turn, the guard
    found no delivery yet and forwarded the model's last progress note to the
    person as its answer, minutes before the real reply (Кнопа Кирила and Кеш,
    17.09). A turn without its closing record is not the guard's to judge.
    """
    if records is None:
        return True
    return any(record.get("type") == "system" and record.get("subtype") == "turn_duration"
               for record in records)


def turn_never_ran(records: list[dict] | None) -> str | None:
    """The reason the model produced nothing at all, if Claude Code wrote it down.

    Only a record the CLI itself flags isApiErrorMessage counts, and only from
    this delivery's own turn on. The same words sit in the documentation of a
    tool loaded on demand (SendMessage: "the subscription expired", written
    into the transcript since CLI 2.1.274) and in a limit record from a turn
    that ended hours earlier; read from the raw tail, both parked a live head
    until the healthcheck restarted a healthy agent (Kirill's box, 16–17.09).
    """
    for record in records or []:
        if not record.get("isApiErrorMessage"):
            continue
        message = record.get("message")
        content = message.get("content") if isinstance(message, dict) else None
        texts = [content] if isinstance(content, str) else [
            block.get("text", "") for block in (content or []) if isinstance(block, dict)]
        found = TURN_NEVER_RAN.search("\n".join(str(text) for text in texts))
        if found:
            return found.group(0)
    return None


def durable_recovery(connection: sqlite3.Connection | None = None) -> bool:
    """A durable request ledger makes the receiver the sole rescheduler."""
    own_connection = connection is None
    try:
        if connection is None:
            connection = sqlite3.connect(f"file:{STATE_DIR / 'messages.db'}?mode=ro", uri=True, timeout=2)
        return any(row[1] == 'request_payload' for row in connection.execute('PRAGMA table_info(delivery_results)'))
    except sqlite3.Error:
        # Unknown ownership is not permission to mutate a queue.
        return True
    finally:
        if own_connection and connection is not None:
            connection.close()


def log_retained_delivery(delivery_id: str, age: int, note: str) -> None:
    """The receiver alone schedules a new attempt of the saved request."""
    log(f"{delivery_id} sat {age}s — retained for receiver recovery: {note or 'no confirmed output'}")


def settle_completed_durable_head() -> None:
    """Retire only an old guard-owned carrier with a proven final reply.

    The durable receiver records completion before the Stop guard can inspect
    its transcript. If that guard misses the closing record, its started carrier
    blocks FIFO forever even though the reply was delivered. This proof is
    deliberately narrower than the guard's general completion decision.
    """
    lock = None
    try:
        LIFECYCLE_LOCK.parent.mkdir(parents=True, exist_ok=True)
        lock = LIFECYCLE_LOCK.open("a")
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (OSError, BlockingIOError):
        if lock is not None:
            lock.close()
        return
    try:
        with closing(sqlite3.connect(STATE_DIR / "messages.db", timeout=5)) as connection, connection:
            connection.execute("BEGIN IMMEDIATE")
            # A completed result can still have a later native callback. An
            # older receiver has no immutable callback ledger, so it cannot
            # prove that retiring this carrier is safe.
            callback_columns = {item[1] for item in connection.execute(
                "PRAGMA table_info(delivery_task_returns)"
            )}
            if not {"session_id", "stamp", "turn_id", "delivery_id", "observed_at"} <= callback_columns:
                return
            # The receiver snapshots pre-ledger native sessions before it can
            # rebind a retained request. An old request timestamp says nothing
            # about whether the newly claimed native session is safe.
            if not connection.execute(
                "SELECT 1 FROM sqlite_master WHERE type='table' "
                "AND name='delivery_legacy_native_sessions'"
            ).fetchone():
                return
            if not connection.execute(
                "SELECT 1 FROM sqlite_master WHERE type='table' "
                "AND name='delivery_task_owners'"
            ).fetchone():
                return
            # An owner without a request is an unresolved conflict only when it is
            # legacy. A launch no request has claimed yet (unowned) is not one: this
            # guard-mode sweep reads the launch ledger as if it did not exist.
            obligations = "state" in {
                item[1] for item in connection.execute("PRAGMA table_info(delivery_task_owners)")}
            unclaimed = ("(own.delivery_id IS NULL AND own.state='legacy')" if obligations
                         else "own.delivery_id IS NULL")
            row = connection.execute(
                "SELECT delivery_id, state, coalesce(started_at, created_at) "
                "FROM pending_inbound_deliveries ORDER BY created_at, rowid LIMIT 1"
            ).fetchone()
            if row is None or row[1] != "started":
                return
            delivery_id, _, marked = row
            now = int(time.time() * 1000)
            marked_ms = marked if marked and marked > 10 ** 11 else (marked or 0) * 1000
            if now - marked_ms < STUCK_SECONDS * 1000:
                return
            # A restart resumes the same native session under a new service
            # stamp; the result's own stamp still binds its receipt and epoch.
            retired = connection.execute(
                "DELETE FROM pending_inbound_deliveries WHERE delivery_id=? AND state='started' "
                "AND EXISTS (SELECT 1 FROM delivery_results r "
                "JOIN delivery_sessions s ON s.session_id=r.session_id AND s.stamp IS NOT NULL "
                "JOIN delivery_runtime epoch ON epoch.key='callback_ledger_epoch:'||r.stamp "
                "AND epoch.value=CAST(CAST(epoch.value AS INTEGER) AS TEXT) "
                "AND CAST(epoch.value AS INTEGER)>100000000000 "
                "JOIN delivery_turns orig ON orig.turn_id=r.turn_id AND orig.session_id=r.session_id "
                "JOIN delivery_turns ans ON ans.turn_id=coalesce(r.response_turn_id,r.turn_id) "
                "AND ans.session_id=r.session_id "
                "JOIN delivery_turn_messages m ON m.turn_id=r.turn_id AND m.delivery_id=r.delivery_id "
                "AND m.chat_id=r.chat_id AND m.thread_id IS r.thread_id "
                "JOIN delivery_receipts c ON c.delivery_id=r.delivery_id AND c.turn_id=r.turn_id "
                "AND c.chat_id=r.chat_id AND c.thread_id IS r.thread_id AND c.stamp=r.stamp "
                "AND c.source='reply' "
                "WHERE r.delivery_id=? AND r.state='complete' AND r.task_id IS NULL "
                "AND r.created_at>0 AND r.finished_at>0 "
                "AND r.finished_at<=? AND r.stamp IS NOT NULL AND r.stamp<>'' "
                "AND orig.closed_at IS NOT NULL AND ans.closed_at IS NOT NULL "
                "AND m.closed_at IS NOT NULL AND m.closed_by='receipt' "
                "AND NOT EXISTS (SELECT 1 FROM delivery_legacy_native_sessions legacy "
                "WHERE legacy.session_id=r.session_id) "
                "AND NOT EXISTS (SELECT 1 FROM delivery_task_owners own "
                "WHERE own.session_id=r.session_id AND own.stamp=r.stamp "
                f"AND (own.delivery_id=r.delivery_id OR {unclaimed})) "
                "AND NOT EXISTS (SELECT 1 FROM delivery_task_returns ret "
                "WHERE ret.session_id=r.session_id AND ret.stamp=r.stamp "
                "AND (ret.delivery_id=r.delivery_id OR "
                "(ret.delivery_id IS NULL AND ret.observed_at>=r.created_at))))",
                (delivery_id, delivery_id, now - 30_000),
            ).rowcount
            if retired == 1:
                log(f"{delivery_id} — completed durable reply retired its stale started carrier")
                return
            terminal_columns = {item[1] for item in connection.execute(
                "PRAGMA table_info(delivery_terminal_receipts)"
            )}
            if not {"delivery_id", "turn_id", "session_id", "stamp", "chat_id", "thread_id",
                    "result_generation", "task_return_id", "source", "message_id", "created_at"} <= terminal_columns:
                return
            # A bound native callback is safe only if the *whole* final send and the
            # result completion committed at its exact generation. Every worker the
            # request owns returned or stopped, each return bound before that final;
            # a legacy obligation keeps the carrier. A later callback, re-launch,
            # retry, cancellation or unknown return invalidates the proof. Without
            # the obligation ledger the request had one task. Other shapes stay in HOLD.
            # A worker of its turns that no progress registered, or a launch not
            # resolved yet, would keep it under the receiver; this sweep runs under
            # guard and shadow only, where nothing new may block (NOVSKY, 27.09),
            # so it logs would_block_unowned_worker and retires as before.
            if obligations:
                other_work = "own.delivery_id=r.delivery_id AND own.state NOT IN ('returned','stopped')"
                later_return = "other.observed_at>terminal.created_at"
                unknown_return = "unknown.delivery_id IS NULL AND unknown.occurrence IS NULL"
                launches = connection.execute(
                    "SELECT 1 FROM sqlite_master WHERE type='table' AND name='delivery_task_launches'").fetchone()
                unowned = [row[0] for row in connection.execute(
                    "SELECT 'task ' || own.task_id || ' launch=' || coalesce(own.launch_ref, '') "
                    "FROM delivery_task_owners own JOIN delivery_results r ON r.session_id=own.session_id "
                    "AND r.stamp=own.stamp WHERE r.delivery_id=? AND own.state='unowned' "
                    "AND own.launched_turn IN (r.turn_id, r.response_turn_id)"
                    + (" UNION ALL SELECT 'launch ' || l.launch_ref FROM delivery_task_launches l "
                       "JOIN delivery_results r ON r.session_id=l.session_id AND r.stamp=l.stamp "
                       "WHERE r.delivery_id=? AND l.state='launching' "
                       "AND l.launched_turn IN (r.turn_id, r.response_turn_id)" if launches else ""),
                    (delivery_id, delivery_id) if launches else (delivery_id,))]
            else:
                other_work = "own.delivery_id=r.delivery_id AND own.task_id<>r.task_id"
                later_return = "other.return_id<>ret.return_id"
                unknown_return = "unknown.delivery_id IS NULL"
                unowned = []
            retired = connection.execute(
                "DELETE FROM pending_inbound_deliveries WHERE delivery_id=? AND state='started' "
                "AND EXISTS (SELECT 1 FROM delivery_results r "
                "JOIN delivery_runtime epoch ON epoch.key='callback_ledger_epoch:'||r.stamp "
                "AND epoch.value=CAST(CAST(epoch.value AS INTEGER) AS TEXT) "
                "AND CAST(epoch.value AS INTEGER)>100000000000 "
                "JOIN delivery_turns orig ON orig.turn_id=r.turn_id AND orig.session_id=r.session_id "
                "JOIN delivery_turns ans ON ans.turn_id=r.response_turn_id AND ans.session_id=r.session_id "
                "JOIN delivery_turn_messages m ON m.turn_id=r.turn_id AND m.delivery_id=r.delivery_id "
                "AND m.chat_id=r.chat_id AND m.thread_id IS r.thread_id "
                "JOIN delivery_terminal_receipts terminal ON terminal.delivery_id=r.delivery_id "
                "AND terminal.turn_id=r.turn_id AND terminal.session_id=r.session_id "
                "AND terminal.stamp=r.stamp AND terminal.chat_id=r.chat_id "
                "AND terminal.thread_id IS r.thread_id "
                "AND terminal.result_generation=r.result_generation "
                "AND terminal.created_at=r.finished_at AND terminal.message_id>0 "
                "AND terminal.source IN ('reply','shell') "
                "JOIN delivery_task_returns ret ON ret.return_id=terminal.task_return_id "
                "AND ret.session_id=r.session_id AND ret.stamp=r.stamp "
                "AND ret.delivery_id=r.delivery_id AND ret.turn_id=r.response_turn_id "
                "AND ret.task_id=r.task_id AND ret.observed_at>=r.created_at "
                "WHERE r.delivery_id=? AND r.state='complete' AND r.task_id IS NOT NULL "
                "AND r.response_turn_id IS NOT NULL AND r.request_payload IS NOT NULL "
                "AND r.result_generation>0 AND r.created_at>0 AND r.finished_at>0 "
                "AND r.finished_at<=? AND terminal.created_at>=ret.observed_at "
                "AND r.stamp IS NOT NULL AND r.stamp<>'' "
                "AND orig.closed_at IS NOT NULL AND ans.closed_at IS NOT NULL "
                "AND m.closed_at IS NOT NULL AND m.closed_by='receipt' "
                "AND NOT EXISTS (SELECT 1 FROM delivery_legacy_native_sessions legacy "
                "WHERE legacy.session_id=r.session_id) "
                "AND NOT EXISTS (SELECT 1 FROM delivery_task_owners own "
                "WHERE own.session_id=r.session_id AND own.stamp=r.stamp "
                f"AND ({unclaimed} OR {other_work})) "
                "AND EXISTS (SELECT 1 FROM delivery_receipts c WHERE c.delivery_id=r.delivery_id "
                "AND c.turn_id=r.turn_id AND c.chat_id=r.chat_id AND c.thread_id IS r.thread_id "
                "AND c.stamp=r.stamp AND c.source=terminal.source) "
                "AND NOT EXISTS (SELECT 1 FROM delivery_task_returns other "
                "WHERE other.session_id=r.session_id AND other.stamp=r.stamp "
                f"AND other.delivery_id=r.delivery_id AND {later_return} "
                "AND other.observed_at>=r.created_at) "
                "AND NOT EXISTS (SELECT 1 FROM delivery_task_returns unknown "
                "WHERE unknown.session_id=r.session_id AND unknown.stamp=r.stamp "
                f"AND {unknown_return} AND unknown.observed_at>=r.created_at))",
                (delivery_id, delivery_id, now - 30_000),
            ).rowcount
            if retired == 1:
                log(f"{delivery_id} — exact terminal native callback receipt retired stale started carrier")
                if unowned:
                    log(f"{delivery_id} — would_block_unowned_worker: {', '.join(unowned)}")
    except sqlite3.Error as error:
        log(f"durable completed-head check deferred: {error}")
    finally:
        lock.close()


def main() -> int:
    if not GUARD.is_file() or not (STATE_DIR / "messages.db").exists():
        return 0
    if durable_recovery():
        if delivery_authority() != "receiver":
            settle_completed_durable_head()
        return 0
    if delivery_authority() == "receiver":
        log("delivery authority is receiver: the receiver settles its own queue — sweep inert")
        return 0
    head = queue_head()
    if head is None:
        return 0
    delivery_id, age = head
    if age < STUCK_SECONDS:
        return 0
    lock = None
    try:
        LIFECYCLE_LOCK.parent.mkdir(parents=True, exist_ok=True)
        lock = LIFECYCLE_LOCK.open("a")
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except (OSError, BlockingIOError):
        if lock is not None:
            lock.close()
        log(f"{delivery_id} sat {age}s but the transport lifecycle lock is busy — left for its holder")
        return 0
    try:
        transcript = transcript_for(delivery_id)
        if transcript is None:
            log(f"{delivery_id} sat {age}s and no recent transcript carries it — left untouched")
            return 0
        session = session_of(transcript)
        if session is None:
            log(f"{delivery_id} sat {age}s but {transcript.name} names no session")
            return 0
        records = turn_records(transcript, delivery_id)
        if not turn_closed(records):
            log(f"{delivery_id} sat {age}s but its turn is still running — left alone")
            return 0
        # The guard needs the session to ask the team broker about delegated work;
        # without it every turn that used a shell looks unconfirmed and it refuses.
        payload = json.dumps({
            "transcript_path": str(transcript),
            "session_id": session,
            "stop_hook_active": False,
        })
        try:
            verdict = subprocess.run([str(GUARD)], input=payload, text=True, capture_output=True, timeout=60)
        except (OSError, subprocess.SubprocessError) as error:
            log(f"{delivery_id} sat {age}s and the guard did not run: {error}")
            return 0
        if not still_started(delivery_id):
            log(f"{delivery_id} sat {age}s — settled by running the guard again")
            return 0
        note = (verdict.stdout or verdict.stderr or "").strip().replace("\n", " ")[:160]
        # A provider limit needs receiver recovery, not another blind execution.
        external = turn_never_ran(records)
        if external:
            log(f"{delivery_id} sat {age}s and the turn never ran ({external}) — left for the limit watcher")
            return 0
        # A missing response alone proves neither completion nor deliberate silence.
        log_retained_delivery(delivery_id, age, note)
        return 0
    finally:
        lock.close()


if __name__ == "__main__":
    sys.exit(main())
