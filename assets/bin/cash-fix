#!/bin/bash
# cash-fix — on-demand heal ("doctor --fix"): re-patch the plugin from the golden (in
# case the marketplace sync reverted it), clear any failed state, restart the service,
# then report via cash-doctor. The AUTO-FIXABLE subset only — codex login and low disk
# need the owner (cash-doctor flags them). Most failures self-heal via healthcheck (cron);
# this is the on-demand "force heal".
set -u
H="${HOME:-/home/claude}"
SVC="${CLAUDE_TELEGRAM_SERVICE:-claude-telegram.service}"
echo "🔧 {{AGENT_NAME}} — виправлення"
echo

# 1. golden restore — only the exact official 0.0.7 provenance may transition
# to the reviewed golden. A future or locally modified plugin is a manual review,
# never a wildcard overwrite followed by a restart.
if [ ! -x "$H/bin/reconcile-telegram-plugin" ]; then
  echo "  ❌ відсутній перевірений reconciler Telegram plugin; службу не перезапущено" >&2
  exit 2
fi
if ! "$H/bin/reconcile-telegram-plugin" --apply; then
  echo "  ❌ Telegram plugin несумісний із перевіреним patch 0.0.7; службу не перезапущено" >&2
  exit 2
fi

# 2. clear failed state + restart — re-reads creds, respawns poller, clears crash-loop stop
sudo systemctl reset-failed "$SVC" 2>/dev/null
if sudo systemctl restart "$SVC" 2>/dev/null; then
  echo "  ✅ службу перезапущено"
else
  echo "  ❌ перезапуск не вдався — потрібен ти (SSH)"
fi

sleep 5
echo
echo "── стан після виправлення ──"
"$H/bin/cash-doctor"
