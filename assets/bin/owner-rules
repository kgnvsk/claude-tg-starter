#!/usr/bin/env python3
"""Lossless local owner-rule library. Migrate only during an idle, backed-up change window."""
import argparse
from contextlib import contextmanager
try:import fcntl
except ImportError:fcntl=None  # native Windows kits use the OS byte-range lock
import hashlib
import json
import os
from pathlib import Path
import re
import sys
import tempfile
import stat
import time

HOME = Path(os.environ.get('ANSWER_CONTEXT_HOME') or Path.home())
DIRECTORY = HOME / '.claude/owner-rules'
CAP = 4500

def digest(data):
    return hashlib.sha256(data).hexdigest()

def safe_directory(path):
    if path == HOME:
        if path.is_symlink(): raise ValueError('unsafe home')
        return
    path.relative_to(HOME)
    safe_directory(path.parent)
    if path.is_symlink(): raise ValueError('symlinked rules directory')
    path.mkdir(mode=0o700, exist_ok=True)
    if not path.is_dir(): raise ValueError('unsafe rules directory')

def atomic(path, content):
    fd, name=tempfile.mkstemp(dir=path.parent, prefix='.rules-')
    try:
        with os.fdopen(fd,'wb') as out:
            out.write(content); out.flush(); os.fsync(out.fileno())
        if path.exists(): os.chmod(name,stat.S_IMODE(path.stat().st_mode))
        os.replace(name,path)
        if os.name!='nt':
            directory_fd=os.open(path.parent,os.O_RDONLY)
            try: os.fsync(directory_fd)
            finally: os.close(directory_fd)
    finally:
        Path(name).unlink(missing_ok=True)

def load():
    with locked():
        value=json.loads(read_bytes(DIRECTORY/'index.json'))
        if value.get('schemaVersion') != 1 or not isinstance(value.get('rules'),list): raise ValueError('invalid rule library')
        return value


def core_path():
    return HOME/'CLAUDE.md'


def read_bytes(path, missing=False, maximum=2_000_000):
    """No pipe/device/link or failed read can become an empty rule source."""
    try:
        metadata=path.lstat()
    except FileNotFoundError:
        if missing:return None
        raise
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink!=1:
        raise ValueError('unsafe rule source')
    fd=os.open(path,os.O_RDONLY|getattr(os,'O_NOFOLLOW',0)|getattr(os,'O_NONBLOCK',0))
    with os.fdopen(fd,'rb') as stream:
        current=os.fstat(stream.fileno())
        if not stat.S_ISREG(current.st_mode) or current.st_nlink!=1 or current.st_size>maximum or (current.st_dev,current.st_ino)!=(metadata.st_dev,metadata.st_ino):
            raise ValueError('unsafe or oversized rule source')
        value=stream.read(maximum+1)
    if len(value)>maximum:raise ValueError('rule source too large')
    return value


@contextmanager
def locked():
    safe_directory(DIRECTORY)
    fd=os.open(DIRECTORY/'write.lock',os.O_RDWR|os.O_CREAT|getattr(os,'O_NOFOLLOW',0),0o600)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):raise ValueError('unsafe rule lock')
        if fcntl is not None:fcntl.flock(fd,fcntl.LOCK_EX)
        else:
            import msvcrt
            if os.fstat(fd).st_size==0:os.write(fd,b'0')
            os.lseek(fd,0,0);deadline=time.monotonic()+2
            while True:
                try:msvcrt.locking(fd,msvcrt.LK_NBLCK,1);break
                except OSError:
                    if time.monotonic()>=deadline:raise ValueError('rule store busy; retry the current read')
                    time.sleep(.02)
        recover()
        yield
    finally:os.close(fd)


def recover():
    """Finish a recorded two-file replacement, or retain evidence and refuse a foreign edit.

    All cooperating readers/writers hold the same lock. A crash can leave the old
    core beside the new library, but no reader accepts that mixed revision.
    """
    path=DIRECTORY/'transaction.json'
    raw=read_bytes(path,True,10_000_000)
    if raw is None:return
    tx=json.loads(raw)
    if not isinstance(tx,dict) or set(tx)!={'core','index','coreTarget'}:raise ValueError('invalid rule transaction target')
    if tx['coreTarget']!=str(core_path().resolve()):raise ValueError('rule transaction target changed; original journal retained')
    targets={'index':DIRECTORY/'index.json','core':core_path()}
    for key,target in targets.items():
        item=tx[key]
        if not isinstance(item,dict) or set(item)!={'before','after'} or not isinstance(item['after'],str):
            raise ValueError('invalid rule transaction')
        actual=read_bytes(target,True)
        if actual not in (None if item['before'] is None else item['before'].encode(),item['after'].encode()):
            raise ValueError('rule source changed during recovery; original and replacement retained')
    for key,target in targets.items():
        after=tx[key]['after'].encode()
        actual=read_bytes(target,True)
        if actual!=after:
            if actual!=(None if tx[key]['before'] is None else tx[key]['before'].encode()):
                raise ValueError('rule source changed before replacement')
            atomic(target,after)
    path.unlink()


REFERENCE=('Правила збережено без скорочень у ~/.claude/owner-rules/index.json. '
           'Перед відповіддю прочитай актуальні правила й переписку через answer-context. '
           'Зміни правил зберігай через owner-rules з джерелом, областю дії та явною заміною старого правила.\n')


def core_rules(raw):
    """Extract only explicit owner-rule sections, preserving every other byte."""
    kept=[];body=[];parts=[];inside=False;contacts=False;referenced=False
    def flush():
        if body:
            parts.extend(blocks(''.join(body)));body.clear()
    for line in (raw or b'').decode('utf-8').splitlines(keepends=True):
        if line.startswith('<!-- novsky-'):flush();contacts=True
        if contacts:
            kept.append(line)
            if line.startswith('<!-- /novsky-'):contacts=False
            continue
        if line.startswith('# '):
            flush();inside=line.strip()=='# Правила власника'
            kept.append(line)
            if inside and not referenced:kept.append(REFERENCE);referenced=True
            continue
        if inside:
            if line.startswith('Правила збережено без скорочень у ~/.claude/owner-rules/index.json.'):
                continue  # The old, exact migration reference is not a rule.
            body.append(line)
        else:kept.append(line)
    flush()
    if not referenced:kept.append('\n# Правила власника\n'+REFERENCE)
    return [p.strip() for p in parts if p.strip()],''.join(kept)


def _snapshot(scope=None):
    core=read_bytes(core_path(),True);raw=read_bytes(DIRECTORY/'index.json',True)
    value=json.loads(raw) if raw is not None else {'schemaVersion':1,'rules':[]}
    if not isinstance(value,dict) or value.get('schemaVersion')!=1 or not isinstance(value.get('rules'),list):
        raise ValueError('invalid rule library')
    rows=[];seen=set()
    for row in value['rules']:
        if not isinstance(row,dict) or not isinstance(row.get('id'),str) or not isinstance(row.get('text'),str):
            raise ValueError('invalid rule')
        if row['id'] in seen:raise ValueError('duplicate rule ID')
        seen.add(row['id']);rows.append({**row,'scope':row.get('scope','owner')})
    texts,cleaned=core_rules(core)
    existing={(row['scope'],row['text'].strip()) for row in rows}
    for text in texts:
        if ('owner',text) in existing:continue
        identifier='core:'+digest(text.encode())
        if identifier in seen:raise ValueError('rule id collision')
        seen.add(identifier);existing.add(('owner',text))
        rows.append({'id':identifier,'scope':'owner','text':text,'origin':'core'})
    revision=digest(json.dumps([None if core is None else digest(core),None if raw is None else digest(raw)],separators=(',',':')).encode())
    owner_context=read_bytes(core_path().parent/'OWNER.md',True)
    if owner_context is not None:revision=digest((revision+digest(owner_context)).encode())
    projected=[row for row in rows if scope is None or row['scope'] in (scope,'all')]
    if scope is not None:
        # Provenance stays in the owner's private store. A rule published for a
        # company chat must not carry unrelated words from its private source.
        projected=[{key:row[key] for key in ('id','key','scope','text') if key in row} for row in projected]
        revision=digest(json.dumps(projected,sort_keys=True,ensure_ascii=False).encode())
    result={'revision':revision,'rules':projected}
    if scope is None:
        result['legacyContext']={'core':cleaned,'ownerContext':(owner_context or b'').decode()}
    return result,{'core':core,'index':raw,'value':value,'cleaned':cleaned}


def snapshot(scope=None):
    with locked():return _snapshot(scope)[0]


def instruction_receipt(source):
    with locked():
        _,state=_snapshot()
        saved=state['value'].get('appliedChanges',{}).get(f"{source['chatId']}:{source['messageId']}")
        if saved and saved.get('sourceHash')==digest(json.dumps(source,sort_keys=True,ensure_ascii=False).encode()):
            return saved.get('disposition')


def apply_rules(request, scope=None):
    """Host-authenticated source is required by the engine adapter; this is storage, not ACL.

    No semantic guessing: the caller reads all active candidates and explicitly
    names replacements, full conditions/exceptions, and a stable subject/scope.
    """
    if not isinstance(request,dict):raise ValueError('invalid rule change')
    with locked():
        current,state=_snapshot()
        applicable=_snapshot(scope)[0] if scope is not None else current
        source=request.get('source');changes=request.get('changes')
        if isinstance(source,dict):
            operation=f"{source.get('chatId')}:{source.get('messageId')}"
            fingerprint=digest(json.dumps([source,changes,request.get('disposition'),request.get('reason')],sort_keys=True,ensure_ascii=False).encode())
            saved=state['value'].get('appliedChanges',{}).get(operation)
            if saved:
                if saved['fingerprint']!=fingerprint:raise ValueError('owner instruction already saved with a different edit; inspect its receipt')
                return {'ok':True,'revision':applicable['revision'],'savedIds':saved['savedIds'],'disposition':saved.get('disposition'),'replayed':True}
        if request.get('revision')!=applicable['revision']:raise ValueError('rules changed; read current rules before saving')
        ids={row['id'] for row in applicable['rules']}
        reviewed=request.get('reviewedIds')
        if not isinstance(reviewed,list) or len(reviewed)!=len(ids) or set(reviewed)!=ids:
            raise ValueError('review every current rule before replacing conflicts')
        source=request.get('source')
        if (not isinstance(source,dict) or set(source)!={'chatId','messageId','text'}
            or not isinstance(source['chatId'],str) or not re.fullmatch(r'-?\d+',source['chatId'])
            or type(source['messageId']) is not int or source['messageId']<=0
            or not isinstance(source['text'],str) or not source['text'].strip() or len(source['text'])>60_000):
            raise ValueError('source of owner instruction required')
        changes=request.get('changes')
        if not isinstance(changes,list) or len(changes)>50:raise ValueError('invalid changes')
        if changes:
            if request.get('disposition') not in (None,'applied'):raise ValueError('a rule change must be applied')
            disposition='applied'
        else:
            disposition=request.get('disposition')
            if disposition not in ('not_rule','clarify') or not isinstance(request.get('reason'),str) or not 20<=len(request['reason'])<=2000:
                raise ValueError('explain why this is a one-off task or what rule scope needs clarification')
        removed=set();added=[]
        for change in changes:
            if not isinstance(change,dict) or set(change)!={'key','scope','text','replaces'}:raise ValueError('invalid change fields')
            key,change_scope,text,replaces=(change[k] for k in ('key','scope','text','replaces'))
            if not isinstance(key,str) or not re.fullmatch(r'[a-z0-9][a-z0-9._-]{0,119}',key):raise ValueError('invalid rule subject')
            if not isinstance(change_scope,str) or not re.fullmatch(r'owner|all|chat:-?\d+:\d+',change_scope):raise ValueError('explicit rule scope required')
            if scope is not None and change_scope!=scope:raise ValueError('rule change outside current scope')
            if not isinstance(text,str) or len(text.strip())>60_000 or (not text.strip() and not replaces):raise ValueError('complete rule text or explicit retirement required')
            if not isinstance(replaces,list) or len(set(replaces))!=len(replaces) or not set(replaces)<=ids or removed.intersection(replaces):
                raise ValueError('invalid replacement IDs')
            if any(row['scope']!=change_scope for row in current['rules'] if row['id'] in replaces):
                raise ValueError('replacement cannot silently change scope')
            removed.update(replaces)
            if text.strip():
                identifier=digest(json.dumps([change_scope,key,text.strip(),source],sort_keys=True,ensure_ascii=False).encode())[:24]
                added.append({'id':identifier,'key':key,'scope':change_scope,'text':text.strip(),'source':source,'replaces':replaces})
        rows=[row for row in current['rules'] if row['id'] not in removed]
        subjects=set()
        for row in rows+added:
            subject=(row['scope'],row.get('key',row['id']))
            if subject in subjects:raise ValueError('active rule subject already exists; explicitly replace its current version')
            subjects.add(subject)
        if len({r['id'] for r in rows+added})!=len(rows+added):raise ValueError('duplicate rule ID')
        value={**state['value'],'rules':rows+added,'history':[*state['value'].get('history',[]),
            {'at':int(time.time()),'source':source,'revision':current['revision'],
             'rules':[row for row in current['rules'] if row['id'] in removed]}]}
        value['appliedChanges']={**state['value'].get('appliedChanges',{}),
            operation:{'fingerprint':fingerprint,'savedIds':[row['id'] for row in added],
                       'sourceHash':digest(json.dumps(source,sort_keys=True,ensure_ascii=False).encode()),
                       'disposition':disposition,'reason':request.get('reason')}}
        index=json.dumps(value,ensure_ascii=False,indent=2)+'\n'
        if len(index.encode())>2_000_000:raise ValueError('rule history is full; archive it before saving')
        tx={'coreTarget':str(core_path().resolve()),'core':{'before':None if state['core'] is None else state['core'].decode(),'after':state['cleaned']},
            'index':{'before':None if state['index'] is None else state['index'].decode(),'after':index}}
        # Keep the original before the first change; never overwrite a previous backup.
        backup=DIRECTORY/f"before-{current['revision']}.json"
        if not backup.exists():atomic(backup,json.dumps(tx,ensure_ascii=False).encode())
        atomic(DIRECTORY/'transaction.json',json.dumps(tx,ensure_ascii=False).encode())
        recover()
        return {'ok':True,'revision':_snapshot(scope)[0]['revision'],'savedIds':[row['id'] for row in added],'disposition':disposition}

def blocks(text):
    # Start a new block at a margin list item or a heading; retain every continuation, whitespace and paragraph.
    return [x for x in re.split(r'(?m)(?=^(?:[-*+] |\d+[.)] |#{2,6} ))',text) if x.strip()]

def migrate(expected):
    path=HOME/'CLAUDE.md'
    if path.is_symlink() or path.stat().st_nlink != 1: raise ValueError('unsafe CLAUDE.md')
    original=path.read_bytes()
    if len(original)>2_000_000 or digest(original)!=expected: raise ValueError('CLAUDE.md changed; inspect the current version')
    safe_directory(DIRECTORY)
    if (DIRECTORY/'index.json').exists(): raise ValueError('rule library already exists; do not replace it')
    core=[]; parts=[]; body=[]; inside=False; contacts=False
    reference=('# Правила власника\nПравила збережено без скорочень у ~/.claude/owner-rules/index.json. '
               'Перед роботою: ~/bin/owner-rules context "тема запиту"; повне правило: ~/bin/owner-rules read ID. '
               'Нові правила власника додавай нижче: вони підхоплюються окремо, чинні правила не губляться.\n')
    referenced=False
    def flush():
        if body: parts.extend(blocks(''.join(body))); body.clear()
    for line in original.decode('utf-8').splitlines(keepends=True):
        if line.startswith('<!-- novsky-'):
            flush(); contacts=True
        if contacts:
            core.append(line)
            if line.startswith('<!-- /novsky-'): contacts=False
            continue
        if line.startswith('# '):
            flush(); inside=line.strip()=='# Правила власника'
            if inside:
                if not referenced: core.append(reference);referenced=True
                continue
        if inside: body.append(line)
        else: core.append(line)
    flush()
    if not parts: raise ValueError('no owner rules to migrate')
    rows={}
    for i,part in enumerate(parts):
        # Collapse only byte-identical meaningful text; original bytes stay in the immutable backup.
        text=part.strip(); key=digest(text.encode())[:16]
        if key in rows and rows[key]['text']!=text: raise ValueError('rule id collision')
        rows.setdefault(key,{'id':key,'text':text,'occurrences':[]})['occurrences'].append(i+1)
    backup=DIRECTORY/f'CLAUDE-{expected}.md'
    with backup.open('xb') as out: out.write(original)
    os.chmod(backup,0o600)
    value={'schemaVersion':1,'sourceSha256':expected,'backup':str(backup.relative_to(HOME)),'rules':list(rows.values())}
    atomic(DIRECTORY/'index.json',(json.dumps(value,ensure_ascii=False,indent=2)+'\n').encode())
    # The deployment holds the live agent idle. A changed source is still refused here.
    if path.read_bytes()!=original: raise ValueError('source changed during migration; library saved, CLAUDE.md untouched')
    atomic(path,''.join(core).encode())
    return {'backup':str(backup.relative_to(HOME)),'sourceSha256':expected,'coreSha256':digest(path.read_bytes()),
            'occurrences':len(parts),'uniqueRules':len(rows),'coreBytes':path.stat().st_size}

def tokens(text):
    return set(re.findall(r'[\w]{3,}',text.lower().replace('ё','е'))) - {'the','and','with','что','как','для','это','его','или','при','все','with'}

def rule_label(row):
    # Dotted owner-facing numbers are distinct from positional integer reads.
    match=re.match(r'^\s*(\d+(?:\.\d+)+)(?=\s|$)',row['text'])
    return match.group(1) if match else None

def read_rule(rows, identifier):
    if identifier.isdecimal() and 0<int(identifier)<=len(rows):
        return rows[int(identifier)-1]
    row=next((x for x in rows if x['id']==identifier),None)
    if row is not None:return row
    matched=[x for x in rows if rule_label(x)==identifier]
    if len(matched)>1:raise ValueError('ambiguous rule label; read the position or stable ID')
    if not matched:raise ValueError('unknown rule id')
    return matched[0]

def context(query):
    rows=load()['rules']; words=tokens(query)
    labels=set(re.findall(r'(?<![\w.])\d+(?:\.\d+)+(?![\w.])',query))
    def score(row):
        found=tokens(row['text'])
        return (1000 if rule_label(row) in labels else 0)+sum(10 if x in found else 1 if not any(c.isdigit() for c in x) and any(len(y)>=5 and len(x)>=5 and (y.startswith(x[:5]) or x.startswith(y[:5])) for y in found) else 0 for x in words)
    ordered=sorted(enumerate(rows),key=lambda p:(-score(p[1]),p[0]))
    out=['OWNER RULES: every rule applies; full text: ~/bin/owner-rules read POSITION, dotted LABEL, or ID.']
    # Numeric positions keep the always-visible index compact. IDs remain stable in storage.
    room=max(12,min(64,(3000-len(out[0]))//max(1,len(rows))-8))
    for i,row in enumerate(rows,1):
        title=' '.join(row['text'].split())
        out.append(f"{i}. {title[:room]}"+('…' if len(title)>room else ''))
    out.append('MATCHED RULE DETAILS (read the full numbered rule when clipped):')
    for i,row in ordered:
        if score(row)==0:continue
        room=CAP-len('\n'.join(out))-40
        if room<100:break
        text=row['text'];excerpt=text[:min(room,1500)]
        out.append(f"{i+1}. {excerpt}"+('…' if excerpt!=text else ''))
    return '\n'.join(out)

def main():
    p=argparse.ArgumentParser(description=__doc__); sub=p.add_subparsers(dest='action',required=True)
    s=sub.add_parser('migrate');s.add_argument('--expected-sha',required=True)
    s=sub.add_parser('context');s.add_argument('query')
    s=sub.add_parser('read');s.add_argument('id')
    s=sub.add_parser('snapshot');s.add_argument('--scope')
    args=p.parse_args()
    if args.action=='migrate':
        with locked():print(json.dumps(migrate(args.expected_sha),ensure_ascii=False))
    elif args.action=='context': print(context(args.query))
    elif args.action=='snapshot': print(json.dumps(snapshot(args.scope),ensure_ascii=False))
    else:
        rows=load()['rules']
        row=read_rule(rows,args.id)
        print(row['text'])

if __name__=='__main__':
    try:main()
    except (ValueError,OSError,KeyError) as exc:
        print(str(exc),file=sys.stderr);sys.exit(1)
