#!/usr/bin/env python3
"""relogin-watch — owner-triggered Claude re-login. Runs from cron every minute,
INDEPENDENT of the Claude brain: even when the agent's login is dead, the
Telegram poller keeps logging incoming messages to messages.db on the bot token,
so we read the owner's `/relogin` command from there and fire a fresh login link.

This is the manual escape hatch for the case the auto-rescue link expired before
the owner got to it — instead of waiting for the next auto-tick (or the agent,
which may be brain-dead), the owner just types /relogin and gets a fresh link now.

Fires `claude-auth-rescue --force` (bypasses the logged-in check and debounce).
Only the configured owner can trigger it. Never logs message text.
"""
import json
import os
import re
import sqlite3
import subprocess
import time
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path(os.environ.get("HOME", "/home/claude"))
AGENT_ROOT = Path(os.environ.get("AGENT_ROOT", str(HOME)))
STATE_DIR = Path(os.environ.get("TELEGRAM_STATE_DIR")
                 or (AGENT_ROOT / ".claude/channels/telegram"))
ENV_FILE = STATE_DIR / ".env"
ACCESS_FILE = STATE_DIR / "access.json"
MESSAGES_DB = STATE_DIR / "messages.db"
STATE_FILE = AGENT_ROOT / "logs/relogin-watch.state"
RESCUE = AGENT_ROOT / "bin/claude-auth-rescue"
TRIGGER = re.compile(r"^\s*/?(relogin|релог[іи]н|перевхід)\s*$", re.IGNORECASE)


def env_val(key: str) -> str:
    try:
        for line in ENV_FILE.read_text(encoding="utf-8").splitlines():
            if line.startswith(key + "="):
                return line.split("=", 1)[1].strip()
    except Exception:
        pass
    return ""


def owner() -> str:
    configured = os.environ.get("OWNER_CHAT_ID", env_val("OWNER_CHAT_ID"))
    if configured:
        return configured
    data = json.loads(ACCESS_FILE.read_text(encoding="utf-8"))
    ids = data.get("admins") or data.get("allowFrom") or []
    return str(ids[0]) if ids else ""


def control_chats(primary: str) -> set[str]:
    allowed = {primary}
    try:
        access = json.loads(ACCESS_FILE.read_text(encoding="utf-8"))
        admins, admitted, superadmins = (access[key] for key in ("admins", "allowFrom", "superadmins"))
        if not all(isinstance(items, list) and all(isinstance(item, str) and re.fullmatch(r"[1-9]\d{0,19}", item)
                                                   for item in items) for items in (admins, admitted, superadmins)):
            return allowed
        allowed.update((set(superadmins) & set(admins) & set(admitted)) - {primary})
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return allowed


def send(chat: str, text: str) -> None:
    token = env_val("TELEGRAM_BOT_TOKEN")
    if not token or not chat:
        return
    body = urllib.parse.urlencode({"chat_id": chat, "text": text}).encode()
    try:
        urllib.request.urlopen(urllib.request.Request(
            f"https://api.telegram.org/bot{token}/sendMessage", data=body), timeout=15)
    except Exception:
        pass


def main() -> int:
    if not MESSAGES_DB.exists() or not RESCUE.exists():
        return 0
    primary = owner()
    if not primary:
        return 0
    try:
        last = int(json.loads(STATE_FILE.read_text(encoding="utf-8"))["ts"])
    except Exception:
        last = int((time.time() - 120) * 1000)  # first run: only look 2 min back

    try:
        conn = sqlite3.connect(f"file:{MESSAGES_DB}?mode=ro", uri=True, timeout=2)
        columns = {row[1] for row in conn.execute("PRAGMA table_info(messages)")}
        chats = control_chats(primary) if "user_id" in columns else {primary}
        placeholders = ",".join("?" for _ in chats)
        rows = conn.execute(
            f"SELECT ts,text,chat_id FROM messages WHERE chat_id IN ({placeholders}) AND direction='in' "
            + ("AND chat_id=user_id " if "user_id" in columns else "")
            + "AND ts>? ORDER BY ts", (*sorted(chats), last)).fetchall()
        conn.close()
    except Exception:
        return 0

    # One OAuth flow may run at a time. Keep every authorized requester visible
    # when several people asked before this cron tick.
    requests: dict[str, int] = {}
    newest = last
    for ts, text, sender_chat in rows:
        newest = max(newest, ts)
        if text and TRIGGER.match(text.strip()):
            requests[sender_chat] = ts

    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps({"ts": newest}))

    authorized = control_chats(owner())
    requests = {chat: ts for chat, ts in requests.items() if chat in authorized}
    if requests:
        chat = max(requests, key=requests.get)
        # exactly ONE live login flow: kill any stale one first (no verifier clobber)
        subprocess.run(["pkill", "-f", "claude auth login"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for stale in (AGENT_ROOT / "logs/auth-rescue.state",):
            try:
                stale.unlink()
            except OSError:
                pass
        subprocess.Popen(
            ["/usr/bin/timeout", "900", str(RESCUE), "--force", "--chat", chat],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True)
        # Network notices can each block for 15 seconds. The rescue must be
        # running before any send, or the 55-second cron deadline can consume
        # checkpointed requests without starting the login flow.
        for superseded in requests:
            if superseded != chat:
                send(superseded, "⚠️ Одночасно надійшов запит на вхід з іншого дозволеного чату. "
                                 "Запускаю одне нове посилання там; повтори /relogin пізніше, якщо потрібне окреме посилання.")
        send(chat, "🔄 Запускаю повторний вхід — за кілька секунд надішлю свіже посилання.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
