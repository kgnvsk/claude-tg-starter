#!/usr/bin/env python3
"""Securely configure voice transcription without exposing the key in process args."""

from __future__ import annotations

import getpass
import json
import os
from pathlib import Path
import shlex
import sys
import tempfile

HOME = Path.home()
ENV = HOME / ".claude/channels/telegram/.env"
STATE = HOME / ".claude/onboarding-state.json"

args = sys.argv[1:]
if args == ["--stdin"]:
    key = sys.stdin.readline().strip()
elif not args:
    key = getpass.getpass("OpenAI API key (hidden): ").strip()
else:
    print("usage: set-openai-key [--stdin]", file=sys.stderr)
    raise SystemExit(2)

if not key.startswith("sk-") or len(key) < 23:
    print("invalid OpenAI API key format", file=sys.stderr)
    raise SystemExit(2)

ENV.parent.mkdir(parents=True, exist_ok=True)
lines = ENV.read_text(encoding="utf-8").splitlines() if ENV.exists() else []
replacement = "OPENAI_API_KEY=" + shlex.quote(key)
updated = []
found = False
for line in lines:
    if line.startswith("OPENAI_API_KEY="):
        updated.append(replacement)
        found = True
    else:
        updated.append(line)
if not found:
    updated.append(replacement)

fd, temporary = tempfile.mkstemp(prefix="telegram-env-", dir=ENV.parent)
with os.fdopen(fd, "w", encoding="utf-8") as handle:
    handle.write("\n".join(updated) + "\n")
os.chmod(temporary, 0o600)
os.replace(temporary, ENV)

if STATE.exists():
    state = json.loads(STATE.read_text(encoding="utf-8"))
    voice = state.setdefault("optionalFeatures", {}).setdefault("voice_transcription", {})
    voice.update({
        "status": "configured",
        "model": "gpt-4o-mini-transcribe",
        "remindAfterDays": 7,
    })
    voice["lastReminderAt"] = None
    state_tmp = STATE.with_suffix(".json.tmp")
    state_tmp.write_text(json.dumps(state, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    state_tmp.chmod(0o600)
    state_tmp.replace(STATE)

print(
    "Voice transcription configured. Restart "
    + os.environ.get("CLAUDE_TELEGRAM_SERVICE", "claude-telegram.service")
    + " to apply it."
)
