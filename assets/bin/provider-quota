#!/usr/bin/env python3
"""Read native account quota without starting a model, refreshing or changing login.

Only a positive provider response is permission to reconsider an old limit.
Credentials stay in memory; redirects, malformed data and unavailable reads
return unknown. This helper does not change queues or claim a delivered answer.
"""
import json
import math
import os
from pathlib import Path
import stat
import sys
import urllib.request
import urllib.error

MAX_BYTES = 128 * 1024

class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(req.full_url if req else '', code, 'redirect refused', {}, None)

def read_private(path):
    before = path.lstat()
    if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1 or before.st_size > MAX_BYTES:
        raise ValueError('unavailable')
    fd = os.open(path, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0) | getattr(os, 'O_NONBLOCK', 0))
    try:
        opened = os.fstat(fd)
        if (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino) or not stat.S_ISREG(opened.st_mode):
            raise ValueError('unavailable')
        if hasattr(os, 'geteuid') and opened.st_uid != os.geteuid():
            raise ValueError('unavailable')
        data = os.read(fd, MAX_BYTES + 1)
        after = path.lstat()
        if len(data) > MAX_BYTES or (after.st_dev, after.st_ino, after.st_mtime_ns, after.st_size) != (opened.st_dev, opened.st_ino, opened.st_mtime_ns, opened.st_size):
            raise ValueError('unavailable')
        return data
    finally:
        os.close(fd)

def fetch(url, headers):
    try:
        request = urllib.request.Request(url, headers={**headers, 'User-Agent': 'Novsky-quota/1', 'Cache-Control': 'no-cache'})
        with urllib.request.build_opener(NoRedirect()).open(request, timeout=5) as reply:
            if reply.status != 200 or reply.url != url:
                return None
            data = reply.read(MAX_BYTES + 1)
            if len(data) > MAX_BYTES: return None
            result = json.loads(data)
            return result if type(result) is dict else None
    except (OSError, ValueError, urllib.error.URLError):
        return None

def percent(value):
    return type(value) in (int, float) and math.isfinite(value) and 0 <= value <= 100

def claude_available(body):
    if type(body) is not dict or not all(type(body.get(k)) is dict for k in ('five_hour', 'seven_day')):
        return None
    # The live endpoint also returns dashboard metadata, not quota windows.
    # Explicit limits are quota evidence too; malformed/new windows stay unknown.
    metadata = {'extra_usage', 'limits', 'spend', 'member_dashboard_available', 'seven_day_breakdown'}
    windows = [value for key, value in body.items() if key not in metadata and value is not None]
    if not windows or any(type(window) is not dict or not percent(window.get('utilization')) for window in windows):
        return None
    limits = body.get('limits', [])
    if type(limits) is not list or any(type(item) is not dict or not percent(item.get('percent')) or type(item.get('is_active')) is not bool for item in limits):
        return None
    if all(window['utilization'] < 100 for window in windows) and all(item['percent'] < 100 for item in limits): return True
    extra = body.get('extra_usage')
    if type(extra) is dict and extra.get('is_enabled') is True:
        limit, used = extra.get('monthly_limit'), extra.get('used_credits')
        if type(limit) in (int, float) and type(used) in (int, float) and math.isfinite(limit) and math.isfinite(used) and 0 <= used < limit:
            return True
    return False

def codex_available(body):
    if type(body) is not dict: return None
    additional = body.get('additional_rate_limits', [])
    if type(additional) is not list: return None
    buckets = [body.get('rate_limit')] + [item.get('rate_limit') if type(item) is dict else None for item in additional]
    if any(type(bucket) is not dict or type(bucket.get('allowed')) is not bool or type(bucket.get('limit_reached')) is not bool for bucket in buckets):
        return None
    return all(bucket['allowed'] and not bucket['limit_reached'] for bucket in buckets)

def available(engine, home):
    try:
        root = Path(home)
        directory = Path(os.environ.get('CLAUDE_CONFIG_DIR') or root / '.claude') if engine == 'claude' else Path(os.environ.get('CODEX_HOME') or root / '.codex')
        if not directory.is_absolute() or not stat.S_ISDIR(directory.lstat().st_mode): return None
        path = directory / ('.credentials.json' if engine == 'claude' else 'auth.json')
        before = read_private(path)
        data = json.loads(before)
        if engine == 'claude':
            token = data.get('claudeAiOauth', {}).get('accessToken')
            url, headers = 'https://api.anthropic.com/api/oauth/usage', {'anthropic-beta': 'oauth-2025-04-20'}
        elif engine == 'codex':
            tokens = data.get('tokens') or {}
            token, account = tokens.get('access_token'), tokens.get('account_id')
            if not isinstance(account, str) or not account or '\n' in account or '\r' in account: return None
            url, headers = 'https://chatgpt.com/backend-api/wham/usage', {'ChatGPT-Account-Id': account}
        else: return None
        if not isinstance(token, str) or not token or '\n' in token or '\r' in token: return None
        body = fetch(url, {**headers, 'Authorization': 'Bearer ' + token})
        if read_private(path) != before: return None
        return (claude_available if engine == 'claude' else codex_available)(body)
    except (OSError, ValueError, TypeError, AttributeError):
        return None

if __name__ == '__main__':
    if len(sys.argv) != 3 or sys.argv[1] not in ('claude', 'codex'): raise SystemExit(2)
    print(json.dumps({'available': available(sys.argv[1], Path(sys.argv[2]))}, separators=(',', ':')))
