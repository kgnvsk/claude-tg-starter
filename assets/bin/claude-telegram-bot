#!/bin/bash
set -eu
# One bot per home: the kit's services never set AGENT_ROOT. Any other value
# would hand this launch another bot's --resume session and helpers.
if [ -n "${AGENT_ROOT:-}" ] && [ "${AGENT_ROOT%/}" != "${HOME%/}" ]; then
  echo "telegram launcher: FATAL: AGENT_ROOT=$AGENT_ROOT is not this bot's home $HOME; not starting" >&2
  exit 1
fi
# A bot started from another agent's shell inherits that agent's Claude config
# and Telegram state, loads its token and kills its poller (Lera, 26.09). Keep
# a caller's path only inside this agent's own ~/.claude — a neighbour's home
# can sit inside this one — and without a .. segment; "root" also allows
# ~/.claude itself.
own_claude_path() {
  local path="${1%/}"
  case "/$path/" in */../*) return 1 ;; esac
  case "$path" in
    "${HOME%/}/.claude") [ "${2:-}" = root ] ;;
    "${HOME%/}/.claude/"?*) return 0 ;;
    *) return 1 ;;
  esac
}
ignore_caller_path() {
  echo "telegram launcher: ignored $1=$2 from the caller; using $3" >&2
}
# Unset rather than pointed at ~/.claude: an explicit CLAUDE_CONFIG_DIR would
# move the CLI's own ~/.claude.json and log the bot out.
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
  if own_claude_path "$CLAUDE_CONFIG_DIR" root; then
    export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR%/}"
  else
    ignore_caller_path CLAUDE_CONFIG_DIR "$CLAUDE_CONFIG_DIR" "$HOME/.claude"
    unset CLAUDE_CONFIG_DIR
  fi
fi
CLAUDE_CONFIG_ROOT="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
STATE_DIR="$CLAUDE_CONFIG_ROOT/channels/telegram"
if [ -n "${TELEGRAM_STATE_DIR:-}" ]; then
  if own_claude_path "$TELEGRAM_STATE_DIR"; then
    STATE_DIR="$TELEGRAM_STATE_DIR"
  else
    ignore_caller_path TELEGRAM_STATE_DIR "$TELEGRAM_STATE_DIR" "$STATE_DIR"
  fi
fi
export TELEGRAM_STATE_DIR="$STATE_DIR"
if [ -f "$TELEGRAM_STATE_DIR/.env" ]; then
  set -a
  . "$TELEGRAM_STATE_DIR/.env"
  set +a
fi
export BUN_INSTALL="$HOME/.bun"
export PATH="$HOME/.local/bin:$BUN_INSTALL/bin:$HOME/bin:/usr/local/bin:/usr/bin:/bin"
# Native Claude clamps this window to the model's supported context. With a 1M
# model and the output reserve, 850K at 90% compacts around 747K. Keep ordinary
# conversation history; native background workers own lengthy intermediate work.
# A Pro plan counts every step's whole history against its 5-hour limit, so it
# compacts around 450K (owner, 03.10.2026: Арти read 283M-447M tokens a day at
# ~747K and ran out within hours). Explicit operator overrides remain authoritative.
if [ -z "${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-}" ] \
  && grep -q '"subscriptionType" *: *"pro"' "$CLAUDE_CONFIG_ROOT/.credentials.json" 2>/dev/null; then
  CLAUDE_CODE_AUTO_COMPACT_WINDOW=500000
fi
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="${CLAUDE_CODE_AUTO_COMPACT_WINDOW:-850000}"
export CLAUDE_AUTOCOMPACT_PCT_OVERRIDE="${CLAUDE_AUTOCOMPACT_PCT_OVERRIDE:-90}"

# Preflight: погасить ВСЕ интерактивные промпты первого старта claude, чтобы `claude --channels`
# поднимал Telegram-поллер, а не блокировался в ожидании ввода. `claude auth login` ставит auth,
# но НЕ эти флаги; без них свежий бокс упирается в:
#   1) онбординг (выбор темы «Choose the text style») — hasCompletedOnboarding/theme
#   2) «trust this folder?» — projects[cwd].hasTrustDialogAccepted
#   3) внешний импорт управляемого CLAUDE.premium.md — projects[cwd].hasClaudeMdExternalIncludes*
#      (также для отдельного cwd фоновых RUN=1 задач)
#   4) upsell-промпты («Try the new fullscreen renderer? 1.Yes/2.Not now», remote control, passes)
#      — claude капит их показ на 3; ставим *UpsellSeenCount=3 = «уже видел, не показывай».
#   5) предложение сделать auto mode режимом по умолчанию — новый экран свежего CLI.
#      Для бота без человека за терминалом auto mode опасен: классификатор рисков
#      заблокирует действие, а подтвердить его некому — бот встанет навсегда.
# Идемпотентно, self-healing на каждый старт. No-op пока не залогинен.
# With an isolated CLAUDE_CONFIG_DIR the CLI reads .config.json first when it
# exists, then .claude.json. The reminder worker uses the same selection.
CLAUDE_STATE_ROOT="${CLAUDE_CONFIG_DIR:-$HOME}"
CJ="$CLAUDE_STATE_ROOT/.claude.json"
if [ -n "${CLAUDE_CONFIG_DIR:-}" ] && [ -f "$CLAUDE_STATE_ROOT/.config.json" ]; then
  CJ="$CLAUDE_STATE_ROOT/.config.json"
fi
if [ -f "$CJ" ]; then
  python3 - "$CJ" "$HOME" "${AGENT_TASK_DIR:-}" <<'PY' 2>/dev/null || true
import json, os, pathlib, stat, sys, tempfile

p = pathlib.Path(sys.argv[1])
home = sys.argv[2]
task_override = sys.argv[3]
trust = [home, os.path.join(home, "obsidian-vault"),
         os.path.join(home, ".atarax", "agent-task")]
if task_override and os.path.isabs(task_override):
    trust.append(task_override)
trust = list(dict.fromkeys(os.path.realpath(path) for path in trust))
if p.is_symlink():
    sys.exit(0)
try:
    with p.open(encoding="utf-8") as source:
        d = json.load(source)
    original_mode = stat.S_IMODE(p.stat().st_mode)
except (OSError, UnicodeError, ValueError):
    sys.exit(0)
if not isinstance(d, dict):
    sys.exit(0)
ch = False
if d.get("hasCompletedOnboarding") is not True:
    d["hasCompletedOnboarding"] = True; ch = True
if not d.get("theme"):
    d["theme"] = "dark"; ch = True
# upsell-промпты блокируют поллер на свежем боксе; claude капит показ на 3 → ставим 3 ("видел")
for uk in ("fullscreenUpsellSeenCount", "remoteControlUpsellSeenCount", "passesUpsellSeenCount"):
    if not isinstance(d.get(uk), int) or d[uk] < 3:
        d[uk] = 3; ch = True
# «Make auto mode your default permission mode?» — тот же класс: висит ДО старта поллера
for offer in ("hasSeenAutoDefaultNudge", "hasResetAutoModeOptInForDefaultOffer"):
    if d.get(offer) is not True:
        d[offer] = True; ch = True
proj = d.get("projects")
if proj is None:
    proj = {}
elif not isinstance(proj, dict):
    sys.exit(0)
for k in trust:
    e = proj.get(k)
    if e is None:
        e = {}
    elif not isinstance(e, dict):
        sys.exit(0)
    if e.get("hasTrustDialogAccepted") is not True:
        e["hasTrustDialogAccepted"] = True; ch = True
    if e.get("hasCompletedProjectOnboarding") is not True:
        e["hasCompletedProjectOnboarding"] = True; ch = True
    if e.get("hasClaudeMdExternalIncludesApproved") is not True:
        e["hasClaudeMdExternalIncludesApproved"] = True; ch = True
    if e.get("hasClaudeMdExternalIncludesWarningShown") is not True:
        e["hasClaudeMdExternalIncludesWarningShown"] = True; ch = True
    proj[k] = e
if ch:
    d["projects"] = proj
    fd = None
    temp = None
    try:
        fd, temp = tempfile.mkstemp(prefix=p.name + ".", dir=p.parent)
        with os.fdopen(fd, "w", encoding="utf-8") as out:
            fd = None
            os.fchmod(out.fileno(), original_mode)
            json.dump(d, out, indent=2)
            out.write("\n")
            out.flush()
            os.fsync(out.fileno())
        os.replace(temp, p)
    except OSError:
        pass
    finally:
        if fd is not None:
            os.close(fd)
        if temp is not None:
            try:
                os.unlink(temp)
            except FileNotFoundError:
                pass
PY
fi

# Ответ на тот же промпт переключает режим разрешений на auto прямо в settings.json.
# Для бота это тупик: классификатор остановит действие, а подтвердить некому. Возвращаем
# режим, который комплект объявляет своим, — молча, при каждом старте.
SETTINGS="$CLAUDE_CONFIG_ROOT/settings.json"
# Під root CLI відмовляється від bypassPermissions зовсім, тож повертати його
# там означає не дати боту стартувати. Такій установці потрібен не цей режим, а
# список дозволів — сторож її не чіпає.
if [ -f "$SETTINGS" ] && [ "$(id -u)" -ne 0 ]; then
  python3 - "$SETTINGS" <<'PYMODE' 2>/dev/null || true
import json, sys

path = sys.argv[1]
try:
    settings = json.load(open(path))
except Exception:
    sys.exit(0)
permissions = settings.get("permissions")
if not isinstance(permissions, dict) or permissions.get("defaultMode") == "bypassPermissions":
    sys.exit(0)
permissions["defaultMode"] = "bypassPermissions"
json.dump(settings, open(path, "w"), indent=2)
PYMODE
fi

# A noninteractive auth probe can cache the local Telegram MCP as
# "needs-auth". The next interactive --channels launch then trusts that cache
# and skips the poller even though both Claude and the bot token are valid.
# Forget only this local channel verdict; unrelated integration cache survives.
AUTH_CACHE="$CLAUDE_CONFIG_ROOT/mcp-needs-auth-cache.json"
if [ -f "$AUTH_CACHE" ]; then
  python3 - "$AUTH_CACHE" <<'PYCACHE' 2>/dev/null || true
import json, os, pathlib, sys, tempfile

path = pathlib.Path(sys.argv[1])
try:
    cache = json.loads(path.read_text(encoding="utf-8"))
except (OSError, UnicodeError, json.JSONDecodeError):
    sys.exit(0)
if not isinstance(cache, dict):
    sys.exit(0)
if cache.pop("plugin:telegram:telegram", None) is None:
    sys.exit(0)

try:
    fd, raw_tmp = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
except OSError:
    sys.exit(0)
tmp = pathlib.Path(raw_tmp)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        os.fchmod(handle.fileno(), 0o600)
        json.dump(cache, handle, separators=(",", ":"))
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(tmp, path)
except OSError:
    pass
finally:
    try:
        tmp.unlink()
    except FileNotFoundError:
        pass
PYCACHE
fi

cd ~/obsidian-vault
# No forced --effort: the model picks its own depth per turn (owner decision
# 2026-09-01 — a pinned "low" made every agent shallow). AGENT_EFFORT in the
# channel .env still overrides when someone really wants a fixed level.
# The permission mode is passed on the command line, not left to
# settings.json: CLI 2.1.260 stopped applying the file's defaultMode to a
# --channels launch, so every Bash call started asking the owner for
# approval in Telegram (Paradox, 04.09). Under root the CLI refuses
# bypassPermissions outright — that install runs on its allow list, exactly
# as the settings block above already decided.
# Штамп служби (KTD3): випадкове значення на кожен старт, лише в оточенні
# процесу CLI — його бачать хуки й інструменти моделі, а крон і сторонні
# claude -p ні. У .env каналу і в файли воно не пишеться: той файл читає два
# десятки скриптів, і статичне значення відтворив би будь-який з них.
export TG_DELIVERY_STAMP="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
# Resume only the exact Telegram-bound session validated against its transcript.
# A missing old helper/database is a fresh installation, never --continue's
# arbitrary most recent interactive/cron session.
RESUME_SESSION=""
RESUME_HELPER="${AGENT_ROOT:-$HOME}/bin/tg-resume-session"
if [ -x "$RESUME_HELPER" ]; then
  RESUME_SESSION=$("$RESUME_HELPER") || RESUME_SESSION=""
else
  echo "telegram launcher: session selector unavailable; starting fresh" >&2
fi
# The owner's model from settings.json goes on the command line: --resume
# keeps the model the session started with and ignores the file, so the fleet
# switch to Opus 5.5 left resumed bots on Opus 5 (Лилу, 22.09.2026). A missing
# or malformed value adds nothing and the CLI keeps its own default.
AGENT_MODEL=$(python3 -c '
import json, re, sys
try:
    model = json.load(open(sys.argv[1], encoding="utf-8")).get("model")
except Exception:
    model = None
if isinstance(model, str) and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:\-\[\]]{0,79}", model):
    print(model)
' "$SETTINGS" 2>/dev/null) || AGENT_MODEL=""
PERMISSION_MODE=""
if [ "$(id -u)" -ne 0 ]; then
  PERMISSION_MODE="--permission-mode bypassPermissions"
fi
exec $HOME/.local/bin/claude $PERMISSION_MODE ${AGENT_EFFORT:+--effort "$AGENT_EFFORT"} ${AGENT_MODEL:+--model "$AGENT_MODEL"} ${RESUME_SESSION:+--resume "$RESUME_SESSION"} --channels plugin:telegram@claude-plugins-official
