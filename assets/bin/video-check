#!/usr/bin/env python3
"""Check a finished video the way an editor watches it, and show the agent what it has to look at.

Owner, 04.11.2026: the montage misses what a specialist's eye would catch (a face leaving the frame, a cut edge, small
text). Arthur's 44-minute video of 02.11 was checked on 272 frames, the general plan once every 20 s, the face once every
5 s, and every frame was seen at about 95×53 points. This tool reads the whole file:

- every cut and every flash or jerk shorter than a third of a second (all frames, not a sample);
- black frames, frozen picture, loudness, peaks and silences;
- the face of the main shot on every analysed frame (15 per second for short videos, 10 for long): cut by the frame
  edge, lost in the middle of a shot, off-centre in a vertical video. A face in a picture-in-picture inset is not
  checked: the person moves there and the inset is not cut again (owner, 04.11.2026);
- subtitles and plates from the .ass file, each line at its own time: text that is small or closer to the edge than the
  safe zone, and a style that differs from the given sample;

and it lays out every finding (just before, at, just after) and every scene on sheets of a few frames at a size the
model reads whole. It reports; it never blocks anything. Whatever it could not read or check is named at the top of the
report as an incomplete check, and the result folder is replaced only by a finished new one (Codex review, 04.11.2026).
`video-check faces` gives the dense face track for framing.
"""
from __future__ import annotations

import argparse
import glob
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import threading

try:
    import cv2
    import numpy as np
except ImportError:  # OpenCV lives in the agent's video environment; use it when this interpreter has none.
    cv2 = np = None
    if not os.environ.get("VIDEO_CHECK_REEXEC"):
        for candidate in (os.environ.get("VIDEO_CHECK_PYTHON"), "~/.venvs/video/bin/python", "~/.venvs/montazh/bin/python"):
            path = Path(os.path.expanduser(candidate)) if candidate else None
            if path and path.is_file() and os.access(path, os.X_OK):
                os.environ["VIDEO_CHECK_REEXEC"] = "1"
                os.execv(str(path), [str(path), __file__, *sys.argv[1:]])

SHORT_SHOT = 0.3          # a piece shorter than this between two cuts reads as a flash or a jerk
EDGE = 0.005              # a face box touching the frame edge is cut by it
MAIN = 0.22               # a face at least this wide (share of the frame's shorter side) is the main shot, not an inset
BLIP = 0.2                # a face finding shorter than this is the detector, not the picture
LOST = 0.4                # a face missing this long in the middle of a face shot left the frame
CENTRE = (0.3, 0.7)       # where the face centre stays in a vertical video
MERGE = 0.5               # findings of one kind closer than this are one finding
SHEET_PIXELS = 1_150_000  # a sheet the model reads without shrinking it
MARK = ".video-check"     # names a result folder as this tool's own
OWN = re.compile(r"\.video-check|report\.(?:md|json)|(?:findings|scenes)-\d+\.jpg")
LEVEL = re.compile(r"(?:\[[^\]]+\] )?\[(info|verbose|warning|error|fatal|panic)\] (.*)")


class CheckError(RuntimeError):
    pass


def run(argv: list[str], timeout: float = 600, text: bool = True, **kwargs) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(argv, capture_output=True, text=text, timeout=timeout, **kwargs)
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(argv, 124, "" if text else b"", f"не уложилось в {timeout:.0f} с")


def complaint(result: subprocess.CompletedProcess) -> str:
    """What ffmpeg said was wrong: whole lines, each once; only its error lines when its output carries levels."""
    lines = [line.strip() for line in (result.stderr or "").splitlines() if line.strip()]
    tagged = [LEVEL.match(line) for line in lines]
    if any(tagged):
        lines = [m.group(2) for m in tagged if m and m.group(1) in ("error", "fatal", "panic")]
    said = "; ".join(dict.fromkeys(lines))
    return f"код {result.returncode}" + (f": {said}" if said else "")


def budget(duration: float) -> float:
    """How long one ffmpeg pass over the whole file may take: a generous multiple of its length."""
    return max(300.0, duration * 6)


def clock(seconds: float) -> str:
    minutes, rest = divmod(max(0.0, seconds), 60)
    return f"{int(minutes):02d}:{rest:04.1f}"


# ---------------------------------------------------------------- the file

def probe(video: Path) -> dict:
    result = run(["ffprobe", "-v", "error", "-print_format", "json", "-show_streams", "-show_format", str(video)])
    if result.returncode:
        raise CheckError("ffprobe не прочитал файл: " + complaint(result))
    data = json.loads(result.stdout or "{}")
    streams = data.get("streams", [])
    picture = next((s for s in streams if s.get("codec_type") == "video"), None)
    if not picture:
        raise CheckError("в файле нет видеодорожки")
    num, _, den = str(picture.get("avg_frame_rate") or picture.get("r_frame_rate") or "30/1").partition("/")
    fps = float(num) / float(den or 1) if float(den or 1) else 30.0
    duration = float(data.get("format", {}).get("duration") or picture.get("duration") or 0)
    if duration <= 0:
        raise CheckError("длительность файла не читается")
    return {"width": int(picture["width"]), "height": int(picture["height"]), "fps": round(fps, 3),
            "duration": duration, "audio": any(s.get("codec_type") == "audio" for s in streams)}


def scan(video: Path, duration: float) -> dict:
    """Cuts, black and frozen stretches, read on every frame in one pass."""
    result = run(["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "level+info", "-i", str(video), "-an", "-vf",
                  "blackdetect=d=0.08:pix_th=0.10,freezedetect=n=-60dB:d=0.6,select='gt(scene,0.3)',showinfo",
                  "-f", "null", "-"], timeout=budget(duration))
    if result.returncode:
        raise CheckError("ffmpeg не прочитал картинку: " + complaint(result))
    text = result.stderr
    cuts = sorted({round(float(t), 3) for t in re.findall(r"Parsed_showinfo.*?pts_time:([0-9.]+)", text)})
    blacks = [(float(a), float(b)) for a, b in re.findall(r"black_start:([0-9.]+)\s+black_end:([0-9.]+)", text)]
    starts = [float(t) for t in re.findall(r"freeze_start: ([0-9.]+)", text)]
    ends = [float(t) for t in re.findall(r"freeze_end: ([0-9.]+)", text)]
    freezes = [(a, ends[i] if i < len(ends) else None) for i, a in enumerate(starts)]
    return {"cuts": cuts, "blacks": blacks, "freezes": freezes}


def sound(video: Path, duration: float) -> dict:
    result = run(["ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "level+info", "-i", str(video), "-vn", "-af",
                  "ebur128=peak=true,silencedetect=noise=-45dB:d=1.5", "-f", "null", "-"], timeout=budget(duration))
    if result.returncode:
        return {"error": "звук не прочитан: " + complaint(result)}
    text = result.stderr
    summary = text[text.rfind("Summary:"):] if "Summary:" in text else ""
    loud = re.search(r"I:\s+(-?[0-9.]+) LUFS", summary)
    peak = re.search(r"Peak:\s+(-?[0-9.]+|-inf) dBFS", summary)
    starts = [float(t) for t in re.findall(r"silence_start: (-?[0-9.]+)", text)]
    ends = [float(t) for t in re.findall(r"silence_end: ([0-9.]+)", text)]
    return {"loudness": float(loud.group(1)) if loud else None,
            "peak": float(peak.group(1)) if peak and peak.group(1) != "-inf" else None,
            "silences": [(a, ends[i] if i < len(ends) else None) for i, a in enumerate(starts)]}


# ---------------------------------------------------------------- findings

def finding(kind: str, start: float, end: float | None, what: str) -> dict:
    return {"kind": kind, "start": round(start, 2), "end": round(end if end is not None else start, 2), "what": what}


def merged(items: list[tuple[float, float]], gap: float = MERGE) -> list[tuple[float, float]]:
    out: list[list[float]] = []
    for a, b in sorted(items):
        if out and a - out[-1][1] <= gap: out[-1][1] = max(out[-1][1], b)
        else: out.append([a, b])
    return [(a, b) for a, b in out]


def shots(cuts: list[float], duration: float) -> list[tuple[float, float]]:
    edges = [0.0, *[c for c in cuts if 0 < c < duration], duration]
    return [(edges[i], edges[i + 1]) for i in range(len(edges) - 1) if edges[i + 1] > edges[i]]


def short_shots(cuts: list[float], duration: float) -> list[dict]:
    return [finding("short_shot", a, b, f"кусок длиной {b - a:.2f} с между двумя склейками: вспышка или рывок")
            for a, b in shots(cuts, duration) if b - a < SHORT_SHOT and 0 < a and b < duration]


def picture_findings(scanned: dict, duration: float) -> list[dict]:
    out = [finding("black", a, b, f"чёрный кадр {b - a:.2f} с") for a, b in scanned["blacks"]]
    for a, b in scanned["freezes"]:
        end = b if b is not None else duration
        out.append(finding("freeze", a, end, f"картинка стоит {end - a:.1f} с: так задумано (заставка, слайд) или зависло?"))
    return out


def sound_findings(heard: dict, duration: float) -> list[dict]:
    out = []
    if heard["loudness"] is not None and not -17.0 <= heard["loudness"] <= -11.0:
        out.append(finding("loudness", 0, duration, f"общая громкость {heard['loudness']:.1f} LUFS, для соцсетей около −14"))
    if heard["peak"] is not None and heard["peak"] > -1.0:
        out.append(finding("peak", 0, duration, f"пики до {heard['peak']:.1f} dBFS: возможен хрип"))
    for a, b in heard["silences"]:
        end = b if b is not None else duration
        if a > 1.0 and end < duration - 1.0:
            out.append(finding("silence", a, end, f"тишина {end - a:.1f} с посреди ролика"))
    return out


def face_findings(track: list[tuple[float, tuple | None]], cut_shots: list[tuple[float, float]],
                  width: int, height: int, step: float) -> list[dict]:
    """track: (time, (x, y, w, h) of the biggest face or None) in the video's own pixels. Only the main shot's face
    counts: a smaller one is a picture-in-picture inset or a far plan, and a shot without a main face is not checked."""
    edge_runs, lost_runs, off_runs = [], [], []
    vertical = height > width
    track = [(t, box if box is not None and box[2] >= MAIN * min(width, height) else None) for t, box in track]
    for a, b in cut_shots:
        inside = [(t, box) for t, box in track if a <= t < b]
        if len(inside) < 3 or sum(box is not None for _, box in inside) < 0.4 * len(inside):
            continue  # not a shot with a face in it
        seen = False; missing_from = None
        for t, box in inside:
            if box is None:
                if seen and missing_from is None: missing_from = t
                continue
            if missing_from is not None and t - missing_from >= LOST: lost_runs.append((missing_from, t))
            missing_from = None; seen = True
            x, y, w, h = box
            if x <= EDGE * width or y <= EDGE * height or x + w >= (1 - EDGE) * width or y + h >= (1 - EDGE) * height:
                edge_runs.append((t, t + step))
            centre = (x + w / 2) / width
            if vertical and not CENTRE[0] <= centre <= CENTRE[1]:
                off_runs.append((t, t + step))
        if missing_from is not None and b - missing_from >= LOST and seen:
            lost_runs.append((missing_from, b))
    out = [finding("face_edge", a, b, "лицо в основном кадре упирается в край или обрезано им") for a, b in merged(edge_runs) if b - a >= BLIP]
    out += [finding("face_lost", a, b, "лицо ушло из кадра посреди сцены") for a, b in merged(lost_runs)]
    out += [finding("face_off_centre", a, b, "лицо не по центру вертикального кадра") for a, b in merged(off_runs) if b - a >= BLIP]
    return out


def ass_time(value: str) -> float:
    hours, minutes, seconds = value.strip().split(":")
    return int(hours) * 3600 + int(minutes) * 60 + float(seconds)


def num(value) -> float:
    try: return float(value or 0)
    except ValueError: return 0.0


def read_ass(path: Path) -> dict:
    """Styles by name and every Dialogue with its own times, style, margins and text (Codex review: findings at the
    plate's own time, from the styles it really uses, with the margins and placement each line really has)."""
    text = path.read_text(encoding="utf-8-sig", errors="replace")
    play = {k: int(v) for k, v in re.findall(r"^PlayRes([XY]):\s*(\d+)", text, re.M)}
    x, y = play.get("X", 0), play.get("Y", 0)
    if not x and not y: x, y = 384, 288  # the canvas renderers assume when the file names none
    elif not y: y = 1024 if x == 1280 else x * 3 // 4
    elif not x: x = 1280 if y == 1024 else y * 4 // 3
    style_fields, event_fields, styles, events = [], [], {}, []
    section = None
    for line in text.splitlines():
        if line.startswith("["): section = line.strip().lower(); continue
        if section in ("[v4+ styles]", "[v4 styles]"):
            if line.startswith("Format:"): style_fields = [f.strip().lower() for f in line[7:].split(",")]
            elif line.startswith("Style:") and style_fields:
                values = [v.strip() for v in line[6:].split(",", len(style_fields) - 1)]
                style = dict(zip(style_fields, values)); styles[style.get("name", "")] = style
        elif section == "[events]":
            if line.startswith("Format:"): event_fields = [f.strip().lower() for f in line[7:].split(",")]
            elif line.startswith("Dialogue:") and event_fields:
                values = line[9:].split(",", len(event_fields) - 1)
                event = {k: (v if k == "text" else v.strip()) for k, v in zip(event_fields, values)}
                try: event["start_s"], event["end_s"] = ass_time(event["start"]), ass_time(event["end"])
                except (KeyError, ValueError): continue
                events.append(event)
    return {"x": x, "y": y, "styles": styles, "events": events}


TAG = re.compile(r"\\(fn|fscy|fsc(?![a-z])|fs(?![a-z])|r|p(?=\d))([^\\}]*)")  # not \fscx, \fsp, \pos


def pieces(text: str, style: dict, styles: dict) -> set[tuple[str, float]]:
    """The font and height of every visible piece of a line: override blocks applied in order, resets included."""
    def base(of: dict) -> tuple[str, float, float]:
        return of.get("fontname", "?"), num(of.get("fontsize")), num(of.get("scaley")) or 100.0
    line = style
    font, size, scale = base(line); drawing = False; out = set()
    for block, words in re.findall(r"\{([^}]*)\}|([^{]+)", text):
        if words:
            if not drawing and re.sub(r"\\[Nnh]", "", words).strip(): out.add((font, size * scale / 100))
            continue
        for tag, value in TAG.findall(block):
            value = value.strip()
            if tag == "r": font, size, scale = base(styles.get(value, line) if value else line)
            elif tag == "fn": font = value or base(line)[0]
            elif tag == "fs":  # as libass: a signed value is relative (\fs-2 on 100 is 80), zero or less is the style's
                size = size * (1 + num(value) / 10) if value[:1] in "+-" and value else num(value)
                size = size if size > 0 else base(line)[1]
            elif tag == "fscy": scale = num(value) if value else base(line)[2]
            elif tag == "fsc": scale = base(line)[2]
            elif tag == "p": drawing = num(value) > 0
    return out


def text_findings(ass: dict, sample: dict | None, duration: float) -> list[dict]:
    """Every Dialogue line at its own time, with the size, font, placement and margins it really gets."""
    wide, tall = ass["x"], ass["y"]
    small, top, bottom, side = 0.03 * tall, tall / 8, tall * 7 / 8, wide / 20
    runs: dict[tuple[str, str], list[tuple[float, float]]] = {}
    for event in ass["events"]:
        if event["start_s"] >= duration: continue
        name = event.get("style", "?").lstrip("*")
        style, text = ass["styles"].get(name, {}), event.get("text", "")
        span = (event["start_s"], min(event["end_s"], duration))
        def note(kind: str, what: str) -> None: runs.setdefault((kind, f"«{name}»: {what}"), []).append(span)
        for font, size in sorted(pieces(text, style, ass["styles"])):
            if size and size < small:
                note("text_small", f"шрифт {size:g} при высоте кадра {tall}, мелко (меньше {small:.0f})")
            if sample and sample.get("fonts") and not any(f.lower() in font.lower() for f in sample["fonts"]):
                note("style", f"шрифт {font}, а в образце {', '.join(sample['fonts'])}")
            if sample and size and not sample.get("minSize", 0) <= size <= sample.get("maxSize", 10 ** 6):
                note("style", f"размер {size:g}, в образце {sample.get('minSize')}–{sample.get('maxSize')}")
        position = re.search(r"\\pos\(\s*([-0-9.]+)\s*,\s*([-0-9.]+)\s*\)", text)
        if position:
            x, y = float(position.group(1)), float(position.group(2))
            if not (top <= y <= bottom and side <= x <= wide - side):
                note("text_margin", f"текст поставлен в точку {x:g}, {y:g}, вне безопасной зоны "
                                    f"({side:.0f}–{wide - side:.0f} по ширине, {top:.0f}–{bottom:.0f} по высоте)")
        else:
            placed = re.search(r"\\an([1-9])", text)
            alignment = int(placed.group(1) if placed else num(style.get("alignment")) or 2)
            vertical = num(event.get("marginv")) or num(style.get("marginv"))
            if alignment not in (4, 5, 6) and vertical < top:
                note("text_margin", f"отступ {vertical:g} от {'верхнего' if alignment > 6 else 'нижнего'} края, "
                                    f"ближе безопасной зоны ({top:.0f})")
            for edge, field, aligned in (("левого", "marginl", (1, 4, 7)), ("правого", "marginr", (3, 6, 9))):
                margin = num(event.get(field)) or num(style.get(field))
                if alignment in aligned and margin < side:
                    note("text_margin", f"отступ {margin:g} от {edge} края, ближе безопасной зоны ({side:.0f})")
    return [finding(kind, a, b, what) for (kind, what), spans in runs.items() for a, b in merged(spans)]


# ---------------------------------------------------------------- faces

def face_model() -> Path | None:
    for pattern in (os.environ.get("VIDEO_CHECK_FACE_MODEL"), "~/.claude/skills/*/models/yunet*.onnx",
                    "~/.claude/skills/*/models/face_detection_yunet*.onnx"):
        if pattern:
            found = sorted(glob.glob(os.path.expanduser(pattern)))
            if found: return Path(found[0])
    return None


def track_faces(video: Path, info: dict, fps: float, model: Path) -> tuple[list[tuple[float, tuple | None]], str | None]:
    """The biggest face on every analysed frame, and what was missed when not every frame could be read."""
    width = 640; height = max(2, round(info["height"] * width / info["width"] / 2) * 2)
    scale = info["width"] / width
    detector = cv2.FaceDetectorYN.create(str(model), "", (width, height), 0.6, 0.3, 50)
    size, track, limit, late = width * height * 3, [], budget(info["duration"]), threading.Event()
    with tempfile.TemporaryFile() as said:
        process = subprocess.Popen(["ffmpeg", "-nostdin", "-v", "error", "-i", str(video), "-an", "-vf",
                                    f"fps={fps},scale={width}:{height}", "-pix_fmt", "bgr24", "-f", "rawvideo", "-"],
                                   stdout=subprocess.PIPE, stderr=said)
        def stop() -> None: late.set(); process.kill()
        watchdog = threading.Timer(limit, stop); watchdog.start()
        try:
            while True:
                raw = process.stdout.read(size)
                if len(raw) < size: break
                _, seen = detector.detect(np.frombuffer(raw, np.uint8).reshape(height, width, 3))
                box = None
                if seen is not None and len(seen):
                    x, y, w, h = max(seen, key=lambda f: f[2] * f[3])[:4]
                    box = (float(x) * scale, float(y) * scale, float(w) * scale, float(h) * scale)
                track.append((len(track) / fps, box))
            code = process.wait()
        finally:
            watchdog.cancel()
            if process.poll() is None: process.kill(); process.wait()
            process.stdout.close()
        said.seek(0)
        stopped = subprocess.CompletedProcess([], code, None, said.read().decode("utf-8", "replace"))
    expected = info["duration"] * fps  # a second at most may go missing (sound padding), a tenth of a very short clip
    if not late.is_set() and not code and len(track) >= expected - min(0.1 * expected, fps):
        return track, None
    why = f"не уложилось в {limit:.0f} с" if late.is_set() else complaint(stopped) if code else "кадров меньше, чем длится ролик"
    return track, f"лица проверены только до {clock(len(track) / fps)} из {clock(info['duration'])}: {why}"


# ---------------------------------------------------------------- sheets

def when(info: dict, at: float) -> float:
    """A moment the file has a frame for: a finding at the very end shows the last frames."""
    return min(max(0.0, at), max(0.0, info["duration"] - 0.25))


def grab(video: Path, at: float, width: int, height: int):
    result = run(["ffmpeg", "-nostdin", "-v", "error", "-ss", f"{at:.3f}", "-i", str(video), "-frames:v", "1",
                  "-vf", f"scale={width}:{height}", "-f", "image2pipe", "-vcodec", "png", "-"], timeout=120, text=False)
    if result.returncode or not result.stdout: return None
    return cv2.imdecode(np.frombuffer(result.stdout, np.uint8), cv2.IMREAD_COLOR)


def picture(video: Path, at: float, width: int, height: int, missing: list[float]):
    """The frame, or a grey tile that says it is missing (and the report says so), never a made-up black frame."""
    image = grab(video, at, width, height)
    if image is not None and image.shape[:2] == (height, width): return image
    missing.append(at)
    image = np.full((height, width, 3), 160, np.uint8)
    cv2.putText(image, "NO FRAME", (8, height // 2), cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 0, 255), 2, cv2.LINE_AA)
    return image


def labelled(image, label: str):
    band = np.full((30, image.shape[1], 3), 255, np.uint8)
    cv2.putText(band, label, (6, 21), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 0), 1, cv2.LINE_AA)
    return np.vstack([band, image])


def tile_size(info: dict, per_row: int, rows: int) -> tuple[int, int]:
    """The biggest tile such that per_row × rows tiles (with their labels) stay a sheet the model reads whole."""
    aspect = info["height"] / info["width"]
    width = int(min(1520 / per_row, 1560 / rows / aspect))
    while width > 120 and per_row * width * rows * (width * aspect + 30) > SHEET_PIXELS: width -= 10
    return width - width % 2, max(2, round(width * aspect / 2) * 2)


def write_sheet(path: Path, rows: list[list]) -> None:
    width = max(sum(i.shape[1] for i in row) for row in rows)
    lines = [np.hstack(row + ([np.full((row[0].shape[0], width - sum(i.shape[1] for i in row), 3), 255, np.uint8)]
                              if sum(i.shape[1] for i in row) < width else [])) for row in rows]
    if not cv2.imwrite(str(path), np.vstack(lines), [cv2.IMWRITE_JPEG_QUALITY, 88]):
        raise CheckError(f"лист {path.name} не записан")


def sheets(video: Path, info: dict, found: list[dict], cut_shots: list[tuple[float, float]], build: Path,
           missing: list[float]) -> list[dict]:
    made, vertical = [], info["height"] > info["width"]
    # Every finding: just before, at, just after, side by side.
    per_sheet = 2 if vertical else 3
    tw, th = tile_size(info, 3, per_sheet)
    for start in range(0, len(found), per_sheet):
        group, rows = found[start:start + per_sheet], []
        for number, item in enumerate(group, start + 1):
            moments = [when(info, item["start"] + shift) for shift in (-0.3, 0.0, 0.3)]
            rows.append([labelled(picture(video, t, tw, th, missing), f"#{number} {clock(t)}") for t in moments])
        path = build / f"findings-{start // per_sheet + 1:02d}.jpg"; write_sheet(path, rows)
        made.append({"file": path.name, "shows": "находки " + ", ".join(f"#{n}" for n in range(start + 1, start + len(group) + 1))})
    # Every scene: its start, and inside long shots a frame every 2 s (short videos) or 20 s (long ones).
    every = 2.0 if info["duration"] <= 180 else 20.0
    moments = []
    for number, (a, b) in enumerate(cut_shots, 1):
        moments.append((when(info, min(a + 0.15, (a + b) / 2)), number))
        t = a + every
        while t < b - 0.5: moments.append((t, number)); t += every
    per_row, rows_per = (4, 1) if vertical else (2, 2)
    tw, th = tile_size(info, per_row, rows_per)
    chunk = per_row * rows_per
    for start in range(0, len(moments), chunk):
        group = moments[start:start + chunk]
        tiles = [labelled(picture(video, t, tw, th, missing), f"{clock(t)} scene {n}") for t, n in group]
        rows = [tiles[i:i + per_row] for i in range(0, len(tiles), per_row)]
        path = build / f"scenes-{start // chunk + 1:03d}.jpg"; write_sheet(path, rows)
        made.append({"file": path.name, "shows": f"сцены {group[0][1]}–{group[-1][1]}, {clock(group[0][0])}–{clock(group[-1][0])}"})
    return made


# ---------------------------------------------------------------- report

def report(build: Path, out: Path, video: Path, info: dict, found: list[dict], made: list[dict],
           notes: list[str], gaps: list[str]) -> None:
    lines = [f"# Проверка {video.name}", ""]
    if gaps:
        lines += ["## ⚠️ Проверка неполная", "", "Не проверено или не прочитано:", ""] + [f"- {g}" for g in gaps]
        lines += ["", "Когда отдаёшь ролик, назови эти пробелы — или устрани причину и проверь заново.", ""]
    lines += [f"{info['width']}×{info['height']}, {info['fps']:g} к/с, {clock(info['duration'])}. "
              f"Находок: {len(found)}. Листов: {len(made)}.", ""]
    lines += [f"- {n}" for n in notes] + ([""] if notes else [])
    lines += ["Открой каждый лист ниже инструментом Read, по порядку: сначала находки, потом сцены. Каждую находку "
              "исправь или назови причину, почему так задумано. После правки проверь новый файл заново.", "", "## Находки", ""]
    lines += [f"{i}. {clock(f['start'])}–{clock(f['end'])} — {f['what']} ({f['kind']})" for i, f in enumerate(found, 1)] or ["Нет."]
    lines += ["", "## Листы", ""] + [f"- {out / m['file']} — {m['shows']}" for m in made]
    (build / "report.md").write_text("\n".join(lines) + "\n", encoding="utf-8")
    (build / "report.json").write_text(json.dumps({"video": str(video), "complete": not gaps, "gaps": gaps, "info": info,
                                                  "findings": found, "sheets": made, "notes": notes},
                                                 ensure_ascii=False, indent=1), encoding="utf-8")


def claim(out: Path, sources: list[Path]) -> None:
    """The result goes to a new or empty folder, or to one this tool made; never onto a source file, a folder that
    holds one, or a folder of someone else's (Codex review, 04.11.2026)."""
    for source in sources:
        if source == out or out in source.parents:
            raise CheckError(f"--out {out}: это входной файл или папка, где он лежит; укажи отдельную папку")
    if out.exists() and not out.is_dir():
        raise CheckError(f"--out {out}: это файл; укажи папку")
    if out.is_dir() and ours(out) is None:
        raise CheckError(f"папка {out} не пустая и не от video-check; укажи новую через --out")


def ours(folder: Path) -> dict | None:
    """Each entry's identity when the folder is empty or holds only this tool's regular files next to its marker;
    None otherwise. Only entries of this snapshot, unchanged, are ever removed (Codex review)."""
    snapshot = {}
    for entry in folder.iterdir():
        info = entry.lstat()
        if not (OWN.fullmatch(entry.name) and stat.S_ISREG(info.st_mode)):
            return None
        snapshot[entry.name] = (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns)
    return snapshot if not snapshot or MARK in snapshot else None


def publish(build: Path, out: Path) -> None:
    """The finished folder takes the old one's place; until then the previous result stays whole. The old folder is
    checked again once it is out of the way (Codex review: something may have been put there after the first check)
    and only the tool's own files are removed from it, one by one; anything else stays."""
    old = Path(tempfile.mkdtemp(prefix=f".{out.name}.old.", dir=out.parent)) if out.exists() else None
    if old:
        os.rename(out, old)  # onto the fresh empty folder: a rename may replace an empty one
        snapshot = ours(old)
        if snapshot is None:
            os.rename(old, out)
            raise CheckError(f"в папку {out} положили чужое, пока шла проверка; укажи новую через --out")
    try:
        os.rename(build, out)
    except OSError:
        if old: os.rename(old, out)
        raise
    if old:
        # Each file first moves into a private folder (one atomic rename), and only there, where nothing else can swap
        # it, is it compared with the check and removed; anything else stays where it went (Codex review).
        removing = Path(tempfile.mkdtemp(prefix=".removing.", dir=old))
        for name, identity in snapshot.items():
            try:
                os.rename(old / name, removing / name)
            except FileNotFoundError:
                continue
            info = (removing / name).lstat()
            if stat.S_ISREG(info.st_mode) and (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns) == identity:
                (removing / name).unlink()
        for folder in (removing, old):
            try:
                folder.rmdir()
            except OSError:
                pass  # something arrived or was swapped in after the check: it stays, untouched


def check(args) -> int:
    video = args.video.resolve()
    if not video.is_file(): raise CheckError(f"нет такого файла: {video}")
    sources = [video] + [p.resolve() for p in (args.ass, args.style) if p]
    for source in sources[1:]:
        if not source.is_file(): raise CheckError(f"нет такого файла: {source}")
    out = (args.out or video.with_name(video.stem + "-check")).resolve()
    claim(out, sources)
    if args.fps is not None and args.fps <= 0: raise CheckError("--fps должен быть больше нуля")
    sample = None
    if args.style:
        try: sample = json.loads(args.style.read_text(encoding="utf-8"))
        except (OSError, ValueError) as error: raise CheckError(f"образец стиля не прочитан: {error}") from None
        if not isinstance(sample, dict):
            raise CheckError('образец стиля — объект вида {"fonts": ["Montserrat"], "minSize": 70, "maxSize": 110}')
    info = probe(video); notes: list[str] = []; gaps: list[str] = []
    scanned = scan(video, info["duration"]); cut_shots = shots(scanned["cuts"], info["duration"])
    found = short_shots(scanned["cuts"], info["duration"]) + picture_findings(scanned, info["duration"])
    if not info["audio"]:
        notes.append("звука в файле нет")
    else:
        heard = sound(video, info["duration"])
        if heard.get("error"): gaps.append(heard["error"])
        else:
            if heard["loudness"] is None: gaps.append("громкость не измерена: ffmpeg не дал итог")
            found += sound_findings(heard, info["duration"])
    if args.ass:
        found += text_findings(read_ass(args.ass), sample, info["duration"])
    if cv2 is None:
        gaps.append("нет OpenCV: лица не проверены и листы не собраны; поставь окружение командой video-check --setup")
    elif args.no_faces:
        gaps.append("лица не проверялись (--no-faces)")
    else:
        model = face_model()
        if model is None: gaps.append("нет модели лиц yunet.onnx (VIDEO_CHECK_FACE_MODEL): лица не проверены")
        else:
            fps = args.fps or (15.0 if info["duration"] <= 600 else 10.0)
            track, problem = track_faces(video, info, fps, model)
            notes.append(f"лица проверены на {fps:g} кадрах в секунду, сцены — на каждом кадре")
            if problem: gaps.append(problem)
            found += face_findings(track, cut_shots, info["width"], info["height"], 1 / fps)
    found.sort(key=lambda f: (f["start"], f["kind"]))
    out.parent.mkdir(parents=True, exist_ok=True)
    build = Path(tempfile.mkdtemp(prefix=f".{out.name}.", dir=out.parent))
    mask = os.umask(0); os.umask(mask); os.chmod(build, 0o777 & ~mask)  # readable like any folder, as before
    try:
        (build / MARK).write_text(f"{video}\n", encoding="utf-8")
        missing: list[float] = []
        made = sheets(video, info, found, cut_shots, build, missing) if cv2 is not None else []
        if missing:
            gaps.append(f"{len(missing)} кадров для листов не извлечены, на их месте серые плашки NO FRAME: "
                        + ", ".join(clock(t) for t in missing))
        report(build, out, video, info, found, made, notes, gaps)
        claim(out, sources)
        publish(build, out)
    except BaseException:
        shutil.rmtree(build, ignore_errors=True)
        raise
    print(f"video-check: {len(found)} находок, {len(made)} листов"
          f"{', ПРОВЕРКА НЕПОЛНАЯ (пробелы в начале отчёта)' if gaps else ''} -> {out / 'report.md'}")
    return 0


def faces(args) -> int:
    video, out = args.video.resolve(), args.out.resolve()
    if not video.is_file(): raise CheckError(f"нет такого файла: {video}")
    if out == video or out.suffix.lower() != ".json":
        raise CheckError("--out: отдельный файл .json, не сам ролик")
    if args.fps <= 0: raise CheckError("--fps должен быть больше нуля")
    if cv2 is None: raise CheckError("нет OpenCV: video-check --setup")
    model = face_model()
    if model is None: raise CheckError("нет модели лиц yunet.onnx (VIDEO_CHECK_FACE_MODEL)")
    info = probe(video)
    track, problem = track_faces(video, info, args.fps, model)
    if problem: raise CheckError(problem)
    data = json.dumps({"fps": args.fps, "width": info["width"], "height": info["height"],
                       "track": [[round(t, 3), *(round(v, 1) for v in box)] if box else [round(t, 3)] for t, box in track]})
    out.parent.mkdir(parents=True, exist_ok=True)
    handle, name = tempfile.mkstemp(prefix=f".{out.name}.", dir=out.parent)
    try:
        mask = os.umask(0); os.umask(mask); os.fchmod(handle, 0o666 & ~mask)
        with os.fdopen(handle, "w", encoding="utf-8") as stream: stream.write(data)
        os.replace(name, out)
    except BaseException:
        Path(name).unlink(missing_ok=True)
        raise
    print(f"video-check faces: {sum(1 for _, b in track if b)} из {len(track)} кадров с лицом -> {out}")
    return 0


def setup() -> int:
    venv = Path(os.path.expanduser("~/.venvs/video"))
    if not (venv / "bin/python").exists():
        subprocess.run([sys.executable, "-m", "venv", str(venv)], check=True)
    subprocess.run([str(venv / "bin/pip"), "install", "--quiet", "opencv-python-headless", "numpy"], check=True)
    print(f"video-check: окружение {venv} готово")
    return 0


def main() -> int:
    if sys.argv[1:2] == ["--setup"]: return setup()
    if sys.argv[1:2] == ["faces"]:
        parser = argparse.ArgumentParser(prog="video-check faces", description="Dense face track for framing and zooms.")
        parser.add_argument("video", type=Path); parser.add_argument("--out", type=Path, required=True)
        parser.add_argument("--fps", type=float, default=15.0)
        return faces(parser.parse_args(sys.argv[2:]))
    parser = argparse.ArgumentParser(prog="video-check", description=__doc__.split("\n\n")[0])
    parser.add_argument("video", type=Path)
    parser.add_argument("--out", type=Path, help="folder for report.md, report.json and the sheets (new, empty or its own)")
    parser.add_argument("--ass", type=Path, help="the subtitles/plates file the video was rendered with")
    parser.add_argument("--style", type=Path, help='a sample: {"fonts": ["Montserrat"], "minSize": 70, "maxSize": 110}')
    parser.add_argument("--fps", type=float, help="frames per second for the face check (default 15, 10 past 10 min)")
    parser.add_argument("--no-faces", action="store_true")
    return check(parser.parse_args())


if __name__ == "__main__":
    try:
        sys.exit(main())
    except CheckError as error:
        print(f"video-check: {error}", file=sys.stderr)
        sys.exit(2)
