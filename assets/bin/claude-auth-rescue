#!/usr/bin/env python3
"""Self-service Claude re-login via Telegram — no SSH needed.

When the Claude OAuth refresh token dies, the agent's model calls fail but the
Telegram plugin poller keeps running (bot token is independent). This script,
launched by the healthcheck, closes the loop without an operator:

  1. spawn `claude auth login --claudeai` under a pty, capture the OAuth URL
     ("If the browser didn't open, visit: https://claude.com/cai/oauth/...");
  2. send that URL to the owner via raw Bot API with instructions;
  3. the owner signs in, gets a code, and sends it back TO THE BOT as a plain
     message; we read it from the plugin's messages.db (chat-scoped) and paste
     it into the waiting CLI prompt ("Paste code here if prompted >");
  4. verify `claude auth status`, restart the service, prove the canonical
     Telegram poller is alive, then confirm in Telegram.

Hardening (2026-07-11, Mani incident): codes from stale links (wrong #state
suffix) are ignored while waiting; if the CLI ignores stdin (~2.1.113-era
loopback-only login), the code is delivered to its local OAuth callback
instead; after success the owner is warned about stale
CLAUDE_CODE_OAUTH_TOKEN / ANTHROPIC_API_KEY left in .env (they override fresh
credentials and 401 the bot).

The human tap is unavoidable by OAuth design (and desirable: no password is
ever stored). Everything else is automatic. Debounced via a state file so the
2-minute healthcheck can call this unconditionally. Never logs tokens/codes.

Account switch (2026-09-19, Yasha on a burnt weekly limit): `--force` while the
login is still alive means the owner wants ANOTHER account. The old login keeps
working until the new one lands, so `loggedIn` proves nothing here — only a
different account (or the login process finishing successfully) does.
"""

import json
import hashlib
import importlib.machinery
import importlib.util
from contextlib import closing, contextmanager
import fcntl
import os
import pty
import pwd
import re
import select
import signal
import sqlite3
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

_NOTICE_SPEC = importlib.util.spec_from_file_location(
    "agent_notice_locale", Path(__file__).with_name("agent_notice_locale.py")
)
_NOTICE_MODULE = importlib.util.module_from_spec(_NOTICE_SPEC)
_NOTICE_SPEC.loader.exec_module(_NOTICE_MODULE)

HOME = Path(os.environ.get("HOME", "/home/claude"))
AGENT_ROOT = Path(os.environ.get("AGENT_ROOT", str(HOME)))
CLAUDE_CONFIG_DIR = Path(
    os.environ.get("CLAUDE_CONFIG_DIR", str(HOME / ".claude"))
)
# The launcher leaves CLAUDE_CONFIG_DIR unset for the default folder: set, even to ~/.claude, it
# moves the CLI's account record from ~/.claude.json to <folder>/.claude.json. The CLI is asked
# here exactly as the bot runs it, or a login lands in a record the bot never reads (Арти,
# 02.10.2026: /relogin switched the login and the bot went on naming the previous account).
CLI_CONFIG_ENV = (
    {"CLAUDE_CONFIG_DIR": str(CLAUDE_CONFIG_DIR)} if os.environ.get("CLAUDE_CONFIG_DIR") else {}
)
STATE_DIR = Path(
    os.environ.get("TELEGRAM_STATE_DIR")
    or str(AGENT_ROOT / ".claude/channels/telegram")
)


def _find_claude() -> Path:
    """The kit installs claude to ~/.local/bin, but custom boxes differ."""
    for candidate in (HOME / ".local/bin/claude",
                      Path("/usr/local/bin/claude"), Path("/usr/bin/claude")):
        if candidate.is_file():
            return candidate
    return HOME / ".local/bin/claude"


CLAUDE_BIN = _find_claude()
ENV_FILE = STATE_DIR / ".env"
ACCESS_FILE = STATE_DIR / "access.json"
MESSAGES_DB = STATE_DIR / "messages.db"
AUTH_INPUT_FILE = STATE_DIR / "auth-input.json"
LIFECYCLE_LOCK = AGENT_ROOT / "logs/transport-lifecycle.lock"
BOT_PID_FILE = STATE_DIR / "bot.pid"
STATE_FILE = AGENT_ROOT / "logs/auth-rescue.state"
LOG_FILE = AGENT_ROOT / "logs/auth-rescue.log"
LOCK_FILE = AGENT_ROOT / "logs/auth-rescue.lock"
AUTH_ESTABLISHED = AGENT_ROOT / ".claude/auth-established"
SERVICE = os.environ.get("CLAUDE_TELEGRAM_SERVICE", "claude-telegram.service")
PROC_ROOT = Path("/proc")

URL_TIMEOUT_S = 75        # waiting for the OAuth URL to appear in CLI output
CODE_TIMEOUT_S = 600      # waiting for the owner to send the code back
DEBOUNCE_S = 1200         # min gap between rescue attempts
# One automatic link per outage. After it, only the owner's /relogin may
# start another flow; an ignored link must not become a stream of reminders.
AUTO_ATTEMPTS_CAP = 1
ATTEMPTS_FILE = AGENT_ROOT / ".claude/auth-rescue-auto-attempts"
POLLER_START_TIMEOUT_S = 60
POLLER_POLL_INTERVAL_S = 1
TRANSPORT_RESTART_ATTEMPTS = 2


def log(message: str) -> None:
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a", encoding="utf-8") as handle:
        handle.write(f"{time.strftime('%F %T')} {message}\n")


def say(key: str, ukrainian: str, **values: str) -> str:
    """The owner's text in the agent's notice language (OWNER_NOTICE_LOCALE), Ukrainian by default."""
    return _NOTICE_MODULE.notice_text(key, ukrainian, home=AGENT_ROOT).format(**values)


# A link that died unused and an owner who has not written since: the outage goes on, so a fresh link
# goes in the owner's daytime (09:00-21:00 in the agent's TIMEZONE), at most every 6 hours. Верні, Пара,
# Team bot 03.10: the night link expired and the bots stayed silent until someone noticed.
DAYTIME_RELINK_AFTER_S = 6 * 3600


def owner_daytime(at: float) -> bool:
    from datetime import datetime
    from zoneinfo import ZoneInfo
    try:
        return 9 <= datetime.fromtimestamp(at, ZoneInfo(_NOTICE_MODULE.agent_time_zone(AGENT_ROOT))).hour < 21
    except Exception:
        return False


def mark_auth_established() -> None:
    AUTH_ESTABLISHED.parent.mkdir(parents=True, exist_ok=True)
    AUTH_ESTABLISHED.touch(mode=0o600, exist_ok=True)
    AUTH_ESTABLISHED.chmod(0o600)


def extract_url(text: str) -> str:
    """OAuth URL from real CLI output. Newer CLIs (2.1.2xx) print it as an OSC-8
    terminal hyperlink (\\e]8;;URL\\e\\ visible-URL \\e]8;;\\e\\) — the URL appears
    twice back-to-back with no whitespace, so a greedy \\S* grabbed BOTH copies +
    the escape bytes (that's the 'two links + ]8;; tail' bug). Strip OSC and CSI
    sequences first, then match URL chars only, stopping at ws / esc / ] / \\."""
    clean = re.sub(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)", "", text)  # OSC (incl. 8)
    clean = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", clean)           # CSI
    clean = clean.replace("\x1b\\", "").replace("\x1b", "")        # stray ST/ESC
    match = re.search(r"https://[^\s\x1b\]\\]+oauth[^\s\x1b\]\\]*", clean)
    return match.group(0).rstrip(".,)") if match else ""


def looks_like_code(text: str) -> bool:
    """The pasted-back authorization code: one long token, no spaces."""
    text = text.strip()
    return bool(re.fullmatch(r"[A-Za-z0-9_#\-\.]{15,}", text))


def login_environment() -> dict:
    """The environment of every CLI call of this flow: the bot's own config location."""
    return {**os.environ, "HOME": str(HOME), **CLI_CONFIG_ENV, "ATARAX_SUPPRESS_TELEGRAM": "1"}


def _login_near_end() -> bool:
    """A live login in its last ten minutes (or past them). CLI 2.1.288 renews inside `auth status` then and
    exits before keeping the answer, which wipes the login 8 hours later (kit #186)."""
    try:
        login = json.loads((CLAUDE_CONFIG_DIR / ".credentials.json").read_text(encoding="utf-8")).get("claudeAiOauth") or {}
        return bool(login.get("accessToken") and login.get("refreshToken")
                    and int(login.get("expiresAt") or 0) <= (time.time() + 600) * 1000)
    except (OSError, ValueError, AttributeError, TypeError):
        return False


def _auth_status() -> dict | None:
    """`claude auth status` as JSON; None when blocked, malformed or timed out. A live login near its end is read
    from the files instead: the login itself, and the account from the record the bot reads (CLI_CONFIG_ENV)."""
    if _login_near_end():
        # The record the bot reads, as the launcher selects it: an explicit root prefers its .config.json.
        record = HOME / ".claude.json"
        if CLI_CONFIG_ENV:
            record = CLAUDE_CONFIG_DIR / ".config.json"
            if not record.exists():
                record = CLAUDE_CONFIG_DIR / ".claude.json"
        try:
            email = (json.loads(record.read_text(encoding="utf-8")).get("oauthAccount") or {}).get("emailAddress")
        except (OSError, ValueError, AttributeError):
            email = None
        return {"loggedIn": True, **({"email": email} if isinstance(email, str) else {})}
    try:
        probe = subprocess.run(
            [str(CLAUDE_BIN), "auth", "status"],
            capture_output=True, text=True, timeout=25,
            env=login_environment(),
        )
        out = (probe.stdout or "") + (probe.stderr or "")
        # Хук no-nested-claude-guard блокує виклик і повертає свій текст замість
        # статусу. Порожній статус — це «не знаю», а не «логін помер»: інакше
        # сторож бачить блокування як прострочений токен і щоп'ять хвилин
        # шле власнику посилання на новий вхід.
        if "SELF-KILL GUARD" in out or '"decision": "block"' in out or "PermissionDenied" in out:
            log("auth probe blocked by hook — не вважаю це втратою логіну")
            return None
        status = json.loads(probe.stdout or "")
        return status if isinstance(status, dict) else None
    except Exception:
        return None


def logged_in() -> bool | None:
    status = _auth_status()
    authenticated = status.get("loggedIn") if status else None
    return authenticated if type(authenticated) is bool else None


def auth_email() -> str:
    """Account of the live login; "" when logged out or unknown."""
    status = _auth_status()
    email = status.get("email") if status else ""
    return email if isinstance(email, str) else ""


def listener_port(pid: int) -> str:
    """Old CLIs (~2.1.113) take the code ONLY via a loopback HTTP callback."""
    try:
        out = subprocess.run(["ss", "-tlnp"], capture_output=True, text=True,
                             timeout=10).stdout
    except Exception:
        return ""
    for line in out.splitlines():
        if f"pid={pid}," in line:
            match = re.search(r":(\d+)\s", line)
            if match:
                return match.group(1)
    return ""


def env_token_zombies() -> str:
    """Stale auth env vars in .env override fresh credentials → the bot 401s."""
    try:
        names = [line.split("=", 1)[0]
                 for line in ENV_FILE.read_text(encoding="utf-8").splitlines()
                 if line.startswith(("CLAUDE_CODE_OAUTH_TOKEN=",
                                     "ANTHROPIC_API_KEY="))]
        return ", ".join(names)
    except Exception:
        return ""


def _proc_starttime(pid: int) -> str | None:
    """The kernel's start time of a process (/proc/<pid>/stat field 22): a reused PID has another one."""
    try:
        text = (PROC_ROOT / str(pid) / "stat").read_text(encoding="utf-8", errors="replace")
        return text[text.rfind(")") + 2:].split()[19]
    except (OSError, IndexError):
        return None


def _receiver_state_dir(environ: dict[bytes, bytes]) -> str | None:
    """The state folder a receiver started with this environment uses, or None when it is not an absolute path.

    The receiver's own rule (telegram-server-fixed.ts): TELEGRAM_STATE_DIR when set, even to an empty or
    foreign value, else <CLAUDE_CONFIG_DIR or ~/.claude>/channels/telegram, ~ being HOME or the user's
    home from the password file.
    """
    state = environ.get(b"TELEGRAM_STATE_DIR")
    if state is None:
        config = environ.get(b"CLAUDE_CONFIG_DIR")
        if config is None:
            home = environ.get(b"HOME")
            config = os.path.join(os.fsdecode(home) if home is not None else pwd.getpwuid(os.getuid()).pw_dir,
                                  ".claude")
        state = os.path.join(os.fsdecode(config), "channels", "telegram")
    state = os.fsdecode(state)
    return state if os.path.isabs(state) else None


def poller_token() -> str:
    """TELEGRAM_BOT_TOKEN of this agent's own live poller, or "" unless every check holds.

    The process is the canonical poller (bot.pid, this uid, bun server.ts), the
    state folder its environment gives the receiver is ours, and after its
    environment was read it is still the same process: bot.pid names it and its
    start time is unchanged (Codex AGENTS 03.10, #175). A shared plugins folder
    or working directory proves nothing about which bot a process serves.
    Nothing about the token is ever logged.
    """
    pid = _canonical_poller_pid()
    started = _proc_starttime(pid) if pid else None
    if not started:
        return ""
    try:
        environ = dict(item.split(b"=", 1) for item in (PROC_ROOT / str(pid) / "environ").read_bytes().split(b"\0")
                       if b"=" in item)
    except OSError:
        return ""
    state = _receiver_state_dir(environ)
    ours = state is not None and os.path.realpath(state) == os.path.realpath(STATE_DIR)
    token = environ.get(b"TELEGRAM_BOT_TOKEN", b"").decode("utf-8", "replace").strip()
    if not ours or not token or _canonical_poller_pid() != pid or _proc_starttime(pid) != started:
        return ""
    return token


def bot_token() -> str:
    """The token this agent's live poller runs with; the channel file only when that cannot be proven.

    CMO Bro, 03.10.2026: the channel file held a stale token (401) while the
    poller ran with a valid one from its own environment, so every link was lost.
    """
    token = poller_token()
    if token:
        return token
    for line in ENV_FILE.read_text(encoding="utf-8").splitlines():
        if line.startswith("TELEGRAM_BOT_TOKEN="):
            return line.split("=", 1)[1].strip()
    return ""


def owner_chat() -> str:
    configured = os.environ.get("OWNER_CHAT_ID")
    if configured is None:
        try:
            configured = next((line.split("=", 1)[1].strip()
                for line in ENV_FILE.read_text(encoding="utf-8").splitlines()
                if line.startswith("OWNER_CHAT_ID=")), "")
        except OSError:
            configured = ""
    if configured:
        return configured
    data = json.loads(ACCESS_FILE.read_text(encoding="utf-8"))
    admins = data.get("admins") or []
    if admins:
        return str(admins[0])
    allow = data.get("allowFrom") or []
    return str(allow[0]) if allow else ""


def manual_relogin_chat(chat: str) -> bool:
    """A manually chosen OAuth recipient must hold the role right now."""
    if not re.fullmatch(r"[1-9]\d{0,19}", chat):
        return False
    try:
        primary = owner_chat()
    except (OSError, ValueError, KeyError, TypeError):
        return False
    if chat == primary:
        return True
    try:
        access = json.loads(ACCESS_FILE.read_text(encoding="utf-8"))
        admins, admitted, superadmins = (access[key] for key in ("admins", "allowFrom", "superadmins"))
        return all(isinstance(items, list) and all(isinstance(item, str) for item in items)
                   for items in (admins, admitted, superadmins)) and all(
                       chat in items for items in (admins, admitted, superadmins))
    except (OSError, ValueError, KeyError, TypeError):
        return False


def send(token: str, chat: str, text: str) -> str:
    """"delivered" when Telegram said ok; "refused" when it said no (HTTP 4xx or ok=false: nothing was
    sent); "unconfirmed" when no answer came back — the message may have arrived (Codex AGENTS 03.10,
    #175 P1-1). The reason is logged; the token never is."""
    body = urllib.parse.urlencode({"chat_id": chat, "text": text}).encode()
    req = urllib.request.Request(
        f"https://api.telegram.org/bot{token}/sendMessage", data=body
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as response:
            answer = json.loads(response.read())
    except urllib.error.HTTPError as error:
        try:
            reason = str(json.loads(error.read()).get("description", ""))
        except Exception:
            reason = ""
        log(f"send failed: HTTP {error.code} {reason[:120]}".rstrip())
        return "refused" if 400 <= error.code < 500 else "unconfirmed"
    except Exception as error:
        log(f"send unconfirmed: {type(error).__name__}")
        return "unconfirmed"
    if not isinstance(answer, dict):
        log("send unconfirmed: an answer that is not Telegram's")
        return "unconfirmed"
    if answer.get("ok") is not True:
        log(f"send failed: Telegram refused: {str(answer.get('description', ''))[:120]}")
        return "refused"
    try:
        subprocess.run(
            [str(AGENT_ROOT / "bin/tg-fallback-outbound"), chat],
            check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        log("auth reply delivered but outbound receipt failed")
    return "delivered"


def canonical_poller_alive() -> bool:
    return _canonical_poller_pid() is not None


def _canonical_poller_pid() -> int | None:
    """Prove bot.pid names this user's live Bun server.ts process; its PID, or None.

    A bare PID existence check is unsafe because stale PIDs can be reused. The
    Telegram server owns bot.pid and removes it on clean shutdown, while /proc
    lets us bind the proof to the expected user, executable, and entrypoint.
    """
    try:
        metadata = BOT_PID_FILE.lstat()
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid():
            return None
        raw = BOT_PID_FILE.read_text(encoding="ascii").strip()
        if not raw.isdigit():
            return None
        pid = int(raw)
        if pid <= 1:
            return None
        os.kill(pid, 0)

        process = PROC_ROOT / str(pid)
        status = (process / "status").read_text(encoding="utf-8")
        uid_line = next(
            line for line in status.splitlines() if line.startswith("Uid:")
        )
        if int(uid_line.split()[1]) != os.getuid():
            return None

        executable = Path(os.readlink(process / "exe")).name
        if executable not in {"bun", "bun.exe"}:
            return None
        arguments = [
            value.decode("utf-8", errors="replace")
            for value in (process / "cmdline").read_bytes().split(b"\0")
            if value
        ]
        return pid if any(Path(argument).name == "server.ts" for argument in arguments) else None
    except (OSError, UnicodeDecodeError, ValueError, StopIteration):
        return None


def wait_for_canonical_poller() -> bool:
    """Wait a bounded interval for the post-restart Telegram process."""
    deadline = time.monotonic() + POLLER_START_TIMEOUT_S
    while True:
        if canonical_poller_alive():
            return True
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return False
        time.sleep(min(POLLER_POLL_INTERVAL_S, remaining))


def restart_and_verify_transport() -> bool:
    """Restart at most twice and return only after a proven poller."""
    for attempt in range(1, TRANSPORT_RESTART_ATTEMPTS + 1):
        try:
            result = subprocess.run(
                ["sudo", "systemctl", "restart", SERVICE],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=60,
            )
            restart_ok = result.returncode == 0
        except (OSError, subprocess.SubprocessError):
            restart_ok = False
        if not restart_ok:
            log(f"service restart attempt {attempt} failed")
        if wait_for_canonical_poller():
            return True
        log(f"Telegram poller absent after service restart attempt {attempt}")
    return False


@contextmanager
def stopped_auth_transport():
    """Exclude health restarts and the old consumer before freeing the FIFO."""
    LIFECYCLE_LOCK.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(LIFECYCLE_LOCK, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        deadline = time.monotonic() + 30
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise RuntimeError("transport lifecycle busy")
                time.sleep(0.2)
        try:
            stopped = subprocess.run(["sudo", "systemctl", "stop", SERVICE],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
            if stopped.returncode != 0 or canonical_poller_alive():
                raise RuntimeError("old Telegram transport did not stop")
        except (OSError, subprocess.SubprocessError, RuntimeError):
            # A failed/timeout stop may already have killed the consumer. The
            # context has not yielded, so its caller cannot restart it yet.
            restart_and_verify_transport()
            raise
        yield
    finally:
        os.close(fd)


def publish_auth_input(chat: str, state: str, since_ms: int) -> None:
    """Let the receiver keep this flow's code out of the model's FIFO."""
    AUTH_INPUT_FILE.parent.mkdir(parents=True, exist_ok=True)
    temporary = AUTH_INPUT_FILE.with_name(f".auth-input-{os.getpid()}.tmp")
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump({"owner_chat_id": chat, "since_ms": since_ms,
                   "expires_at": since_ms + CODE_TIMEOUT_S * 1000,
                   "state_sha256": hashlib.sha256(state.encode()).hexdigest()}, handle)
    os.replace(temporary, AUTH_INPUT_FILE)


def settle_auth_control_deliveries(chat: str, auth_code: str = "", since_ms: int = 0) -> int:
    """Upgrade bridge: settle only DB-proven owner controls, never business work.

    Older receivers queued /relogin and its OAuth code as model tasks. Successful
    OAuth cannot acknowledge arbitrary started jobs: their effects are unknown.
    Audit only identifiers, never the code. Keep the original inbox/history.
    """
    if not re.fullmatch(r"[1-9][0-9]*", chat) or not MESSAGES_DB.exists():
        return 0
    with closing(sqlite3.connect(f"file:{MESSAGES_DB}?mode=rw", uri=True, timeout=5)) as db, db:
        if not db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='pending_inbound_deliveries'").fetchone():
            return 0
        db.execute("BEGIN IMMEDIATE")
        rows = db.execute("""SELECT p.delivery_id,p.payload,m.text,m.ts,m.message_id,m.user_id
            FROM pending_inbound_deliveries p JOIN messages m
            ON p.delivery_id = m.chat_id || ':' || m.message_id
            WHERE m.chat_id=? AND m.direction='in'""", (chat,)).fetchall()
        count = 0
        for delivery_id, payload, text, ts, mid, user_id in rows:
            if str(user_id) != chat or not isinstance(text, str):
                continue
            command = bool(re.fullmatch(r"/?(relogin|релог[іи]н|перевхід)", text.strip(), re.I))
            code = bool(auth_code and since_ms > 0 and ts > since_ms and text.strip() == auth_code)
            if not command and not code:
                continue
            try:
                item = json.loads(payload)
                params = item["params"]
                meta = params["meta"]
                if not isinstance(meta, dict):
                    continue
                if (item["method"] != "notifications/claude/channel"
                    or meta.get("chat_id") != chat or meta.get("user_id") != chat
                    or meta.get("delivery_id") != delivery_id
                    or str(meta.get("message_id")) != str(mid) or params.get("content") != text):
                    continue
            except (ValueError, KeyError, TypeError):
                continue
            db.execute("""CREATE TABLE IF NOT EXISTS auth_control_receipts (
                delivery_id TEXT PRIMARY KEY, kind TEXT NOT NULL, handled_at INTEGER NOT NULL)""")
            db.execute("INSERT OR IGNORE INTO auth_control_receipts VALUES (?,?,?)",
                       (delivery_id, "relogin" if command else "oauth_code", int(time.time() * 1000)))
            count += db.execute("DELETE FROM pending_inbound_deliveries WHERE delivery_id=? AND payload=?",
                                (delivery_id, payload)).rowcount
        return count


def distinct_account(before: str | None, after: str | None) -> bool:
    """An account switch that proves a different identity; a same or unknown login keeps its limit."""
    return bool(before) and bool(after) and after != before


def release_limit_hold() -> int:
    """End the previous account's limit hold; the transport is stopped and the lifecycle lock held.

    The receiver keeps requests paused until the old account's reset, and the limit
    watchdog closes its incident only after a reply that the paused queue never lets
    through (Кеш, 29.09: accounts switched at 17:25 UTC, the queue waited for the
    17:42 reset). The watchdog's own reader and writer keep its state valid.
    """
    now = int(time.time() * 1000)
    released = 0
    if MESSAGES_DB.exists():
        with closing(sqlite3.connect(f"file:{MESSAGES_DB}?mode=rw", uri=True, timeout=5)) as db, db:
            tables = {row[0] for row in db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
            if {"delivery_results", "pending_inbound_deliveries", "delivery_runtime"} <= tables:
                db.execute("BEGIN IMMEDIATE")
                paused = [row[0] for row in db.execute(
                    "SELECT delivery_id FROM delivery_results WHERE state='paused' "
                    "AND recovery_reason='provider_limit' AND resume_after>?", (now,))]
                for delivery_id in paused:
                    db.execute("UPDATE delivery_results SET resume_after=? WHERE delivery_id=? "
                               "AND state='paused' AND recovery_reason='provider_limit'", (now, delivery_id))
                    db.execute("UPDATE pending_inbound_deliveries SET next_attempt_at=? WHERE delivery_id=? "
                               "AND state='recovering' AND next_attempt_at>?", (now, delivery_id, now))
                db.execute("UPDATE delivery_runtime SET value=?, updated_at=? WHERE key='provider_pause_until' "
                           "AND CAST(value AS INTEGER)>?", (str(now), now, now))
                released = len(paused)
    watchdog = Path(__file__).resolve().with_name("claude-limit-recovery")
    state_path = AGENT_ROOT / "logs/claude-limit-recovery.json"
    if watchdog.is_file() and state_path.is_file():
        loader = importlib.machinery.SourceFileLoader("claude_limit_recovery", str(watchdog))
        limits = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
        loader.exec_module(limits)
        state = limits.load_state(state_path)
        incident = state["incident"]
        if incident is not None and not incident["resolved"] and not incident["expired"]:
            incident["resolved"] = True
            limits.atomic_write_state(state_path, state)
    return released


def finish_recovery(
    token: str,
    chat: str,
    *,
    success_message: str,
    success_log: str,
    auth_code: str = "",
    since_ms: int = 0,
    account_switched: bool = False,
) -> int:
    """Complete OAuth recovery only when Telegram transport is live."""
    mark_auth_established()
    try:
        with stopped_auth_transport():
            try:
                settled = settle_auth_control_deliveries(chat, auth_code, since_ms)
            finally:
                # Even if settlement fails, do not leave a stopped service behind.
                recovered = restart_and_verify_transport()
            # Another account has its own limit: once the transport is proven live, still under
            # the lifecycle lock, the old one's saved requests go now. A failed restart keeps
            # the hold and its incident as evidence (Codex, task 48).
            released = release_limit_hold() if account_switched and recovered else 0
    except (OSError, sqlite3.Error, RuntimeError, subprocess.SubprocessError):
        log("auth restored but auth-control queue settlement failed; retained")
        send(token, chat, say("auth.queue_unchecked", "⚠️ Вхід відновлено, але черга ще потребує перевірки. Запити збережено."))
        return 1
    if settled:
        log(f"settled {settled} auth-control deliveries; business requests preserved")
    if account_switched and recovered:
        log(f"previous account's limit hold released; {released} paused request(s) resume now")
    try:
        STATE_FILE.unlink()
    except OSError:
        pass
    if recovered:
        send(token, chat, success_message)
        log(success_log)
        return 0
    send(
        token,
        chat,
        say("auth.transport_failed",
            "⚠️ Авторизацію Claude відновлено, але Telegram-канал не запустився "
            "після двох безпечних перезапусків. Відновлення не позначено завершеним — "
            "потрібна перевірка каналу."),
    )
    log("auth restored but Telegram poller failed after two restarts")
    return 1


def debounced() -> bool:
    try:
        state = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except Exception:
        return False
    pid = state.get("pid")
    if pid:
        try:
            os.kill(int(pid), 0)
            return True  # another rescue flow is live
        except OSError:
            pass
    return time.time() - state.get("ts", 0) < DEBOUNCE_S


def save_state() -> None:
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps({"ts": time.time(), "pid": os.getpid()}))


def acquire_lock() -> int | None:
    """Allow only one interactive OAuth flow per agent."""
    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(LOCK_FILE, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(descriptor)
        return None
    return descriptor


def owner_wrote_since(since_ms: int) -> bool:
    """The owner sent the bot a message after this moment (read-only; unread is no)."""
    try:
        chat = owner_chat()
        conn = sqlite3.connect(f"file:{MESSAGES_DB}?mode=ro", uri=True, timeout=2)
        try:
            return conn.execute(
                "SELECT 1 FROM messages WHERE chat_id=? AND direction='in' AND ts>? LIMIT 1",
                (chat, since_ms),
            ).fetchone() is not None
        finally:
            conn.close()
    except Exception:
        return False


def wait_code_from_owner(chat: str, since_ms: int, state: str = "",
                         switching_from: str = "", manual_target: bool = False,
                         switching: bool | None = None) -> str | None:
    if switching is None:
        switching = bool(switching_from)
    deadline = time.time() + CODE_TIMEOUT_S
    while time.time() < deadline:
        if manual_target and not manual_relogin_chat(chat):
            return ""
        # A desktop operator may complete a separate login while this rescue is
        # waiting on its own OAuth code. Stop immediately instead of sending a
        # false "still logged out / link expired" alert ten minutes later.
        # During an account switch the old login is alive by definition: only
        # a different account means someone else completed a login meanwhile.
        # With no address known for the old login, nothing can prove another one: wait for the code.
        if switching:
            if switching_from and auth_email() not in ("", switching_from):
                return None
        elif logged_in():
            return None
        try:
            conn = sqlite3.connect(f"file:{MESSAGES_DB}?mode=ro", uri=True, timeout=2)
            rows = conn.execute(
                "SELECT text FROM messages WHERE chat_id=? AND direction='in' "
                "AND ts>? ORDER BY ts",
                (chat, since_ms),
            ).fetchall()
            conn.close()
            for (text,) in rows:
                if not text or not looks_like_code(text):
                    continue
                text = text.strip()
                # a code from an OLD login link (stale #state suffix) can never
                # succeed — ignore it and keep waiting for the right one
                if state and not text.endswith(f"#{state}"):
                    continue
                return text
        except Exception:
            pass
        time.sleep(5)
    return ""


def login_outcome(switching_from: str, switched_to: str, warn: str,
                  show_identity: bool = True, switching: bool | None = None) -> tuple[str, str]:
    """The owner's message and the log line for a login that landed. Only a distinct account
    is a switch: the same one, or one we could not identify, keeps its limit (Codex, task 48 P2).
    Only the owner's chat sees account identities, as everywhere else in this flow."""
    queued = say("auth.queued", "Службу перезапущено, збережені запити залишаються в черзі.") + warn
    if not (bool(switching_from) if switching is None else switching):
        return say("auth.restored", "✅ Вхід у Claude відновлено. ") + queued, "rescue OK, transport verified"
    if distinct_account(switching_from, switched_to):
        who = switched_to if show_identity else say("auth.new_login", "новий вхід")
        return (say("auth.switched", "✅ Обліковий запис Claude змінено: тепер {who}. ", who=who) + queued,
                "account switched, transport verified")
    if switching_from and switched_to == switching_from:
        who = switched_to if show_identity else say("auth.hidden", "приховано")
        return (say("auth.same_account", "✅ Вхід виконано, але це той самий обліковий запис Claude ({who}): якщо його "
                    "ліміт вичерпано, відповіді підуть після скидання. ", who=who) + queued,
                "same account logged in again, transport verified")
    return (say("auth.unverified", "✅ Вхід у Claude виконано, але не вдалося перевірити, який це обліковий запис, тому пауза "
                "через ліміт, якщо вона була, лишається до скидання. ") + queued,
            "login landed, account unverified, transport verified")


def main(force: bool = False, chat_override: str | None = None) -> int:
    lock_descriptor = acquire_lock()
    if lock_descriptor is None:
        log("another rescue flow is active")
        return 0
    if chat_override is not None and (not force or not manual_relogin_chat(chat_override)):
        log("manual relogin recipient no longer authorized")
        os.close(lock_descriptor)
        return 1
    # force = owner typed /relogin: send a fresh link now, even if the current
    # login still looks alive and regardless of the auto-debounce.
    if not force:
        authenticated = logged_in()
        if authenticated is not False:
            if authenticated is True:
                mark_auth_established()
                try:
                    os.unlink(ATTEMPTS_FILE)
                except FileNotFoundError:
                    pass
            # A blocked, malformed or timed-out probe is not proof of recovery
            # and must neither send a link nor reset the one-shot marker.
            return 0
    if not force and not AUTH_ESTABLISHED.exists():
        log("initial Claude auth pending; auto-rescue disabled")
        return 0
    if not force and debounced():
        log("debounced")
        return 0
    # Manual retries bypass the cap but keep it consumed. If the owner ignores
    # that link too, the next health tick still must not send another one —
    # until the owner writes again: a link sent at night dies in ten minutes,
    # and the owner's next message is when a fresh one is useful (03.10.2026).
    # A cap taken before the last established login belongs to an outage that
    # login ended (AALL, Лилу: capped since 28.09, no link on 03.10).
    if not force:
        try:
            _n = int(ATTEMPTS_FILE.read_text(encoding="ascii").strip() or "0")
            capped_at = ATTEMPTS_FILE.stat().st_mtime
        except Exception:
            _n, capped_at = 0, 0.0
        if _n >= AUTO_ATTEMPTS_CAP:
            try:
                stale = AUTH_ESTABLISHED.stat().st_mtime > capped_at
            except OSError:
                stale = False
            if stale:
                log("auto-rescue cap of an earlier outage cleared: a login was established after it")
            elif owner_wrote_since(int(capped_at * 1000)):
                log("owner wrote after the last link; sending a fresh one")
            elif time.time() - capped_at >= DAYTIME_RELINK_AFTER_S and owner_daytime(time.time()):
                log("the outage goes on and it is the owner's daytime; sending a fresh link")
            else:
                log(f"auto-rescue capped after {_n} attempts; waiting for /relogin or the owner's next message")
                return 0
    ATTEMPTS_FILE.parent.mkdir(parents=True, exist_ok=True)
    ATTEMPTS_FILE.write_text(str(AUTO_ATTEMPTS_CAP), encoding="ascii")
    ATTEMPTS_FILE.chmod(0o600)
    save_state()

    token = bot_token()
    chat = chat_override or owner_chat()
    if not token or not chat:
        log("no bot token or owner chat — cannot assist")
        return 1
    show_account_identity = chat == owner_chat()

    # /relogin while the login is alive = the owner switches accounts (a burnt
    # weekly limit, a shared login). Nothing below may read `loggedIn` as
    # "done": the old account answers `loggedIn: true` until the new one lands.
    switching_from = auth_email() if force else ""
    # Арти, 02.10.2026: a live login can answer `loggedIn: true` with no account address. The
    # owner's /relogin is an account switch then too. Taken for a dead login, the first liveness
    # check ended it as «restored by another flow»: the link died three seconds after it was
    # sent, the service restarted, and the pasted code was never read.
    switching = bool(switching_from) or (force and logged_in() is True)
    log("account switch requested — starting login flow" if switching
        else "auth dead — starting rescue flow")
    pid, fd = pty.fork()
    if pid == 0:
        os.execve(str(CLAUDE_BIN), [str(CLAUDE_BIN), "auth", "login", "--claudeai"], login_environment())

    output = b""
    url = ""
    end = time.time() + URL_TIMEOUT_S
    while time.time() < end and not url:
        ready, _, _ = select.select([fd], [], [], 1)
        if ready:
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                break
            if not chunk:
                break
            output += chunk
            url = extract_url(output.decode(errors="replace"))

    if not url:
        os.kill(pid, signal.SIGKILL)
        log("no oauth url captured; waiting for /relogin")
        try:
            STATE_FILE.unlink()
        except OSError:
            pass
        return 1

    state_match = re.search(r"[?&]state=([A-Za-z0-9_\-]+)", url)
    state = state_match.group(1) if state_match else ""

    since_ms = int(time.time() * 1000)
    if chat_override is not None and not manual_relogin_chat(chat):
        os.kill(pid, signal.SIGKILL)
        log("manual relogin recipient revoked before link delivery")
        return 1
    publish_auth_input(chat, state, since_ms)
    if switching:
        current = (f" ({switching_from if show_account_identity else say('auth.hidden', 'приховано')})"
                   if switching_from else "")
        outcome = send(token, chat, say("auth.switch_link",
             "🔐 Перемикаю обліковий запис Claude за твоєю командою. Поточний вхід{current} "
             "працює, доки не завершиш новий:\n"
             "1) Відкрий посилання нижче та увійди до ПОТРІБНОГО облікового запису Claude.\n"
             "2) Скопіюй код зі сторінки.\n"
             "3) Надішли мені сюди код ОДНИМ повідомленням (лише код, без слів).\n\n"
             "{url}\n\n"
             "⏳ Чекаю код 10 хвилин. Передумав — нічого не надсилай, усе залишиться як є. "
             "Свіже посилання — командою /relogin.", current=current, url=url))
    else:
        outcome = send(token, chat, say("auth.link",
             "🔐 Термін дії моєї авторизації Claude завершився. Віднови її за хвилину, без SSH:\n"
             "1) Відкрий посилання нижче та увійди до свого облікового запису Claude.\n"
             "2) Скопіюй код зі сторінки.\n"
             "3) Надішли мені сюди код ОДНИМ повідомленням (лише код, без слів).\n\n"
             "{url}\n\n"
             "⏳ Чекаю код 10 хвилин. Якщо не встигнеш або посилання втратить чинність — просто напиши мені "
             "/relogin, і я відразу надішлю свіже (скільки завгодно разів).", url=url))
    if outcome == "refused":
        os.kill(pid, signal.SIGKILL)
        if not force:
            try:
                ATTEMPTS_FILE.unlink()
            except OSError:
                pass
        log("oauth url NOT delivered (Telegram refused); the next attempt follows the debounce")
        return 1
    # An unconfirmed send may have reached the owner: the same flow keeps waiting for its code
    # and the link is not sent again (Codex AGENTS 03.10, #175 P1-1).
    log("oauth url sent to authorized chat; waiting for code" if outcome == "delivered"
        else "oauth url send unconfirmed (it may have arrived); waiting for code")

    code = wait_code_from_owner(chat, since_ms, state, switching_from, chat_override is not None,
                                switching=switching)
    if code is None:
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        return finish_recovery(
            token,
            chat,
            success_message=(
                say("auth.switched_elsewhere", "✅ Обліковий запис Claude вже змінено іншим способом: тепер {who}. ",
                    who=(auth_email() or say("auth.new_login", "новий вхід")) if show_account_identity
                    else say("auth.new_login", "новий вхід"))
                + say("auth.queued", "Службу перезапущено, збережені запити залишаються в черзі.")
                if switching else
                say("auth.restored_elsewhere", "✅ Вхід у Claude вже відновлено іншим способом. ")
                + say("auth.queued", "Службу перезапущено, збережені запити залишаються в черзі.")
            ),
            success_log="rescue completed by another login flow; transport verified",
            account_switched=distinct_account(switching_from, auth_email()),
        )
    if not code:
        os.kill(pid, signal.SIGKILL)
        if not force:
            try:
                os.utime(ATTEMPTS_FILE)
            except OSError:
                pass
        log("code wait timeout")
        return 1

    os.write(fd, code.encode() + b"\n")
    log("code pasted into cli")

    # The login process exiting cleanly is the one CLI-independent proof that
    # the pasted code was accepted; an account switch cannot rely on `loggedIn`.
    landed = False
    end = time.time() + 45
    while time.time() < end:
        done, status = os.waitpid(pid, os.WNOHANG)
        if done == pid:
            landed = os.waitstatus_to_exitcode(status) == 0
            break
        ready, _, _ = select.select([fd], [], [], 1)
        if ready:
            try:
                if not os.read(fd, 4096):
                    break
            except OSError:
                break
    if not landed:
        # The terminal closes when the login process ends, and that read leaves the loop before
        # the exit status is collected (Арти, 02.10.2026: an accepted code was called rejected and
        # the service was not restarted). Collect it here; a process still running proves nothing.
        for _ in range(50):
            try:
                done, status = os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                break
            if done == pid:
                landed = os.waitstatus_to_exitcode(status) == 0
                break
            time.sleep(0.2)

    if not logged_in():
        # old CLIs ignore the stdin paste — their login waits on a loopback port
        port = listener_port(pid)
        if port and state:
            try:
                query = urllib.parse.urlencode(
                    {"code": code.split("#", 1)[0], "state": state})
                urllib.request.urlopen(
                    f"http://127.0.0.1:{port}/callback?{query}", timeout=20)
                log("stdin didn't land — delivered via loopback callback")
            except Exception as error:
                log(f"loopback delivery failed: {type(error).__name__}")
            end = time.time() + 40
            while time.time() < end:
                if logged_in():
                    break
                time.sleep(5)

    switched_to = auth_email() if switching else ""
    if switching:
        succeeded = landed or (bool(switching_from) and switched_to not in ("", switching_from))
    else:
        succeeded = bool(logged_in())
    if succeeded:
        zombies = env_token_zombies()
        warn = (say("auth.zombie_warn", "\n⚠️ У {where} залишився {zombies} — старий токен перекриває "
                    "нову авторизацію (бот отримає 401). Видали цей рядок і перезапусти мене.",
                    where=str(ENV_FILE) if show_account_identity else say("auth.settings", "налаштуваннях"),
                    zombies=zombies)
                if zombies else "")
        success_message, success_log = login_outcome(switching_from, switched_to, warn, show_account_identity,
                                                     switching=switching)
        return finish_recovery(
            token,
            chat,
            success_message=success_message,
            success_log=success_log,
            auth_code=code,
            since_ms=since_ms,
            account_switched=distinct_account(switching_from, switched_to),
        )

    if switching:
        send(token, chat, say("auth.code_rejected_switch",
             "❌ Код не підійшов (або надісланий із зайвим текстом). "
             "Залишаюся на {who}. "
             "Напиши /relogin — надішлю свіже посилання, спробуємо ще раз.",
             who=switching_from if switching_from and show_account_identity
             else say("auth.previous_login", "попередньому вході")))
        log("code rejected — account unchanged")
        return 1
    send(token, chat, say("auth.code_rejected",
         "❌ Код не підійшов (або надісланий із зайвим текстом). "
         "Напиши /relogin — надішлю свіже посилання, спробуємо ще раз."))
    log("code rejected — still logged out")
    return 1


if __name__ == "__main__":
    args = sys.argv[1:]
    if args == []:
        sys.exit(main())
    if args == ["--force"]:
        sys.exit(main(force=True))
    if len(args) != 3 or args[:2] != ["--force", "--chat"]:
        sys.exit(2)
    sys.exit(main(force=True, chat_override=args[2]))
