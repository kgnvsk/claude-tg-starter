#!/usr/bin/env python3
"""credential-intake — store one key the owner sent his bot in its private chat (owner, 24.10.2026: no web forms).

The receiver runs it as the agent with one JSON object on stdin: {"provider": ..., "name": ... (custom only),
"value": ...}. It prints metadata JSON only; the value never reaches argv, output or a log.

  vercel, apify, openai   agent-connections: the provider is asked and only a working key is stored («verified»)
  custom                  agent-connections under the given name: stored, not checked («saved»)
  instagram               ig-poll connect --stdin: Meta checks it before it replaces the stored token («verified»;
                          «verified_unready» when it was stored but the first collection after it failed)
  instagram_app_secret    IG_APP_SECRET in the existing ~/ig/config.env, checked private write («saved», not checked)

A key that does not work, or that could not be checked, never replaces the one stored before. State: verified |
verified_unready | saved | invalid (the provider or the shape refused it) | unavailable (not checked, not stored) | unsupported (not this
agent's or not this intake's) | failed (the store refused).
"""
from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys

HOME = Path.home()
CONNECTIONS = ("vercel", "apify", "openai")


def connection_store():
    """agent-connections beside this helper: the one credential store of this agent."""
    loader = importlib.machinery.SourceFileLoader("credential_intake_store", str(Path(__file__).with_name("agent-connections")))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def connection(provider: str, name, value: str) -> dict:
    store = connection_store()
    result = store.handle({"operation": "put", "home": str(HOME), "provider": provider, "value": value,
                           "name": name if provider == "custom" else store.PROVIDERS[provider][0]})
    if result.get("ok"):
        return {"state": "verified" if (result.get("connection") or {}).get("status") == "connected" else "saved"}
    error = result.get("error")
    state = ("invalid" if error in ("invalid_key", "invalid_value") else
             "unsupported" if error in ("invalid_name", "invalid_provider", "native_managed") else
             "unavailable" if error == "unavailable" else "failed")
    return {"state": state, "detail": error}


def instagram_token() -> str | None:
    """The token ig-poll keeps, found the way ig-poll reads its config."""
    configured = ""
    try:
        lines = Path(os.environ.get("IG_CONFIG", str(HOME / "ig/config.env"))).read_text(encoding="utf-8").splitlines()
    except OSError:
        lines = []
    for line in lines:
        key, _, found = line.strip().partition("=")
        if key.strip() == "IG_TOKEN_FILE" and not line.strip().startswith("#"):
            configured = found.strip()
    try:
        return Path(configured or HOME / ".config/ig-page-token").expanduser().read_text(encoding="utf-8").strip()
    except OSError:
        return None


def instagram(value: str) -> dict:
    helper = HOME / "bin/ig-poll"
    if not helper.is_file():
        return {"state": "unsupported", "detail": "instagram-dm is not set up on this agent"}
    before = instagram_token()
    try:
        # Inside the receiver's minute: ig-poll checks the token, stores it, then makes a first collection pass.
        done = subprocess.run([str(helper), "connect", "--stdin"], input=value + "\n", capture_output=True, text=True,
                              timeout=45)
    except subprocess.TimeoutExpired:
        # Stopped midway: only the stored token itself says whether Meta's check had passed.
        saved = before != value and instagram_token() == value
        return {"state": "verified_unready" if saved else "unavailable", "detail": "ig-poll connect did not finish in 45 s"}
    if done.returncode == 0:
        return {"state": "verified"}
    reason = (done.stderr.strip().splitlines() or [""])[-1]
    # An error can happen before or after persistence. Claim a save only when the new token is actually stored.
    if before != value and instagram_token() == value:
        return {"state": "verified_unready", "detail": reason}
    invalid = any(mark in reason for mark in ("не схоже на токен", "не прийняла токен", "немає доступу"))
    return {"state": "invalid" if invalid else "unavailable", "detail": reason}


def app_secret(value: str) -> dict:
    if not re.fullmatch(r"[0-9a-f]{32}", value):
        return {"state": "invalid", "detail": "an App Secret is 32 hexadecimal characters"}
    config = HOME / "ig/config.env"
    try:
        info = config.lstat()
    except FileNotFoundError:
        return {"state": "unsupported", "detail": "instagram-dm is not set up on this agent (no ~/ig/config.env)"}
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_nlink != 1:
        return {"state": "failed", "detail": "~/ig/config.env is not this agent's own regular file"}
    lines = config.read_text(encoding="utf-8").splitlines()
    for index, line in enumerate(lines):
        if line.strip().removeprefix("export ").lstrip().startswith("IG_APP_SECRET="):
            lines[index] = f"IG_APP_SECRET={value}"
            break
    else:
        lines.append(f"IG_APP_SECRET={value}")
    temporary = config.with_name(f".{config.name}.{os.getpid()}")
    descriptor = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write("\n".join(lines) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, config)
        directory = os.open(config.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        temporary.unlink(missing_ok=True)
    return {"state": "saved"}


def main() -> int:
    provider, value = None, ""
    try:
        request = json.loads(sys.stdin.read(64 * 1024))
        if not isinstance(request, dict) or set(request) - {"provider", "name", "value"}:
            raise ValueError("invalid request")
        provider, value = request.get("provider"), request.get("value")
        if not isinstance(value, str) or not value:
            raise ValueError("invalid request")
        if provider in CONNECTIONS:
            result = connection(provider, None, value)
        elif provider == "custom":
            result = connection("custom", request.get("name"), value)
        elif provider == "instagram":
            result = instagram(value)
        elif provider == "instagram_app_secret":
            result = app_secret(value)
        else:
            result = {"state": "unsupported"}
    except (ValueError, TypeError, OSError, subprocess.SubprocessError) as error:
        result = {"state": "failed", "detail": type(error).__name__}
    detail = str(result.get("detail") or "")
    if value and value in detail:
        detail = detail.replace(value, "…")  # a provider that echoes the key does not carry it any further
    print(json.dumps({"ok": result["state"] in ("verified", "verified_unready", "saved"), "provider": provider if isinstance(provider, str) else None,
                      "state": result["state"], **({"detail": detail} if detail else {})}, ensure_ascii=False))
    return 0 if result["state"] in ("verified", "verified_unready", "saved") else 1


if __name__ == "__main__":
    raise SystemExit(main())
