# StreamPost runtime credentials. Copy to .env and fill in.

# Telegram API (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Bot token (from @BotFather) — same bot publishes AND handles admin commands
TELEGRAM_BOT_TOKEN=

# LLM gateway — Mode A (default): Claude Max proxy on localhost (subscription)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:3456
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_MODEL=claude-sonnet-4-6

# LLM gateway — Mode B (alternative): direct Anthropic API key
# ANTHROPIC_API_KEY=

# Optional path overrides
# STREAMPOST_CONFIG_DIR=/opt/streampost/configs
# STREAMPOST_DATA_DIR=/opt/streampost/data
