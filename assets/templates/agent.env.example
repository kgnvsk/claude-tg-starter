# Root-only source of deployment inputs.
#
# Preferred: run `bash onboard.sh`; it writes /etc/claude-tg-starter/agent.env safely.
# For automation, create that file with mode 600, then:
#   set -a; . /etc/claude-tg-starter/agent.env; set +a
#   bash assets/install-core.sh
#
# install-core reads these from the environment, renders every {{PLACEHOLDER}},
# writes the runtime env, and replaces only its managed crontab block.
# NEVER commit a filled config: it holds the Telegram token.

# ─────────────────────────── REQUIRED ───────────────────────────
AGENT_NAME=                 # ім’я АГЕНТА (як бот себе називає), напр. BroAgent. НЕ «Cash» — це чуже ім’я. Якщо власник не визначився — запитай його.
OWNER_NAME=                 # ім’я власника для персони, напр. Alex
OWNER_TG_USERNAME=          # його @username у Telegram, БЕЗ @
OWNER_CHAT_ID=              # його user_id (дізнатися: @userinfobot) — allowlist + тривоги
ADDITIONAL_ADMIN_CHAT_IDS=  # необов’язково: додаткові admin chat_id через кому
ALERT_COPY_CHAT_IDS=        # необов’язково: технічні копії критичних тривог, chat_id через кому
BOT_USERNAME=               # username бота, БЕЗ @ (закінчується на _bot)
TIMEZONE=                   # IANA TZ, напр. Europe/Lisbon — для кронів
TELEGRAM_BOT_TOKEN=         # від @BotFather, формату 1234567890:AA...  (СЕКРЕТ)
NOVSKY_LICENSE_KEY=         # ключ придбаного комплекту; один ключ — один бот. Starter залишає порожнім.

# Recovery only: 1 discards Telegram updates queued before the next successful boot.
# Default 0 preserves messages sent while the agent was offline.
TG_DROP_PENDING_ON_BOOT=0

# Рольові субагенти повного комплекту (assets/agents/roles/*.md): які з них
# бот бачить і може викликати. "all" — усі, порожньо — жодного, або список через
# кому: smm-manager,marketing-strategist. Після зміни — повторний install-core
# (або update.sh) і перезапуск служби.
ACTIVE_ROLES=all

# Роль як окремий бот (лише другий інстанс через AGENT_USER у повному
# комплекті): AGENT_ROLE=smm-manager робить персоною цього бота
# assets/roles/smm-manager/ROLE.md. Основний агент цю змінну не ставить.

# Premium corporate canary: 1 enables isolated read-only Telegram sessions.
# Корпоративний canary Premium: 1 вмикає ізольовані Telegram-сесії лише для читання.
# Default 0 keeps the existing owner runtime unchanged.
# За замовчуванням 0 наявний Telegram runtime власника не змінюється.
TG_CORPORATE_SESSIONS=0

# ─────────────────────────── OPTIONAL ───────────────────────────
OPENAI_API_KEY=             # голосові (transcribe). Порожньо → транскрипцію вимкнено.
VOICE_SETUP_STATUS=deferred # configured або deferred; reminder не частіше разу на 7 днів
MEMORY_EMBEDDINGS_OPENAI=enabled  # semantic (vector) memory reuses the voice key; set disabled to keep the vault and chats out of OpenAI
CALENDAR_EMAIL=             # ранковий дайджест 07:30 через gcalcli. Порожньо → крон не встановлюється.
OWNER_EMAIL=                # email власника. Потрібен для веб-vault: Vercel вимагає, щоб автор
                            #   коміту збігався з email акаунта (інакше деплой = COMMIT_AUTHOR_REQUIRED).
                            #   Той самий email — для GitHub. Порожньо → setup.sh пропустить git-author і попередить.
VAULT_LOCALE=en-US          # локаль Quartz для веб-vault (en-US, uk-UA, ru-RU…). Впливає на формат дат.

# ──────────────────── OPT-IN MODULES (flags) ────────────────────
# Флаги зберігають вибір власника; модульний installer застосовує лише ввімкнені пакети.
# Базовий агент (бот, пам’ять, календар, зображення, PDF, браузер) працює без них.

MODULE_DESIGN_PACK=0        # 1 → дизайн-скіли (impeccable/frontend-design/apple-bento) + vercel-deploy.
                            #     Потрібні node (фаза 1) і токен Vercel (фаза 6) для деплоїв.
MODULE_CHANNEL_PUBLISH=0    # 1 → публікація дописів у Telegram-канал (claw-publish) + (необов’язково) auto-publisher.
                            #     Потребує CHANNEL_ID нижче.
MODULE_SOCIAL_BROWSER=0     # 1 → авторизований браузер (Xvfb+Chrome+proxy) для Instagram/Threads.
                            #     Важкий модуль; встановлюй лише якщо справді потрібен соціальний постинг.
MODULE_TRANSPORT_DAEMON=0   # ЗНЯТО З ПІДТРИМКИ. На Claude Code 2.1.208+ плагін каналу в цьому режимі
                            #     не запускається: демон складає вхідні повідомлення в чергу, а обробляти їх
                            #     нікому. Надсилання (крони, тривоги) водночас працює — бот виглядає
                            #     живим і мовчить на всі повідомлення (інцидент Кеша 29.07.2026).
                            #     Флаг залишено, щоб старі agent.env не падали: встановник його
                            #     ігнорує, а update.sh знімає демон з боксів, де він стояв.
                            #     (відкотити: той самий скрипт з аргументом `disable`).
MODULE_VAULT_WEB=0          # 1 → веб-перегляд Novsky Vault на Vercel (Quartz: граф+нотатки+пошук), за паролем.
                            #     Бренд уже вбудовано (Unbounded+Onest, бурштиновий, граф під текстом). Встановлюється:
                            #     bash modules/vault-web/setup.sh <vercel-домен>. Якщо є ~/.config/vercel-token
                            #     і SITE_PASSWORD — задеплоїть сам; інакше підключаєш репо до Vercel вручну +
                            #     env SITE_PASSWORD. Потрібен OWNER_EMAIL (git-author). Див. modules/vault-web/README.
MODULE_INSTAGRAM_DM=0     # 1 → Instagram Direct (читати+відповідати в директі, Meta API). Далі — modules/instagram-dm/SETUP.md
MODULE_YOUTUBE_COMMENTS=0 # 1 → парсинг коментарів YouTube без відповіді. Далі — modules/youtube-comments/SETUP.md

# ─────────── параметри модулів (потрібні лише за ввімкненого прапорця) ───────────
CHANNEL_ID=                 # для MODULE_CHANNEL_PUBLISH: -100... id цільового каналу (бот — адмін каналу)
SITE_PASSWORD=              # для MODULE_VAULT_WEB (необов’язково): пароль Basic-Auth для веб-vault. Якщо задано +
                            #   є vercel-token, setup.sh сам встановить його у Vercel env. Порожньо → встановлюєш у дашборді.
