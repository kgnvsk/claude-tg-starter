# ~/.claude/channels/telegram/.env  (chmod 600!)
TELEGRAM_BOT_TOKEN=               # від @BotFather
OPENAI_API_KEY=                   # для голосових (transcribe, gpt-4o-mini-transcribe)
OPENAI_API_KEY_FALLBACK=          # необов’язково, резерв
TRANSCRIBE_LANGUAGE=              # необов’язково: мова голосових (uk, ru, en…); порожньо — визначається сама
MEMORY_EMBEDDINGS_OPENAI=disabled # enabled only after separate owner consent
TG_DELIVERY_AUTHORITY=receiver    # guard | shadow | receiver — хто знімає доставлене повідомлення з черги; новий агент — receiver; перехід наявного — RECEIPTS_UPGRADE.md (scripts/receipts-switch)
