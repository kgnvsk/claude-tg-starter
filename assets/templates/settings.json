{
  "permissions": {
    "allow": [
      "Bash({{AGENT_HOME}}/bin/html-to-pdf:*)",
      "Bash({{AGENT_HOME}}/bin/transcribe:*)",
      "Bash({{AGENT_HOME}}/bin/transcribe-telegram:*)",
      "Bash({{AGENT_HOME}}/bin/vc:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(rm /tmp/*)",
      "Bash(rm /tmp/*.html)",
      "Bash(rm /tmp/*.pdf)",
      "Bash(vercel:*)",
      "Bash(~/.npm-global/bin/vercel:*)",
      "Bash(~/bin/html-to-pdf:*)",
      "Bash(~/bin/transcribe:*)",
      "Bash(~/bin/transcribe-telegram:*)",
      "Bash(~/bin/vc:*)",
      "mcp__playwright__*",
      "Bash({{AGENT_HOME}}/bin/allow-chat:*)",
      "Bash(~/bin/allow-chat:*)"
    ],
    "defaultMode": "bypassPermissions",
    "deny": [
      "AskUserQuestion",
      "Read({{AGENT_HOME}}/.claude/channels/telegram/.env)",
      "Read({{AGENT_HOME}}/.claude/.credentials.json)",
      "Read(/etc/claude-tg-starter/**)",
      "Edit({{AGENT_HOME}}/.claude/channels/telegram/.env)",
      "Edit({{AGENT_HOME}}/.claude/.credentials.json)",
      "Edit(/etc/claude-tg-starter/**)"
    ]
  },
  "model": "claude-opus-5",
  "skillListingBudgetFraction": 0.08,
  "skillListingMaxDescChars": 240,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{AGENT_HOME}}/bin/no-nested-claude-guard",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__plugin_telegram_telegram__reply",
        "hooks": [
          {
            "type": "command",
            "command": "{{AGENT_HOME}}/bin/tg-format-enforcer",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{AGENT_HOME}}/bin/no-secrets-guard",
            "timeout": 5
          }
        ],
        "matcher": "Bash|Read|Edit|Write|MultiEdit"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{AGENT_HOME}}/bin/memory-budget-guard",
            "timeout": 5
          }
        ],
        "matcher": "Bash|Edit|Write|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{AGENT_HOME}}/bin/wiki-hot-inject",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "{{AGENT_HOME}}/bin/tg-context-inject",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // \"\"' | grep -q \"^{{AGENT_HOME}}/obsidian-vault/\" && {{AGENT_HOME}}/bin/vault-sync &",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{AGENT_HOME}}/bin/tg-context-inject",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{AGENT_HOME}}/bin/subagent-result-nudge",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{AGENT_HOME}}/bin/tg-reply-stop-guard",
            "timeout": 35
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "telegram@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "alwaysThinkingEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "env": {
    "MCP_TOOL_TIMEOUT": "180000",
    "CLAUDE_CODE_MCP_TOOL_IDLE_TIMEOUT": "120000"
  }
}
