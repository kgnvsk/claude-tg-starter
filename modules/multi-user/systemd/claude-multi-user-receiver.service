[Unit]
Description=Cash multi-user Telegram receiver
Documentation=https://github.com/kgnvsk/claude-tg-starter
Wants=network-online.target
After=network-online.target
Before=claude-multi-user-dispatcher.service

[Service]
Type=simple
WorkingDirectory=%h
EnvironmentFile=%h/multi-user/multi-user.env
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.bun/bin/bun %h/multi-user/src/receiver-main.ts
Restart=always
RestartSec=3
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/multi-user/state
MemoryMax=384M
TasksMax=128
LimitNOFILE=4096
TimeoutStopSec=30
SuccessExitStatus=0 143

[Install]
WantedBy=default.target
